    save_updater_settings();
}
// Single encrypted progress save. Everything the player earns or changes lives
// here: position and facing, vitals, level and experience, resurrections,
// inventory, equipment, posture and discovered maps.
void save_location()
{
    if (current_player_character != "stefan" && current_player_character != "annie" && current_player_character != "ilana") return;
    savedata loc(get_game_save_path(current_player_character), GAME_SAVE_KEY);
    loc.add("mapname", mapname);
    loc.add("pos_x", int(me.x));
    loc.add("pos_y", int(me.y));
    loc.add("pos_z", int(me.z));
    loc.add("facing", facing);
    loc.add("level", level);
    loc.add("xp", xp);
    loc.add("resurrections", resurrections);
    loc.add("health", health);
    loc.add("maxhealth", maxhealth);
    loc.add("player_character", current_player_character);
    loc.add("current_weapon", current_weapon_id);
    loc.add("equipped_shield_id", (current_shield !is null ? current_shield.id : ""));
    loc.add("equipped_shield_durability", (current_shield !is null ? current_shield.durability : 0));
    loc.add("inventory_data", serialize_inventory());
    loc.add("favorite_items", serialize_favorite_items());
    loc.add("is_sitting", is_sitting ? 1 : 0);
    loc.add("player_inside_elevator", player_inside_elevator ? 1 : 0);
    loc.add("elevator_arrived_waiting_for_exit", elevator_arrived_waiting_for_exit ? 1 : 0);
    loc.add("player_elevator_id", player_elevator_id);
    loc.add("player_elevator_floor", player_elevator_floor);
    loc.add("discovered_maps", serialize_discovered_maps());
    loc.add("starter_pack_granted", 1);
    loc.add("kills", kills);
    loc.save();
}
void reset_location_on_death()
{
    if (current_player_character != "stefan" && current_player_character != "annie" && current_player_character != "ilana") return;
    string save_path = get_game_save_path(current_player_character);
    savedata loc(save_path, GAME_SAVE_KEY);
    loc.load();
    string default_spawn_map = "safe_zone";
    string[] available = get_available_maps();
    if (!map_exists_on_disk(default_spawn_map) && available.length() > 0) default_spawn_map = available[0];
    loc.add("mapname", default_spawn_map);
    loc.add("pos_x", 1);
    loc.add("pos_y", 0);
    loc.add("pos_z", 0);
    loc.add("facing", 0);
    loc.add("level", level);
    loc.add("xp", xp);
    loc.add("resurrections", resurrections);
    maxhealth = calculate_player_max_health(current_player_character, resurrections);
    loc.add("maxhealth", maxhealth);
    loc.add("health", maxhealth);
    loc.add("player_character", current_player_character);
    /* On death: equipped weapon is unequipped and equipped shield is removed */
    current_weapon_id = "";
    remove_all_equipment();
    loc.add("current_weapon", "");
    loc.add("equipped_shield_id", "");
    loc.add("equipped_shield_durability", 0);
    /* Items are NOT lost on death! Carried inventory is preserved and saved. */
    loc.add("inventory_data", serialize_inventory());
    loc.add("favorite_items", serialize_favorite_items());
    loc.add("is_sitting", 0);
    loc.add("player_inside_elevator", 0);
    loc.add("elevator_arrived_waiting_for_exit", 0);
    loc.add("player_elevator_id", "");
    loc.add("player_elevator_floor", "");
    loc.add("discovered_maps", serialize_discovered_maps());
    loc.add("starter_pack_granted", 1);
    loc.save();
}
void load_location(string &out saved_map, int &out lx, int &out ly, int &out lz, int &out lfacing)
{
    if (current_player_character != "stefan" && current_player_character != "annie" && current_player_character != "ilana")
    {
        saved_map = "safe_zone";
        string[] available = get_available_maps();
        if (!map_exists_on_disk(saved_map) && available.length() > 0) saved_map = available[0];
        deserialize_discovered_maps("");
        lx = 1; ly = 0; lz = 0; lfacing = 0;
        level = 1;
        xp = 0;
        resurrections = 0;
        maxhealth = 5000;
        health = maxhealth;
        xprequired = get_xp_required(level);
        current_weapon_id = "";
        walktime = 160;
        remove_all_equipment();
        clear_player_inventory();
        give("starter pack", 1);
        return;
    }

    string save_path = get_game_save_path(current_player_character);
    savedata loc(save_path, GAME_SAVE_KEY);
    loc.load();
    if (loc.d.exists("mapname"))
    {
        saved_map = loc.read("mapname");
        lx = loc.readn("pos_x");
        ly = loc.readn("pos_y");
        lz = loc.readn("pos_z");
        lfacing = loc.readn("facing");
        level = loc.readn("level");
		if (level < 0) level = 0;
        xprequired = get_xp_required(level);
        xp = loc.readn("xp");
        resurrections = loc.readn("resurrections");
        
        maxhealth = calculate_player_max_health(current_player_character, resurrections);
        if (loc.d.exists("health")) health = loc.readn("health");
        else health = maxhealth;
        if (health > maxhealth || health <= 0) health = maxhealth;

		normalize_player_xp(false);
        current_weapon_id = "";
        walktime = get_current_walktime();
        remove_all_equipment();
        if (loc.d.exists("inventory_data"))
        {
            deserialize_inventory(loc.read("inventory_data"));
        }
        if (loc.d.exists("favorite_items")) deserialize_favorite_items(loc.read("favorite_items"));
        /* Starter Pack is given ONLY once per character on first creation: */
        if (!loc.d.exists("starter_pack_granted"))
        {
            if (get_item_count("starter pack") == 0 && get_item_count("starter_pack") == 0)
            {
                give("starter pack", 1);
            }
            loc.add("starter_pack_granted", 1);
            loc.save();
        }
        if (loc.d.exists("current_weapon"))
        {
            string saved_w = loc.read("current_weapon");
            if (saved_w != "" && find_weapon_data(saved_w) !is null && get_item_count(saved_w) > 0)
            {
                equip_weapon(saved_w, true);
            }
        }
        if (loc.d.exists("equipped_shield_id"))
        {
            string s_id = loc.read("equipped_shield_id");
            int s_dur = 0;
            if (loc.d.exists("equipped_shield_durability")) s_dur = loc.readn("equipped_shield_durability");
            else if (loc.d.exists("equipped_shield_charges")) s_dur = loc.readn("equipped_shield_charges");
            if (s_id != "" && s_dur > 0)
            {
                @current_shield = equipped_shield();
                current_shield.id = s_id;
                current_shield.durability = s_dur;
            }
        }

        if (loc.d.exists("is_sitting")) is_sitting = (loc.readn("is_sitting") > 0);
        saved_player_inside_elevator = loc.d.exists("player_inside_elevator") && loc.readn("player_inside_elevator") > 0;
        saved_elevator_arrived_waiting_for_exit = loc.d.exists("elevator_arrived_waiting_for_exit") && loc.readn("elevator_arrived_waiting_for_exit") > 0;
        saved_player_elevator_id = loc.d.exists("player_elevator_id") ? loc.read("player_elevator_id") : "";
        saved_player_elevator_floor = loc.d.exists("player_elevator_floor") ? loc.read("player_elevator_floor") : "";
        if (loc.d.exists("kills")) kills = loc.readn("kills");
        if (loc.d.exists("discovered_maps"))
        {
            deserialize_discovered_maps(loc.read("discovered_maps"));
        }
    }
    else
    {
        string default_spawn_map = "safe_zone";
        string[] available = get_available_maps();
        if (!map_exists_on_disk(default_spawn_map) && available.length() > 0) default_spawn_map = available[0];
        saved_map = default_spawn_map;
        deserialize_discovered_maps("");
        lx = 1; ly = 0; lz = 0; lfacing = 0;
        level = 1;
        xp = 0;
        resurrections = 0;
        maxhealth = calculate_player_max_health(current_player_character, 0);
        health = maxhealth;
        xprequired = get_xp_required(level);
        current_weapon_id = "";
        walktime = get_current_walktime();
        remove_all_equipment();
        clear_player_inventory();
        give("starter pack", 1);
        save_location();
    }
}
void tempreset_internal(bool save_state)
{
    if (save_state) save_current_map_state();
    else clear_saved_map_state(mapname);killsrcs();
    sp.update_listener_3d(me.x, me.y, me.z, double(facing));
    clear_map_data();
    destroy_all_projectiles();
    killbodyfalls();
    itempool.destroy_all();
    itempool.update_listener_3d(me.x, me.y, me.z, double(facing));
    destroy_all_builder_objects();
    npc_destroy_all();
    apply_ambient_volume();
    apply_music_volume();
    dmoving = false;
    movetimer.restart();
    has_moved = true;
    player_walked_since_stop = true;
    idle_scuff_primed = false;
    idle_scuff_played = false;
    idle_scuff_timer.restart();
}

void tempreset_seamless(const string&in target_map = "")
{
    tempreset_internal(true);
    if (target_map != "") check_map_discovery(target_map);
}

void tempreset()
{
    cancel_reload();
    p.destroy_all();
    p.update_listener_3d(0, 0, 0, 0);
    killsrcs();
    tempreset_internal(false);
}
bool initial_session_welcome_played = false;
sound session_welcome_sound;

void play_initial_session_welcome_sound()
{
	if (initial_session_welcome_played) return;
	initial_session_welcome_played = true;

	string[] welcome_files;
	if (directory_exists("sounds/welcome"))
	{
		string[]@ files = find_files("sounds/welcome/*.ogg");
		if (files !is null)
		{
			for (uint i = 0; i < files.length(); i++)
			{
				welcome_files.insert_last("sounds/welcome/" + files[i]);
			}
		}
	}

	if (welcome_files.length() > 0)
	{
		int chosen_idx = random(0, welcome_files.length() - 1);
		string wpath = welcome_files[chosen_idx];
		if (wpath != "" && session_welcome_sound.load(wpath))
		{
			session_welcome_sound.play();
			return;
		}
	}

	string fallback = get_sound_path("welcome/welcome.ogg;welcome.ogg");
	if (fallback != "" && session_welcome_sound.load(fallback))
	{
		session_welcome_sound.play();
	}
}

string localize_map_zone_label(const string&in label)
{
	if (string_starts_with(label, "@")) return tr(label.substr(1));
	return label;
}

void announce_zone_on_load()
{
	play_initial_session_welcome_sound();
	string locate=localize_map_zone_label(get_zone_at(int(round(me.x,0)),int(round(me.y,0)),int(round(me.z,0))));
	if (locate!="")
	{
		speak(locate);
		currentloc=locate;
	}
	else
	{
		string unk = tr("map.unknown_area");
		speak(unk);
		currentloc=unk;
	}
}

void checkloc(bool force_announce=false)
{
	if (!is_in_game || mapname == "" || map.length() == 0) return;
	string locate=localize_map_zone_label(get_zone_at(int(round(me.x,0)),int(round(me.y,0)),int(round(me.z,0))));
	string loc_text="";
	if (locate!="")
	{
		loc_text=locate;
	}
	else
	{
		loc_text=tr("map.unknown_area");
	}
	if (force_announce)
	{
		if (locate!="")
		{
			speak(tr("map.current_location", {locate}));
		}
		else
		{
			speak(tr("map.current_location", {tr("map.unknown_area")}));
		}
		currentloc=loc_text;
		return;
	}
	if (loc_text!=currentloc)
	{
		if (verbalize_zones==1)
		{
			speak(loc_text);
		}
		currentloc=loc_text;
	}
}


void init()
{
	is_in_game = false;
	has_moved=false;
	player_walked_since_stop=false;
	clear_map_data();
	init_stores();
	load_all_items_config();
	load_all_packages();
	register_default_shield_if_missing();
	load_all_weapons_wpm();
	cancel_reload();
	remove_all_equipment();
	current_weapon_id = "";
	inv.delete_all();
	health=maxhealth;
	currentloc="";
	load_player_vital_sounds();
}
