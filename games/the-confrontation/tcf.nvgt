void load_player_vital_sounds()
{
	string char_sub = (current_player_character == "annie" || current_player_character == "ilana" || current_player_character == "hane") ? "hane" : "stefan";
	string bpath = find_sound_in_disk("sounds/players/" + char_sub + "/bleeding.ogg");
	if (bpath == "") bpath = get_player_sound("bleeding");
	if (bpath == "") bpath = find_sound_in_disk("sounds/players/stefan/bleeding.ogg");
	if (bpath == "") bpath = get_sound_path("bleeding.ogg");
	if (bpath != "") bleading.load(bpath);

	string hpath = find_sound_in_disk("sounds/players/" + char_sub + "/player health heartbeat.ogg");
	if (hpath == "") hpath = get_player_sound("heartbeat");
	if (hpath == "") hpath = find_sound_in_disk("sounds/players/stefan/player health heartbeat.ogg");
	if (hpath == "") hpath = get_sound_path("player health heartbeat.ogg");
	if (hpath != "") heartbeat.load(hpath);
}

timer movetimer, jumptimer, healtimer;
