void check_cheat_engine()
{
	if (directory_exists(DIRECTORY_TEMP+"/cheat engine") and SCRIPT_COMPILED)
	{
		sound cheater;
		string cpath = get_misc_sound("cheat");
		if (cpath == "") cpath = get_sound_path("cheat.ogg");
		cheater.load(cpath);
		cheater.play_wait();
		exit();
	}
}
savedata sd(get_user_data_dir() + "settings.dat","gipwjefiqoiqewiofeiofqwehjoiwmoiwaniewnfoipwqenefowqiniosawENGRWORWIOPNHGRNIOOGINWGR");
void main()
{
	cleanup_update_temp();
	migrate_user_settings_files();
	if (file_exists("compile_bundles.trigger") || COMMAND_LINE.find("--compile-bundles") >= 0)
	{
		if (file_exists("compile_bundles.trigger")) file_delete("compile_bundles.trigger");
		load_all_items_config(true);
		load_all_weapons_wpm(true);
		init_stores();
		load_all_packages();
		load_all_npcs(true);
		encrypt_all_contents_silent();
		encrypt_all_maps();
		exit();
	}
	if (!directory_exists(prefsdir)) directory_create(prefsdir);
	readprefs();
	init_localization();
	kb_init();

// Content registries are loaded when something actually needs them: init() for
// a game, the store menu, the builders. The window must not wait for them.
show_window("The Confront "+ver);
wait(100);
check_and_prompt_missing_sounds();
if (!verify_files()) exit();
check_cheat_engine();
if (!file_exists(prefsdir+"settings.dat") && !file_exists(prefsdir+"/settings.dat"))
{
dlg("Settings file not found, creating a new settings file...");
}
// King Audio uses Steam Audio HRTF for spatial rendering.
sound_master_volume = 100.0;
king_global_hrtf = true;
king_hrtf_blend_distance = 0.0;
king_hrtf_near_radius = 0.0;
sound_master_volume = 100.0;
king_global_hrtf = true;
king_hrtf_blend_distance = 0.0;
king_hrtf_near_radius = 0.0;
init_world_reverb_mixer();

	p.volume_step = SOUND_VOLUME_STEP;
	sp.volume_step = SOUND_VOLUME_STEP;
	itempool.volume_step = SOUND_VOLUME_STEP;
	spool.volume_step = SOUND_VOLUME_STEP;
	// War Cry lowers the pitch of its distant reports by 6 when the sound sits
	// behind the listener, and the same cue is used here.
	// Max audible radius for pools. The distant weapon pool is unbounded: its
	// reports must reach the far side of any map. A very small rolloff step
	// 125 / volume_step units, so this step (a range of 125,000) makes the
	// engine's own falloff negligible; the report level is computed from the
	// distance instead, so a map of any size can be covered without the far
	// shots sinking into silence.
p.pan_step = SOUND_PAN_STEP;
sp.pan_step = SOUND_PAN_STEP;
itempool.pan_step = SOUND_PAN_STEP;
spool.pan_step = SOUND_PAN_STEP;
p.hrtf = true;
sp.hrtf = false;
map_door_audio.hrtf = true;
p.behind_pitch_decrease = 0.0;
sp.behind_pitch_decrease = 0.0;
	p.max_distance = 80;
	sp.max_distance = 35;
	itempool.max_distance = 80;
load_updater_settings();
if (check_updates_on_startup == 1)
{
	check_for_updates(false);
}
string startup_smap;
int startup_sx = 0, startup_sy = 0, startup_sz = 0, startup_sface = 0;
load_location(startup_smap, startup_sx, startup_sy, startup_sz, startup_sface);
mainmenu();
}
void game()
{
is_in_game = true;
while(true)
{
inventory_closed_by_enter_this_frame = false;
weapon_system_loop();
// Fire is hold-to-fire for automatic weapons and one press per shot for
// semi-automatic ones. Only Left Control (or configured fire key) fires;
// Right Control, Spacebar and jumping never fire.
bool fire_k_active = (kb_down("fire") or kb_pressed("fire") or key_down(KEY_LCONTROL) or key_pressed(KEY_LCONTROL)) and !key_down(KEY_RCONTROL) and !key_pressed(KEY_RCONTROL);
if (fire_k_active and !key_down(KEY_SPACE) and jumping == 0 and falling == false)
{
	string active_w = current_weapon_id;
	if (active_w == "" || find_weapon_data(active_w) is null)
	{
		active_w = "";
	}
	if (active_w != "" && find_weapon_data(active_w) !is null)
	{
		if (current_weapon_id != active_w)
		{
			equip_weapon(active_w, true);
		}
		if (!is_safe(me.x, me.y, me.z))
		{
			fire_current_weapon();
		}
		else if (key_pressed(KEY_LCONTROL) || kb_pressed("fire"))
		{
			speak(tr("game.safe_zone_no_fire"));
		}
	}
	else if ((key_pressed(KEY_LCONTROL) || kb_pressed("fire")) && current_weapon_id == "")
	{
		speak(tr("weapon.none_equipped"));
	}
}
if (kb_pressed("ammo_status") or key_pressed(KEY_A))
{
	speak_ammo_status();
}
if (!altisdown() && (kb_pressed("reload") or key_pressed(KEY_R)))
{
	handle_reload_key();
}
staircasecheckloop();
szloop();
checkloc();
ground_item_loop();
map_item_spawner_loop();
bodyfallloop();
	broadcast_loop();
	update_sources();
	if (autosave_timer.elapsed >= 30000)
	{
		autosave_timer.restart();
		save_location();
	}
update_game_world();
wait(5);
if (health <= 1000 and health > 0)
{
	if (!bleading.playing) bleading.play_looped();
	if (!heartbeat.playing) heartbeat.play_looped();
}
if (health > 1000 or health <= 0)
{
	if (bleading.playing) bleading.stop();
	if (heartbeat.playing) heartbeat.stop();
}
if (health>maxhealth) health=maxhealth;
check_cheat_engine();
if (kb_pressed("kills"))
{
speak("" + kills + " kills");
}
if (kb_pressed("track_npcs")) track_nearby_npcs();
if (kb_pressed("track_travel_point")) show_travel_point_tracker_menu();
if (kb_pressed("track_travel_status") || key_pressed(KEY_W)) speak_travel_point_status();
if (healtimer.elapsed>=15000 and health<maxhealth)
{
healtimer.restart();
health+=random(3,7);
}
bool shift_held = (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT) or kb_down("mod_shift"));

/* Character rotation: Q rotates left, E rotates right across cardinal and ordinal directions */
if ((key_pressed(KEY_Q) or kb_pressed("turn_left")) and !shiftisdown())
{
	if (is_sitting)
	{
		speak(tr("game.sitting_hint"));
	}
	else
	{
		facing = int(snapleft(facing, int(getdir(facing)), 45));
		speak(dir_to_string(getdir(facing)));
	}
}
else if ((key_pressed(KEY_E) or kb_pressed("turn_right")) and !shiftisdown())
{
	if (is_sitting)
	{
		speak(tr("game.sitting_hint"));
	}
	else
	{
		facing = int(snapright(facing, int(getdir(facing)), 45));
		speak(dir_to_string(getdir(facing)));
	}
}
if (kb_pressed("facing"))
{
speak(dir_to_string(getdir(facing)) + ", " + facing + " degrees");
}
// B binding for builder menu
if ((kb_pressed("builder") or key_pressed(KEY_B)))
{
	if (jumping == 0 && falling == false)
	{
		if (!SCRIPT_COMPILED && !is_map_encrypted(mapname))
		{
			show_window("The Confront - Construction Menu");
			buildmenu();
			show_window("The Confront " + ver + (mapname != "" ? " - " + mapname : ""));
		}
	}
}

bool alt_held = (key_down(KEY_LMENU) || key_down(KEY_RMENU) || key_down(KEY_LALT) || key_down(KEY_RALT));
bool vol_up_held = (!alt_held && (kb_down("volume_up") or key_down(KEY_HOME)));
bool vol_down_held = (!alt_held && (kb_down("volume_down") or key_down(KEY_END)));
bool music_up_held = (!onstaircase && alt_held && (key_down(KEY_UP) || kb_down("move_forward")));
bool music_down_held = (!onstaircase && alt_held && (key_down(KEY_DOWN) || kb_down("move_back")));

bool vol_up_pressed = (!alt_held && (kb_pressed("volume_up") or key_pressed(KEY_HOME)));
bool vol_down_pressed = (!alt_held && (kb_pressed("volume_down") or key_pressed(KEY_END)));
bool music_up_pressed = (!onstaircase && alt_held && (key_pressed(KEY_UP) || kb_pressed("move_forward")));
bool music_down_pressed = (!onstaircase && alt_held && (key_pressed(KEY_DOWN) || kb_pressed("move_back")));

if (vol_up_pressed || vol_down_pressed || music_up_pressed || music_down_pressed ||
    ((vol_up_held || vol_down_held || music_up_held || music_down_held) && volume_repeat_timer.elapsed >= 150))
{
	if (vol_up_held)
	{
		volume_repeat_timer.restart();
		if (shiftisdown())
		{
			ambient_volume += 5;
			if (ambient_volume > 100) ambient_volume = 100;
			apply_ambient_volume();
			speak("Ambient volume: " + int(ambient_volume) + " percent");
			writeprefs();
		}
		else
		{
			double cur_m = get_sound_master_volume() + 5.0;
			if (cur_m > 100.0) cur_m = 100.0;
			set_sound_master_volume(cur_m);
			speak("Master volume: " + int(cur_m) + " percent");
		}
	}
	else if (vol_down_held)
	{
		volume_repeat_timer.restart();
		if (shiftisdown())
		{
			ambient_volume -= 5;
			if (ambient_volume < 0) ambient_volume = 0;
			apply_ambient_volume();
			speak("Ambient volume: " + int(ambient_volume) + " percent");
			writeprefs();
		}
		else
		{
			double cur_m = get_sound_master_volume() - 5.0;
			if (cur_m < 0.0) cur_m = 0.0;
			set_sound_master_volume(cur_m);
			speak("Master volume: " + int(cur_m) + " percent");
		}
	}
	else if (music_up_held)
	{
		volume_repeat_timer.restart();
		map_music_volume += 5.0;
		if (map_music_volume > 0.0) map_music_volume = 0.0;
		musicvolume = map_music_volume;
		apply_music_volume();
		speak("Music volume: " + int(map_music_volume) + " dB");
		writeprefs();
	}
	else if (music_down_held)
	{
		volume_repeat_timer.restart();
		map_music_volume -= 5.0;
		if (map_music_volume < -100.0) map_music_volume = -100.0;
		musicvolume = map_music_volume;
		apply_music_volume();
		speak("Music volume: " + int(map_music_volume) + " dB");
		writeprefs();
	}
}

if (kb_pressed("location") or key_pressed(KEY_Z))
{
	if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
	{
		verbalize_zones = (verbalize_zones == 1) ? 0 : 1;
		if (verbalize_zones == 1) speak(tr("map.zones_spoken"));
		else speak(tr("map.zones_not_spoken"));
		writeprefs();
	}
	else
	{
		checkloc(true);
	}
}
// XP is consumed and levelled only in add_player_quantum_xp().
if (kb_pressed("level_status"))
{
	normalize_player_xp(false);
	int req_levels = get_resurrection_levels_required(resurrections);
	speak(tr("game.level_status", {"" + level, "" + req_levels, "" + resurrections, "" + xp, "" + (xprequired-xp), "" + (level+1)}));
}
if (altisdown() && key_pressed(KEY_O)) player_options_menu();
if (kb_pressed("health_status"))
{
	speak(tr("game.health_status", {"" + health, "" + maxhealth}));
}
    if (health<=0)
    {
        // Death by health alone. The unified death sequence speaks "You died."
        // and starts the whole death ensemble at once - Tristan's voice 17, the
        // three numbered death effects and the platform fall sound - waiting for
        // all of them before the main menu.
        player_die(tr("game.died"));
    }
if (kb_pressed("inventory_menu") && jumping == 0 && falling == false) inventory_menu();
handle_favorite_gameplay_key();
if (key_pressed(KEY_S) or kb_pressed("sit_stand"))
{
	toggle_sit_stand();
}
/* Shift+Enter interacts with stores; Alt+Enter enters an elevator or travel point.
   Item favorites use 1–0; Shift+number assigns the held or selected item. */
bool enter_pressed = key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER);
if (altisdown() && enter_pressed)
{
	if (!try_interact_map_door() && !try_use_elevator_at_player()) use_travel_point_at_player();
}
else if (player_inside_elevator && enter_pressed && !shiftisdown())
{
	try_use_elevator_at_player();
}
else if (shiftisdown() && enter_pressed)
{
	try_open_map_store_at_player();
}
else if (!inventory_closed_by_enter_this_frame && !altisdown() && !shiftisdown() && (kb_pressed("use") || enter_pressed) && (inventory_use_pending || inventory_selected_item != ""))
{
	string item_to_use = inventory_selected_item;
	inventory_use_pending = false;
	if (item_to_use != "") { use(item_to_use); if (get_item_count(item_to_use) <= 0) inventory_selected_item = ""; }
	else speak(tr("inventory.favorite_select_item"));
}
else if (!altisdown() && !shiftisdown() && (kb_pressed("use") || enter_pressed) && is_sitting)
{
	speak(tr("game.sitting_hint"));
}
if (kb_pressed("coordinates") or key_pressed(KEY_C))
{
	if (shiftisdown())
	{
		speak_equipped_equipment();
	}
	else
	{
		speak(int(round(me.x, 0)) + ", " + int(round(me.y, 0)) + ", " + int(round(me.z, 0)));
	}
}
walktime = get_current_walktime();
if (jumping==1) movetime=airtime;
else movetime=walktime;
if (!player_inside_elevator && dmoving==false and movetimer.elapsed>=movetime)
{
	if (is_sitting)
	{
		if (kb_pressed("move_forward") or key_pressed(KEY_UP) or kb_pressed("move_back") or key_pressed(KEY_DOWN) or kb_pressed("move_left") or key_pressed(KEY_LEFT) or kb_pressed("move_right") or key_pressed(KEY_RIGHT) or kb_down("move_left") or key_down(KEY_LEFT) or kb_down("move_right") or key_down(KEY_RIGHT) or kb_down("move_forward") or key_down(KEY_UP) or kb_down("move_back") or key_down(KEY_DOWN))
		{
			if (sitting_speech_debounce.elapsed >= 1500)
			{
				sitting_speech_debounce.restart();
				speak(tr("game.sitting_hint"));
			}
		}
	}
	else
	{
		if (!alt_held && (kb_down("move_forward") or key_down(KEY_UP)))
		{
			movetimer.restart();
			player_step(north);
		}
		else if (!alt_held && (kb_down("move_back") or key_down(KEY_DOWN)))
		{
			movetimer.restart();
			player_step(south);
		}
		else if (!alt_held && (kb_down("move_left") or key_down(KEY_LEFT)))
		{
			movetimer.restart();
			player_step(west);
		}
		else if (!alt_held && (kb_down("move_right") or key_down(KEY_RIGHT)))
		{
			movetimer.restart();
			player_step(east);
		}
	}
}
if (me.z < minz) me.z = minz;
if (!player_inside_elevator && (kb_pressed("jump") || key_pressed(KEY_SPACE)) and !key_down(KEY_LCONTROL) and !key_down(KEY_RCONTROL) and jumping==0 and falling==false and dmoving==false)
{
	if (is_sitting)
	{
		if (sitting_speech_debounce.elapsed >= 1500)
		{
			sitting_speech_debounce.restart();
			speak(tr("game.sitting_hint"));
		}
	}
	else
	{
		sjumpcheck();
		if (abletojump2>0)
		{
			p.play_stationary(get_player_sound("jump"),false);
			ty2=int(me.z)+jumpheight;
			jumping=1;
			ascending=true;
			atapex=false;
			jumptimer.restart();
		}
	}
}
if (jumping==1 && !player_inside_elevator)
{
	if (atapex==true)
	{
		if (jumptimer.elapsed>=apextime)
		{
			jumptimer.restart();
			atapex=false;
		}
	}
	else if (ascending==true)
	{
		if (jumptimer.elapsed>=jumptime)
		{
			jumptimer.restart();
			me.z+=1;
			if (me.z>=ty2)
			{
				ascending=false;
				jumptimer.restart();
				atapex=true;
			}
		}
	}
	else if (jumptimer.elapsed>=jumptime2)
	{
		jumptimer.restart();
		me.z-=1;
		checkforplatforms();
	}
}
if(!player_inside_elevator && jumping==0 && !falling && me.z > minz && gmt()=="" and dmoving==false)
{
	falling=true;
	fallcounter=0;
	falltimer.restart();
	p.play_stationary(get_player_sound("fall"), false);
}
if(falling && !player_inside_elevator)
{
if(falltimer.elapsed>=falltime && me.z > minz)
{
falltimer.restart();
me.z--;
	fallcounter++;

}
bool landed = false;
if (me.z <= minz)
{
me.z = minz;
landed = true;
}
else if (gmt() != "")
{
landed = true;
}
if (landed)
{
if (gmt() != "")
{
string land_sound = get_platform_sound(gmt(), (fallcounter > 9 ? "hardland" : "land"));
if (land_sound != "") p.play_stationary(land_sound, false);
}
if (fallcounter > 9)
{
healtimer.restart();	int actual_fall_dmg = fallcounter * 2;
	health -= actual_fall_dmg;
	speak(tr("game.lost_health_fall", {"" + actual_fall_dmg}));
}
if (fallcounter >= 8)
{
	is_sitting = true;
	string sit_snd = get_player_sound("sit");
	if (sit_snd == "") sit_snd = get_sound_path("players/" + ((current_player_character == "annie" || current_player_character == "ilana" || current_player_character == "hane") ? "hane" : "stefan") + "/sit.ogg;sounds/players/stefan/sit.ogg;sit.ogg;sitdown.ogg");
	if (sit_snd != "") p.play_stationary(sit_snd, false);
	string pfall = get_platform_sound(gmt(), "fall");
	if (pfall != "") p.play_stationary(pfall, false);
	sitting_speech_debounce.restart();
	speak(tr("game.land_seated"));
}
falling = false;
fallcounter = 0;
}
}
update_idle_scuff();
	// Refresh every pool after movement, falling, and facing
	// changes have been processed. This prevents one-frame stale listener
	// coordinates when walking away from a stationary 3-D source.
	p.update_listener_3d(me.x, me.y, me.z, double(facing));
	sp.update_listener_3d(me.x, me.y, me.z, double(facing));
	itempool.update_listener_3d(me.x, me.y, me.z, double(facing));
	update_map_reverb();
if (kb_pressed("exit_game") and jumping==0 and falling==false)
{
    bool do_exit = (confirm_exit == 1) ? confirm_exit_dialog() : true;
    if (do_exit)
    {
        save_location();
        reset();
        mainmenu();
    }
}
}
}


// Moves the player one tile in the given direction relative to facing, then
// snaps the position to whole tiles. Without the snap, diagonal facings
// (northeast, etc.) add 0.7071 to both axes and the player drifts off the
// grid, effectively moving a full tile only every other step.
void player_step(int dir)
{
old = me;
vector step_start = me;
vector target = move(me.x, me.y, me.z, dir, facing);
int attempt_dx = int(round(target.x - me.x, 0));
int attempt_dy = int(round(target.y - me.y, 0));
int attempt_dz = int(round(target.z - me.z, 0));
target.x = round(target.x, 0);
target.y = round(target.y, 0);
target.z = round(target.z, 0);
bool hit_boundary = false;
if (target.x < minx) { target.x = minx; hit_boundary = true; }
if (target.x > maxx) { target.x = maxx; hit_boundary = true; }
if (target.y < miny) { target.y = miny; hit_boundary = true; }
if (target.y > maxy) { target.y = maxy; hit_boundary = true; }
if (target.z < minz) { target.z = minz; hit_boundary = true; }
if (jumping == 0 && !falling && target.z > maxz) { target.z = maxz; hit_boundary = true; }

me = target;

if (hit_boundary && target.x == old.x && target.y == old.y && target.z == old.z)
{
	return;
}

if (me.x != step_start.x || me.y != step_start.y || me.z != step_start.z)
{
	has_moved = true;
	player_walked_since_stop = true;
	check_map_exploration(mapname, int(round(me.x, 0)), int(round(me.y, 0)), int(round(me.z, 0)));
}
playstep();
}

void checkforplatforms()
{
	if (gmt() != "")
	{
		string lnd = get_platform_sound(gmt(), "land");
		if (lnd != "") p.play_stationary(lnd, false);
		jumping = 0;
		ascending = false;
		atapex = false;
		falling = false;
		fallcounter = 0;
	}
	else if (me.z <= minz)
	{
		me.z = minz;
		string lnd = get_platform_sound(gmt(), "land");
		if (lnd != "") p.play_stationary(lnd, false);
		jumping = 0;
		ascending = false;
		atapex = false;
		falling = false;
		fallcounter = 0;
	}
	else if(jumping==0&&!falling&&me.z>minz&&gmt()=="" and dmoving==false)
	{
		falling=true;
		fallcounter=0;
		falltimer.restart();
		p.play_stationary(get_player_sound("fall"), false);
	}
}
// Foot-drag / idle scuff: after the player comes to a complete stop on a
// platform that has a scuff (foot-drag) sound configured, wait 1000 ms and
// play the scuff sound ONCE per stop - it never repeats while the player keeps
// standing still. Each new stop (after moving again) plays it once more.
// Disabled entirely when the "foot dragging" option is off; platforms without
// a scuff sound simply play nothing (no fallback, no generic sound).
void update_idle_scuff()
{
	if (player_inside_elevator)
	{
		idle_scuff_primed = false;
		idle_scuff_played = false;
		return;
	}
	bool shift_held = (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT) or kb_down("mod_shift"));
	bool moving = (dmoving == true)
		|| kb_down("move_forward") || key_down(KEY_UP)
		|| kb_down("move_back") || key_down(KEY_DOWN)
		|| kb_down("move_left") || key_down(KEY_LEFT)
		|| kb_down("move_right") || key_down(KEY_RIGHT)
		|| jumping == 1 || falling;
	/* The scuff sound only exists after the player has actually moved for the
	   first time and has walked since the last stop - it must never play on spawn */
	// or when merely trying to walk while blocked at a map boundary.
	if (moving || footdrag_enabled == 0 || !has_moved || !player_walked_since_stop)
	{
		idle_scuff_primed = false;
		idle_scuff_played = false;
		return;
	}
	string tile = gmt();
	if (tile == "" || string_contains(tile, "wall", 1) > -1)
	{
		idle_scuff_primed = false;
		idle_scuff_played = false;
		return;
	}
	if (!idle_scuff_primed)
	{
		idle_scuff_primed = true;
		idle_scuff_played = false;
		idle_scuff_timer.restart();
		return;
	}
	if (!idle_scuff_played && idle_scuff_timer.elapsed >= 1000)
	{
		idle_scuff_played = true;
		player_walked_since_stop = false;
		string sc = get_platform_sound(tile, "scuff");
		if (sc != "") p.play_stationary(sc, false);
	}
}
void play(string snd, bool loop=false)
{
string s = get_pack_sound(snd);
if (s == "") s = get_sound_path(snd);
if (s != "") p.play_stationary(s,loop);
}
bool shiftisdown()
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
return true;
}
return false;
}
bool altisdown()
{
if (key_down(KEY_LMENU) or key_down(KEY_RMENU) or key_down(KEY_LALT) or key_down(KEY_RALT))
{
return true;
}
return false;
}
void fade_pool(sound_pool@ pool, double final_volume=-50, double delay=10)
{
	bool fading = true;
	while (fading)
	{
		fading = false;
		for (uint i = 0; i <= pool.highest_slot; i++)
		{
			if (pool.verify_slot(i) && @pool.items[i].handle != null && pool.items[i].handle.active)
			{
				double vol = pool.items[i].handle.volume;
				if (vol > final_volume)
				{
					pool.items[i].handle.volume = vol - 1;
					fading = true;
				}
			}
		}
		if (fading) wait(delay);
	}
}
void reset()
{
is_in_game = false;
mapname = "";
currentloc = "";
cancel_reload();
fade_pool(@sp, -50, 10);
fade_pool(@p, -50, 10);
bleading.stop();
heartbeat.stop();
	clear_all_map_states();
	destroy_all_ground_items();
	destroy_all_map_spawners();
	p.destroy_all();
	p.update_listener_3d(0, 0, 0, 0);
	killbodyfalls();
itempool.update_listener_3d(0, 0, 0, 0);
killsrcs();
clear_map_data();
destroy_all_builder_objects();
npc_destroy_all();
	remove_all_equipment();
	is_sitting = false;
health = maxhealth;
}
double stn(string str)
{
return string_to_number(str);
}
void readprefs()
{
sd.load();
if (sd.d.exists("menu_music_volume"))
{
menu_music_volume=sd.readn("menu_music_volume");
if (menu_music_volume > 0.0) menu_music_volume = 0.0;
if (menu_music_volume < -100.0) menu_music_volume = -100.0;
}
else if (sd.d.exists("musicvolume"))
{
menu_music_volume=sd.readn("musicvolume");
if (menu_music_volume > 0.0) menu_music_volume = 0.0;
if (menu_music_volume < -100.0) menu_music_volume = -100.0;
}
else
{
menu_music_volume=0.0;
}

if (sd.d.exists("map_music_volume"))
{
map_music_volume=sd.readn("map_music_volume");
if (map_music_volume > 0.0) map_music_volume = 0.0;
if (map_music_volume < -100.0) map_music_volume = -100.0;
musicvolume = map_music_volume;
apply_music_volume();
}
else if (sd.d.exists("musicvolume"))
{
map_music_volume=sd.readn("musicvolume");
if (map_music_volume > 0.0) map_music_volume = 0.0;
if (map_music_volume < -100.0) map_music_volume = -100.0;
musicvolume = map_music_volume;
apply_music_volume();
}
else
{
map_music_volume=0.0;
musicvolume=0.0;
apply_music_volume();
}
if (sd.d.exists("ambient_volume"))
{
ambient_volume=sd.readn("ambient_volume");
apply_ambient_volume();
}
if (sd.d.exists("wrap_disabled"))
{
wrap_disabled=sd.readn("wrap_disabled");
}
if (sd.d.exists("footdrag_enabled"))
{
footdrag_enabled=int(sd.readn("footdrag_enabled"));
}
if (sd.d.exists("play_logo"))
{
play_logo=sd.readn("play_logo");
}
if (sd.d.exists("confirm_exit"))
{
confirm_exit=int(sd.readn("confirm_exit"));
}
if (sd.d.exists("verbalize_zones"))
{
verbalize_zones=int(sd.readn("verbalize_zones"));
}
if (sd.d.exists("menu_music_choice"))
{
menu_music_choice=sd.read("menu_music_choice");
}
if (sd.d.exists("enable_player_pain_sounds"))
{
enable_player_pain_sounds=int(sd.readn("enable_player_pain_sounds"));
}
if (sd.d.exists("check_updates_on_startup"))
{
check_updates_on_startup=int(sd.readn("check_updates_on_startup"));
}
if (sd.d.exists("language"))
{
current_language=sd.read("language");
}
if (sd.d.exists("player_character"))
{
    string pc = sd.read("player_character");
    if (pc == "ilana" || pc == "hane") pc = "annie";
    if (pc == "stefan" || pc == "annie")
        set_player_character(pc, false);
    else
        current_player_character = "";
}
else
{
    current_player_character = "";
}
}
void writeprefs()
{
    sd.add("menu_music_volume",menu_music_volume);
    sd.add("map_music_volume",map_music_volume);
    sd.add("musicvolume",map_music_volume);
    sd.add("ambient_volume",ambient_volume);
    sd.add("wrap_disabled",wrap_disabled);
    sd.add("footdrag_enabled",footdrag_enabled);
    sd.add("play_logo",play_logo);
    sd.add("confirm_exit",confirm_exit);
    sd.add("verbalize_zones",verbalize_zones);
    sd.add("menu_music_choice",menu_music_choice);
    sd.add("enable_player_pain_sounds",enable_player_pain_sounds);
    sd.add("check_updates_on_startup",check_updates_on_startup);
    sd.add("language",current_language);
