bool confirm_exit_dialog()
{
	speak(tr("dialog.exit_prompt"));
	while (true)
	{
		wait(5);
		update_game_world();
		if (key_pressed(KEY_Y) || key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER) || key_pressed(KEY_NUMPADENTER) || kb_pressed("menu_confirm") || kb_pressed("menu_activate") || kb_pressed("use"))
		{
			return true;
		}
		if (key_pressed(KEY_ESCAPE) || key_pressed(KEY_N) || kb_pressed("menu_back") || kb_pressed("exit_game"))
		{
			speak(tr("ui.cancel"));
			return false;
		}
		if (key_pressed(KEY_UP) || key_pressed(KEY_DOWN) || key_pressed(KEY_LEFT) || key_pressed(KEY_RIGHT) || key_pressed(KEY_SPACE))
		{
			speak(tr("dialog.exit_prompt"));
		}
	}
	return false;
}
/* Toggles the player between sitting and standing (S key). */
void toggle_sit_stand()
{
	string char_sub = (current_player_character == "annie" || current_player_character == "ilana" || current_player_character == "hane") ? "hane" : "stefan";
	if (is_sitting)
	{
		is_sitting = false;
		string snd = get_player_sound("stand");
		if (snd == "") snd = find_sound_in_disk("sounds/players/" + char_sub + "/stand.ogg");
		if (snd == "") snd = find_sound_in_disk("sounds/players/stefan/stand.ogg");
		if (snd == "") snd = get_sound_path("players/" + char_sub + "/stand.ogg;players/stefan/stand.ogg;stand.ogg;standup.ogg");
		if (snd != "") p.play_stationary(snd, false);
		speak(tr("game.stand_up"), true);
	}
	else
	{
		is_sitting = true;
		string snd = get_player_sound("sit");
		if (snd == "") snd = find_sound_in_disk("sounds/players/" + char_sub + "/sit.ogg");
		if (snd == "") snd = find_sound_in_disk("sounds/players/stefan/sit.ogg");
		if (snd == "") snd = get_sound_path("players/" + char_sub + "/sit.ogg;players/stefan/sit.ogg;sit.ogg;sitdown.ogg");
		if (snd != "") p.play_stationary(snd, false);
		string plat_snd = get_platform_sound(gmt(), "fall");
		if (plat_snd != "") p.play_stationary(plat_snd, false);
		speak(tr("game.sit_down"), true);
	}
}
