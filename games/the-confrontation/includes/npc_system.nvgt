// npc_system.nvgt - NPC runtime for The Confront.
//
// There are no enemies and no allies anymore. Every character on the map is an
// NPC loaded from settings/npcs/*.npc, and every NPC belongs to one of three
// classes: animal, robot or zombie. The class changes nothing in the rules; it
// only names what the character is. Behaviour comes entirely from the .npc file:
//
//   - The NPC is aware of the player as soon as it spawns, wherever the player
//     stands, and immediately starts pursuing.
//   - It attacks only when the player is inside its attack range, counted in
//     whole tiles as the largest axis gap: an attack range of five means five
//     tiles, never one step more, from any angle. Inside that range it attacks
//     even when the player stands outside the area it may walk in, because
//     attacking and walking have separate limits. Attacking never roots it in
//     place: it keeps closing the distance, at a single tile per step so a
//     diagonal approach is not faster, until it stands next to the player.
//   - Walking is done on a route, not in a straight line: pursuit and patrol
//     search the walkable tiles of the NPC's own area (four-way, so no corner is
//     cut through a wall), walk the route tile by tile, and only plan again when
//     the goal changes, the route runs out or the next tile is blocked. A long
//     wall is walked around by widening the search to the whole area, so an NPC
//     is never left pushing against a wall.
//   - Detection and attack ranges are whole tiles, exactly the integer numbers
//     written in the .npc file.
//   - Detection range is its vision: after it loses the player (safe zone, for
//     example) it only notices the player again inside that range.
//   - When the player damages it, it becomes furious and runs at run_speed
//     instead of walk_speed, forever, until it dies.
//   - Its voices follow the old NPC system: a clip is repeated two or three
//     times, then the list rotates, and the silence between clips is counted
//     from the end of the clip, between voice_min_delay and voice_max_delay.
//   - Its footsteps are the map's platform sound, or its own clips when it is
//     set to custom steps.
//   - Killing it gives the player the XP configured for it, plays the platform
//     fall sound as the body hits the floor, and drops its configured items.
//   - Its spawner also gives it a volume, min and max on X, Y and Z. Those six
//     numbers are a hard border: the NPC spawns inside, walks inside and
//     chases only inside. If the player leaves the volume the NPC cannot
//     follow, so it patrols the border closest to the player and attacks again
//     the moment the player steps back in.
//   - Death plays its death sound, announces the kill and queues a replacement
//     on the respawn time configured for its spawner. A spawner never adds an
//     NPC that is still alive: it only replaces one that actually died.
//
// The rules are the same for the player's projectiles: a hit damages the NPC,
// provokes fury and can kill it.

#include "npc_data.nvgt"

// Population budget. Maps are shared between every spawner line, so the total
// is what protects the frame loop: a line asking for hundreds of NPCs can never
// flood the map, it simply fills up to the budget and waits.
const int NPC_MAX_ACTIVE = 40;
const int NPC_MAX_PER_SPAWNER = 20;
const int NPC_DEATH_LINGER_MS = 1000;
const int NPC_LOCAL_SOUND_DISTANCE = 40;
// A spawn that cannot be placed (no floor in the area, budget full) is retried
// on this interval instead of every frame.
const int NPC_SPAWN_RETRY_MS = 1000;

// ---------------------------------------------------------------------------
// Map spawners
// ---------------------------------------------------------------------------
// One line per NPC type on the map:
// npcspawner:<npc id>:<count>:<respawn ms>:<min x>:<min y>:<min z>:<max x>:<max y>:<max z>
// The six coordinates are the volume the NPCs of that line live in: they spawn
// somewhere inside it and never walk out of it, on any axis.
class npc_spawn_def
{
	string npc_id;
	int count;
	int respawn_ms;
	int rx0, ry0, rz0, rx1, ry1, rz1;

	npc_spawn_def(const string&in id, int amount, int respawn, int x0, int y0, int z0, int x1, int y1, int z1)
	{
		npc_id = id;
		count = amount;
		respawn_ms = respawn;
		rx0 = x0; ry0 = y0; rz0 = z0;
		rx1 = x1; ry1 = y1; rz1 = z1;
	}
}

npc_spawn_def@[] npc_spawn_defs(0);

void npc_reset_spawners()
{
	npc_spawn_defs.resize(0);
}

void npc_add_spawner(const string&in npc_id, int count, int respawn_ms, int x0, int y0, int z0, int x1, int y1, int z1)
{
	if (npc_id == "") return;
	if (count <= 0) return;
	if (count > NPC_MAX_PER_SPAWNER) count = NPC_MAX_PER_SPAWNER;
	if (respawn_ms < 0) respawn_ms = 0;
	if (x0 > x1) { int t = x0; x0 = x1; x1 = t; }
	if (y0 > y1) { int t = y0; y0 = y1; y1 = t; }
	if (z0 > z1) { int t = z0; z0 = z1; z1 = t; }
	if (x0 < minx) x0 = minx;
	if (y0 < miny) y0 = miny;
	if (z0 < minz) z0 = minz;
	if (x1 > maxx) x1 = maxx;
	if (y1 > maxy) y1 = maxy;
	if (z1 > maxz) z1 = maxz;
	npc_spawn_defs.insert_last(npc_spawn_def(npc_id, count, respawn_ms, x0, y0, z0, x1, y1, z1));
}

// A spawner only refills with its own NPC type while that type is below its own
// count, and only after one of its NPCs died. The replacement waits exactly
// respawn_ms milliseconds counted from the death.
class npc_spawner_state
{
	string npc_id;
	int count;
	int respawn_ms;
	int rx0, ry0, rz0, rx1, ry1, rz1;
	bool populated;
	bool waiting;
	bool retry_backoff;
	timer respawn_timer;

	npc_spawner_state(const string&in id, int amount, int respawn, int x0, int y0, int z0, int x1, int y1, int z1)
	{
		npc_id = id;
		count = amount;
		if (count > NPC_MAX_PER_SPAWNER) count = NPC_MAX_PER_SPAWNER;
		respawn_ms = respawn;
		rx0 = x0; ry0 = y0; rz0 = z0;
		rx1 = x1; ry1 = y1; rz1 = z1;
		populated = false;
		waiting = false;
		retry_backoff = false;
		respawn_timer.restart();
	}
}

npc_spawner_state@[] npc_spawner_states(0);

// ---------------------------------------------------------------------------
// NPC instance
// ---------------------------------------------------------------------------
class npc_instance
{
	npc_data@ data;

	int x, y, z;
	int facing;
	int hp;
	int maxhp;

	bool dead;
	bool aware;
	bool furious;

	int patrol_x, patrol_y;

	// Area this NPC was placed in and the spawner that owns it. The NPC never
	// walks outside the area on any axis, and its spawner counts it by index.
	int rx0, ry0, rz0, rx1, ry1, rz1;
	int spawner_index;

	timer move_timer;
	timer attack_timer;
	timer death_timer;
	timer patrol_timer;

	// Voice playback, ported from the old NPC system: the current clip owns a
	// persistent pool slot, is allowed to finish, then rotates to the next clip
	// only after being repeated two or three times. The silence between clips is
	// the configured window measured after the clip really ended.
	timer voice_delay_timer;
	sound@ voice_handle;
	int voice_slot;
	int voice_index;
	int voice_repeats_done;
	int voice_repeats_target;
	int voice_delay_target;
	bool voice_waiting_delay;

	// Owner key every sound of this NPC carries in the NPC pool. The pool moves
	// all of them at once with update_sounds_3d(), so there is no parallel list of
	// slots and handles to keep in sync.
	string sound_owner;

	// Route to the current goal, as tile keys inside the NPC's own rectangle.
	// The route is recomputed only when the goal changes, runs out or becomes
	// blocked, so a chase around a wall costs nothing on ordinary frames.
	int[] path;
	int path_index;
	int path_goal_x, path_goal_y;
	bool path_stop_next_to;
	int path_bx0, path_by0, path_bx1, path_by1;
	timer path_timer;

	// Bearing used to walk a circle around the player inside a safe zone.
	double patrol_angle;

	npc_instance()
	{
		@data = null;
		x = 0; y = 0; z = 0;
		facing = north;
		hp = 1;
		maxhp = 1;
		dead = false;
		aware = true;
		furious = false;
		patrol_x = 0;
		patrol_y = 0;
		rx0 = 0; ry0 = 0; rz0 = 0;
		rx1 = 0; ry1 = 0; rz1 = 0;
		spawner_index = -1;
		@voice_handle = null;
		voice_slot = -1;
		voice_index = 0;
		voice_repeats_done = 0;
		voice_repeats_target = 2;
		voice_delay_target = 1500;
		voice_waiting_delay = false;
		patrol_angle = 0.0;
		sound_owner = "";
		path_index = 0;
		path_goal_x = -1;
		path_goal_y = -1;
		path_stop_next_to = false;
		path_bx0 = 0;
		path_by0 = 0;
		path_bx1 = 0;
		path_by1 = 0;
	}
}

npc_instance@[] npc_instances(0);

// Source of the per-NPC owner keys. The trailing separator keeps one key from
// being a prefix of another (npc:1; is not a prefix of npc:10;), because the pool
// matches owners by prefix.
int npc_sound_owner_seq = 0;

// ---------------------------------------------------------------------------
// Audio
// ---------------------------------------------------------------------------
// The pool is created on first use, not when the script starts: 128 audio slots
// are only paid for once an NPC actually has something to play, so launching the
// game never waits for them.
sound_pool@ npcp = null;
bool npc_pool_ready = false;

void npc_init_pool()
{
	if (npc_pool_ready) return;
	npc_pool_ready = true;
	@npcp = sound_pool(128);
	npcp.max_distance = NPC_LOCAL_SOUND_DISTANCE;
	// The same attenuation as every other pool in the game: the NPC is not
	// faded by a rule of its own, it is faded exactly like the player's sounds,
	// the map and the projectiles at the same distance.
	npcp.volume_step = SOUND_VOLUME_STEP;
	npcp.pan_step = SOUND_PAN_STEP;
	npcp.hrtf = true;
	npcp.behind_pitch_decrease = 0.0;
	npcp.update_listener_3d(me.x, me.y, me.z, double(facing));
}

// Tags a slot with the NPC's owner key. From then on the pool knows the sound
// belongs to this NPC, and destroying or moving its sounds is a single call.
void npc_tag_sound(npc_instance@ npc, int slot)
{
	if (npc is null || slot < 0 || !npc_pool_ready || npc.sound_owner == "") return;
	npcp.set_sound_owner(slot, npc.sound_owner);
}

// Moves every sound this NPC still has playing to its current tile, using the
// pool's own owner lookup.
void npc_follow_sounds(npc_instance@ npc)
{
	if (npc is null || !npc_pool_ready || npc.sound_owner == "") return;
	npcp.update_sounds_3d(npc.sound_owner, npc.x, npc.y, npc.z);
}

// Plays one of the NPC's sounds at its current tile and hands the slot to the
// follow list, so the clip keeps moving with the NPC until it ends.
void npc_play_positional(npc_instance@ npc, const string&in snd)
{
	if (npc is null || snd == "") return;
	string path = get_sound_path(snd);
	if (path == "") return;
	npc_init_pool();
	int slot = npcp.play_3d(path, me.x, me.y, me.z, npc.x, npc.y, npc.z, double(facing), false);
	npc_tag_sound(npc, slot);
}

// Picks one clip out of a semicolon separated list. An empty list returns an
// empty string, which every caller treats as "no sound configured".
string npc_pick_clip(const string&in list)
{
	if (list == "") return "";
	string[]@ parts = string_split(list, ";", true);
	if (parts is null || parts.length() == 0) return "";
	if (parts.length() == 1) return parts[0].trim_whitespace();
	int idx = random(0, int(parts.length()) - 1);
	return parts[uint(idx)].trim_whitespace();
}

// ---------------------------------------------------------------------------
// Kill feed
// ---------------------------------------------------------------------------
void npc_write_kill_line(const string&in line)
{
	string path = "settings/killfeed.log";
	string old = "";
	if (file_exists(path)) old = file_get_contents(path);
	if (old != "" && !string_ends_with(old, "\n")) old += "\n";
	file_put_contents(path, old + line + "\n");
}

// ---------------------------------------------------------------------------
// Map helpers
// ---------------------------------------------------------------------------
bool npc_tile_is_floor(int tx, int ty, int tz)
{
	if (tx < minx || tx > maxx || ty < miny || ty > maxy || tz < minz || tz > maxz) return false;
	string tile = g_active_map.get_tile(tx, ty, tz);
	if (tile == "") return false;
	if (string_contains(string_to_lower_case(tile), "wall", 1) > -1) return false;
	if (g_active_map.get_wall(tx, ty, tz) != "") return false;
	return true;
}

bool npc_find_spawn(int x0, int y0, int z0, int x1, int y1, int z1, int &out sx, int &out sy, int &out sz)
{
	for (int attempt = 0; attempt < 64; attempt++)
	{
		int tx = random(x0, x1);
		int ty = random(y0, y1);
		// Only floors inside the configured volume count, so an NPC can never
		// appear above or below the area it is allowed to walk in.
		for (int tz = z1; tz >= z0; tz--)
		{
			if (npc_tile_is_floor(tx, ty, tz))
			{
				sx = tx; sy = ty; sz = tz;
				return true;
			}
		}
	}
	return false;
}

bool npc_can_step_to(int tx, int ty, int tz)
{
	return npc_tile_is_floor(tx, ty, tz);
}

// Is that tile solid? The same test the floor check uses, answered the other way
// around, plus the map bounds.
bool npc_tile_is_wall(int tx, int ty, int tz)
{
	if (tx < minx || tx > maxx || ty < miny || ty > maxy || tz < minz || tz > maxz) return true;
	if (g_active_map.get_wall(tx, ty, tz) != "") return true;
	return string_contains(string_to_lower_case(g_active_map.get_tile(tx, ty, tz)), "wall", 1) > -1;
}

// Walks the straight tile line between two tiles and reports a wall in between.
// Both ends are excluded, so two neighbours always have a clear line. The answer
// depends only on the pair of tiles, which is what makes it stable frame after
// frame: unlike a sampled line of sight, it cannot flicker and stop an attack.
bool npc_wall_between(int x0, int y0, int x1, int y1, int z)
{
	int dx = (x1 > x0) ? (x1 - x0) : (x0 - x1);
	int dy = (y1 > y0) ? (y1 - y0) : (y0 - y1);
	int sx = (x1 >= x0) ? 1 : -1;
	int sy = (y1 >= y0) ? 1 : -1;
	int err = dx - dy;
	int cx = x0;
	int cy = y0;
	while (cx != x1 || cy != y1)
	{
		int e2 = 2 * err;
		if (e2 > -dy) { err -= dy; cx += sx; }
		if (e2 < dx) { err += dx; cy += sy; }
		if (cx == x1 && cy == y1) break;
		if (npc_tile_is_wall(cx, cy, z)) return true;
	}
	return false;
}

// ---------------------------------------------------------------------------
// Pathfinding
// ---------------------------------------------------------------------------
// A route over the tiles the NPC may walk in, four-way so it never cuts a
// corner through a wall. The search is bounded by the NPC's own rectangle and by
// an expansion budget, so a map-wide chase can never stall the frame loop.
const int NPC_PATH_MAX_TILES = 20000;
const int NPC_PATH_MAX_EXPANSIONS = 2000;
const int NPC_PATH_RECALC_MS = 250;
// Path searches allowed per world tick. Whatever happens, the frame loop never
// pays for more than this, so any number of living NPCs can never freeze the
// player: the ones without a route fall back to a direct step until their turn.
const int NPC_PATH_SEARCHES_PER_TICK = 2;
int npc_path_budget = NPC_PATH_SEARCHES_PER_TICK;

// Binary min-heap for the open set. The old version scanned the whole open list
// to find the best node and removed it with remove_at, which is quadratic and
// was what stalled the game when a few NPCs had to plan a route.
int[] npc_heap_key;
int[] npc_heap_f;

void npc_heap_push(int key, int f)
{
	npc_heap_key.insert_last(key);
	npc_heap_f.insert_last(f);
	int i = int(npc_heap_key.length()) - 1;
	while (i > 0)
	{
		int p = (i - 1) / 2;
		if (npc_heap_f[p] <= npc_heap_f[i]) break;
		int tk = npc_heap_key[p];
		npc_heap_key[p] = npc_heap_key[i];
		npc_heap_key[i] = tk;
		int tf = npc_heap_f[p];
		npc_heap_f[p] = npc_heap_f[i];
		npc_heap_f[i] = tf;
		i = p;
	}
}

int npc_heap_pop()
{
	int top = npc_heap_key[0];
	int last = int(npc_heap_key.length()) - 1;
	npc_heap_key[0] = npc_heap_key[last];
	npc_heap_f[0] = npc_heap_f[last];
	npc_heap_key.remove_at(uint(last));
	npc_heap_f.remove_at(uint(last));
	int n = int(npc_heap_key.length());
	int i = 0;
	while (true)
	{
		int l = i * 2 + 1;
		if (l >= n) break;
		int r = l + 1;
		int m = l;
		if (r < n && npc_heap_f[r] < npc_heap_f[l]) m = r;
		if (npc_heap_f[i] <= npc_heap_f[m]) break;
		int tk = npc_heap_key[i];
		npc_heap_key[i] = npc_heap_key[m];
		npc_heap_key[m] = tk;
		int tf = npc_heap_f[i];
		npc_heap_f[i] = npc_heap_f[m];
		npc_heap_f[m] = tf;
		i = m;
	}
	return top;
}

bool npc_tile_walkable(npc_instance@ npc, int tx, int ty)
{
	if (npc is null) return false;
	if (!npc_point_in_area(npc, tx, ty, npc.z)) return false;
	return npc_tile_is_floor(tx, ty, npc.z);
}

// Search window: the rectangle between the NPC and its goal, grown by a margin
// so there is room to walk around a wall, clamped to the NPC's own area. Working
// inside this window keeps a replan cheap on a big map, because the arrays never
// grow past the patch of ground the NPC is actually walking through.
const int NPC_PATH_MARGIN = 12;

int npc_path_box_width(npc_instance@ npc)
{
	return npc.path_bx1 - npc.path_bx0 + 1;
}

int npc_path_key(npc_instance@ npc, int tx, int ty)
{
	return (ty - npc.path_by0) * npc_path_box_width(npc) + (tx - npc.path_bx0);
}

int npc_path_x(npc_instance@ npc, int key)
{
	return key % npc_path_box_width(npc) + npc.path_bx0;
}

int npc_path_y(npc_instance@ npc, int key)
{
	return key / npc_path_box_width(npc) + npc.path_by0;
}

// Stores the window for this plan on the instance, so the route keys can be
// decoded after the search is done.
void npc_set_path_box(npc_instance@ npc, int gx, int gy)
{
	int x0 = (npc.x < gx) ? npc.x : gx;
	int x1 = (npc.x > gx) ? npc.x : gx;
	int y0 = (npc.y < gy) ? npc.y : gy;
	int y1 = (npc.y > gy) ? npc.y : gy;
	x0 -= NPC_PATH_MARGIN;
	y0 -= NPC_PATH_MARGIN;
	x1 += NPC_PATH_MARGIN;
	y1 += NPC_PATH_MARGIN;
	if (x0 < npc.rx0) x0 = npc.rx0;
	if (y0 < npc.ry0) y0 = npc.ry0;
	if (x1 > npc.rx1) x1 = npc.rx1;
	if (y1 > npc.ry1) y1 = npc.ry1;
	npc.path_bx0 = x0;
	npc.path_by0 = y0;
	npc.path_bx1 = x1;
	npc.path_by1 = y1;
}

// A route is done when it reaches the goal tile itself, or - for a chase - any
// tile next to it, because the NPC never steps onto the target's own tile.
bool npc_path_goal_done(int cx, int cy, int gx, int gy, bool stop_next_to)
{
	if (stop_next_to) return npc_tile_gap(cx, gx) <= 1 && npc_tile_gap(cy, gy) <= 1;
	return cx == gx && cy == gy;
}

// Tile keys to walk through, start excluded and goal included. An empty array
// means no route exists inside the area.
int[] npc_find_path(npc_instance@ npc, int gx, int gy, bool stop_next_to)
{
	int[] route;
	if (npc is null) return route;
	// Every route costs one unit of the frame budget. A frame with no budget
	// left simply walks straight for now; the next frame plans again.
	if (npc_path_budget <= 0) return route;
	npc_path_budget--;

	// First try the small window around the straight line: that is the normal
	// case and it costs almost nothing. Only when the obstacle is longer than
	// the window is the whole area searched before giving up.
	npc_set_path_box(npc, gx, gy);
	route = npc_path_search(npc, gx, gy, stop_next_to);
	if (route.length() > 0) return route;

	int w = npc.rx1 - npc.rx0 + 1;
	int h = npc.ry1 - npc.ry0 + 1;
	if (w <= 0 || h <= 0 || w * h > NPC_PATH_MAX_TILES) return route;
	npc.path_bx0 = npc.rx0;
	npc.path_by0 = npc.ry0;
	npc.path_bx1 = npc.rx1;
	npc.path_by1 = npc.ry1;
	return npc_path_search(npc, gx, gy, stop_next_to);
}

int[] npc_path_search(npc_instance@ npc, int gx, int gy, bool stop_next_to)
{
	int[] route;
	int w = npc_path_box_width(npc);
	int h = npc.path_by1 - npc.path_by0 + 1;
	if (w <= 0 || h <= 0) return route;
	int total = w * h;
	if (total > NPC_PATH_MAX_TILES) return route;

	int start = npc_path_key(npc, npc.x, npc.y);
	if (start < 0 || start >= total) return route;

	int[] score;
	score.resize(total);
	int[] parent;
	parent.resize(total);
	bool[] closed;
	closed.resize(total);
	// Floor lookups are cached per search: each tile is asked the native map
	// once instead of once per neighbour visit.
	int[] walk_cache;
	walk_cache.resize(total);
	for (int i = 0; i < total; i++)
	{
		score[i] = -1;
		parent[i] = -1;
		closed[i] = false;
		walk_cache[i] = -1;
	}

	npc_heap_key.resize(0);
	npc_heap_f.resize(0);
	score[start] = 0;
	parent[start] = start;
	npc_heap_push(start, npc_tile_gap(npc.x, gx) + npc_tile_gap(npc.y, gy));

	int goal = -1;
	int expansions = 0;
	while (npc_heap_key.length() > 0 && expansions < NPC_PATH_MAX_EXPANSIONS)
	{
		int cur = npc_heap_pop();
		if (closed[cur]) continue;
		closed[cur] = true;
		expansions++;

		int cx = npc_path_x(npc, cur);
		int cy = npc_path_y(npc, cur);
		if (npc_path_goal_done(cx, cy, gx, gy, stop_next_to))
		{
			goal = cur;
			break;
		}

		int[] nx = {cx + 1, cx - 1, cx, cx};
		int[] ny = {cy, cy, cy + 1, cy - 1};
		for (uint d = 0; d < 4; d++)
		{
			int tx = nx[d];
			int ty = ny[d];
			// Outside the window a key would alias another tile inside it, so the
			// window edge is a hard border of the search.
			if (tx < npc.path_bx0 || tx > npc.path_bx1 || ty < npc.path_by0 || ty > npc.path_by1) continue;
			int nk = npc_path_key(npc, tx, ty);
			if (nk < 0 || nk >= total || closed[nk]) continue;
			if (walk_cache[nk] < 0) walk_cache[nk] = npc_tile_walkable(npc, tx, ty) ? 1 : 0;
			if (walk_cache[nk] == 0) continue;
			int next_score = score[cur] + 1;
			if (score[nk] >= 0 && next_score >= score[nk]) continue;
			score[nk] = next_score;
			parent[nk] = cur;
			npc_heap_push(nk, next_score + npc_tile_gap(tx, gx) + npc_tile_gap(ty, gy));
		}
	}
	if (goal < 0) return route;

	int[] backwards;
	int walk = goal;
	while (walk != start && walk >= 0)
	{
		backwards.insert_last(walk);
		if (parent[walk] == walk) break;
		walk = parent[walk];
	}
	for (int i = int(backwards.length()) - 1; i >= 0; i--)
		route.insert_last(backwards[uint(i)]);
	return route;
}

// One tile along the shortest route to a point. A wall is walked around: the
// NPC follows the route tile by tile and, when it is blocked or no route exists
// at all, it takes a direct step rather than standing still for good.
void npc_walk_to(npc_instance@ npc, int tx, int ty, bool stop_next_to = false)
{
	if (npc is null) return;
	if (npc.x == tx && npc.y == ty) return;

	bool goal_changed = (npc.path_goal_x != tx || npc.path_goal_y != ty || npc.path_stop_next_to != stop_next_to);
	if (goal_changed || npc.path.length() == 0)
	{
		if (!goal_changed && npc.path_timer.elapsed < NPC_PATH_RECALC_MS) return;
		npc.path = npc_find_path(npc, tx, ty, stop_next_to);
		npc.path_index = 0;
		npc.path_goal_x = tx;
		npc.path_goal_y = ty;
		npc.path_stop_next_to = stop_next_to;
		npc.path_timer.restart();
	}

	// Tiles the NPC is already standing on are simply old news on the route.
	while (npc.path_index < int(npc.path.length()))
	{
		int key = npc.path[npc.path_index];
		if (npc_path_x(npc, key) == npc.x && npc_path_y(npc, key) == npc.y) npc.path_index++;
		else break;
	}

	if (npc.path_index < int(npc.path.length()))
	{
		int key = npc.path[npc.path_index];
		int px = npc_path_x(npc, key);
		int py = npc_path_y(npc, key);
		if (npc_step_to(npc, px, py))
		{
			npc.path_index++;
			return;
		}
		// The next tile got blocked after the route was built: drop it and let
		// the next tick work out a fresh one.
		npc.path.resize(0);
		return;
	}

	// No route inside the window: step straight at the goal, and if the wall is
	// in the way slip sideways instead of standing still.
	if (npc_step_toward(npc, tx, ty)) return;
	int[] step_x = {1, -1, 0, 0};
	int[] step_y = {0, 0, 1, -1};
	int first = random(0, 3);
	for (int k = 0; k < 4; k++)
	{
		int d = (first + k) % 4;
		if (npc_step_to(npc, npc.x + step_x[uint(d)], npc.y + step_y[uint(d)])) return;
	}
}

void npc_pick_patrol(npc_instance@ npc)
{
	if (npc is null) return;
	for (int attempt = 0; attempt < 100; attempt++)
	{
		int tx = random(npc.rx0, npc.rx1);
		int ty = random(npc.ry0, npc.ry1);
		if (npc_can_step_to(tx, ty, npc.z))
		{
			npc.patrol_x = tx;
			npc.patrol_y = ty;
			npc.patrol_timer.restart();
			return;
		}
	}
	npc.patrol_x = npc.x;
	npc.patrol_y = npc.y;
	npc.patrol_timer.restart();
}

// ---------------------------------------------------------------------------
// Movement
// ---------------------------------------------------------------------------
void npc_face_target(npc_instance@ npc, int tx, int ty)
{
	if (npc is null) return;
	if (tx > npc.x) npc.facing = east;
	else if (tx < npc.x) npc.facing = west;
	else if (ty > npc.y) npc.facing = north;
	else if (ty < npc.y) npc.facing = south;
}

// Is that point inside the volume the NPC is allowed to walk in, on all three
// axes? Everything that moves the NPC or decides its behaviour uses this.
bool npc_point_in_area(npc_instance@ npc, int tx, int ty, int tz)
{
	if (npc is null) return false;
	if (tx < npc.rx0 || tx > npc.rx1) return false;
	if (ty < npc.ry0 || ty > npc.ry1) return false;
	if (tz < npc.rz0 || tz > npc.rz1) return false;
	return true;
}

bool npc_target_in_area(npc_instance@ npc, int tx, int ty, int tz)
{
	return npc_point_in_area(npc, tx, ty, tz);
}

// The step sound of one move: the platform under the NPC's feet when it is set
// to use the map's platforms, otherwise its own clips. The platform falling back
// to the custom list keeps a map without step sounds audible.
void npc_play_step(npc_instance@ npc)
{
	if (npc is null || npc.data is null) return;
	string step = "";
	if (npc.data.use_platform_footsteps)
	{
		string tile = get_tile_at(npc.x, npc.y, npc.z);
		if (tile != "" && tile != "empty") step = get_platform_sound(tile, "step");
	}
	if (step == "") step = npc_pick_clip(npc.data.sound_footsteps);
	if (step != "") npc_play_positional(npc, step);
}

bool npc_step_to(npc_instance@ npc, int nx, int ny)
{
	if (npc is null) return false;
	// The configured area is a hard border: the NPC walks, patrols and chases
	// only inside it, on every axis. A step that would cross an edge is simply
	// refused, so the NPC can never leave no matter where its target runs.
	if (!npc_point_in_area(npc, nx, ny, npc.z)) return false;
	if (!npc_can_step_to(nx, ny, npc.z)) return false;
	if (nx > npc.x) npc.facing = east;
	else if (nx < npc.x) npc.facing = west;
	else if (ny > npc.y) npc.facing = north;
	else if (ny < npc.y) npc.facing = south;
	npc.x = nx;
	npc.y = ny;
	npc_play_step(npc);
	return true;
}

// One tile per call on a single axis, so an approach is never faster on a
// diagonal. The axis with the larger gap is tried first and the other axis
// carries the NPC around an obstacle when the first one is blocked.
bool npc_step_toward(npc_instance@ npc, int tx, int ty)
{
	if (npc is null) return false;
	int dx = tx - npc.x;
	int dy = ty - npc.y;
	if (dx == 0 && dy == 0) return false;
	int sx = (dx > 0) ? 1 : ((dx < 0) ? -1 : 0);
	int sy = (dy > 0) ? 1 : ((dy < 0) ? -1 : 0);
	if (npc_tile_gap(npc.x, tx) >= npc_tile_gap(npc.y, ty))
	{
		if (sx != 0 && npc_step_to(npc, npc.x + sx, npc.y)) return true;
		if (sy != 0 && npc_step_to(npc, npc.x, npc.y + sy)) return true;
	}
	else
	{
		if (sy != 0 && npc_step_to(npc, npc.x, npc.y + sy)) return true;
		if (sx != 0 && npc_step_to(npc, npc.x + sx, npc.y)) return true;
	}
	return false;
}

// How many whole tiles separate the NPC from a point, axis by axis.
int npc_tile_gap(int from, int to)
{
	int gap = from - to;
	if (gap < 0) gap = -gap;
	return gap;
}

// True when the NPC already stands on one of the eight tiles around the target.
// That is the closest it ever gets: it never steps onto the target's own tile.
bool npc_next_to_target(npc_instance@ npc, int tx, int ty, int tz)
{
	if (npc is null) return false;
	if (npc.z != tz) return false;
	return npc_tile_gap(npc.x, tx) <= 1 && npc_tile_gap(npc.y, ty) <= 1;
}

// Whole tiles between the NPC and a point, counted the way a player counts
// steps on a square grid: the largest of the three axis gaps. A diagonal
// neighbour is one step away, never 1.41, so an attack range of five tiles means
// exactly five tiles and never a single step more.
int npc_step_gap(npc_instance@ npc, int tx, int ty, int tz)
{
	if (npc is null) return 0;
	int gap = npc_tile_gap(npc.x, tx);
	int gy = npc_tile_gap(npc.y, ty);
	int gz = npc_tile_gap(npc.z, tz);
	if (gy > gap) gap = gy;
	if (gz > gap) gap = gz;
	return gap;
}

// The attack range is in whole tiles and is a hard limit: outside it the NPC
// never attacks, whatever the angle.
bool npc_in_attack_reach(npc_instance@ npc, int tx, int ty, int tz)
{
	if (npc is null || npc.data is null) return false;
	return npc_step_gap(npc, tx, ty, tz) <= npc.data.attack_range;
}

// Attacking does not root the NPC in place. Until it reaches a tile next to the
// target it keeps stepping closer at its walking or running pace, so a target
// that stops moving is approached instead of being attacked from far away.
void npc_close_in(npc_instance@ npc, int tx, int ty)
{
	if (npc is null || npc.data is null) return;
	if (npc_next_to_target(npc, tx, ty, npc.z)) return;
	int speed = npc.furious ? npc.data.run_speed : npc.data.walk_speed;
	if (npc.move_timer.elapsed < speed) return;
	npc.move_timer.restart();
	npc_walk_to(npc, tx, ty, true);
}

// ---------------------------------------------------------------------------
// Death drops
// ---------------------------------------------------------------------------
// Semicolon separated item_id:quantity pairs. A pair without a quantity drops
// a single unit. The item lands on the ground exactly where the NPC fell.
void npc_drop_death_items(npc_instance@ npc)
{
	if (npc is null || npc.data is null) return;
	if (!npc.data.drop_items_on_death || npc.data.death_drops == "") return;
	string[]@ drops = string_split(npc.data.death_drops, ";", true);
	if (drops is null) return;
	for (uint i = 0; i < drops.length(); i++)
	{
		string spec = drops[i].trim_whitespace();
		if (spec == "") continue;
		string item_id = spec;
		int qty = 1;
		int col = string_contains(spec, ":", 1);
		if (col != -1)
		{
			item_id = string_left(spec, col).trim_whitespace();
			qty = int(string_to_number(spec.substr(col + 1).trim_whitespace()));
			if (qty < 1) qty = 1;
		}
		if (item_id == "") continue;
		spawn_ground_item(item_id, qty, npc.x, npc.y, npc.z, 180000, 480000, "items/item.ogg", 300);
	}
}

// ---------------------------------------------------------------------------
// Damage and death
// ---------------------------------------------------------------------------
void npc_die(npc_instance@ npc, const string&in killer, const string&in weapon_name)
{
	if (npc is null || npc.dead) return;
	npc.dead = true;
	npc.death_timer.restart();
	npc.aware = false;
	if (npc.data !is null)
	{
		npc_play_positional(npc, npc.data.sound_death);

		// The body hits the floor of the platform the NPC was standing on: its
		// fall sound, or the harder landing of platforms that only define that.
		string tile = get_tile_at(npc.x, npc.y, npc.z);
		if (tile != "" && tile != "empty")
		{
			string fall = get_platform_sound(tile, "fall");
			if (fall == "") fall = get_platform_sound(tile, "hardland");
			if (fall != "") npc_play_positional(npc, fall);
		}

		npc_drop_death_items(npc);

		string line = killer + " killed " + npc.data.name + " at " + npc.x + ", " + npc.y + ", " + npc.z + " with " + weapon_name + ".";
		npc_write_kill_line(line);
		speak(line);
	}
	if (killer == "Player")
	{
		kills += 1;
		// Only the player earns experience: an NPC killed by another NPC pays
		// nothing, because no player was involved in the fight.
		if (npc.data !is null) add_player_quantum_xp(npc.data.xp);
	}
}

void npc_take_damage(npc_instance@ npc, int dmg, const string&in killer, const string&in weapon_name)
{
	if (npc is null || npc.dead || dmg <= 0) return;
	if (npc.data is null) return;

	// Being attacked is what turns an NPC furious: from now on it runs at the
	// configured running pace instead of walking.
	// Damage never touches the attack cooldown. Restarting it here made every
	// hit push the next attack back, so a fast automatic weapon kept an NPC
	// silent and harmless forever. The cooldown belongs to the attack cadence
	// alone: the NPC keeps striking at its configured attack_speed while it is
	// being shot.
	npc.furious = true;
	npc.aware = true;
	npc_play_positional(npc, npc.data.sound_pain);

	npc.hp -= dmg;
	if (npc.hp <= 0) npc_die(npc, killer, weapon_name);
}

// The player's shots are straight: every projectile moves exactly one tile per
// tick along a single axis. A shot only counts as a hit when the step is
// perfectly aligned (it travels on one axis, never diagonally) and the tile it
// reaches is exactly the NPC's tile. So the aim has to be straight ahead,
// straight behind, straight left or straight right; anything else, even an NPC
// standing inside the field of view, is not hit.
bool npc_projectile_aims_at(double fx, double fy, double fz, double tx, double ty, double tz, npc_instance@ npc)
{
	if (npc is null) return false;
	int axes = 0;
	if (tx != fx) axes++;
	if (ty != fy) axes++;
	if (tz != fz) axes++;
	if (axes > 1) return false;
	return (int(round(tx, 0)) == npc.x && int(round(ty, 0)) == npc.y && int(round(tz, 0)) == npc.z);
}

// Called by the projectile system so the player's own shots can hit NPCs. The
// step goes from where the projectile was to where it is now.
bool npc_projectile_intersect(double fx, double fy, double fz, double tx, double ty, double tz, int dmg, const string&in weapon_id)
{
	if (npc_instances.length() == 0) return false;
	for (uint i = 0; i < npc_instances.length(); i++)
	{
		npc_instance@ npc = npc_instances[i];
		if (npc is null || npc.dead) continue;
		if (!npc_projectile_aims_at(fx, fy, fz, tx, ty, tz, npc)) continue;
		weapon_data@ w = find_weapon_data(weapon_id);
		string wname = (w !is null && w.name != "") ? w.name : weapon_id;
		// The weapon's own impact sound plays on the target: that is the feedback
		// that tells the player the shot connected. NPCs whose pain clip is not
		// configured would otherwise take damage in complete silence.
		if (w !is null && w.sound_hit != "") npc_play_positional(npc, w.sound_hit);
		npc_take_damage(npc, dmg, "Player", wname);
		return true;
	}
	return false;
}

// ---------------------------------------------------------------------------
// Attack
// ---------------------------------------------------------------------------
void npc_attack_player(npc_instance@ npc)
{
	if (npc is null || npc.data is null || npc.dead) return;
	npc_play_positional(npc, npc.data.sound_attack);
	int dmg = random(npc.data.min_damage, npc.data.max_damage);
	int through = shield_process_damage(dmg, "melee");
	if (through > 0) health_damage_player(through, npc.data.name, "attack");
}

// ---------------------------------------------------------------------------
// Behaviour
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Voice
// ---------------------------------------------------------------------------
// Same rules as the old NPC system: the current clip owns a persistent pool
// slot and is allowed to finish, each clip is repeated two or three times before
// the list rotates to the next one, and the silence between clips is counted
// from the moment the clip really ended, between voice_min_delay and
// voice_max_delay.
void npc_release_voice(npc_instance@ npc)
{
	if (npc is null) return;
	if (npc.voice_handle !is null && npc.voice_slot >= 0 && npc_pool_ready
		&& npc.voice_slot < int(npcp.items.length())
		&& npcp.items[npc.voice_slot].handle is npc.voice_handle)
	{
		npcp.destroy_sound(npc.voice_slot);
	}
	@npc.voice_handle = null;
	npc.voice_slot = -1;
}

void npc_voice_pick_delay(npc_instance@ npc)
{
	if (npc is null || npc.data is null) return;
	int min_delay = (npc.data.voice_min_delay > 0) ? npc.data.voice_min_delay : 1500;
	int max_delay = (npc.data.voice_max_delay >= min_delay) ? npc.data.voice_max_delay : min_delay;
	npc.voice_delay_target = random(min_delay, max_delay);
	npc.voice_delay_timer.restart();
	npc.voice_waiting_delay = true;
}

void npc_update_voice(npc_instance@ npc)
{
	if (npc is null || npc.data is null || npc.dead) return;
	if (npc.data.sound_voice == "") return;
	if (get_3d_distance(me.x, me.y, me.z, double(npc.x), double(npc.y), double(npc.z)) > NPC_LOCAL_SOUND_DISTANCE) return;

	// A clip is still playing: let it end, then start the silence only now.
	if (npc.voice_handle !is null)
	{
		if (npc.voice_slot >= 0 && npc_pool_ready && npc.voice_slot < int(npcp.items.length())
			&& npcp.items[npc.voice_slot].handle is npc.voice_handle && npc.voice_handle.playing)
		{
			return;
		}
		npc_release_voice(npc);
		npc_voice_pick_delay(npc);
		return;
	}

	if (npc.voice_waiting_delay)
	{
		if (npc.voice_delay_timer.elapsed < npc.voice_delay_target) return;
		npc.voice_waiting_delay = false;
	}

	string[]@ clips = string_split(npc.data.sound_voice, ";", true);
	if (clips is null || clips.length() == 0) return;
	if (npc.voice_index >= int(clips.length())) npc.voice_index = 0;

	string clip = clips[uint(npc.voice_index)].trim_whitespace();
	npc.voice_repeats_done++;
	if (npc.voice_repeats_done >= npc.voice_repeats_target)
	{
		npc.voice_repeats_done = 0;
		npc.voice_repeats_target = random(2, 3);
		npc.voice_index = (npc.voice_index + 1) % int(clips.length());
	}
	string path = (clip != "") ? get_sound_path(clip) : "";
	if (path == "")
	{
		// An empty entry or a missing file must not be retried every frame.
		npc_voice_pick_delay(npc);
		return;
	}
	npc_init_pool();
	// Persistent: the pool must never recycle the voice slot for another sound
	// while the clip plays, or the finished detection reads a foreign handle.
	int slot = npcp.play_extended_3d(path, me.x, me.y, me.z, npc.x, npc.y, npc.z, double(facing), 0, 0, 0, 0, 0, 0, false, 0, 0.0, 0.0, 100.0, true);
	if (slot >= 0)
	{
		npc.voice_slot = slot;
		@npc.voice_handle = npcp.items[slot].handle;
		npc_tag_sound(npc, slot);
	}
	else
	{
		// Out of range or no slot: go back to waiting instead of retrying every frame.
		npc_voice_pick_delay(npc);
	}
}

// ---------------------------------------------------------------------------
// Patrol
// ---------------------------------------------------------------------------
// Inside a safe zone nothing can be attacked, so the NPC keeps walking a circle
// around the player, within its own area, instead of wandering off: it surrounds
// the player and is already close when the zone is left.
void npc_circle_patrol(npc_instance@ npc, int px, int py)
{
	if (npc is null || npc.data is null) return;
	npc.patrol_angle += 40.0;
	while (npc.patrol_angle >= 360.0) npc.patrol_angle -= 360.0;
	double rad = npc.patrol_angle * 0.01745329251;
	int radius = 3;
	int tx = px + int(round(cos(rad) * double(radius), 0));
	int ty = py + int(round(sin(rad) * double(radius), 0));
	if (tx < npc.rx0) tx = npc.rx0;
	if (tx > npc.rx1) tx = npc.rx1;
	if (ty < npc.ry0) ty = npc.ry0;
	if (ty > npc.ry1) ty = npc.ry1;
	npc.patrol_x = tx;
	npc.patrol_y = ty;
	if (npc.move_timer.elapsed < npc.data.walk_speed) return;
	npc.move_timer.restart();
	npc_walk_to(npc, tx, ty);
}

void npc_patrol_tick(npc_instance@ npc)
{
	if (npc is null || npc.data is null) return;
	double d = get_3d_distance(double(npc.x), double(npc.y), double(npc.z), double(npc.patrol_x), double(npc.patrol_y), double(npc.z));
	if (d < 1.0 || npc.patrol_timer.elapsed > 20000) npc_pick_patrol(npc);
	if (npc.move_timer.elapsed >= npc.data.walk_speed)
	{
		npc.move_timer.restart();
		npc_walk_to(npc, npc.patrol_x, npc.patrol_y);
	}
}

// The target is unreachable: it stands outside the area this NPC is allowed to
// walk in. The NPC does not freeze and it does not leave either - it keeps
// patrolling along the border closest to the target, waiting for it to come
// back. As soon as the target steps inside the area again, the hunt resumes.
void npc_patrol_edge(npc_instance@ npc)
{
	if (npc is null || npc.dead || npc.data is null) return;
	if (npc.move_timer.elapsed < npc.data.walk_speed) return;
	npc.move_timer.restart();

	int tx = int(round(me.x, 0));
	int ty = int(round(me.y, 0));

	// Closest point inside the area to the target: where the NPC should stand.
	int ex = tx;
	int ey = ty;
	if (ex < npc.rx0) ex = npc.rx0;
	if (ex > npc.rx1) ex = npc.rx1;
	if (ey < npc.ry0) ey = npc.ry0;
	if (ey > npc.ry1) ey = npc.ry1;

	// Still walking to the border: head straight for that edge point.
	if (npc.x != ex || npc.y != ey)
	{
		npc_walk_to(npc, ex, ey);
		return;
	}

	// Already on the edge nearest the target: patrol that border instead of
	// standing still, so it keeps scanning the area for the returning target.
	if (tx < npc.rx0 || tx > npc.rx1)
	{
		npc.patrol_x = ex;
		npc.patrol_y = random(npc.ry0, npc.ry1);
	}
	else if (ty < npc.ry0 || ty > npc.ry1)
	{
		npc.patrol_x = random(npc.rx0, npc.rx1);
		npc.patrol_y = ey;
	}
	else
	{
		// The target is outside the area only on the z axis: walk the whole
		// edge under it while staying on the allowed floor.
		npc.patrol_x = ex;
		npc.patrol_y = random(npc.ry0, npc.ry1);
	}
	npc_walk_to(npc, npc.patrol_x, npc.patrol_y);
}

void npc_instance_tick(npc_instance@ npc)
{
	if (npc is null || npc.dead || npc.data is null) return;

	npc_follow_sounds(npc);
	npc_update_voice(npc);

	int px = int(round(me.x, 0));
	int py = int(round(me.y, 0));
	int pz = int(round(me.z, 0));

	// A safe zone suspends the hunt completely: the NPC keeps surrounding the
	// player and loses its awareness, and it only notices the player again inside
	// its detection range once the hunt resumes.
	if (is_safe(px, py, pz) || is_safe(npc.x, npc.y, npc.z))
	{
		npc.aware = false;
		npc_circle_patrol(npc, px, py);
		return;
	}

	int gap = npc_step_gap(npc, px, py, pz);
	if (!npc.aware && gap <= npc.data.detection_range) npc.aware = true;

	if (!npc.aware)
	{
		npc_patrol_tick(npc);
		return;
	}

	// The player is only a valid target to walk to while standing inside the
	// area this NPC may walk in. Attacking is a different rule: whatever the
	// walk limits are, a target inside the attack range can be hit.
	bool target_in_area = npc_target_in_area(npc, px, py, pz);

	// The attack is decided by the attack range and by the tiles between the two
	// of them. The wall rule walks the tile line between the pair, so it gives the
	// same answer every frame: an NPC never hits through a wall, and a clear hit
	// is never lost to a flickering check either.
	if (npc_in_attack_reach(npc, px, py, pz) && !npc_wall_between(npc.x, npc.y, px, py, npc.z))
	{
		npc_face_target(npc, px, py);
		if (npc.attack_timer.elapsed >= npc.data.attack_speed)
		{
			npc.attack_timer.restart();
			npc_attack_player(npc);
		}
		// Keep advancing while attacking, but only where it is allowed to walk:
		// it stops when it is on a tile next to the player, or at the edge of its
		// area when the player stands beyond it.
		if (target_in_area) npc_close_in(npc, px, py);
		return;
	}

	if (!target_in_area)
	{
		// Hunt the edge; never cross it.
		npc_patrol_edge(npc);
		return;
	}

	// Pursuit inside the area: walking pace while calm, running pace after
	// being attacked. Every step is bound-checked, so even a target just
	// inside the border cannot pull the NPC across it.
	int speed = npc.furious ? npc.data.run_speed : npc.data.walk_speed;
	if (npc.move_timer.elapsed >= speed)
	{
		npc.move_timer.restart();
		npc_walk_to(npc, px, py, true);
	}
}

// ---------------------------------------------------------------------------
// Spawning
// ---------------------------------------------------------------------------
npc_instance@ npc_spawn_instance(const string&in npc_id, int spawner_index, int x0, int y0, int z0, int x1, int y1, int z1)
{
	if (npc_instances.length() >= uint(NPC_MAX_ACTIVE)) return null;
	npc_data@ data = find_npc_data(npc_id);
	if (data is null) return null;

	int sx = 0, sy = 0, sz = 0;
	if (!npc_find_spawn(x0, y0, z0, x1, y1, z1, sx, sy, sz)) return null;

	npc_instance@ npc = npc_instance();
	@npc.data = data;
	npc.spawner_index = spawner_index;
	npc.sound_owner = "npc:" + npc_sound_owner_seq + ";";
	npc_sound_owner_seq++;
	npc.rx0 = x0; npc.ry0 = y0; npc.rz0 = z0;
	npc.rx1 = x1; npc.ry1 = y1; npc.rz1 = z1;
	npc.hp = data.max_health;
	npc.maxhp = data.max_health;
	npc.x = sx; npc.y = sy; npc.z = sz;
	npc.facing = random(0, 3) * 90;
	// The NPC knows where the player is from the moment it appears.
	npc.aware = true;
	npc.attack_timer.restart();
	npc.move_timer.restart();
	npc.voice_delay_timer.restart();
	npc.patrol_timer.restart();

	// First voice comes after the configured silence, not immediately.
	npc_voice_pick_delay(npc);
	npc.voice_index = 0;
	npc.voice_repeats_target = random(2, 3);
	npc_pick_patrol(npc);

	npc_instances.insert_last(npc);
	// Spawning is silent on purpose: a map with dozens of NPCs must not queue
	// dozens of announcements while it starts.
	return npc;
}

// Living NPCs belonging to one spawner line. Dead bodies are not counted, so a
// spawner sees the loss as soon as its NPC really dies.
int npc_count_for_spawner(int spawner_index)
{
	int n = 0;
	for (uint i = 0; i < npc_instances.length(); i++)
	{
		npc_instance@ npc = npc_instances[i];
		if (npc is null || npc.dead || npc.data is null) continue;
		if (npc.spawner_index == spawner_index) n++;
	}
	return n;
}

void npc_destroy_all()
{
	npc_instances.resize(0);
	npc_spawner_states.resize(0);
	if (npc_pool_ready) npcp.destroy_all();
}

void npc_start_for_map()
{
	npc_destroy_all();
	npc_spawner_states.resize(0);
	load_all_npcs();
	for (uint i = 0; i < npc_spawn_defs.length(); i++)
		npc_spawner_states.insert_last(npc_spawner_state(
			npc_spawn_defs[i].npc_id, npc_spawn_defs[i].count, npc_spawn_defs[i].respawn_ms,
			npc_spawn_defs[i].rx0, npc_spawn_defs[i].ry0, npc_spawn_defs[i].rz0,
			npc_spawn_defs[i].rx1, npc_spawn_defs[i].ry1, npc_spawn_defs[i].rz1));
}

// ---------------------------------------------------------------------------
// Loop
// ---------------------------------------------------------------------------
void npc_loop()
{
	// Refill the pathfinding budget once per world tick, before any NPC plans.
	npc_path_budget = NPC_PATH_SEARCHES_PER_TICK;
	if (npc_instances.length() == 0 && npc_spawner_states.length() == 0) return;
	if (npc_pool_ready) npcp.update_listener_3d(me.x, me.y, me.z, double(facing));

	// Spawners never duplicate: the first population fills the area once, and
	// after that a slot is refilled only when one of its own NPCs actually dies,
	// waiting exactly the configured number of milliseconds from that death.
	for (uint s = 0; s < npc_spawner_states.length(); s++)
	{
		npc_spawner_state@ sp = npc_spawner_states[s];
		if (sp is null) continue;
		int living = npc_count_for_spawner(int(s));

		if (!sp.populated)
		{
			while (living < sp.count)
			{
				if (npc_spawn_instance(sp.npc_id, int(s), sp.rx0, sp.ry0, sp.rz0, sp.rx1, sp.ry1, sp.rz1) is null)
				{
					// No floor in the area, or the map already holds the entire
					// population budget: stop here and try again later, never in a
					// tight loop.
					sp.retry_backoff = true;
					break;
				}
				living++;
			}
			sp.populated = true;
			sp.waiting = (living < sp.count);
			sp.respawn_timer.restart();
			continue;
		}

		if (living >= sp.count)
		{
			sp.waiting = false;
			sp.retry_backoff = false;
			continue;
		}

		// A slot opened (an NPC died): start counting the respawn delay now.
		if (!sp.waiting)
		{
			sp.waiting = true;
			sp.respawn_timer.restart();
			continue;
		}

		int wait_ms = sp.respawn_ms;
		if (sp.retry_backoff && wait_ms < NPC_SPAWN_RETRY_MS) wait_ms = NPC_SPAWN_RETRY_MS;
		if (sp.respawn_timer.elapsed < wait_ms) continue;
		sp.respawn_timer.restart();
		if (npc_spawn_instance(sp.npc_id, int(s), sp.rx0, sp.ry0, sp.rz0, sp.rx1, sp.ry1, sp.rz1) is null)
			sp.retry_backoff = true;
		else
			sp.retry_backoff = false;
	}

	for (int i = int(npc_instances.length()) - 1; i >= 0; i--)
	{
		npc_instance@ npc = npc_instances[uint(i)];
		if (npc is null)
		{
			npc_instances.remove_at(uint(i));
			continue;
		}
		if (npc.dead)
		{
			if (npc.death_timer.elapsed >= NPC_DEATH_LINGER_MS)
			{
				// The voice slot is persistent, so it is handed back before the
				// instance goes away; one-shot clips simply expire on their own.
				npc_release_voice(npc);
				npc_instances.remove_at(uint(i));
			}
			continue;
		}
		npc_instance_tick(npc);
	}
}

// ---------------------------------------------------------------------------
// Map spawner line
// ---------------------------------------------------------------------------
void npc_save_spawner_to_map(const string&in npc_id, int count, int respawn_ms, int x0, int y0, int z0, int x1, int y1, int z1, bool refresh = true)
{
	if (SCRIPT_COMPILED || is_map_encrypted(mapname))
	{
		speak("Cannot edit an encrypted map.");
		return;
	}
	string id = npc_id.trim_whitespace();
	if (id == "") return;
	if (count < 0) count = 0;
	if (count > NPC_MAX_PER_SPAWNER) count = NPC_MAX_PER_SPAWNER;
	if (respawn_ms < 0) respawn_ms = 0;
	if (x0 > x1) { int t = x0; x0 = x1; x1 = t; }
	if (y0 > y1) { int t = y0; y0 = y1; y1 = t; }
	if (z0 > z1) { int t = z0; z0 = z1; z1 = t; }
	if (x0 < minx) x0 = minx;
	if (y0 < miny) y0 = miny;
	if (z0 < minz) z0 = minz;
	if (x1 > maxx) x1 = maxx;
	if (y1 > maxy) y1 = maxy;
	if (z1 > maxz) z1 = maxz;

	string path = MAP_DIR + "/" + mapname + ".map";
	string content = "";
	if (file_exists(path)) content = file_get_contents(path);
	if (content == "") content = get_map_content_by_name(mapname);

	string prefix = "npcspawner:" + id + ":";
	string new_line = prefix + count + ":" + respawn_ms + ":" + x0 + ":" + y0 + ":" + z0 + ":" + x1 + ":" + y1 + ":" + z1;
	string[]@ raw = string_split(string_replace(content, "\r", "", true), "\n", false);
	string rebuilt = "";
	bool replaced = false;
	if (raw !is null)
	{
		for (uint i = 0; i < raw.length(); i++)
		{
			string line = raw[i].trim_whitespace();
			if (line == "") continue;

			// The NPC spawner is a new format: an id, a count, a respawn time and
			// six area coordinates. Anything else that starts with npcspawner:
			// belongs to a removed format and is dropped, never rewritten.
			if (string_starts_with(line, "npcspawner:"))
			{
				string[]@ parts = string_split(line, ":", false);
				bool valid = (parts !is null && parts.length() == 10 && string_to_number(parts[1]) <= 0);
				if (string_starts_with(line, prefix))
				{
					if (!replaced && count > 0) { rebuilt += new_line + "\n"; replaced = true; }
					continue;
				}
				if (!valid) continue;
			}
			rebuilt += line + "\n";
		}
	}
	if (!replaced && count > 0) rebuilt += new_line + "\n";

	file_put_contents(path, rebuilt);
	map_bundle_cache[mapname] = rebuilt;
	invalidate_map_lines_cache(mapname);
	if (!refresh) return;
	speak("map updated");
	tempreset();
	draw_map(mapname);
}
