// store_menu.nvgt - One placed storefront containing its configured categories.
// Each category loads its inventory and payment settings from its own .st data.
//
//   Up / Down   - move between categories (the first press selects the first
//                 category; nothing is selected when the store opens)
//   Tab         - open the items of the selected category (Tab again returns)
//   Up / Down   - in the item list, move between items
//   Right       - add one unit of the item to the cart
//   Left        - remove one unit of the item from the cart
//   Enter       - buy everything in the cart (or open a category)
//   F1          - speak the currency balances
//   F2          - speak the cart total
//   Escape      - leave the store
//
// Everything is local and offline: the cart is checked against the player's
// inventory balances, the currency is deducted and the items are granted
// immediately. No item carries its own payment method; the store's currency
// charges the whole cart.

const string CURRENCY_GOLD = "gold";
const string CURRENCY_GOLDEN_CRYSTAL = "golden_crystal";
string[] store_currencies = {CURRENCY_GOLD, CURRENCY_GOLDEN_CRYSTAL};

bool is_valid_store_currency(string cur)
{
	for (uint i = 0; i < store_currencies.length(); i++)
	{
		if (store_currencies[i] == cur) return true;
	}
	return false;
}

// Currencies are identified by their canonical ids: gold, golden_crystal.
// The only normalization is case and surrounding whitespace;
// no other spelling is treated as a currency.
string normalize_currency(string cur)
{
	return string_to_lower_case(string_trim_sides(cur));
}

string currency_display_name(const string&in currency)
{
	string id = normalize_currency(currency);
	if (id == CURRENCY_GOLD) return tr("currency.gold");
	if (id == CURRENCY_GOLDEN_CRYSTAL) return tr("currency.golden_crystal");
	return tr("currency.gold");
}

// Resolves the inventory/balance key for a currency item: the item's id when
// it is one of the two native currencies (gold, golden crystal), otherwise its subtype (so a custom item like "gold_pouch" with
// subtype "gold" still credits the gold balance).
string currency_key_for_item(item_data@ it)
{
	if (it is null) return "";
	string by_id = normalize_currency(it.id);
	if (is_valid_store_currency(by_id)) return by_id;
	string by_sub = normalize_currency(it.subtype);
	if (is_valid_store_currency(by_sub)) return by_sub;
	return it.id;
}

string store_cart_balances_text()
{
	return tr("store.balances", {"" + get_item_count(CURRENCY_GOLD), tr("currency.gold"), "" + get_item_count(CURRENCY_GOLDEN_CRYSTAL), tr("currency.golden_crystal")});
}

// Grants a bought product and reports whether the item exists in the registry,
// so a cart that names a missing item is refunded instead of half-delivered.
bool store_grant_product(const string&in product, int quantity)
{
	load_all_items_config();
	load_all_weapons_wpm();
	load_all_packages();
	if (find_item_data(product) is null && find_weapon_data(product) is null && find_package_data(product) is null) return false;
	give(product, quantity);
	return true;
}

// The currency every item of this store is charged in. store_finalize_currencies()
// settles it to one of the four native ids when the store is loaded or saved.
string store_charge_currency(store_cfg@ s)
{
	return normalize_currency(s.currency);
}

// ---------------------------------------------------------------------------
// Main menu store
// ---------------------------------------------------------------------------
int[][] store_browse_amounts;

void store_browse_resize_cart(int cat)
{
	store_browse_amounts.resize(store_configs.length());
	int n = int(store_configs[cat].item_names.length());
	if (int(store_browse_amounts[cat].length()) != n) store_browse_amounts[cat].resize(n);
}

void store_browse_announce_category(int cat)
{
	store_cfg@ s = store_configs[cat];
	store_browse_resize_cart(cat);
	speak(s.display_name);
}

void store_browse_announce_item(int cat, int item)
{
	store_cfg@ s = store_configs[cat];
	string iname = get_item_display_name(s.item_names[item]);
	speak(tr("store.in_cart", {iname, s.item_prices[item], currency_display_name(store_charge_currency(s)), "" + store_browse_amounts[cat][item]}));
}

string get_store_sound(const string&in name)
{
	string char_folder = (current_player_character == "annie" || current_player_character == "ilana" || current_player_character == "hane") ? "sounds/players/hane/" : "sounds/players/stefan/";
	string snd = find_sound_in_disk(char_folder + name + ".ogg");
	if (snd == "") snd = find_sound_in_disk(char_folder + name);
	if (snd == "") snd = get_player_sound(name);
	if (snd == "") snd = find_sound_in_disk("sounds/players/stefan/" + name + ".ogg");
	if (snd == "") snd = find_sound_in_disk("sounds/players/stefan/" + name);
	if (snd == "") snd = get_sound_path(name + ".ogg");
	return snd;
}

void play_store_error()
{
	string err_snd = get_store_sound("store_error");
	if (err_snd == "") err_snd = get_sound_path("player/store_error.ogg;sounds/player/store_error.ogg;misc/error.ogg;error.ogg");
	if (err_snd != "") p.play_stationary(err_snd, false);
}

void load_player_store_inventory()
{
	if (current_player_character != "stefan" && current_player_character != "annie" && current_player_character != "ilana") return;
	string save_path = get_game_save_path(current_player_character);
	if (file_exists(save_path))
	{
		savedata loc(save_path, GAME_SAVE_KEY);
		loc.load();
		if (loc.d.exists("inventory_data"))
		{
			deserialize_inventory(loc.read("inventory_data"));
		}
	}
}

void save_player_store_inventory()
{
	if (current_player_character != "stefan" && current_player_character != "annie" && current_player_character != "ilana") return;
	string save_path = get_game_save_path(current_player_character);
	savedata loc(save_path, GAME_SAVE_KEY);
	if (file_exists(save_path))
	{
		loc.load();
	}
	else
	{
		loc.add("mapname", "florest");
		loc.add("pos_x", 1);
		loc.add("pos_y", 0);
		loc.add("pos_z", 0);
		loc.add("facing", 0);
		loc.add("level", 1);
		loc.add("xp", 0);
		loc.add("resurrections", 0);
		int base_hp = calculate_player_max_health(current_player_character, 0);
		loc.add("maxhealth", base_hp);
		loc.add("health", base_hp);
	}
	loc.add("player_character", current_player_character);
	loc.add("inventory_data", serialize_inventory());
	loc.save();
}

void store_browse_buy(int cat)
{
	store_cfg@ s = store_configs[cat];
	string currency = store_charge_currency(s);
	int total_cost = 0;
	int total_items = 0;
	for (uint i = 0; i < s.item_names.length(); i++)
	{
		int q = store_browse_amounts[cat][i];
		if (q <= 0) continue;
		total_cost += int(stn(s.item_prices[i])) * q;
		total_items += q;
	}
	if (total_items == 0)
	{
		play_store_error();
		speak(tr("store.empty_cart"));
		return;
	}
	int balance = get_item_count(currency);
	if (balance < total_cost)
	{
		play_store_error();
		speak(tr("store.not_enough_money", {currency_display_name(currency), "" + total_cost, "" + balance}));
		return;
	}

	give(currency, -total_cost);
	string summary = "";
	for (uint i = 0; i < s.item_names.length(); i++)
	{
		int q = store_browse_amounts[cat][i];
		if (q <= 0) continue;
		if (!store_grant_product(s.item_names[i], q))
		{
			give(currency, total_cost);
			speak(tr("store.payment_returned"));
			return;
		}
		store_browse_amounts[cat][i] = 0;
		if (summary != "") summary += ", ";
		summary += q + " " + get_item_display_name(s.item_names[i]);
	}

	save_player_store_inventory();

	string buy_snd = get_store_sound("buy");
	if (buy_snd == "") buy_snd = get_sound_path("player/buy.ogg;sounds/player/buy.ogg;player/storepurchase.ogg;items/buy.ogg;items/storepurchase.ogg;storepurchase.ogg;buy.ogg");
	if (buy_snd != "") p.play_stationary(buy_snd, false);
	speak(tr("store.purchase_success", {summary, "" + total_cost, currency_display_name(currency)}));
}

string store_welcome_text(const string&in store_name)
{
	string[] args = {store_name};
	return tr("store.welcome", args);
}

bool try_open_map_store_at_player()
{
	string store_id = get_map_store_at(int(round(me.x, 0)), int(round(me.y, 0)), int(round(me.z, 0)));
	if (store_id == "") return false;
	if (get_storefront(store_id) is null)
	{
		speak(tr("store_point.store_missing"));
		return true;
	}
	store_main_menu(store_id);
	return true;
}

void store_main_menu(const string&in storefront_id)
{
	if (current_player_character != "stefan" && current_player_character != "annie" && current_player_character != "ilana")
	{
		p.play_stationary(get_sound_path("misc/error.ogg"), false);
		speak(tr("game.select_character_first"));
		return;
	}

	init_stores();
	load_all_items_config();
	load_player_store_inventory();
	init_storefronts();
	if (store_configs.length() == 0)
	{
		speak(tr("store.no_categories"));
		return;
	}
	storefront_cfg@ storefront = get_storefront(storefront_id);
	if (storefront is null)
	{
		speak(tr("store_point.store_missing"));
		return;
	}
	int[] visible_categories;
	for (uint c = 0; c < storefront.categories.length(); c++)
		for (uint i = 0; i < store_configs.length(); i++)
			if (store_configs[i].name == storefront.categories[c]) { visible_categories.insert_last(int(i)); break; }
	if (visible_categories.length() == 0) { speak(tr("store.no_categories")); return; }

	while (key_down(KEY_RETURN) || key_down(KEY_NUMPAD_ENTER) || kb_down("use") || kb_down("menu_activate"))
	{
		wait(5);
	}

	speak(store_welcome_text(storefront.display_name));

	int category_position = 0;
	int cat = visible_categories[category_position];
	int item = 0;
	bool in_items = false;
	// Nothing is focused when the store opens: the first category is only
	// selected after the player presses an arrow, Tab or Enter.
	bool has_category = false;
	store_browse_resize_cart(cat);

	while (true)
	{
		wait(5);
		update_game_world();

		if (key_pressed(KEY_ESCAPE) || kb_pressed("menu_back"))
		{
			play("menuclick");
			return;
		}

		if (key_pressed(KEY_TAB))
		{
			if (!has_category)
			{
				has_category = true;
				category_position = 0;
				cat = visible_categories[category_position];
				in_items = false;
			}
			store_cfg@ s = store_configs[cat];
			if (s.item_names.length() == 0)
			{
				speak(tr("store.category_no_items", {s.display_name}));
			}
			else
			{
				in_items = !in_items;
				item = 0;
				play("menuclick");
				if (in_items) store_browse_announce_item(cat, item);
				else store_browse_announce_category(cat);
			}
			continue;
		}

		if (!in_items)
		{
			if (key_pressed(KEY_UP) || kb_pressed("menu_up"))
			{
				if (!has_category)
				{
					has_category = true;
					category_position = 0;
					cat = visible_categories[category_position];
				}
				else if (category_position > 0) { category_position--; cat = visible_categories[category_position]; }
				else play("menuedge");
				store_browse_announce_category(cat);
			}
			if (key_pressed(KEY_DOWN) || kb_pressed("menu_down"))
			{
				if (!has_category)
				{
					has_category = true;
					category_position = 0;
					cat = visible_categories[category_position];
				}
				else if (category_position < int(visible_categories.length()) - 1) { category_position++; cat = visible_categories[category_position]; }
				else play("menuedge");
				store_browse_announce_category(cat);
			}
			// Left and right do nothing in the category list.
			if (key_pressed(KEY_LEFT) || key_pressed(KEY_RIGHT))
			{
				play("menuedge");
			}
			if (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER) || kb_pressed("menu_activate"))
			{
				has_category = true;
				store_cfg@ s = store_configs[cat];
				if (s.item_names.length() == 0) speak(tr("store.category_no_items", {s.display_name}));
				else
				{
					in_items = true;
					item = 0;
					store_browse_announce_item(cat, item);
				}
			}
			continue;
		}

		store_cfg@ s = store_configs[cat];
		if (s.item_names.length() == 0)
		{
			in_items = false;
			continue;
		}
		if (item >= int(s.item_names.length())) item = int(s.item_names.length()) - 1;
		if (item < 0) item = 0;

		if (key_pressed(KEY_UP) || kb_pressed("menu_up"))
		{
			if (item > 0) item--;
			else play("menuedge");
			store_browse_announce_item(cat, item);
		}
		if (key_pressed(KEY_DOWN) || kb_pressed("menu_down"))
		{
			if (item < int(s.item_names.length()) - 1) item++;
			else play("menuedge");
			store_browse_announce_item(cat, item);
		}
		if (key_pressed(KEY_RIGHT) || kb_pressed("menu_right"))
		{
			string currency = store_charge_currency(s);
			int price = int(stn(s.item_prices[item]));
			int spent = 0;
			for (uint ci = 0; ci < s.item_names.length(); ci++) spent += int(stn(s.item_prices[ci])) * store_browse_amounts[cat][ci];
			if (get_item_count(currency) - spent >= price)
			{
				store_browse_amounts[cat][item]++;
				speak("" + store_browse_amounts[cat][item]);
				play("menuenter");
			}
			else
			{
				play_store_error();
				speak(tr("store.not_enough_currency_short", {currency}));
			}
		}
		if (key_pressed(KEY_LEFT) || kb_pressed("menu_left"))
		{
			if (store_browse_amounts[cat][item] > 0)
			{
				store_browse_amounts[cat][item]--;
				speak("" + store_browse_amounts[cat][item]);
				play("menuclick");
			}
			else
			{
				play_store_error();
				speak(tr("store.nothing_in_cart_for_item"));
			}
		}
		if (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER) || kb_pressed("menu_activate"))
		{
			store_browse_buy(cat);
		}
		if (key_pressed(KEY_F1)) speak(store_cart_balances_text());
		if (key_pressed(KEY_F2))
		{
			int total_items = 0;
			int total_cost = 0;
			for (uint ci = 0; ci < s.item_names.length(); ci++)
			{
				total_items += store_browse_amounts[cat][ci];
				total_cost += int(stn(s.item_prices[ci])) * store_browse_amounts[cat][ci];
			}
			if (total_items == 0) speak(tr("store.empty_cart"));
			else speak(tr("store.items_in_cart_total", {"" + total_items, "" + total_cost, currency_display_name(store_charge_currency(s))}));
		}
	}
}
