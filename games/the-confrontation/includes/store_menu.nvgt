// store_menu.nvgt - The single store, opened from the main menu.
//
// The store is not tied to any map: it is one place, opened from the main menu.
// Its categories are the store configurations in settings/stores. Every item of
// a category is charged in that category's own currency.
//
//   Up / Down   - move between categories (the first press selects the first
//                 category; nothing is selected when the store opens)
//   Tab         - open the items of the selected category (Tab again returns)
//   Up / Down   - in the item list, move between items
//   Right       - add one unit of the item to the cart
//   Left        - remove one unit of the item from the cart
//   Enter       - buy everything in the cart (or open a category)
//   F1          - speak the currency balances
//   F2          - speak the cart total
//   Escape      - leave the store
//
// Everything is local and offline: the cart is checked against the player's
// inventory balances, the currency is deducted and the items are granted
// immediately. No item carries its own payment method; the store's currency
// charges the whole cart.

const string CURRENCY_GOLD = "gold";
const string CURRENCY_GOLDEN_CRYSTAL = "golden_crystal";
const string CURRENCY_DIAMOND = "diamond";
const string CURRENCY_SILVER = "silver";
string[] store_currencies = {CURRENCY_GOLD, CURRENCY_GOLDEN_CRYSTAL, CURRENCY_DIAMOND, CURRENCY_SILVER};

bool is_valid_store_currency(string cur)
{
	for (uint i = 0; i < store_currencies.length(); i++)
	{
		if (store_currencies[i] == cur) return true;
	}
	return false;
}

// Currencies are identified by their canonical id: gold, golden_crystal,
// diamond, silver. The only normalization is case and surrounding whitespace;
// no other spelling is treated as a currency.
string normalize_currency(string cur)
{
	return string_to_lower_case(string_trim_sides(cur));
}

// Resolves the inventory/balance key for a currency item: the item's id when
// it is one of the four native currencies (gold, golden crystal, diamond,
// silver), otherwise its subtype (so a custom item like "gold_pouch" with
// subtype "gold" still credits the gold balance).
string currency_key_for_item(item_data@ it)
{
	if (it is null) return "";
	string by_id = normalize_currency(it.id);
	if (is_valid_store_currency(by_id)) return by_id;
	string by_sub = normalize_currency(it.subtype);
	if (is_valid_store_currency(by_sub)) return by_sub;
	return it.id;
}

string store_cart_balances_text()
{
	return "Balances: " + get_item_count(CURRENCY_GOLD) + " gold, " + get_item_count(CURRENCY_GOLDEN_CRYSTAL) + " golden crystals, " + get_item_count(CURRENCY_DIAMOND) + " diamonds, " + get_item_count(CURRENCY_SILVER) + " silver.";
}

// Grants a bought product and reports whether the item exists in the registry,
// so a cart that names a missing item is refunded instead of half-delivered.
bool store_grant_product(const string&in product, int quantity)
{
	load_all_items_config();
	load_all_weapons_wpm();
	load_all_packages();
	if (find_item_data(product) is null && find_weapon_data(product) is null && find_package_data(product) is null) return false;
	give(product, quantity);
	return true;
}

// The currency every item of this store is charged in. store_finalize_currencies()
// settles it to one of the four native ids when the store is loaded or saved.
string store_charge_currency(store_cfg@ s)
{
	return normalize_currency(s.currency);
}

// ---------------------------------------------------------------------------
// Main menu store
// ---------------------------------------------------------------------------
int[][] store_browse_amounts;

void store_browse_resize_cart(int cat)
{
	store_browse_amounts.resize(store_configs.length());
	int n = int(store_configs[cat].item_names.length());
	if (int(store_browse_amounts[cat].length()) != n) store_browse_amounts[cat].resize(n);
}

void store_browse_announce_category(int cat)
{
	store_cfg@ s = store_configs[cat];
	store_browse_resize_cart(cat);
	speak(s.display_name + ", category " + (cat + 1) + " of " + store_configs.length() + ", " + s.item_names.length() + " items. Press Tab to browse the items of this category.");
}

void store_browse_announce_item(int cat, int item)
{
	store_cfg@ s = store_configs[cat];
	string iname = get_item_display_name(s.item_names[item]);
	speak(iname + ", " + s.item_prices[item] + " " + store_charge_currency(s) + ", in the cart: " + store_browse_amounts[cat][item] + ".");
}

void store_browse_buy(int cat)
{
	store_cfg@ s = store_configs[cat];
	string currency = store_charge_currency(s);
	int total_cost = 0;
	int total_items = 0;
	for (uint i = 0; i < s.item_names.length(); i++)
	{
		int q = store_browse_amounts[cat][i];
		if (q <= 0) continue;
		total_cost += int(stn(s.item_prices[i])) * q;
		total_items += q;
	}
	if (total_items == 0)
	{
		speak("Your cart is empty.");
		return;
	}
	int balance = get_item_count(currency);
	if (balance < total_cost)
	{
		string err_snd = get_sound_path("misc/error.ogg;error.ogg");
		if (err_snd != "") p.play_stationary(err_snd, false);
		speak("You don't have enough " + currency + ". You need " + total_cost + " and have " + balance + ".");
		return;
	}

	give(currency, -total_cost);
	string summary = "";
	for (uint i = 0; i < s.item_names.length(); i++)
	{
		int q = store_browse_amounts[cat][i];
		if (q <= 0) continue;
		if (!store_grant_product(s.item_names[i], q))
		{
			give(currency, total_cost);
			speak("The purchase could not be delivered; your payment was returned.");
			return;
		}
		store_browse_amounts[cat][i] = 0;
		if (summary != "") summary += ", ";
		summary += q + " " + get_item_display_name(s.item_names[i]);
	}

	string buy_snd = get_sound_path("player/storepurchase.ogg;items/buy.ogg;items/storepurchase.ogg;storepurchase.ogg;buy.ogg");
	if (buy_snd != "") p.play_stationary(buy_snd, false);
	speak("Purchased " + summary + " for " + total_cost + " " + currency + ".");
}

// Gives the medical and ammunition shelves a starting stock taken from the item
// registry, so the store is usable before the builder edits it. Categories that
// already have items are left untouched.
void store_fill_default_items()
{
	load_all_items_config();
	for (uint i = 0; i < store_configs.length(); i++)
	{
		store_cfg@ s = store_configs[i];
		if (s.item_names.length() > 0) continue;
		string want = (s.name == "medical") ? "medical items" : ((s.name == "ammunition") ? "ammo" : "");
		if (want == "") continue;
		for (uint r = 0; r < item_registry.length(); r++)
		{
			if (item_registry[r].category != want) continue;
			s.item_names.insert_last(item_registry[r].id);
			s.item_prices.insert_last((want == "ammo") ? "5" : "100");
		}
	}
}

string store_welcome_text()
{
	return "Welcome to the store! What would you like to buy today? Select items in one of the available categories.";
}

void store_main_menu()
{
	init_stores();
	load_all_items_config();
	store_fill_default_items();
	if (store_configs.length() == 0)
	{
		speak("The store has no categories yet.");
		return;
	}

	while (key_down(KEY_RETURN) || key_down(KEY_NUMPAD_ENTER) || kb_down("use") || kb_down("menu_activate"))
	{
		wait(5);
	}

	speak(store_welcome_text());

	int cat = 0;
	int item = 0;
	bool in_items = false;
	// Nothing is focused when the store opens: the first category is only
	// selected after the player presses an arrow, Tab or Enter.
	bool has_category = false;
	store_browse_resize_cart(cat);

	while (true)
	{
		wait(5);
		update_game_world();

		if (key_pressed(KEY_ESCAPE) || kb_pressed("menu_back"))
		{
			play("menuclick");
			return;
		}

		if (key_pressed(KEY_TAB))
		{
			if (!has_category)
			{
				has_category = true;
				cat = 0;
				in_items = false;
			}
			store_cfg@ s = store_configs[cat];
			if (s.item_names.length() == 0)
			{
				speak(s.display_name + " has no items.");
			}
			else
			{
				in_items = !in_items;
				item = 0;
				play("menuclick");
				if (in_items) store_browse_announce_item(cat, item);
				else store_browse_announce_category(cat);
			}
			continue;
		}

		if (!in_items)
		{
			if (key_pressed(KEY_UP) || kb_pressed("menu_up"))
			{
				if (!has_category)
				{
					has_category = true;
					cat = 0;
				}
				else if (cat > 0) cat--;
				else play("menuedge");
				store_browse_announce_category(cat);
			}
			if (key_pressed(KEY_DOWN) || kb_pressed("menu_down"))
			{
				if (!has_category)
				{
					has_category = true;
					cat = 0;
				}
				else if (cat < int(store_configs.length()) - 1) cat++;
				else play("menuedge");
				store_browse_announce_category(cat);
			}
			// Left and right do nothing in the category list.
			if (key_pressed(KEY_LEFT) || key_pressed(KEY_RIGHT))
			{
				play("menuedge");
			}
			if (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER) || kb_pressed("menu_activate"))
			{
				has_category = true;
				store_cfg@ s = store_configs[cat];
				if (s.item_names.length() == 0) speak(s.display_name + " has no items.");
				else
				{
					in_items = true;
					item = 0;
					store_browse_announce_item(cat, item);
				}
			}
			continue;
		}

		store_cfg@ s = store_configs[cat];
		if (s.item_names.length() == 0)
		{
			in_items = false;
			continue;
		}
		if (item >= int(s.item_names.length())) item = int(s.item_names.length()) - 1;
		if (item < 0) item = 0;

		if (key_pressed(KEY_UP) || kb_pressed("menu_up"))
		{
			if (item > 0) item--;
			else play("menuedge");
			store_browse_announce_item(cat, item);
		}
		if (key_pressed(KEY_DOWN) || kb_pressed("menu_down"))
		{
			if (item < int(s.item_names.length()) - 1) item++;
			else play("menuedge");
			store_browse_announce_item(cat, item);
		}
		if (key_pressed(KEY_RIGHT) || kb_pressed("menu_right"))
		{
			string currency = store_charge_currency(s);
			int price = int(stn(s.item_prices[item]));
			int spent = 0;
			for (uint ci = 0; ci < s.item_names.length(); ci++) spent += int(stn(s.item_prices[ci])) * store_browse_amounts[cat][ci];
			if (get_item_count(currency) - spent >= price)
			{
				store_browse_amounts[cat][item]++;
				speak("" + store_browse_amounts[cat][item]);
				play("menuenter");
			}
			else
			{
				speak("You don't have enough " + currency + ".");
				p.play_stationary(get_sound_path("misc/error.ogg"), false);
			}
		}
		if (key_pressed(KEY_LEFT) || kb_pressed("menu_left"))
		{
			if (store_browse_amounts[cat][item] > 0)
			{
				store_browse_amounts[cat][item]--;
				speak("" + store_browse_amounts[cat][item]);
				play("menuclick");
			}
			else
			{
				speak("Nothing in the cart for this item.");
				p.play_stationary(get_sound_path("misc/error.ogg"), false);
			}
		}
		if (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER) || kb_pressed("menu_activate"))
		{
			store_browse_buy(cat);
		}
		if (key_pressed(KEY_F1)) speak(store_cart_balances_text());
		if (key_pressed(KEY_F2))
		{
			int total_items = 0;
			int total_cost = 0;
			for (uint ci = 0; ci < s.item_names.length(); ci++)
			{
				total_items += store_browse_amounts[cat][ci];
				total_cost += int(stn(s.item_prices[ci])) * store_browse_amounts[cat][ci];
			}
			if (total_items == 0) speak("Your cart is empty.");
			else speak("" + total_items + " items in the cart, total: " + total_cost + " " + store_charge_currency(s) + ".");
		}
	}
}
