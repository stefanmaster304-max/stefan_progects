// builder/misc/npc_spawner_builder.nvgt - NPC spawner form.
//
// The map stores a single consolidated line for selected NPCs:
// npcspawner:<npc id(s)>:<count>:<respawn>:<min x>:<min y>:<min z>:<max x>:<max y>:<max z>:<respawn_after_death>
//
// Any number of NPCs can be checked at once; they are saved in a single line.
// The area is the volume the NPCs spawn in and are allowed to walk in.
// If "respawn after death" is checked, a dead NPC is replaced only after the
// configured respawn time counted in milliseconds from its death. A count of
// zero removes those NPCs from the map.

void build_npc_spawner()
{
	load_all_npcs();
	if (npc_registry.length() == 0)
	{
		speak("No NPCs found. Create one in the NPC manager first.");
		dlg("No NPCs found in " + NPC_DIR + ". Create one in the NPC manager first.");
		return;
	}

	audio_form f;
	f.create_window(tr("builder.npc_spawner_title"), false, true, false);
	int list = f.create_list("NPCs to place on this map (Space to check/uncheck)", 0, true, true);
	for (uint i = 0; i < npc_registry.length(); i++)
	{
		npc_data@ n = npc_registry[i];
		f.add_list_item(list, n.name + " (" + n.id + ", " + n.npc_class + ")", n.id, -1, false, (i == 0));
	}

	int i_count = f.create_input_box("How many of each selected NPC should live in this area (0 removes it, maximum " + NPC_MAX_PER_SPAWNER + ")", "1");
	int i_respawn = f.create_input_box("Respawn time after death in milliseconds", "30000");
	int cb_respawn_after_death = f.create_checkbox("Only respawn after death", true);
	int i_minx = f.create_input_box(tr("form.min_x"), "" + int(minx));
	int i_maxx = f.create_input_box(tr("form.max_x"), "" + int(maxx));
	int i_miny = f.create_input_box(tr("form.min_y"), "" + int(miny));
	int i_maxy = f.create_input_box(tr("form.max_y"), "" + int(maxy));
	int i_minz = f.create_input_box(tr("form.min_z"), "" + int(round(me.z, 0)));
	int i_maxz = f.create_input_box(tr("form.max_z"), "" + int(round(me.z, 0)));
	f.set_disallowed_chars(i_count, "0123456789", true, "Numbers only.");
	f.set_disallowed_chars(i_respawn, "0123456789", true, "Numbers only.");
	f.set_disallowed_chars(i_minx, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_maxx, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_miny, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_maxy, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_minz, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_maxz, "0123456789-", true, "Numbers only.");
	int btn_ok = f.create_button("&" + tr("builder.save_spawner"), true);
	int btn_cancel = f.create_button("&" + tr("ui.cancel"), false, true);
	f.set_default_controls(btn_ok, btn_cancel);
	f.focus(list);

	while (true)
	{
		wait(5);
		update_game_world();
		f.monitor();

		if (key_pressed(KEY_ESCAPE) || f.is_pressed(btn_cancel))
		{
			speak(tr("ui.cancel"));
			return;
		}

		if (f.is_pressed(btn_ok))
		{
			int[]@ checked = f.get_checked_list_items(list);
			if (checked is null || checked.length() == 0)
			{
				speak("Select at least one NPC with Space.");
				f.focus(list);
				continue;
			}

			int count = int(string_to_number(f.get_text(i_count)));
			int respawn_ms = int(string_to_number(f.get_text(i_respawn)));
			int x0 = int(string_to_number(f.get_text(i_minx)));
			int x1 = int(string_to_number(f.get_text(i_maxx)));
			int y0 = int(string_to_number(f.get_text(i_miny)));
			int y1 = int(string_to_number(f.get_text(i_maxy)));
			int z0 = int(string_to_number(f.get_text(i_minz)));
			int z1 = int(string_to_number(f.get_text(i_maxz)));
			bool respawn_after_death = f.is_checked(cb_respawn_after_death);
			if (count < 0) count = 0;
			if (count > NPC_MAX_PER_SPAWNER)
			{
				count = NPC_MAX_PER_SPAWNER;
				speak("A single spawner holds at most " + NPC_MAX_PER_SPAWNER + " NPCs of each type; the count was lowered.");
			}
			if (respawn_ms < 0) respawn_ms = 0;

			string joined_ids = "";
			for (uint c = 0; c < checked.length(); c++)
			{
				int pos = checked[c];
				if (pos < 0 || pos >= int(npc_registry.length())) continue;
				if (joined_ids != "") joined_ids += ",";
				joined_ids += npc_registry[uint(pos)].id;
			}
			npc_save_spawner_to_map(joined_ids, count, respawn_ms, x0, y0, z0, x1, y1, z1, respawn_after_death, true);
			return;
		}
	}
}
