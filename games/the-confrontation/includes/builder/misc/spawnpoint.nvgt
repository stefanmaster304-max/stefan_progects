// includes/builder/misc/spawnpoint.nvgt - Spawnpoint builder and state

int map_spawn_x = 0;
int map_spawn_y = 0;
int map_spawn_z = 0;
bool has_map_spawnpoint = false;

void set_map_spawnpoint(int x, int y, int z)
{
	map_spawn_x = x;
	map_spawn_y = y;
	map_spawn_z = z;
	has_map_spawnpoint = true;
}

void build_spawnpoint()
{
	int sx = int(round(me.x, 0));
	int sy = int(round(me.y, 0));
	int sz = int(round(me.z, 0));
	save_to_map("spawnpoint:" + sx + ":" + sy + ":" + sz);
}
