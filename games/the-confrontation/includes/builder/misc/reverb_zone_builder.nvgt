// builder/misc/reverb_zone_builder.nvgt - Reverb zone construction form.
//
// Only reverb exists in this builder. Every adjustable control is a slider and
// every slider maps to a native king_audio_engine reverb parameter. A list of
// reverb types sets all the sliders at once, and a platform sound list loops a
// real surface through a dedicated mixer so the effect is heard while it is
// being tuned, not only after the zone is saved.

const int REVERB_PARAM_COUNT = 13;

string[] reverb_preset_names = {
	"room",
	"small room",
	"long room",
	"hall",
	"cathedral",
	"cave",
	"bathroom",
	"arena",
	"hangar",
	"forest",
	"tunnel",
	"underwater"
};

// One block of REVERB_PARAM_COUNT values per preset, in the same order as the
// sliders: decay, wet, dry, diffusion, density, early, late, high frequency
// reference, high frequency decay ratio, low shelf frequency, low shelf gain,
// high cut, early to late mix.
double[] reverb_preset_values = {
	1500, -6,  -6, 80, 65,  8, 16, 5000, 60, 250,  0,  9000, 60,
	 700, -8,  -3, 85, 70,  4,  8, 6500, 70, 250,  0, 10000, 70,
	2600, -5,  -8, 78, 60, 12, 30, 4500, 55, 250,  1,  8500, 50,
	3500, -4, -10, 85, 70, 15, 35, 4000, 50, 200,  2,  8000, 45,
	8000, -3, -12, 92, 80, 25, 60, 3500, 40, 180,  3,  7000, 35,
	5000, -4, -14, 70, 55, 20, 50, 2500, 45, 120,  5,  5000, 40,
	 900, -4,  -4, 95, 85,  3,  6, 8000, 80, 300, -2, 12000, 75,
	4500, -4, -10, 90, 75, 18, 40, 4500, 55, 250,  1,  9000, 50,
	6000, -4, -10, 88, 70, 22, 45, 4000, 45, 220,  2,  7500, 45,
	1800, -7,  -8, 60, 40, 12, 25, 3000, 35, 300, -2,  6000, 55,
	3200, -4, -12, 65, 50, 30, 25, 3000, 40, 200,  0,  6000, 30,
	4000, -4, -20, 50, 45, 25, 55, 2000, 30, 150,  6,  3000, 35
};

string[] reverb_zone_sound_options()
{
	return platform_surface_options();
}

// The preview has its own mixer so the reverb can be changed live without
// touching anything the world is playing.
mixer reverb_preview_mixer;

void reverb_preview_apply(double[]@ v)
{
	if (v is null || v.length() < uint(REVERB_PARAM_COUNT)) return;
	reverb_preview_mixer.set_reverb(
		float(v[0]), float(v[1]), float(v[2]), float(v[3]), float(v[4]),
		float(v[5]), float(v[6]), float(v[7]), float(v[8]), float(v[9]),
		float(v[10]), float(v[11]), float(v[12]));
}

bool reverb_preview_start(const string&in path)
{
	if (path == "") return false;
	builder_preview_sound.close();
	bool ok = builder_preview_sound.load(path);
	if (!ok) ok = builder_preview_sound.stream(path);
	if (!ok) return false;
	builder_preview_sound.set_mixer(reverb_preview_mixer);
	builder_preview_sound.volume = 0.0;
	builder_preview_sound.pitch = 100.0;
	builder_preview_sound.play_looped();
	return true;
}

void build_reverb_zone()
{
	string[] sound_options = reverb_zone_sound_options();

	int saved_x1 = minx, saved_x2 = maxx;
	int saved_y1 = miny, saved_y2 = maxy;
	int saved_z1 = minz, saved_z2 = maxz;

	string[] labels = {
		"reverb decay time in milliseconds",
		"reverb wet volume in decibels",
		"reverb dry volume in decibels",
		"reverb diffusion",
		"reverb density",
		"reverb early reflection delay in milliseconds",
		"reverb late reflection delay in milliseconds",
		"reverb high frequency reference in hertz",
		"reverb high frequency decay ratio",
		"reverb low shelf frequency in hertz",
		"reverb low shelf gain in decibels",
		"reverb high cut frequency in hertz",
		"reverb early to late mix"
	};
	double[] defaults = {1500, -6, -80, 80, 60, 5, 10, 5000, 50, 250, 0, 8000, 60};
	double[] minimums = {100, -60, -80, 0, 0, 0, 0, 1000, 10, 20, -24, 500, 0};
	double[] maximums = {10000, 0, 0, 100, 100, 200, 200, 20000, 200, 1000, 24, 20000, 100};
	double[] steps = {50, 1, 1, 1, 1, 1, 1, 100, 1, 10, 1, 100, 1};

	audio_form f;
	f.create_window("Reverb Zone", false, true, false);

	int i_x1 = f.create_input_box("minimum x", "" + saved_x1);
	int i_x2 = f.create_input_box("maximum x", "" + saved_x2);
	int i_y1 = f.create_input_box("minimum y", "" + saved_y1);
	int i_y2 = f.create_input_box("maximum y", "" + saved_y2);
	int i_z1 = f.create_input_box("minimum z", "" + saved_z1);
	int i_z2 = f.create_input_box("maximum z", "" + saved_z2);
	f.set_disallowed_chars(i_x1, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_x2, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_y1, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_y2, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_z1, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_z2, "0123456789-", true, "Numbers only.");

	int list_preset = f.create_list("reverb type (choosing one sets every slider below)");
	f.add_list_item(list_preset, "custom");
	for (uint i = 0; i < reverb_preset_names.length(); i++)
		f.add_list_item(list_preset, reverb_preset_names[i]);

	int list_sound_preview = f.create_list("platform sound to loop while tuning (Space to start or stop)");
	f.add_list_item(list_sound_preview, "none", "none");
	for (uint i = 0; i < sound_options.length(); i++)
		f.add_list_item(list_sound_preview, sound_options[i], sound_options[i]);

	int[] sliders;
	for (uint s = 0; s < labels.length(); s++)
	{
		int ctrl = f.create_slider(labels[s], defaults[s], minimums[s], maximums[s], "", steps[s]);
		sliders.insert_last(ctrl);
	}

	int btn_ok = f.create_button("&add reverb zone", true);
	int btn_cancel = f.create_button("&cancel", false, true);
	f.set_default_controls(btn_ok, btn_cancel);
	f.focus_silently(i_x1);

	bool preview_playing = false;
	int last_sound_pos = 0;
	int last_preset_pos = 0;
	timer space_preview_timer;

	double[] last_values(REVERB_PARAM_COUNT);
	bool values_valid = false;

	while (true)
	{
		wait(5);
		update_game_world();
		f.monitor();

		// A preset fills every slider. The change is picked up by the value
		// comparison below and applied to the loop at once.
		int preset_pos = f.get_list_position(list_preset);
		if (preset_pos != last_preset_pos)
		{
			last_preset_pos = preset_pos;
			if (preset_pos > 0 && preset_pos <= int(reverb_preset_names.length()))
			{
				for (uint i = 0; i < sliders.length() && i < uint(REVERB_PARAM_COUNT); i++)
					f.set_slider(sliders[i], reverb_preset_values[(preset_pos - 1) * REVERB_PARAM_COUNT + int(i)]);
			}
		}

		// Read the sliders and reconfigure the preview reverb only when a value
		// actually changed, so dragging a slider is heard immediately.
		double[] values(REVERB_PARAM_COUNT);
		bool changed = !values_valid;
		for (uint i = 0; i < sliders.length() && i < uint(REVERB_PARAM_COUNT); i++)
		{
			values[i] = f.get_slider(sliders[i]);
			if (!values_valid || values[i] != last_values[i]) changed = true;
			last_values[i] = values[i];
		}
		if (changed)
		{
			values_valid = true;
			reverb_preview_apply(values);
		}

		int cur_pos = f.get_list_position(list_sound_preview);
		if (cur_pos != last_sound_pos)
		{
			last_sound_pos = cur_pos;
			if (preview_playing)
			{
				builder_preview_sound.close();
				preview_playing = false;
			}
			if (cur_pos > 0 && cur_pos <= int(sound_options.length()))
			{
				string snd = get_platform_sound(sound_options[cur_pos - 1], "step");
				if (snd != "")
					preview_playing = reverb_preview_start(snd);
			}
		}

		if ((key_pressed(KEY_SPACE) || key_down(KEY_SPACE)) && f.get_current_focus() == list_sound_preview)
		{
			if (key_pressed(KEY_SPACE) || space_preview_timer.elapsed >= 300)
			{
				space_preview_timer.restart();
				if (preview_playing)
				{
					builder_preview_sound.close();
					preview_playing = false;
				}
				else if (cur_pos > 0 && cur_pos <= int(sound_options.length()))
				{
					string snd = get_platform_sound(sound_options[cur_pos - 1], "step");
					if (snd != "") preview_playing = reverb_preview_start(snd);
				}
			}
		}

		if (key_pressed(KEY_ESCAPE) || f.is_pressed(btn_cancel))
		{
			builder_preview_sound.close();
			preview_playing = false;
			speak("canceled");
			return;
		}

		if (f.is_pressed(btn_ok))
		{
			string tx1 = f.get_text(i_x1);
			string tx2 = f.get_text(i_x2);
			string ty1 = f.get_text(i_y1);
			string ty2 = f.get_text(i_y2);
			string tz1 = f.get_text(i_z1);
			string tz2 = f.get_text(i_z2);
			if (tx1 == "" || tx2 == "" || ty1 == "" || ty2 == "" || tz1 == "" || tz2 == "")
			{
				speak("Coordinates cannot be empty.");
				continue;
			}

			builder_preview_sound.close();
			preview_playing = false;

			string line = "reverbzone:" + tx1 + ":" + tx2 + ":" + ty1 + ":" + ty2 + ":" + tz1 + ":" + tz2;
			for (uint s2 = 0; s2 < sliders.length(); s2++)
				line += ":" + f.get_slider(sliders[s2]);

			save_to_map(line);
			return;
		}
	}
}
