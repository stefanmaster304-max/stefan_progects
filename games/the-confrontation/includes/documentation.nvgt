// documentation.nvgt - In-game documentation viewer (readme, changes) using native NVGT audio_form notepad.

const string DOC_README_PATH = "settings/docs/readme.txt";
const string DOC_CHANGES_PATH = "settings/docs/changes.txt";

void open_documentation_notepad(const string&in title, const string&in file_path)
{
	file f;
	if (!f.open(file_path, "rb"))
	{
		speak(tr("documentation.error_opening"));
		return;
	}
	string content = f.read();
	f.close();

	pause_main_menu_music();

	while (key_down(KEY_RETURN) || key_down(KEY_NUMPAD_ENTER) || kb_down("use") || kb_down("menu_activate"))
	{
		wait(5);
	}

	audio_form df;
	df.create_window(title, false, true, false);
	int txt = df.create_input_box(title, content, "", 0, true, true, false);
	int btn_copy = df.create_button("&" + tr("ui.copy"));
	int btn_close = df.create_button("&" + tr("ui.close"), false, true);
	df.focus(txt);
	while (true)
	{
		wait(5);
		update_game_world();
		df.monitor();
		if (key_pressed(KEY_ESCAPE) || df.is_pressed(btn_close)) break;
		if (df.is_pressed(btn_copy))
		{
			clipboard_copy_text(content);
			speak(tr("ui.copied"));
		}
	}

	while (key_down(KEY_ESCAPE) || kb_down("menu_back"))
	{
		wait(5);
	}

	resume_main_menu_music();
}

void open_documentation_file(const string&in title, const string&in file_path)
{
	open_documentation_notepad(title, file_path);
}

void documentation_menu()
{
	while (key_down(KEY_RETURN) || key_down(KEY_NUMPAD_ENTER) || kb_down("use") || kb_down("menu_activate"))
	{
		wait(5);
	}

	while (true)
	{
		audio_form doc_form;
		doc_form.create_window(tr("documentation.title"), false, true, false);
		int dl = doc_form.create_list(tr("documentation.options"), 0, false, true);
		doc_form.add_list_item(dl, tr("documentation.file_changes"), "changes");
		doc_form.add_list_item(dl, tr("documentation.file_readme"), "readme");
		int select_btn = doc_form.create_button("&" + tr("ui.select"), true);
		int back_btn = doc_form.create_button("&" + tr("ui.back"), false, true);
		doc_form.focus(dl);

		bool exit_doc = false;
		while (true)
		{
			wait(5);
			update_game_world();
			doc_form.monitor();
			if (key_pressed(KEY_ESCAPE) || doc_form.is_pressed(back_btn))
			{
				exit_doc = true;
				break;
			}
			if (doc_form.is_pressed(select_btn))
			{
				int pos = doc_form.get_list_position(dl);
				if (pos == 0)
				{
					string changes_file = "";
					if (file_exists("settings/docs/changes.txt")) changes_file = "settings/docs/changes.txt";
					else if (file_exists("docs/changes.txt")) changes_file = "docs/changes.txt";
					else if (file_exists("changes.txt")) changes_file = "changes.txt";

					if (changes_file != "")
					{
						open_documentation_notepad(tr("documentation.file_changes"), changes_file);
					}
					else
					{
						speak(tr("documentation.changes_not_found"));
					}
					break;
				}
				else if (pos == 1)
				{
					string readme_file = "";
					if (file_exists("settings/docs/readme.txt")) readme_file = "settings/docs/readme.txt";
					else if (file_exists("docs/readme.txt")) readme_file = "docs/readme.txt";
					else if (file_exists("readme.txt")) readme_file = "readme.txt";
					else if (file_exists("settings/docs/LEIAME.txt")) readme_file = "settings/docs/LEIAME.txt";
					else if (file_exists("docs/LEIAME.txt")) readme_file = "docs/LEIAME.txt";
					else if (file_exists("LEIAME.txt")) readme_file = "LEIAME.txt";
					else if (file_exists("settings/docs/leame.txt")) readme_file = "settings/docs/leame.txt";
					else if (file_exists("docs/leame.txt")) readme_file = "docs/leame.txt";
					else if (file_exists("leame.txt")) readme_file = "leame.txt";

					if (readme_file != "")
					{
						open_documentation_notepad(tr("documentation.file_readme"), readme_file);
					}
					else
					{
						speak(tr("documentation.readme_not_found"));
					}
					break;
				}
			}
		}
		if (exit_doc) break;
	}

	while (key_down(KEY_ESCAPE) || kb_down("menu_back"))
	{
		wait(5);
	}
}

void game_documentation_menu()
{
	documentation_menu();
}

void player_options_menu()
{
	documentation_menu();
}
