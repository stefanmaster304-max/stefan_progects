/* documentation.nvgt - In-game documentation viewer (readme, changes) using native NVGT audio_form notepad. */

const string DOC_README_PATH = "settings/docs/readme.txt";
const string DOC_CHANGES_PATH = "settings/docs/changes.txt";

void open_documentation_notepad(const string&in title, const string&in file_path)
{
	file f;
	if (!f.open(file_path, "rb"))
	{
		speak(tr("documentation.error_opening"));
		return;
	}
	string content = f.read();
	f.close();

	pause_main_menu_music();

	while (key_down(KEY_RETURN) || key_down(KEY_NUMPAD_ENTER) || kb_down("use") || kb_down("menu_activate"))
	{
		wait(5);
	}

	audio_form df;
	df.create_window(title, false, true, false);
	int txt = df.create_input_box(title, content, "", 0, true, true, false);
	int btn_copy = df.create_button("&" + tr("ui.copy"));
	int btn_close = df.create_button("&" + tr("ui.close"), false, true);
	df.focus(txt);
	while (true)
	{
		wait(5);
		update_game_world();
		df.monitor();
		if (key_pressed(KEY_ESCAPE) || df.is_pressed(btn_close)) break;
		if (df.is_pressed(btn_copy))
		{
			clipboard_copy_text(content);
			speak(tr("ui.copied"));
		}
	}

	while (key_down(KEY_ESCAPE) || kb_down("menu_back"))
	{
		wait(5);
	}

	resume_main_menu_music();
}

void open_documentation_file(const string&in title, const string&in file_path)
{
	open_documentation_notepad(title, file_path);
}

void documentation_menu()
{
	while (key_down(KEY_RETURN) || key_down(KEY_NUMPAD_ENTER) || kb_down("use") || kb_down("menu_activate"))
	{
		wait(5);
	}

	while (true)
	{
		audio_form doc_form;
		doc_form.create_window(tr("documentation.title"), false, true, false);
		int dl = doc_form.create_list(tr("documentation.options"), 0, false, true);
		doc_form.add_list_item(dl, tr("documentation.changes_pt"), "changes_pt");
		doc_form.add_list_item(dl, tr("documentation.changes_en"), "changes_en");
		doc_form.add_list_item(dl, tr("documentation.changes_es"), "changes_es");
		doc_form.add_list_item(dl, tr("documentation.readme_pt"), "readme_pt");
		doc_form.add_list_item(dl, tr("documentation.readme_en"), "readme_en");
		doc_form.add_list_item(dl, tr("documentation.readme_es"), "readme_es");
		int select_btn = doc_form.create_button("&" + tr("ui.select"), true);
		int back_btn = doc_form.create_button("&" + tr("ui.back"), false, true);
		doc_form.focus(dl);

		bool exit_doc = false;
		while (true)
		{
			wait(5);
			update_game_world();
			doc_form.monitor();
			if (key_pressed(KEY_ESCAPE) || doc_form.is_pressed(back_btn))
			{
				exit_doc = true;
				break;
			}
			if (doc_form.is_pressed(select_btn))
			{
				int pos = doc_form.get_list_position(dl);
				string target_file = "";
				string title = "";

				if (pos == 0)
				{
					title = tr("documentation.changes_pt");
					if (file_exists("settings/docs/changes_pt.txt")) target_file = "settings/docs/changes_pt.txt";
					else if (file_exists("settings/docs/changes.txt")) target_file = "settings/docs/changes.txt";
					else if (file_exists("docs/changes_pt.txt")) target_file = "docs/changes_pt.txt";
					else if (file_exists("changes.txt")) target_file = "changes.txt";
				}
				else if (pos == 1)
				{
					title = tr("documentation.changes_en");
					if (file_exists("settings/docs/changes_en.txt")) target_file = "settings/docs/changes_en.txt";
					else if (file_exists("docs/changes_en.txt")) target_file = "docs/changes_en.txt";
					else if (file_exists("settings/docs/changes.txt")) target_file = "settings/docs/changes.txt";
				}
				else if (pos == 2)
				{
					title = tr("documentation.changes_es");
					if (file_exists("settings/docs/changes_es.txt")) target_file = "settings/docs/changes_es.txt";
					else if (file_exists("docs/changes_es.txt")) target_file = "docs/changes_es.txt";
					else if (file_exists("settings/docs/changes.txt")) target_file = "settings/docs/changes.txt";
				}
				else if (pos == 3)
				{
					title = tr("documentation.readme_pt");
					if (file_exists("settings/docs/readme_pt.txt")) target_file = "settings/docs/readme_pt.txt";
					else if (file_exists("settings/docs/readme.txt")) target_file = "settings/docs/readme.txt";
					else if (file_exists("settings/docs/LEIAME.txt")) target_file = "settings/docs/LEIAME.txt";
				}
				else if (pos == 4)
				{
					title = tr("documentation.readme_en");
					if (file_exists("settings/docs/readme_en.txt")) target_file = "settings/docs/readme_en.txt";
					else if (file_exists("docs/readme_en.txt")) target_file = "docs/readme_en.txt";
					else if (file_exists("settings/docs/readme.txt")) target_file = "settings/docs/readme.txt";
				}
				else if (pos == 5)
				{
					title = tr("documentation.readme_es");
					if (file_exists("settings/docs/readme_es.txt")) target_file = "settings/docs/readme_es.txt";
					else if (file_exists("docs/readme_es.txt")) target_file = "docs/readme_es.txt";
					else if (file_exists("settings/docs/leame.txt")) target_file = "settings/docs/leame.txt";
					else if (file_exists("settings/docs/readme.txt")) target_file = "settings/docs/readme.txt";
				}

				if (target_file != "" && file_exists(target_file))
				{
					open_documentation_notepad(title, target_file);
				}
				else
				{
					speak(tr("documentation.error_opening"));
				}
				break;
			}
		}
		if (exit_doc) break;
	}

	while (key_down(KEY_ESCAPE) || kb_down("menu_back"))
	{
		wait(5);
	}
}

void game_documentation_menu()
{
	documentation_menu();
}

void player_options_menu()
{
	documentation_menu();
}
