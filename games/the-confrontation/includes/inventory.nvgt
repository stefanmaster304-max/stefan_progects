// inventory.nvgt - Categorized inventory menu and numbered favorite items.

#include "package_manager.nvgt"
#include "shield_system.nvgt"

dictionary inv;

string[] player_favorite_items(10);
string inventory_selected_item = "";
bool inventory_use_pending = false;
bool inventory_closed_by_enter_this_frame = false;
int inventory_category_index = 0;
string[] inventory_categories = {"all", "weapons_ammo", "medical", "currency"};
int inventory_move_sound_index = 0;

void give(string item, int amount)
{
	if (item == "diamond" || item == "silver") return;
	int a;
	if (!inv.exists(item))
	{
		if (amount <= 0) return;
		inv.set(item, amount);
	}
	else
	{
		inv.get(item, a);
		if (a + amount <= 0)
		{
			inv.delete(item);
		}
		else
			inv.set(item, a + amount);
	}
}

int get_item_count(string item)
{
	int amount = 0;
	if (inv.exists(item))
		inv.get(item, amount);
	return amount;
}

int count_total_items()
{
	string[] keys = inv.get_keys();
	return int(keys.length());
}

// Wipes every carried item and favorite assignment. Used when the player
// dies: nothing is carried into the next life.
void clear_player_inventory()
{
	inv.delete_all();
	g_inventory_item_order.resize(0);
	for (uint i = 0; i < player_favorite_items.length(); i++) player_favorite_items[i] = "";
	inventory_selected_item = "";
}

string[] g_inventory_item_order;

void ensure_inventory_item_order(string[]@ keys)
{
	for (uint i = 0; i < keys.length(); i++)
	{
		if (g_inventory_item_order.find(keys[i]) == -1)
		{
			g_inventory_item_order.insert_last(keys[i]);
		}
	}
	for (int i = int(g_inventory_item_order.length()) - 1; i >= 0; i--)
	{
		if (keys.find(g_inventory_item_order[i]) == -1)
		{
			g_inventory_item_order.remove_at(i);
		}
	}
}

string[] get_all_inv_keys()
{
	string[] all_keys = inv.get_keys();
	string[] keys;
	for (uint i = 0; i < all_keys.length(); i++)
	{
		int qty = 0;
		inv.get(all_keys[i], qty);
		if (qty > 0 && keys.find(all_keys[i]) == -1)
		{
			keys.insert_last(all_keys[i]);
		}
	}

	ensure_inventory_item_order(keys);

	string[] ordered;
	for (uint i = 0; i < g_inventory_item_order.length(); i++)
	{
		string item_k = g_inventory_item_order[i];
		if (keys.find(item_k) >= 0)
		{
			ordered.insert_last(item_k);
		}
	}
	return ordered;
}

string serialize_inventory()
{
	string[] keys = inv.get_keys();
	string out_str = "";
	for (uint i = 0; i < keys.length(); i++)
	{
		int qty = 0;
		inv.get(keys[i], qty);
		if (qty > 0)
		{
			if (out_str != "") out_str += ";";
			out_str += keys[i] + ":" + qty;
		}
	}
	return out_str;
}

void deserialize_inventory(const string&in data)
{
	inv.delete_all();
	g_inventory_item_order.resize(0);
	inventory_selected_item = "";
	if (data == "") return;
	string[] pairs = string_split(data, ";", false);
	for (uint i = 0; i < pairs.length(); i++)
	{
		string[] kv = string_split(pairs[i], ":", false);
		if (kv.length() >= 2)
		{
			string item = kv[0];
			if (item == "diamond" || item == "silver") continue;
			int qty = int(string_to_number(kv[1]));
			if (qty > 0) inv.set(item, qty);
		}
	}
}

string get_item_display_name(const string&in item_id)
{
	if (item_id == "gold") return tr("currency.gold");
	if (item_id == "golden_crystal") return tr("currency.golden_crystal");
	weapon_data@ w = find_weapon_data(item_id);
	if (w !is null && w.name != "") return tr("inventory.weapon_prefix") + " " + tr("weapon_names." + item_id, localize_weapon_name(w.name));

	item_data@ it = get_item_data(item_id);
	if (it !is null && it.name != "") return tr("item_names." + item_id, it.name);

	package_data@ pkg = find_package_data(item_id);
	if (pkg !is null && pkg.name != "") return tr("item_names." + item_id, pkg.name);

	return string_replace(item_id, "_", " ", true);
}

string localize_weapon_name(string name)
{
	name = string_replace(name, "_", " ", true);
	string[] terms = {"heavy_machine_gun", "light_machine_gun", "heavy_assault_rifle", "heavy_battle_rifle", "sub_machine_gun", "machine_pistol", "tactical_sniper_rifle", "marksman_rifle", "pump_action_shotgun", "grenade_launcher", "rocket_launcher", "assault_rifle", "battle_rifle", "combat_rifle", "sniper_rifle", "laser_rifle", "shotgun", "carbine", "revolver", "pistol", "rifle", "smg", "sword", "knife", "axe"};
	string[] labels = {"Heavy Machine Gun", "Light Machine Gun", "Heavy Assault Rifle", "Heavy Battle Rifle", "Sub Machine Gun", "Machine Pistol", "Tactical Sniper Rifle", "Marksman Rifle", "Pump Action Shotgun", "Grenade Launcher", "Rocket Launcher", "Assault Rifle", "Battle Rifle", "Combat Rifle", "Sniper Rifle", "Laser Rifle", "Shotgun", "Carbine", "Revolver", "Pistol", "Rifle", "SMG", "Sword", "Knife", "Axe"};
	for (uint i = 0; i < terms.length(); i++)
		name = string_replace(name, labels[i], tr("weapon_terms." + terms[i], labels[i]), true);
	string[] lower_labels = {"sword", "knife", "axe", "shotgun", "sniper", "rifle"};
	string[] lower_terms = {"sword", "knife", "axe", "shotgun", "sniper_rifle", "rifle"};
	for (uint i = 0; i < lower_labels.length(); i++)
		name = string_replace(name, lower_labels[i], tr("weapon_terms." + lower_terms[i], lower_labels[i]), true);
	return name;
}

string get_item_description(const string&in item_id)
{
	item_data@ it = get_item_data(item_id);
	if (it !is null)
	{
		if (it.category == "equipment") return build_equipment_description(it);
		if (it.description != "") return it.description;
	}

	package_data@ pkg = find_package_data(item_id);
	if (pkg !is null && pkg.description != "") return pkg.description;

	weapon_data@ w = find_weapon_data(item_id);
	if (w !is null)
	{
		if (w.description != "") return w.description;
		if (w.melee) return "Melee Weapon. Damage " + w.min_damage + "-" + w.max_damage + ".";
		return "Ranged Weapon. Class: " + w.wclass + ", Capacity: " + w.capacity + " " + w.ammo_display + ", Damage: " + w.min_damage + "-" + w.max_damage + ".";
	}

	return "";
}

// Uses one item. Health-restoring consumables heal only when health is missing;
// shields and weapons are equipped. Nothing is ever dropped.
void use(string item)
{
	if (item == "") return;
	load_all_items_config();
	load_all_weapons_wpm();
	load_all_packages();

	weapon_data@ w = find_weapon_data(item);
	if (w !is null)
	{
		equip_weapon(item);
		return;
	}

	if (is_package(item))
	{
		open_package_by_id(item);
		return;
	}

	if (is_equipment_item(item))
	{
		equip_equipment(item);
		return;
	}

	item_data@ it = get_item_data(item);
	if (it is null)
	{
		speak("Cannot use this item directly.");
		return;
	}

	if (it.subtype == "anti_death_card" || it.id == "anti_death_card")
	{
		speak("The anti-death card is used automatically when your health reaches zero.");
		return;
	}

	if (it.category == "currency")
	{
		return;
	}

	if (it.category == "packages")
	{
		open_package_by_id(item);
		return;
	}

	bool heals = (it.restores_health || it.heal_amount > 0);
	if (!heals)
	{
		speak("Cannot use this item directly.");
		return;
	}

	if (health >= maxhealth)
	{
		speak("Your health is already at maximum.");
		return;
	}

	if (it.sound_use != "")
	{
		string usnd = get_sound_path(it.sound_use);
		if (usnd != "") p.play_stationary(usnd, false);
	}

	health += it.heal_amount;
	if (health > maxhealth) health = maxhealth;
	give(item, -1);
	/* Consumable health potion consumed: sound plays, speech removed */
}

void play_invcat_change_sound()
{
	string snd = "sounds/players/" + current_player_character + "/invcat_change.ogg";
	if (!file_exists(snd)) snd = "sounds/players/hane/invcat_change.ogg";
	if (file_exists(snd)) p.play_stationary(snd, false);
}

bool inventory_item_matches_category(const string&in id, const string&in category)
{
	if (category == "all") return true;
	if (category == "weapons_ammo")
	{
		item_data@ ammo_item = get_item_data(id);
		return find_weapon_data(id) !is null || (ammo_item !is null && (ammo_item.category == "ammo" || ammo_item.category == "ammunition")) || id.find("ammo") >= 0 || id.find("bullet") >= 0 || id.find("shell") >= 0 || id.find("round") >= 0 || id.find("cell") >= 0;
	}
	item_data@ it = get_item_data(id);
	if (category == "medical") return it !is null && (it.restores_health || it.heal_amount > 0 || it.category == "medical");
	if (category == "currency") return id == "gold" || id == "golden_crystal" || (it !is null && it.category == "currency");
	return false;
}

string[] inventory_items_for_category(const string&in category)
{
	string[] all = get_all_inv_keys();
	string[] filtered;
	for (uint i = 0; i < all.length(); i++)
		if (inventory_item_matches_category(all[i], category)) filtered.insert_last(all[i]);
	return filtered;
}

int favorite_slot_for_key(int key)
{
	if (key == KEY_1) return 0;
	if (key == KEY_2) return 1;
	if (key == KEY_3) return 2;
	if (key == KEY_4) return 3;
	if (key == KEY_5) return 4;
	if (key == KEY_6) return 5;
	if (key == KEY_7) return 6;
	if (key == KEY_8) return 7;
	if (key == KEY_9) return 8;
	if (key == KEY_0) return 9;
	return -1;
}

string favorite_slot_label(int slot)
{
	return slot == 9 ? "0" : "" + (slot + 1);
}

string serialize_favorite_items()
{
	string serialized = "";
	for (uint i = 0; i < player_favorite_items.length(); i++)
	{
		if (i > 0) serialized += ";";
		serialized += player_favorite_items[i] == "" ? "-" : player_favorite_items[i];
	}
	return serialized;
}

void deserialize_favorite_items(const string&in data)
{
	for (uint i = 0; i < player_favorite_items.length(); i++) player_favorite_items[i] = "";
	if (data == "") return;
	string[] saved = string_split(data, ";", false);
	for (uint i = 0; i < saved.length() && i < player_favorite_items.length(); i++)
		player_favorite_items[i] = saved[i] == "-" ? "" : saved[i];
}

bool assign_inventory_favorite(int slot, const string&in item_id)
{
	if (slot < 0 || slot >= int(player_favorite_items.length()) || item_id == "") return false;
	if (player_favorite_items[uint(slot)] != "")
	{
		speak(tr("inventory.favorite_occupied", {favorite_slot_label(slot)}));
		return false;
	}
	player_favorite_items[uint(slot)] = item_id;
	save_location();
	speak(tr("inventory.favorite_assigned", {get_item_display_name(item_id), favorite_slot_label(slot)}));
	return true;
}

void use_inventory_favorite(int slot)
{
	if (slot < 0 || slot >= int(player_favorite_items.length())) return;
	string id = player_favorite_items[uint(slot)];
	if (id == "" || get_item_count(id) <= 0)
	{
		if (id != "")
		{
			player_favorite_items[uint(slot)] = "";
			save_location();
		}
		speak(tr("inventory.favorite_empty", {favorite_slot_label(slot)}));
		return;
	}
	use(id);
}

bool handle_favorite_gameplay_key()
{
	int[] number_keys = {KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0};
	for (uint i = 0; i < number_keys.length(); i++)
	{
		int key = number_keys[i];
		if (!key_pressed(key)) continue;
		int slot = favorite_slot_for_key(key);
		if (key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT))
		{
			speak(tr("inventory.favorite_select_item"));
		}
		else use_inventory_favorite(slot);
		return true;
	}
	return false;
}

void play_inventory_effect(const string&in filename)
{
	string path = "sounds/players/" + current_player_character + "/" + filename;
	if (!file_exists(path)) path = "sounds/players/hane/" + filename;
	if (!file_exists(path)) path = "sounds/players/stefan/" + filename;
	if (file_exists(path)) p.play_stationary(path, false);
}

void play_inventory_navigation_sound()
{
	string[] names = {"invmove.ogg", "invmove2.ogg", "invmove3.ogg", "invmove4.ogg", "invmove5.ogg"};
	string name = names[uint(inventory_move_sound_index % int(names.length()))];
	string path = "sounds/players/" + current_player_character + "/" + name;
	if (!file_exists(path)) path = "sounds/players/hane/" + name;
	if (!file_exists(path)) path = "sounds/players/stefan/" + name;
	if (file_exists(path)) p.play_stationary(path, false);
	inventory_move_sound_index++;
}

void speak_inventory_category(const string&in category, const string[]&in items)
{
	int quantity = 0;
	for (uint i = 0; i < items.length(); i++) quantity += get_item_count(items[i]);
	speak(tr("inventory.category_" + category) + ". " + tr("inventory.total_items", {"" + quantity}) + ".");
}

void speak_inventory_item(const string[]&in items, int position)
{
	if (items.length() == 0) { speak(tr("inventory.empty_category")); return; }
	if (position < 0) position = 0;
	if (position >= int(items.length())) position = int(items.length()) - 1;
	string id = items[uint(position)];
	int quantity = get_item_count(id);
	speak(get_item_display_name(id) + ", " + tr("inventory.quantity", {"" + quantity}) + ".");
}

void inventory_menu()
{
	load_all_items_config();
	load_all_weapons_wpm();
	load_all_packages();
	play_inventory_effect("invopen.ogg");
	inventory_use_pending = false;
	inventory_closed_by_enter_this_frame = false;
	int position = 0;
	inventory_selected_item = "";
	string[] items = inventory_items_for_category(inventory_categories[uint(inventory_category_index)]);
	if (items.length() > 0) inventory_selected_item = items[0];
	speak_inventory_category(inventory_categories[uint(inventory_category_index)], items);
	while (true)
	{
		wait(5);
		update_game_world();
		if (key_pressed(KEY_ESCAPE) || kb_pressed("menu_back"))
		{
			play_inventory_effect("invclose.ogg");
			inventory_selected_item = "";
			inventory_use_pending = false;
			return;
		}
		if (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER))
		{
			if (inventory_selected_item == "")
			{
				speak(tr("inventory.favorite_select_item"));
				continue;
			}
			inventory_use_pending = true;
			inventory_closed_by_enter_this_frame = true;
			play_inventory_effect("invclose.ogg");
			return;
		}
		if (key_pressed(KEY_TAB))
		{
			int step = (key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT)) ? -1 : 1;
			inventory_category_index += step;
			if (inventory_category_index < 0) inventory_category_index = int(inventory_categories.length()) - 1;
			if (inventory_category_index >= int(inventory_categories.length())) inventory_category_index = 0;
			position = 0;
			items = inventory_items_for_category(inventory_categories[uint(inventory_category_index)]);
			inventory_selected_item = items.length() > 0 ? items[0] : "";
			play_invcat_change_sound();
			speak_inventory_category(inventory_categories[uint(inventory_category_index)], items);
			continue;
		}
		items = inventory_items_for_category(inventory_categories[uint(inventory_category_index)]);
		if (position >= int(items.length())) position = int(items.length()) - 1;
		if (items.length() == 0) position = 0;
		if (key_pressed(KEY_UP) || kb_pressed("menu_up"))
		{
			if (position > 0) position--;
			if (items.length() > 0) { inventory_selected_item = items[uint(position)]; play_inventory_navigation_sound(); }
			speak_inventory_item(items, position);
		}
		if (key_pressed(KEY_DOWN) || kb_pressed("menu_down"))
		{
			if (position < int(items.length()) - 1) position++;
			if (items.length() > 0) { inventory_selected_item = items[uint(position)]; play_inventory_navigation_sound(); }
			speak_inventory_item(items, position);
		}
		if (key_pressed(KEY_HOME) || kb_pressed("menu_home"))
		{
			position = 0;
			if (items.length() > 0) { inventory_selected_item = items[0]; play_inventory_navigation_sound(); }
			speak_inventory_item(items, position);
		}
		if (key_pressed(KEY_END) || kb_pressed("menu_end"))
		{
			position = int(items.length()) - 1;
			if (items.length() > 0) { inventory_selected_item = items[uint(position)]; play_inventory_navigation_sound(); }
			speak_inventory_item(items, position);
		}
		if (key_pressed(KEY_SPACE) && inventory_selected_item != "")
		{
			string desc = get_item_description(inventory_selected_item);
			if (desc != "") speak(desc);
		}
		int[] number_keys = {KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0};
		for (uint key_index = 0; key_index < number_keys.length(); key_index++)
		{
			int key = number_keys[key_index];
			if (!key_pressed(key)) continue;
			int slot = favorite_slot_for_key(key);
			if (key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT))
			{
				if (inventory_selected_item != "") assign_inventory_favorite(slot, inventory_selected_item);
				else speak(tr("inventory.favorite_select_item"));
			}
			else use_inventory_favorite(slot);
			break;
		}
	}
}
