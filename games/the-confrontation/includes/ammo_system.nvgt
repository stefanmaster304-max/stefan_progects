// ammo_system.nvgt - Modular inventory-backed ammunition system for The Confront.
// Weapons track currently loaded ammo; spare ammo lives in player inventory.
// Supports magazines, loose ammo belts/boxes, energy cells, and fuel canisters.

// ---------------------------------------------------------------------------
// Fire mode system
// ---------------------------------------------------------------------------
// A weapon has exactly one fire mode and it is chosen when the weapon is
// created: either semi-automatic or full automatic. Nothing switches it at
// runtime and there is no mode list.
const int FIREMODE_SEMI = 0;
const int FIREMODE_AUTO = 1;

dictionary weapon_fire_modes;

void register_weapon_fire_mode(weapon_data@ w)
{
	if (w is null) return;
	string fm = string_to_lower_case(w.fire_modes).trim_whitespace();
	int mode = FIREMODE_SEMI;
	if (fm == "auto" || fm == "automatic" || fm == "full_auto" || fm == "full automatic") mode = FIREMODE_AUTO;
	weapon_fire_modes.set(w.id, mode);
}

int get_fire_mode(string wname)
{
	int mode = FIREMODE_SEMI;
	weapon_fire_modes.get(wname, mode);
	return mode;
}

string fire_mode_name(int mode)
{
	return (mode == FIREMODE_AUTO) ? "full automatic" : "semi-automatic";
}

// ---------------------------------------------------------------------------
// Loaded magazine/chamber state per weapon instance
// ---------------------------------------------------------------------------
dictionary loaded_ammo;
bool is_reloading = false;
timer reload_timer;
// Persistent sound-pool slot that is playing the reload sound (-1 when no
// reload sound is available and the fixed fallback is used instead).
int current_reload_slot = -1;
string reloading_weapon = "";
// Safety fallback used ONLY when a weapon has no playable reload sound, so a
// weapon can never get stuck reloading forever. Weapons with a reload sound
// finish reloading exactly when that sound stops playing.
const int RELOAD_NO_SOUND_FALLBACK_MS = 2000;

int get_loaded_ammo(string wname)
{
	int count = 0;
	if (loaded_ammo.exists(wname))
		loaded_ammo.get(wname, count);
	return count;
}

void set_loaded_ammo(string wname, int count)
{
	if (count < 0) count = 0;
	loaded_ammo.set(wname, count);
}

void init_weapon_ammo(string wname, int cap)
{
	if (!loaded_ammo.exists(wname))
		loaded_ammo.set(wname, cap);
}


string find_reserve_ammo_item(weapon_data@ w)
{
	if (w is null) return "";

	// 1. Explicit configured reserve_item on this weapon
	if (w.reserve_item != "" && get_item_count(w.reserve_item) > 0)
	{
		return w.reserve_item;
	}

	// 2. Normalized alias match (handling underscores / spaces)
	if (w.reserve_item != "")
	{
		string norm_target = string_replace(w.reserve_item, "_", "", true);
		string[] carried = get_all_inv_keys();
		for (uint i = 0; i < carried.length(); i++)
		{
			if (get_item_count(carried[i]) <= 0) continue;
			string norm_c = string_replace(carried[i], "_", "", true);
			if (norm_c == norm_target) return carried[i];
		}
	}

	// 3. Scan carried items for compatible ammunition by caliber / weapon family
	string at = string_to_lower_case(w.ammo_type);
	string wid = string_to_lower_case(w.id);
	string[] carried = get_all_inv_keys();

	for (uint i = 0; i < carried.length(); i++)
	{
		string item_id = carried[i];
		if (get_item_count(item_id) <= 0) continue;
		string lower_id = string_to_lower_case(item_id);

		// 9mm / 9x19mm
		if (string_contains(at, "9x19", 1) > -1 || string_contains(at, "9mm", 1) > -1 || string_contains(wid, "9mm", 1) > -1)
		{
			if (string_contains(lower_id, "9x19", 1) > -1 || string_contains(lower_id, "9mm", 1) > -1 || lower_id == "ammo_9mm")
				return item_id;
		}

		// 5.56x45mm / .223 Remington
		if (string_contains(at, "5.56", 1) > -1 || string_contains(at, "223", 1) > -1)
		{
			if (string_contains(lower_id, "5.56", 1) > -1 || string_contains(lower_id, "223", 1) > -1)
				return item_id;
		}

		// 7.62x51mm / .308 Winchester
		if (string_contains(at, "7.62x51", 1) > -1 || string_contains(at, "308", 1) > -1)
		{
			if (string_contains(lower_id, "7.62x51", 1) > -1 || string_contains(lower_id, "308", 1) > -1)
				return item_id;
		}

		// 7.62x54mmR
		if (string_contains(at, "7.62x54", 1) > -1)
		{
			if (string_contains(lower_id, "7.62x54", 1) > -1)
				return item_id;
		}

		// 5.45x39mm
		if (string_contains(at, "5.45x39", 1) > -1)
		{
			if (string_contains(lower_id, "5.45x39", 1) > -1)
				return item_id;
		}

		// 7.62x39mm
		if (string_contains(at, "7.62x39", 1) > -1)
		{
			if (string_contains(lower_id, "7.62x39", 1) > -1)
				return item_id;
		}

		// 12 Gauge
		if (string_contains(at, "12 gauge", 1) > -1 || string_contains(at, "12_gauge", 1) > -1 || w.wclass == "shotguns")
		{
			if (string_contains(lower_id, "12_gauge", 1) > -1 || string_contains(lower_id, "12gauge", 1) > -1)
				return item_id;
		}

		// 23x75mmR Heavy Shotgun
		if (string_contains(at, "23x75", 1) > -1)
		{
			if (string_contains(lower_id, "23x75", 1) > -1)
				return item_id;
		}

		// .45 ACP
		if (string_contains(at, "45 acp", 1) > -1 || string_contains(at, "45_acp", 1) > -1)
		{
			if (string_contains(lower_id, "45_acp", 1) > -1 || string_contains(lower_id, "45acp", 1) > -1)
				return item_id;
		}

		// .44 Magnum
		if (string_contains(at, "44 magnum", 1) > -1 || string_contains(at, "44_magnum", 1) > -1)
		{
			if (string_contains(lower_id, "44_magnum", 1) > -1 || string_contains(lower_id, "44magnum", 1) > -1)
				return item_id;
		}

		// .357 Magnum
		if (string_contains(at, "357 magnum", 1) > -1 || string_contains(at, "357_magnum", 1) > -1)
		{
			if (string_contains(lower_id, "357_magnum", 1) > -1 || string_contains(lower_id, "357magnum", 1) > -1)
				return item_id;
		}

		// .50 Action Express
		if (string_contains(at, "50 action express", 1) > -1 || string_contains(at, "50 ae", 1) > -1 || string_contains(at, "50_ae", 1) > -1)
		{
			if (string_contains(lower_id, "50_ae", 1) > -1 || string_contains(lower_id, "50ae", 1) > -1)
				return item_id;
		}

		// 5.7x28mm
		if (string_contains(at, "5.7x28", 1) > -1)
		{
			if (string_contains(lower_id, "5.7x28", 1) > -1)
				return item_id;
		}

		// .380 ACP
		if (string_contains(at, "380 acp", 1) > -1 || string_contains(at, "380_acp", 1) > -1)
		{
			if (string_contains(lower_id, "380_acp", 1) > -1 || string_contains(lower_id, "380acp", 1) > -1)
				return item_id;
		}

		// .40 S&W
		if (string_contains(at, "40 s&w", 1) > -1 || string_contains(at, "40_sw", 1) > -1)
		{
			if (string_contains(lower_id, "40_sw", 1) > -1 || string_contains(lower_id, "40sw", 1) > -1)
				return item_id;
		}

		// .22 LR
		if (string_contains(at, "22 lr", 1) > -1 || string_contains(at, "22_lr", 1) > -1)
		{
			if (string_contains(lower_id, "22_lr", 1) > -1 || string_contains(lower_id, "22lr", 1) > -1)
				return item_id;
		}

		// .50 BMG / 12.7x99mm
		if (string_contains(at, "12.7x99", 1) > -1 || string_contains(at, "50 bmg", 1) > -1 || string_contains(at, "50_cal", 1) > -1)
		{
			if (string_contains(lower_id, "12.7x99", 1) > -1 || string_contains(lower_id, "heavy_50_cal", 1) > -1)
				return item_id;
		}

		// .30-06 Springfield
		if (string_contains(at, "30-06", 1) > -1 || string_contains(at, "30_06", 1) > -1)
		{
			if (string_contains(lower_id, "30_06", 1) > -1)
				return item_id;
		}

		// 4.6x30mm
		if (string_contains(at, "4.6x30", 1) > -1)
		{
			if (string_contains(lower_id, "4.6x30", 1) > -1)
				return item_id;
		}

		// Crossbow
		if (string_contains(at, "crossbow", 1) > -1 || string_contains(wid, "crossbow", 1) > -1)
		{
			if (string_contains(lower_id, "crossbow_bolt", 1) > -1 || string_contains(lower_id, "bolt", 1) > -1)
				return item_id;
		}

		// Flamethrower
		if (string_contains(at, "gel", 1) > -1 || string_contains(wid, "flame", 1) > -1)
		{
			if (string_contains(lower_id, "gel_canister", 1) > -1 || string_contains(lower_id, "flamethrower_fuel", 1) > -1 || string_contains(lower_id, "canister", 1) > -1)
				return item_id;
		}

		// Cannon / Mortar
		if (string_contains(at, "120mm", 1) > -1 || string_contains(wid, "cannon", 1) > -1)
		{
			if (string_contains(lower_id, "120mm", 1) > -1 || string_contains(lower_id, "mortar", 1) > -1)
				return item_id;
		}
	}

	return "";
}

int get_reserve_ammo(const string&in item_id)
{
	if (item_id == "") return 0;
	int cnt = get_item_count(item_id);
	if (cnt > 0) return cnt;
	if (string_contains(item_id, "9mm", 1) > -1 || string_contains(item_id, "9x19", 1) > -1)
	{
		int legacy = get_item_count("ammo_9mm");
		if (legacy > 0) return legacy;
	}
	return 0;
}

int get_reserve_ammo_for_weapon(weapon_data@ w)
{
	if (w is null) return 0;
	string item_id = find_reserve_ammo_item(w);
	if (item_id != "") return get_item_count(item_id);
	return 0;
}

bool is_container_ammo_item(const string&in item_id, weapon_data@ w)
{
	if (w !is null && w.is_magazine) return true;
	string lid = string_to_lower_case(item_id);
	if (string_contains(lid, "box", 1) > -1 ||
	    string_contains(lid, "magazine", 1) > -1 ||
	    string_contains(lid, "mag", 1) > -1 ||
	    string_contains(lid, "drum", 1) > -1 ||
	    string_contains(lid, "clip", 1) > -1 ||
	    string_contains(lid, "rack", 1) > -1 ||
	    string_contains(lid, "canister", 1) > -1 ||
	    string_contains(lid, "loader", 1) > -1 ||
	    string_contains(lid, "speedloader", 1) > -1 ||
	    string_contains(lid, "cell", 1) > -1 ||
	    string_contains(lid, "battery", 1) > -1 ||
	    string_contains(lid, "shell", 1) > -1)
	{
		return true;
	}
	return false;
}

bool consume_loaded_round(string wname)
{
	int cur = get_loaded_ammo(wname);
	if (cur <= 0) return false;
	set_loaded_ammo(wname, cur - 1);
	return true;
}

bool can_reload(weapon_data@ w)
{
	if (w is null or w.melee) return false;
	if (is_reloading) return false;
	int loaded = get_loaded_ammo(w.id);
	if (loaded >= w.capacity) return false;
	string res_item = find_reserve_ammo_item(w);
	return (res_item != "" && get_item_count(res_item) > 0);
}

string localized_ammo_unit(const string&in unit)
{
	string key = string_to_lower_case(string_trim_sides(unit));
	key = string_replace(key, " ", "_", true);
	string tr_key = "game.ammo_unit." + key;
	if (key == "rounds" || key == "shells" || key == "cells" || key == "missiles" || key == "rockets" || key == "grenades" || key == "arrows" || key == "fuel_units" || key == "canisters")
		return tr(tr_key, unit);
	return unit;
}

string localized_reserve_label(weapon_data@ w, bool plural)
{
	string label = (w.reserve_label != "") ? w.reserve_label : "magazine";
	if (string_to_lower_case(label) == "magazine" || string_to_lower_case(label) == "magazines")
		return tr(plural ? "game.ammo_unit.magazines" : "game.ammo_unit.magazine", plural ? "magazines" : "magazine");
	if (plural && !string_ends_with(label, "s")) label += "s";
	return label;
}

void start_reload(weapon_data@ w)
{
	if (w is null or w.melee) return;
	if (is_reloading) return;

	int loaded = get_loaded_ammo(w.id);
	if (loaded >= w.capacity)
	{
		string[] args = { w.name };
		speak(tr("game.weapon_already_loaded", args));
		return;
	}

	string res_item = find_reserve_ammo_item(w);
	int reserve = (res_item != "") ? get_item_count(res_item) : 0;
	if (reserve <= 0)
	{
		// Pressing R with an empty reserve announces the required ammo type
		string atype = (w.ammo_type != "") ? w.ammo_type : tr("game.ammo_fallback");
		string res_label = localized_reserve_label(w, true);
		speak(tr("game.no_reserve_ammo", {atype, res_label, w.name}));
		return;
	}

	is_reloading = true;
	reloading_weapon = w.id;
	current_reload_slot = -1;
	reload_timer.restart();

	string rsnd = "";
	if (w.sound_reload != "") rsnd = get_sound_path(w.sound_reload);
	if (rsnd != "")
	{
		// Persistent slot: stays dedicated to this reload until it finishes,
		// so no other sound from the pool steals it while the reload sound is playing.
		current_reload_slot = p.play_stationary(rsnd, false, true);
	}
}

// Aborts a reload in progress (weapon switched, map reset, new game, etc.)
// and releases its sound slot without granting any ammunition.
void cancel_reload()
{
	if (!is_reloading && current_reload_slot < 0) return;
	if (current_reload_slot >= 0)
	{
		p.destroy_sound(current_reload_slot);
		current_reload_slot = -1;
	}
	is_reloading = false;
	reloading_weapon = "";
}

void ammo_system_loop()
{
	if (!is_reloading) return;

	weapon_data@ w = get_weapon_data(reloading_weapon);
	if (w is null)
	{
		cancel_reload();
		return;
	}

	bool finished = false;
	if (current_reload_slot >= 0)
	{
		// The weapon stays in its reloading state for exactly as long as the
		// reload sound plays. Once the sound has stopped completely, the
		// reload is finished and the magazine is full again.
		if (!p.sound_is_playing(current_reload_slot)) finished = true;
	}
	else
	{
		// No playable reload sound on this weapon: rely on the safety timer.
		if (reload_timer.elapsed >= RELOAD_NO_SOUND_FALLBACK_MS) finished = true;
	}
	if (!finished) return;

	if (current_reload_slot >= 0)
	{
		p.destroy_sound(current_reload_slot);
		current_reload_slot = -1;
	}
	is_reloading = false;
	reloading_weapon = "";

	string active_item = find_reserve_ammo_item(w);
	if (active_item == "") active_item = w.reserve_item;
	int reserve = get_item_count(active_item);
	if (reserve <= 0) return;

	if (w.is_magazine || is_container_ammo_item(active_item, w))
	{
		// Magazine / box / canister / rack swap: consume 1 unit from inventory, set loaded to full capacity
		give(active_item, -1);
		set_loaded_ammo(w.id, w.capacity);
	}
	else
	{
		// Loose rounds/cells: consume needed amount from inventory
		int needed = w.capacity - get_loaded_ammo(w.id);
		int to_load = (reserve >= needed) ? needed : reserve;
		give(active_item, -to_load);
		set_loaded_ammo(w.id, get_loaded_ammo(w.id) + to_load);
	}
}

void handle_reload_key()
{
	string wid = current_weapon_id;
	if (wid == "" || find_weapon_data(wid) is null)
	{
		// If quick inventory is focused on a weapon, equip it
		if (quick_inv_focused)
		{
			string[] keys = get_all_inv_keys();
			if (quick_inv_index >= 0 && quick_inv_index < int(keys.length()))
			{
				string candidate = keys[quick_inv_index];
				if (find_weapon_data(candidate) !is null)
				{
					equip_weapon(candidate, true);
					wid = candidate;
				}
			}
		}
		// If still empty, check carried inventory for any carried weapon
		if (wid == "" || find_weapon_data(wid) is null)
		{
			string[] carried = get_all_inv_keys();
			for (uint i = 0; i < carried.length(); i++)
			{
				if (find_weapon_data(carried[i]) !is null)
				{
					equip_weapon(carried[i], true);
					wid = carried[i];
					break;
				}
			}
		}
	}

	if (wid == "" || find_weapon_data(wid) is null)
	{
		speak(tr("weapon.none_equipped"));
		return;
	}

	weapon_data@ w = get_weapon_data(wid);
	if (w is null)
	{
		speak(tr("weapon.none_equipped"));
		return;
	}

	if (w.melee)
	{
		speak(tr("game.melee_weapon", {w.name}));
		return;
	}

	start_reload(w);
}

void speak_ammo_status()
{
	string wid = current_weapon_id;
	if (wid == "" || find_weapon_data(wid) is null)
	{
		if (quick_inv_focused)
		{
			string[] keys = get_all_inv_keys();
			if (quick_inv_index >= 0 && quick_inv_index < int(keys.length()))
			{
				string candidate = keys[quick_inv_index];
				if (find_weapon_data(candidate) !is null)
				{
					equip_weapon(candidate, true);
					wid = candidate;
				}
			}
		}
	}

	if (wid == "" || find_weapon_data(wid) is null)
	{
		speak(tr("weapon.none_equipped"));
		return;
	}

	weapon_data@ w = get_weapon_data(wid);
	if (w is null)
	{
		speak(tr("weapon.none_equipped"));
		return;
	}

	if (w.melee)
	{
		speak(tr("game.melee_weapon", {w.name}));
		return;
	}

	if (is_reloading && reloading_weapon == w.id)
	{
		speak(tr("game.reloading_weapon", {w.name}));
		return;
	}

	int loaded = get_loaded_ammo(w.id);
	string res_item = find_reserve_ammo_item(w);
	int reserve = (res_item != "") ? get_item_count(res_item) : 0;
	string atype = (w.ammo_type != "") ? w.ammo_type : tr("game.ammo_fallback");
	string raw_unit = (w.ammo_display != "") ? w.ammo_display : "rounds";
	string disp = localized_ammo_unit(raw_unit);
	string res_label = localized_reserve_label(w, reserve != 1);
	speak(tr("game.ammo_status", {"" + loaded, "" + w.capacity, disp, atype, "" + reserve, res_label}));
}
