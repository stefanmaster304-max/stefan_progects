// npc_manager.nvgt - NPC Manager: create, edit, delete and list the .npc files.
//
// Every field of an NPC is a choice of the developer. Nothing is derived from
// code: the manager writes exactly the values typed here into
// settings/npcs/<id>.npc and the runtime reads them back.

string npc_manager_pick_sound(const string&in title, const string&in current_val)
{
	return select_sound_by_category_dialog(title, current_val, "", true);
}

string npc_sound_count_label(const string&in val)
{
	if (val == "") return "";
	string[]@ parts = string_split(val, ";", true);
	int count = (parts !is null && parts.length() > 0) ? int(parts.length()) : 1;
	return " (" + count + " selected)";
}

// Death drops: the items checked here are the ones that land on the ground when
// this NPC dies. The result is stored as item_id:quantity pairs separated by
// semicolons, which is exactly what the runtime reads.
bool npc_drop_list_has(const string&in drops, const string&in item_id)
{
	if (drops == "" || item_id == "") return false;
	string[]@ toks = string_split(drops, ";", true);
	if (toks is null) return false;
	for (uint i = 0; i < toks.length(); i++)
	{
		string spec = toks[i].trim_whitespace();
		int col = string_contains(spec, ":", 1);
		if (col != -1) spec = string_left(spec, col).trim_whitespace();
		if (string_to_lower_case(spec) == string_to_lower_case(item_id)) return true;
	}
	return false;
}

int npc_drop_list_qty(const string&in drops, const string&in item_id)
{
	if (drops == "" || item_id == "") return 1;
	string[]@ toks = string_split(drops, ";", true);
	if (toks is null) return 1;
	for (uint i = 0; i < toks.length(); i++)
	{
		string spec = toks[i].trim_whitespace();
		int col = string_contains(spec, ":", 1);
		if (col != -1)
		{
			string id = string_left(spec, col).trim_whitespace();
			if (string_to_lower_case(id) == string_to_lower_case(item_id))
			{
				int q = int(string_to_number(spec.substr(col + 1).trim_whitespace()));
				return (q > 0) ? q : 1;
			}
		}
	}
	return 1;
}

string npc_pick_death_drops_dialog(const string&in current_drops)
{
	load_all_items_config();
	if (item_registry.length() == 0)
	{
		speak(tr("npc_manager.no_npcs_found"));
		return current_drops;
	}

	dictionary drop_qtys;
	for (uint i = 0; i < item_registry.length(); i++)
	{
		string iid = item_registry[i].id;
		drop_qtys.set(iid, npc_drop_list_qty(current_drops, iid));
	}

	audio_form pf;
	pf.create_window(tr("npc_manager.select_death_drop"), false, true, false);
	int list = pf.create_list(tr("npc_manager.available_drop_items"), 0, true, true);

	for (uint i = 0; i < item_registry.length(); i++)
	{
		string iid = item_registry[i].id;
		string iname = (item_registry[i].name != "") ? item_registry[i].name : iid;
		bool is_sel = npc_drop_list_has(current_drops, iid);
		int q = 1;
		drop_qtys.get(iid, q);
		pf.add_list_item(list, iname + " (" + iid + ") - Drop Quantity: " + q, iid, -1, false, is_sel);
	}

	int in_qty = pf.create_input_box(tr("npc_manager.drop_quantity"), "1");
	pf.set_disallowed_chars(in_qty, "0123456789", true, "Numbers only.");
	int b_save = pf.create_button("&" + tr("npc_manager.save_drops"), true);
	int b_clear = pf.create_button("&" + tr("npc_manager.clear_selection"), false);
	int b_cancel = pf.create_button("&" + tr("ui.cancel"), false, true);
	pf.focus(list);

	int last_focused_idx = -1;

	while (true)
	{
		wait(5);
		update_game_world();
		pf.monitor();

		int cur_pos = pf.get_list_position(list);
		if (cur_pos >= 0 && cur_pos < int(item_registry.length()) && cur_pos != last_focused_idx)
		{
			if (last_focused_idx >= 0 && last_focused_idx < int(item_registry.length()))
			{
				string prev_iid = item_registry[uint(last_focused_idx)].id;
				int prev_q = int(string_to_number(pf.get_text(in_qty)));
				if (prev_q < 1) prev_q = 1;
				drop_qtys.set(prev_iid, prev_q);
			}
			last_focused_idx = cur_pos;
			string cur_iid = item_registry[uint(cur_pos)].id;
			int cur_q = 1;
			drop_qtys.get(cur_iid, cur_q);
			pf.set_text(in_qty, "" + cur_q);
		}

		if (pf.is_pressed(b_save) || key_pressed(KEY_RETURN))
		{
			if (cur_pos >= 0 && cur_pos < int(item_registry.length()))
			{
				string cur_iid = item_registry[uint(cur_pos)].id;
				int cur_q = int(string_to_number(pf.get_text(in_qty)));
				if (cur_q < 1) cur_q = 1;
				drop_qtys.set(cur_iid, cur_q);
			}
			int[]@ checked = pf.get_checked_list_items(list);
			string result = "";
			if (checked !is null && checked.length() > 0)
			{
				for (uint i = 0; i < checked.length(); i++)
				{
					int idx = checked[i];
					if (idx < 0 || idx >= int(item_registry.length())) continue;
					string iid = item_registry[uint(idx)].id;
					int q = 1;
					if (drop_qtys.exists(iid)) drop_qtys.get(iid, q);
					if (q < 1) q = 1;
					if (result != "") result += ";";
					result += iid + ":" + q;
				}
			}
			else
			{
				if (cur_pos >= 0 && cur_pos < int(item_registry.length()))
				{
					string iid = item_registry[uint(cur_pos)].id;
					int q = 1;
					if (drop_qtys.exists(iid)) drop_qtys.get(iid, q);
					if (q < 1) q = 1;
					result = iid + ":" + q;
				}
			}
			return result;
		}

		if (pf.is_pressed(b_clear))
			return "";

		if (pf.is_pressed(b_cancel) || key_pressed(KEY_ESCAPE))
			return current_drops;
	}
	return current_drops;
}

string npc_sanitize_id(const string&in raw)
{
	string id = string_to_lower_case(raw.trim_whitespace());
	id = string_replace(id, " ", "_", true);
	id = string_replace(id, "/", "_", true);
	id = string_replace(id, "\\", "_", true);
	id = string_replace(id, ":", "_", true);
	return id;
}

void npc_edit_form(npc_data@ n, bool is_new)
{
	if (n is null) return;

	audio_form form;
	form.create_window(is_new ? (tr("npc_manager.create_title") + " - " + n.npc_class) : (tr("npc_manager.edit_title") + ": " + n.name), true, true, false);

	int in_id = form.create_input_box(tr("npc_manager.internal_id"), n.id);
	int in_name = form.create_input_box(tr("npc_manager.display_name"), n.name);

	// The class is chosen once, in the create flow. The form only carries the
	// class list when an existing NPC is being edited, so creating never asks
	// for the same class twice.
	int in_class = -1;
	if (!is_new)
	{
		int def_class = 0;
		if (n.npc_class == NPC_CLASS_ROBOT) def_class = 1;
		else if (n.npc_class == NPC_CLASS_ZOMBIE) def_class = 2;
		in_class = form.create_list(tr("npc_manager.npc_class"), 0, false, false);
		form.add_list_item(in_class, tr("npc_manager.class_animal"), NPC_CLASS_ANIMAL, -1, false, (def_class == 0));
		form.add_list_item(in_class, tr("npc_manager.class_robot"), NPC_CLASS_ROBOT, -1, false, (def_class == 1));
		form.add_list_item(in_class, tr("npc_manager.class_zombie"), NPC_CLASS_ZOMBIE, -1, false, (def_class == 2));
		form.set_list_position(in_class, def_class, false);
	}

	int in_attack_speed = form.create_input_box(tr("npc_manager.attack_speed"), "" + n.attack_speed);
	int in_min_dmg = form.create_input_box(tr("npc_manager.min_damage"), "" + n.min_damage);
	int in_max_dmg = form.create_input_box(tr("npc_manager.max_damage"), "" + n.max_damage);
	int in_detection = form.create_input_box(tr("npc_manager.detection_range"), "" + n.detection_range);
	int in_attack_range = form.create_input_box(tr("npc_manager.attack_range"), "" + n.attack_range);
	int in_walk = form.create_input_box(tr("npc_manager.walk_speed"), "" + n.walk_speed);
	int in_run = form.create_input_box(tr("npc_manager.run_speed"), "" + n.run_speed);
	int in_health = form.create_input_box(tr("npc_manager.max_health"), "" + n.max_health);

	int in_xp = form.create_input_box(tr("npc_manager.xp_reward"), "" + n.xp);

	int cb_drop = form.create_checkbox(tr("npc_manager.drop_on_death"), n.drop_items_on_death);
	int btn_drops = form.create_button(tr("npc_manager.select_drops") + npc_sound_count_label(n.death_drops));

	int cb_platform_steps = form.create_checkbox(tr("npc_manager.platform_steps"), n.use_platform_footsteps);
	int btn_steps = form.create_button(tr("npc_manager.select_custom_steps") + npc_sound_count_label(n.sound_footsteps));

	int in_voice_min = form.create_input_box(tr("npc_manager.voice_min"), "" + n.voice_min_delay);
	int in_voice_max = form.create_input_box(tr("npc_manager.voice_max"), "" + n.voice_max_delay);

	int btn_voice = form.create_button(tr("npc_manager.select_voice") + npc_sound_count_label(n.sound_voice));
	int btn_attack = form.create_button(tr("npc_manager.select_attack") + npc_sound_count_label(n.sound_attack));
	int btn_hit = form.create_button(tr("npc_manager.select_impact_sound") + npc_sound_count_label(n.sound_hit));
	int btn_pain = form.create_button(tr("npc_manager.select_pain") + npc_sound_count_label(n.sound_pain));
	int btn_death = form.create_button(tr("npc_manager.select_death") + npc_sound_count_label(n.sound_death));

	form.set_disallowed_chars(in_detection, "0123456789", true, "Whole numbers only.");
	form.set_disallowed_chars(in_attack_range, "0123456789", true, "Whole numbers only.");
	form.set_disallowed_chars(in_attack_speed, "0123456789", true, "Numbers only.");
	form.set_disallowed_chars(in_min_dmg, "0123456789", true, "Numbers only.");
	form.set_disallowed_chars(in_max_dmg, "0123456789", true, "Numbers only.");
	form.set_disallowed_chars(in_walk, "0123456789", true, "Numbers only.");
	form.set_disallowed_chars(in_run, "0123456789", true, "Numbers only.");
	form.set_disallowed_chars(in_health, "0123456789", true, "Numbers only.");
	form.set_disallowed_chars(in_xp, "0123456789", true, "Numbers only.");
	form.set_disallowed_chars(in_voice_min, "0123456789", true, "Numbers only.");
	form.set_disallowed_chars(in_voice_max, "0123456789", true, "Numbers only.");

	int btn_save = form.create_button("&" + (is_new ? tr("ui.save") : tr("ui.update_and_save")), true);
	int btn_cancel = form.create_button("&" + tr("ui.cancel"), false, true);
	form.set_default_controls(btn_save, btn_cancel);
	form.focus(is_new ? in_id : in_name);

	while (true)
	{
		wait(5);
		update_game_world();
		form.monitor();

		// The custom footstep picker only exists while the platform footsteps
		// are not allowed: with the box checked the NPC uses the map platform.
		bool use_map_steps = form.is_checked(cb_platform_steps);
		form.set_state(btn_steps, !use_map_steps, !use_map_steps);

		if (form.is_pressed(btn_voice))
		{
			n.sound_voice = npc_manager_pick_sound("Voice clips (multiple allowed)", n.sound_voice);
			form.set_text(btn_voice, tr("npc_manager.select_voice") + npc_sound_count_label(n.sound_voice));
			speak("Voice clips updated.");
		}
		if (form.is_pressed(btn_attack))
		{
			n.sound_attack = npc_manager_pick_sound("Attack sound", n.sound_attack);
			form.set_text(btn_attack, tr("npc_manager.select_attack") + npc_sound_count_label(n.sound_attack));
			speak("Attack sound updated.");
		}
		if (form.is_pressed(btn_hit))
		{
			n.sound_hit = npc_manager_pick_sound("Impact sound", n.sound_hit);
			form.set_text(btn_hit, tr("npc_manager.select_impact_sound") + npc_sound_count_label(n.sound_hit));
			speak("Impact sound updated.");
		}
		if (form.is_pressed(btn_pain))
		{
			n.sound_pain = npc_manager_pick_sound("Pain sound", n.sound_pain);
			form.set_text(btn_pain, tr("npc_manager.select_pain") + npc_sound_count_label(n.sound_pain));
			speak("Pain sound updated.");
		}
		if (form.is_pressed(btn_death))
		{
			n.sound_death = npc_manager_pick_sound("Death sound", n.sound_death);
			form.set_text(btn_death, tr("npc_manager.select_death") + npc_sound_count_label(n.sound_death));
			speak("Death sound updated.");
		}
		if (form.is_pressed(btn_drops))
		{
			n.death_drops = npc_pick_death_drops_dialog(n.death_drops);
			form.set_text(btn_drops, tr("npc_manager.select_drops") + npc_sound_count_label(n.death_drops));
			speak("Dropped items updated.");
		}
		if (form.is_pressed(btn_steps))
		{
			n.sound_footsteps = npc_manager_pick_sound("Custom footstep sounds (multiple allowed)", n.sound_footsteps);
			form.set_text(btn_steps, tr("npc_manager.select_custom_steps") + npc_sound_count_label(n.sound_footsteps));
			speak("Footstep sounds updated.");
		}

		if (form.is_pressed(btn_save))
		{
			string old_id = n.id;
			string target_id = npc_sanitize_id(form.get_text(in_id));
			if (target_id == "")
			{
				speak(tr("npc_manager.id_empty"));
				form.focus(in_id);
				continue;
			}
			if (is_new && find_npc_data(target_id) !is null)
			{
				speak(tr("npc_manager.id_exists"));
				form.focus(in_id);
				continue;
			}
			if (!is_new && target_id != old_id)
			{
				if (find_npc_data(target_id) !is null)
				{
					speak(tr("npc_manager.id_exists"));
					form.focus(in_id);
					continue;
				}
				string old_path = NPC_DIR + "/" + old_id + ".npc";
				if (file_exists(old_path)) file_delete(old_path);
				for (uint i = 0; i < npc_registry.length(); i++)
				{
					if (npc_registry[i].id == old_id)
					{
						npc_registry[i].id = target_id;
						break;
					}
				}
			}

			n.id = target_id;
			n.name = form.get_text(in_name).trim_whitespace();
			if (n.name == "") n.name = string_replace(target_id, "_", " ", true);

			if (!is_new && in_class != -1)
			{
				int class_pos = form.get_list_position(in_class);
				if (class_pos == 1) n.npc_class = NPC_CLASS_ROBOT;
				else if (class_pos == 2) n.npc_class = NPC_CLASS_ZOMBIE;
				else n.npc_class = NPC_CLASS_ANIMAL;
			}

			n.attack_speed = int(string_to_number(form.get_text(in_attack_speed)));
			n.min_damage = int(string_to_number(form.get_text(in_min_dmg)));
			n.max_damage = int(string_to_number(form.get_text(in_max_dmg)));
			n.detection_range = int(string_to_number(form.get_text(in_detection)));
			n.attack_range = int(string_to_number(form.get_text(in_attack_range)));
			n.walk_speed = int(string_to_number(form.get_text(in_walk)));
			n.run_speed = int(string_to_number(form.get_text(in_run)));
			n.max_health = int(string_to_number(form.get_text(in_health)));
			n.xp = int(string_to_number(form.get_text(in_xp)));
			n.drop_items_on_death = form.is_checked(cb_drop);
			n.use_platform_footsteps = form.is_checked(cb_platform_steps);
			n.voice_min_delay = int(string_to_number(form.get_text(in_voice_min)));
			n.voice_max_delay = int(string_to_number(form.get_text(in_voice_max)));

			validate_npc_data(n);
			if (save_npc_file(n))
			{
				if (file_exists(CONTENTS_DAT_PATH)) encrypt_all_contents_silent();
				load_all_npcs(true);
				speak(tr("npc_manager.saved_success", {n.name}));
				return;
			}
			speak(tr("npc_manager.failed_save"));
		}

		if (form.is_pressed(btn_cancel) || key_pressed(KEY_ESCAPE))
		{
			speak(tr("npc_manager.editing_canceled"));
			return;
		}
	}
}

void npc_create_flow()
{
	audio_form cf;
	cf.create_window(tr("npc_manager.create_title"), false, true, false);
	int list = cf.create_list(tr("npc_manager.choose_class"), 0, false, false);
	cf.add_list_item(list, tr("npc_manager.class_animal"), NPC_CLASS_ANIMAL, -1, false, true);
	cf.add_list_item(list, tr("npc_manager.class_robot"), NPC_CLASS_ROBOT, -1, false, false);
	cf.add_list_item(list, tr("npc_manager.class_zombie"), NPC_CLASS_ZOMBIE, -1, false, false);
	int b_ok = cf.create_button("&" + tr("ui.next"), true);
	int b_cancel = cf.create_button("&" + tr("ui.cancel"), false, true);
	cf.set_default_controls(b_ok, b_cancel);
	cf.focus(list);

	while (true)
	{
		wait(5);
		update_game_world();
		cf.monitor();

		if (key_pressed(KEY_ESCAPE) || cf.is_pressed(b_cancel))
		{
			speak(tr("ui.canceled"));
			return;
		}

		if (cf.is_pressed(b_ok))
		{
			int pos = cf.get_list_position(list);
			npc_data n;
			n.npc_class = (pos == 1) ? NPC_CLASS_ROBOT : ((pos == 2) ? NPC_CLASS_ZOMBIE : NPC_CLASS_ANIMAL);
			n.id = "novo_npc";
			n.name = "Novo NPC";
			npc_edit_form(n, true);
			return;
		}
	}
}

void npc_select_flow(const string&in title, const string&in action, bool confirm_delete)
{
	load_all_npcs();
	if (npc_registry.length() == 0)
	{
		speak(tr("npc_manager.no_npcs_found"));
		return;
	}

	audio_form lf;
	lf.create_window(title, false, true, false);
	int list = lf.create_list(tr("npc_manager.available_npcs"), 0, false, false);
	lf.focus(list);

	string[] ids;
	for (uint i = 0; i < npc_registry.length(); i++)
	{
		npc_data@ n = npc_registry[i];
		string label = n.name + " (" + n.id + ", " + n.npc_class + ")";
		lf.add_list_item(list, label, n.id, -1, false, (i == 0));
		ids.insert_last(n.id);
	}

	int b_ok = lf.create_button("&" + action, true);
	int b_cancel = lf.create_button("&" + tr("ui.cancel"), false, true);
	lf.set_default_controls(b_ok, b_cancel);

	while (true)
	{
		wait(5);
		update_game_world();
		lf.monitor();

		if (key_pressed(KEY_ESCAPE) || lf.is_pressed(b_cancel))
		{
			speak(tr("ui.canceled"));
			return;
		}

		if (lf.is_pressed(b_ok))
		{
			int pos = lf.get_list_position(list);
			if (pos < 0 || pos >= int(ids.length())) return;
			npc_data@ n = find_npc_data(ids[pos]);
			if (n is null) return;

			if (confirm_delete)
			{
				if (menuquestion(tr("npc_manager.confirm_delete") + " " + n.name + "?") != 1) return;
				string removed_name = n.name;
				delete_npc_file(n.id);
				if (file_exists(CONTENTS_DAT_PATH)) encrypt_all_contents_silent();
				load_all_npcs(true);
				speak(tr("npc_manager.deleted_success"));
			}
			else
			{
				npc_edit_form(n, false);
			}
			return;
		}
	}
}

void npc_list_flow()
{
	load_all_npcs();
	if (npc_registry.length() == 0)
	{
		speak(tr("npc_manager.no_npcs_found"));
		return;
	}
	speak("Registered NPCs: " + npc_registry.length() + " total.");
	for (uint i = 0; i < npc_registry.length(); i++)
	{
		npc_data@ n = npc_registry[i];
		string desc = n.name + ", ID " + n.id + ", class " + n.npc_class;
		desc += ", damage " + n.min_damage + " to " + n.max_damage;
		desc += ", attack every " + n.attack_speed + " milliseconds";
		desc += ", detection " + n.detection_range + " tiles";
		desc += ", attack range " + n.attack_range + " tiles";
		desc += ", walk " + n.walk_speed + " milliseconds";
		desc += ", run " + n.run_speed + " milliseconds";
		desc += ", health " + n.max_health;
		desc += ", " + n.xp + " XP";
		desc += ", footsteps " + (n.use_platform_footsteps ? "from the map platform" : "custom");
		if (n.drop_items_on_death && n.death_drops != "")
			desc += ", drops " + n.death_drops;
		else
			desc += ", drops nothing";
		desc += ".";
		speak(desc);
	}
}

void npc_manager_menu()
{
	load_all_npcs();

	while (true)
	{
		audio_form mf;
		mf.create_window(tr("npc_manager.title"), false, true, false);
		int list = mf.create_list(tr("npc_manager.select_action"), 0, false, true);
		mf.add_list_item(list, tr("npc_manager.create_title"), "create");
		mf.add_list_item(list, tr("npc_manager.edit_title"), "edit");
		mf.add_list_item(list, tr("npc_manager.delete_title"), "delete");
		mf.add_list_item(list, tr("npc_manager.list_all"), "list");
		int b_select = mf.create_button("&" + tr("ui.select"), true);
		int b_back = mf.create_button("&" + tr("ui.back"), false, true);
		mf.set_default_controls(b_select, b_back);
		mf.focus(list);

		while (true)
		{
			wait(5);
			update_game_world();
			mf.monitor();

			if (key_pressed(KEY_ESCAPE) || mf.is_pressed(b_back))
				return;

			if (mf.is_pressed(b_select))
			{
				int pos = mf.get_list_position(list);
				if (pos == 0) npc_create_flow();
				else if (pos == 1) npc_select_flow(tr("npc_manager.edit_title"), tr("ui.edit"), false);
				else if (pos == 2) npc_select_flow(tr("npc_manager.delete_title"), tr("ui.delete"), true);
				else if (pos == 3) npc_list_flow();
				break;
			}
		}
	}
}
