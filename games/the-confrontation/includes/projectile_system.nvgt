// projectile_system.nvgt - 3D projectile physics and ballistics.
// Handles trajectory simulation, wall/bounds collision, range expiry and
// weapon-configured impact sounds. Targeting and damage belonged to the
// removed NPC system and are intentionally gone.

#include "rotation.nvgt"

sound_pool bulletpool;
bool bullet_pool_initialized = false;
const int MAX_ACTIVE_PROJECTILES = 500;

void ensure_bullet_pool()
{
	if (!bullet_pool_initialized)
	{
		@bulletpool.mixer = mixer();
		bulletpool.max_distance = 60.0;
		bulletpool.pan_step = SOUND_PAN_STEP;
		bulletpool.volume_step = SOUND_VOLUME_STEP;
		bulletpool.hrtf = true;
		bullet_pool_initialized = true;
	}
}

// The weapon decides what it launches. A configured "projectile" always wins;
// "auto" only derives the type for plain firearms whose ammunition already
// names it. Fuel canisters are fire, never grenades: the old canister rule made
// flamethrowers detonate as if they were grenade launchers.
string classify_projectile_type(weapon_data@ w)
{
	if (w is null) return "ballistic";
	string configured = normalize_projectile_name(w.projectile);
	if (configured != "auto") return configured;

	string at = string_to_lower_case(w.ammo_type);
	string wc = string_to_lower_case(w.wclass);
	if (wc == "energy" || wc == "energy_weapons" || wc == "laser" || wc == "plasma") return "energy";
	if (at.find("laser") >= 0 || at.find("energy") >= 0 || at.find("beam") >= 0 ||
		at.find("tesla") >= 0 || at.find("photon") >= 0 || at.find("quantum") >= 0 ||
		at.find("fusion") >= 0 || at.find("particle") >= 0 || at.find("pulse") >= 0 ||
		at.find("mw") >= 0 || at.find("gw") >= 0 || at.find("emp") >= 0)
		return "energy";
	if (at.find("plasma") >= 0) return "plasma";
	if (at.find("missile") >= 0 || at.find("javelin") >= 0 || at.find("stinger") >= 0 ||
		at.find("atgm") >= 0 || at.find("sam ") >= 0)
		return "missile";
	if (at.find("rocket") >= 0 || at.find("rpg") >= 0 || at.find("bazooka") >= 0 ||
		at.find("panzerfaust") >= 0 || at.find("gustaf") >= 0)
		return "rocket";
	if (at.find("grenade") >= 0 || at.find("40mm") >= 0 || at.find("38mm") >= 0 ||
		at.find("mortar") >= 0 || at.find("bomb") >= 0 || at.find("flare") >= 0 ||
		at.find("smoke") >= 0)
		return "grenade";
	if (at.find("incendiar") >= 0 || at.find("flame") >= 0 || at.find("fire") >= 0 ||
		at.find("dragon") >= 0 || at.find("napalm") >= 0 || at.find("thermite") >= 0 ||
		at.find("gel") >= 0 || wc == "incendiary" || wc == "flamethrower")
		return "fire";
	if (at.find("drainage") >= 0 || at.find("drenagem") >= 0 || at.find("hydro") >= 0 || at.find("drain") >= 0)
		return "drainage";
	if (at.find("bolt") >= 0 || at.find("arrow") >= 0) return "bolt";
	if (at.find("cannonball") >= 0 || at.find("cannon ball") >= 0 || at.find("round ball") >= 0) return "ball";
	return "ballistic";
}

class active_projectile
{
	double x, y, z;
	int start_z;
	int direction;
	string weapon_id;
	string wclass;
	string ammo_type;
	string projectile_type;
	string fire_mode;
	timer speedtimer;
	int speedtime;
	int range;
	int distance;
	int damage;
	int spread;

	active_projectile(double px, double py, double pz, int dir, string wid, string fmode, int dmg, int spd, int rng, int sprd)
	{
		x = px;
		y = py;
		z = pz;
		start_z = int(pz);
		weapon_id = wid;
		fire_mode = fmode;
		damage = dmg;
		speedtime = (spd > 0) ? spd : 5;
		range = (rng > 0) ? rng : 30;
		spread = sprd;
		distance = 0;

		weapon_data@ w = get_weapon_data(wid);
		if (w !is null)
		{
			wclass = w.wclass;
			ammo_type = w.ammo_type;
		}
		else
		{
			wclass = "bullet";
			ammo_type = "Standard";
		}

		projectile_type = classify_projectile_type(w);

		if (spread > 0)
			direction = int(degree_limit(double(dir) + double(random(-spread, spread)) * 0.5));
		else
			direction = dir;
	}
}

active_projectile@[] active_projectiles(0);

void spawn_projectile(double px, double py, double pz, int dir, string wid, string fmode, int dmg, int spd, int rng, int sprd)
{
	ensure_bullet_pool();
	if (active_projectiles.length() >= MAX_ACTIVE_PROJECTILES)
	{
		active_projectiles.remove_at(0);
	}
	active_projectile@ proj = active_projectile(px, py, pz, dir, wid, fmode, dmg, spd, rng, sprd);
	active_projectiles.insert_last(proj);
}

void destroy_all_projectiles()
{
	ensure_bullet_pool();
	active_projectiles.resize(0);
}

bool is_projectile_obstacle(int px, int py, int pz)
{
	if (px < minx or px > maxx) return true;
	if (py < miny or py > maxy) return true;
	if (pz < minz or pz > maxz) return true;
	string tile = get_tile_at(px, py, pz);
	if (string_contains(tile, "wall", 1) > -1) return true;
	return false;
}

bool has_line_of_sight(double x1, double y1, double z1, double x2, double y2, double z2)
{
	double dist = get_3d_distance(x1, y1, z1, x2, y2, z2);
	if (dist <= 1.0) return true;
	int steps = int(ceil(dist));
	double step_x = (x2 - x1) / double(steps);
	double step_y = (y2 - y1) / double(steps);
	double step_z = (z2 - z1) / double(steps);
	for (int s = 1; s < steps; s++)
	{
		int cx = int(round(x1 + step_x * double(s), 0));
		int cy = int(round(y1 + step_y * double(s), 0));
		int cz = int(round(z1 + step_z * double(s), 0));
		if (is_projectile_obstacle(cx, cy, cz)) return false;
	}
	return true;
}

void trigger_projectile_impact(active_projectile@ pproj)
{
	if (pproj is null) return;
	weapon_data@ w = get_weapon_data(pproj.weapon_id);
	if (w !is null && w.sound_ricochet != "")
	{
		string rico_path = get_sound_path(w.sound_ricochet);
		if (rico_path != "")
		{
			bulletpool.play_extended_3d(rico_path, me.x, me.y, me.z, pproj.x, pproj.y, pproj.z, double(facing), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 100, false);
		}
	}
}

void detonate_projectile_area(active_projectile@ pproj)
{
	if (pproj is null) return;
	weapon_data@ w = get_weapon_data(pproj.weapon_id);
	if (w !is null && w.sound_hit != "")
	{
		string hp = get_sound_path(w.sound_hit);
		if (hp != "") bulletpool.play_extended_3d(hp, me.x, me.y, me.z, pproj.x, pproj.y, pproj.z, double(facing), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 100, false);
	}
	trigger_projectile_impact(pproj);
}

void projectile_loop()
{
	ensure_bullet_pool();

	for (int i = int(active_projectiles.length()) - 1; i >= 0; i--)
	{
		if (i >= int(active_projectiles.length())) break;
		active_projectile@ pproj = active_projectiles[i];

		if (pproj.speedtimer.elapsed >= pproj.speedtime)
		{
			pproj.speedtimer.restart();

			// The whole stroke of this tick is tested, not only its end point, so a
			// shot connects with a target standing anywhere along the line it
			// travels instead of only when it lands exactly on the target's tile.
			double from_x = pproj.x;
			double from_y = pproj.y;
			double from_z = pproj.z;
			vector next_pos = move(pproj.x, pproj.y, pproj.z, pproj.direction, 0);
			pproj.x = next_pos.x;
			pproj.y = next_pos.y;
			pproj.distance++;

			bool is_area_type = (pproj.projectile_type == "missile" || pproj.projectile_type == "rocket" ||
								 pproj.projectile_type == "grenade" || pproj.projectile_type == "drainage");

			// A projectile that reaches an enemy or an ally damages it, so the
			// player can fight the NPC set with the same weapons it uses.
			if (npc_projectile_intersect(from_x, from_y, from_z, pproj.x, pproj.y, pproj.z, pproj.damage, pproj.weapon_id))
			{
				active_projectiles.remove_at(uint(i));
				continue;
			}

			if (is_projectile_obstacle(int(round(pproj.x, 0)), int(round(pproj.y, 0)), int(round(pproj.z, 0))))
			{
				if (is_area_type) detonate_projectile_area(pproj);
				else trigger_projectile_impact(pproj);
				active_projectiles.remove_at(uint(i));
				continue;
			}

			if (pproj.distance >= pproj.range)
			{
				if (is_area_type) detonate_projectile_area(pproj);
				active_projectiles.remove_at(uint(i));
				continue;
			}
		}
	}
}
