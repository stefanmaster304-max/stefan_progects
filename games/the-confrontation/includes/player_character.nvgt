// player_character.nvgt - Multi-Character Player System for The Confront
// Manages character identity, stats (HP, movement speed), audio profiles and descriptions.

const string CHAR_STEFAN = "stefan";
const string CHAR_ANNIE = "annie";
const string CHAR_ILANA = "annie"; /* Backward compatibility alias */

const string GAME_SAVE_KEY = "G4m3S4v3!2026#pR7$xT2%wQ9&mN4*bV8(nK1)zJ5-fH3+gD6=lS0_aE7@iU2^oY8$cW4";

string get_game_save_path(const string&in char_id = "")
{
    string c = char_id;
    if (c == "") c = current_player_character;
    if (c == "ilana" || c == "ylana" || c == "hane") c = "annie";
    if (c == "stefan" || c == "annie")
    {
        /* Migrate legacy gamesave_ilana.dat to gamesave_annie.dat if present */
        if (c == "annie" && !file_exists("settings/gamesave_annie.dat") && file_exists("settings/gamesave_ilana.dat"))
        {
            file_copy("settings/gamesave_ilana.dat", "settings/gamesave_annie.dat", true);
        }
        return "settings/gamesave_" + c + ".dat";
    }
    return "settings/gamesave.dat";
}

string current_player_character = "";

int get_character_base_max_health(const string&in char_id)
{
	string c = string_to_lower_case(char_id.trim_whitespace());
	if (c == "annie" || c == "ilana" || c == "ylana" || c == "hane") return 10000;
	if (c == "stefan") return 5000;
	return 5000;
}

int calculate_player_max_health(const string&in char_id, int res_count)
{
	if (res_count < 0) res_count = 0;
	return get_character_base_max_health(char_id) + (200 * res_count);
}

int get_player_modified_walktime(int base_walk)
{
	if (base_walk <= 0) base_walk = 160;
	if (current_player_character == "annie" || current_player_character == "ilana" || current_player_character == "hane")
	{
		// Annie runs 5% faster than standard (step interval is reduced by 5%)
		int wt = int(round(double(base_walk) * 0.95, 0));
		return (wt > 10) ? wt : 10;
	}
	else if (current_player_character == "stefan")
	{
		// Stefan runs slower than standard (step interval increased by 28%)
		int wt = int(round(double(base_walk) * 1.28, 0));
		return wt;
	}
	return base_walk;
}

string get_character_name(const string&in char_id)
{
	string c = string_to_lower_case(char_id.trim_whitespace());
	if (c == "annie" || c == "ilana" || c == "ylana" || c == "hane") return tr("options.character_annie");
	if (c == "stefan") return tr("options.character_stefan");
	return "";
}

string get_character_description(const string&in char_id)
{
	string c = string_to_lower_case(char_id.trim_whitespace());
	if (c == "annie" || c == "ilana" || c == "ylana" || c == "hane") return tr("options.character_annie_desc");
	if (c == "stefan") return tr("options.character_stefan_desc");
	return "";
}

void set_player_character(const string&in char_id, bool update_vitals = true)
{
	string c = string_to_lower_case(char_id.trim_whitespace());
	if (c == "ilana" || c == "ylana" || c == "hane") c = "annie";
	if (c != "annie" && c != "stefan")
	{
		current_player_character = "";
		return;
	}

	current_player_character = c;
	maxhealth = calculate_player_max_health(c, resurrections);
	if (update_vitals)
	{
		health = maxhealth;
	}
	else
	{
		if (health > maxhealth || health <= 0) health = maxhealth;
	}
	walktime = get_current_walktime();
	load_player_vital_sounds();
}
