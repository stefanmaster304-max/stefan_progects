/* includes/updater.nvgt - Update system for The Confront.
   Every download goes to the temporary update folder first, is validated and
   only then replaces the live file. Failures are retried, and the player always
   hears a specific reason. Transfer progress is announced with NVGT tone beeps. */

enum update_type
{
	UPDATE_GAME = 0,
	UPDATE_CONTENT = 1,
	UPDATE_SOUNDS = 2,
	UPDATE_MAPS = 3
}

class update_item
{
	update_type type;
	string new_version;
	string current_version;
	int new_build;
	int current_build;
	bool version_changed;
	string url;
	string zip_url;
	int64 size;
	int64 zip_size;

	update_item()
	{
		type = UPDATE_GAME;
		new_version = "";
		current_version = "";
		new_build = 0;
		current_build = 0;
		version_changed = true;
		url = "";
		zip_url = "";
		size = 0;
		zip_size = 0;
	}
}

const string UPDATE_TEMP_DIR = "update_temp";
const int UPDATE_MAX_ATTEMPTS = 3;
const string UPDATE_MANIFEST_URL_DEFAULT = "https://raw.githubusercontent.com/stefanmaster304-max/stefan_progects/main/games/the-confrontation/updates/version.json";

const int COMPILED_GAME_BUILD = 1;
string current_game_version = ver;
int current_game_build = COMPILED_GAME_BUILD;
string current_content_version = "0.6";
int current_content_build = 0;
string current_sounds_version = "0.5";
int current_sounds_build = 1;
string current_maps_version = "0.6";
int current_maps_build = 0;
int check_updates_on_startup = 1;
string update_manifest_url = UPDATE_MANIFEST_URL_DEFAULT;

void load_updater_settings()
{
	cleanup_update_temp();
	current_game_version = ver;
	current_game_build = COMPILED_GAME_BUILD;
	string saved_game_version = "";
	string cfg_path = "settings/versions.cfg";
	if (!file_exists(cfg_path))
	{
		save_updater_settings();
		return;
	}

	file f;
	if (f.open(cfg_path, "r"))
	{
		string data = f.read();
		f.close();

		data = string_replace(data, "\r\n", "\n", true);
		data = string_replace(data, "\r", "\n", true);
		string[]@ lines = string_split(data, "\n", true);
		if (lines !is null)
		{
			for (uint i = 0; i < lines.length(); i++)
			{
				string line = lines[i].trim_whitespace();
				if (line == "" || string_left(line, 1) == "#" || string_left(line, 1) == ";") continue;

				string[]@ parts = string_split(line, "=", true);
				if (parts !is null && parts.length() >= 2)
				{
					string k = parts[0].trim_whitespace().lower();
					string val = parts[1].trim_whitespace();

					if (k == "game_version")
					{
						saved_game_version = val;
						current_game_version = val;
					}
					else if (k == "game_build")
					{
						int read_b = int(string_to_number(val));
						if (read_b > current_game_build) current_game_build = read_b;
					}
					else if (k == "content_version") current_content_version = val;
					else if (k == "content_build") current_content_build = int(string_to_number(val));
					else if (k == "sounds_version") current_sounds_version = val;
					else if (k == "sounds_build") current_sounds_build = int(string_to_number(val));
					else if (k == "maps_version") current_maps_version = val;
					else if (k == "maps_build") current_maps_build = int(string_to_number(val));
					else if (k == "check_updates_on_startup") check_updates_on_startup = int(string_to_number(val));
					else if (k == "manifest_url" && val != "") update_manifest_url = val;
				}
			}
		}
	}
	if (saved_game_version != "" && saved_game_version != ver) current_game_build = COMPILED_GAME_BUILD;
	current_game_version = ver;
	save_updater_settings();
}

void save_updater_settings()
{
	current_game_version = ver;
	if (!directory_exists("settings")) directory_create("settings");

	file f;
	if (f.open("settings/versions.cfg", "w"))
	{
		f.write("# The Confront Version and Update Settings\n");
		f.write("game_version=" + current_game_version + "\n");
		f.write("game_build=" + current_game_build + "\n");
		f.write("content_version=" + current_content_version + "\n");
		f.write("content_build=" + current_content_build + "\n");
		f.write("sounds_version=" + current_sounds_version + "\n");
		f.write("sounds_build=" + current_sounds_build + "\n");
		f.write("maps_version=" + current_maps_version + "\n");
		f.write("maps_build=" + current_maps_build + "\n");
		f.write("check_updates_on_startup=" + check_updates_on_startup + "\n");
		f.write("manifest_url=" + update_manifest_url + "\n");
		f.close();
	}
}

int compare_versions(const string&in v1, const string&in v2)
{
	if (v1 == v2) return 0;
	if (v1 == "") return (v2 == "") ? 0 : 1;
	if (v2 == "") return -1;

	string[]@ parts1 = string_split(v1, ".", true);
	string[]@ parts2 = string_split(v2, ".", true);

	uint max_len = (parts1.length() > parts2.length()) ? parts1.length() : parts2.length();
	for (uint i = 0; i < max_len; i++)
	{
		int n1 = 0;
		int n2 = 0;
		if (i < parts1.length()) n1 = int(string_to_number(parts1[i]));
		if (i < parts2.length()) n2 = int(string_to_number(parts2[i]));

		if (n2 > n1) return 1;
		if (n2 < n1) return -1;
	}
	return 0;
}

string format_byte_size(int64 bytes)
{
	if (bytes <= 0) return "unknown size";
	if (bytes >= 1073741824)
	{
		double gb = double(bytes) / 1073741824.0;
		return round(gb, 2) + " gigabytes";
	}
	if (bytes >= 1048576)
	{
		double mb = double(bytes) / 1048576.0;
		return round(mb, 1) + " megabytes";
	}
	if (bytes >= 1024)
	{
		double kb = double(bytes) / 1024.0;
		return round(kb, 1) + " kilobytes";
	}
	return bytes + " bytes";
}

sound updater_audio;
bool bypass_missing_sounds_check = false;

void play_update_found_sound()
{
	string snd = "sounds/updater/updatFound.ogg";
	if (!file_exists(snd)) snd = "sounds/updater/updatefound.ogg";
	if (!file_exists(snd)) snd = get_sound_path("updater/updatFound.ogg;updater/updatefound.ogg;sounds/updater/updatFound.ogg");
	if (snd != "" && updater_audio.load(snd))
	{
		updater_audio.play();
	}
	else
	{
		updater_beep(950, 120);
	}
}

void play_update_complete_sound()
{
	string snd = "sounds/updater/updatecomplete.ogg";
	if (!file_exists(snd)) snd = get_sound_path("updater/updatecomplete.ogg;sounds/updater/updatecomplete.ogg");
	if (snd != "" && updater_audio.load(snd))
	{
		updater_audio.play();
	}
	else
	{
		updater_beep(1400, 120);
	}
}

void wait_for_update_complete_sound()
{
	while (updater_audio.playing)
	{
		wait(20);
	}
	wait(200);
}

upcoming::sound@ progress_sound;

string powershell_literal(const string&in value)
{
	return "'" + string_replace(value, "'", "''", true) + "'";
}

process@ start_hidden_powershell(const string&in command, const string&in script_path = "")
{
	string[] args = {"powershell.exe", "-NoLogo", "-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden", "-ExecutionPolicy", "Bypass"};
	if (script_path != "")
	{
		args.insert_last("-File");
		args.insert_last(script_path);
	}
	else
	{
		args.insert_last("-Command");
		args.insert_last(command);
	}
	return run(args, PROCESS_BACKGROUND, cwdir());
}

bool wait_for_hidden_process(process@ child, bool progress_beeps = false)
{
	if (child is null || !child.valid) return false;
	double progress = 5.0;
	timer beep_timer;
	while (child.running)
	{
		wait(25);
		update_game_world();
		if (progress_beeps && beep_timer.elapsed >= 350)
		{
			beep_timer.restart();
			beep_percentage(progress);
			if (progress < 95.0) progress += 3.0;
		}
	}
	int exit_code = child.wait();
	if (progress_beeps && exit_code == 0) beep_percentage(100.0);
	return exit_code == 0;
}

bool extract_update_archive(const string&in archive_path, const string&in destination, bool progress_beeps = false)
{
	if (archive_path == "" || destination == "") return false;
	if (!directory_exists(UPDATE_TEMP_DIR) && !directory_create(UPDATE_TEMP_DIR)) return false;
	string command = "$ErrorActionPreference='Stop'; try { Add-Type -AssemblyName System.IO.Compression.FileSystem; $archive=" + powershell_literal(archive_path) + "; $destination=" + powershell_literal(destination) + "; if(!(Test-Path -LiteralPath $archive -PathType Leaf)){throw 'Archive file not found'}; if(Test-Path -LiteralPath $destination){Remove-Item -LiteralPath $destination -Recurse -Force}; [System.IO.Directory]::CreateDirectory($destination) | Out-Null; [System.IO.Compression.ZipFile]::ExtractToDirectory($archive,$destination); exit 0 } catch { $_ | Out-String | Set-Content -LiteralPath 'update_temp/extract_error.txt'; exit 1 }";
	process@ child = start_hidden_powershell(command);
	return wait_for_hidden_process(child, progress_beeps);
}

bool extract_sound_archive(const string&in archive_path, const string&in destination, bool progress_beeps = false)
{
	if (archive_path == "" || destination == "") return false;
	if (!directory_exists(UPDATE_TEMP_DIR) && !directory_create(UPDATE_TEMP_DIR)) return false;
	string command = "$ErrorActionPreference='Stop'; try { Add-Type -AssemblyName System.IO.Compression.FileSystem; $archive=" + powershell_literal(archive_path) + "; $destination=" + powershell_literal(destination) + "; if(Test-Path -LiteralPath $destination){Remove-Item -LiteralPath $destination -Recurse -Force}; [System.IO.Directory]::CreateDirectory($destination)|Out-Null; $soundRoot=[System.IO.Path]::GetFullPath((Join-Path $destination 'sounds')); [System.IO.Directory]::CreateDirectory($soundRoot)|Out-Null; $rootPrefix=$soundRoot.TrimEnd([System.IO.Path]::DirectorySeparatorChar)+[System.IO.Path]::DirectorySeparatorChar; $zip=[System.IO.Compression.ZipFile]::OpenRead($archive); $count=0; try { foreach($entry in $zip.Entries){ if(!$entry.FullName.StartsWith('sounds/',[System.StringComparison]::OrdinalIgnoreCase) -or $entry.FullName.EndsWith('/')){continue}; $relative=$entry.FullName.Substring(7).Replace('/',[System.IO.Path]::DirectorySeparatorChar); if($relative -eq ''){continue}; $target=[System.IO.Path]::GetFullPath((Join-Path $soundRoot $relative)); if(!$target.StartsWith($rootPrefix,[System.StringComparison]::OrdinalIgnoreCase)){throw 'Unsafe sound archive path'}; [System.IO.Directory]::CreateDirectory([System.IO.Path]::GetDirectoryName($target))|Out-Null; $input=$entry.Open(); try{$output=[System.IO.File]::Open($target,[System.IO.FileMode]::Create,[System.IO.FileAccess]::Write,[System.IO.FileShare]::None); try{$input.CopyTo($output)}finally{$output.Dispose()}}finally{$input.Dispose()}; $count++ } } finally{$zip.Dispose()}; if($count -eq 0){throw 'Archive contains no sounds directory entries'}; exit 0 } catch { $_ | Out-String | Set-Content -LiteralPath 'update_temp/extract_sounds_error.txt'; exit 1 }";
	process@ child = start_hidden_powershell(command);
	return wait_for_hidden_process(child, progress_beeps);
}

void cleanup_update_temp()
{
	for (int attempt = 0; attempt < 4 && directory_exists(UPDATE_TEMP_DIR); attempt++)
	{
		directory_delete(UPDATE_TEMP_DIR, true);
		if (directory_exists(UPDATE_TEMP_DIR)) wait(250);
	}
	// Older builds downloaded the bootstrap archive into the game root.
	if (file_exists("sounds.zip")) file_delete("sounds.zip");
	if (file_exists("run_extract_sounds.bat")) file_delete("run_extract_sounds.bat");
	if (file_exists("run_extract_update.bat")) file_delete("run_extract_update.bat");
	if (file_exists("stage_sounds.bat")) file_delete("stage_sounds.bat");
	if (file_exists("swap_sounds.bat")) file_delete("swap_sounds.bat");
	if (file_exists("extract_done.flag")) file_delete("extract_done.flag");
	if (file_exists("apply_game_update.bat")) file_delete("apply_game_update.bat");
	if (file_exists("apply_sounds.bat")) file_delete("apply_sounds.bat");
	if (file_exists("sounds_applied.flag")) file_delete("sounds_applied.flag");
	if (file_exists("tcf.exe.old")) file_delete("tcf.exe.old");
	if (file_exists("game_update_done.flag")) file_delete("game_update_done.flag");
	if (file_exists("game_update_failed.flag")) file_delete("game_update_failed.flag");
}

/* NVDA-style rising pitch progress bar tone */
void beep_percentage(double val, double volume = 0.20)
{
	val = round(val, 0);
	if (val < 0) val = 0;
	if (val > 100) val = 100;
	/* NVDA progress bar formula: 110 Hz base doubling every 25% (A2 110Hz to A6 1760Hz) */
	double freq = 110.0 * (2.0 ** (val / 25.0));
	tone_synth sy;
	sy.waveform_type = 0; /* Pure sine wave */
	sy.volume = volume;
	sy.set_edge_fades(2, 2);
	sy.freq_ms(freq, 40);
	@progress_sound = sy.write_wave_sound();
	sy.reset();
	if (progress_sound !is null) progress_sound.play();
}

string dl_file(string url, string disk_file, bool quiet = false, string msg = "")
{
	if (msg == "") msg = tr("updater.download_help");
	internet_request r(url, disk_file);
	if (!quiet) speak(msg);
	double last_percentage = 0;
	int progbeeps = 1;
	string status = "";
	while (r.complete != true)
	{
		wait(5);
		if (r.download_percent == r.download_percent && r.download_percent >= 0 && (r.download_percent - last_percentage) >= 1)
		{
			if (progbeeps == 1 && r.download_percent > 0) beep_percentage(r.download_percent);
			last_percentage = r.download_percent;
		}
		if (key_pressed(KEY_ESCAPE))
		{
			status = "canceled";
			speak(tr("updater.cancelled"));
			return status;
		}
		if (key_pressed(KEY_1))
		{
			string size = round(r.download_size / 1024 / 1024, 0) + " MB";
			speak(tr("updater.file_size") + ": " + size);
		}
		if (key_pressed(KEY_2))
		{
			string size = round(r.bytes_downloaded / 1024 / 1024, 0) + " MB";
			speak(tr("updater.total_downloaded") + ": " + size);
		}
		if (key_pressed(KEY_3))
		{
			string size = (round(r.download_size / 1024 / 1024, 0) - round(r.bytes_downloaded / 1024 / 1024, 0)) + " MB";
			speak(tr("updater.total_remaining") + ": " + size);
		}
		if (key_pressed(KEY_H))
		{
			speak(msg);
		}
		if (key_pressed(KEY_M))
		{
			if (progbeeps == 1)
			{
				progbeeps = 0;
				speak(tr("updater.beeps_muted"));
			}
			else if (progbeeps == 0)
			{
				progbeeps = 1;
				speak(tr("updater.beeps_unmuted"));
			}
		}
		if (key_pressed(KEY_SPACE))
		{
			if (r.download_percent == r.download_percent && r.download_percent >= 0)
			{
				speak(round(r.download_percent, 0) + " " + tr("updater.percent_downloaded"));
			}
			else
			{
				speak(tr("updater.progress_unavailable"));
			}
		}
		if (r.complete == true)
		{
			status = "finished";
		}
	}
	return status;
}

bool are_game_sounds_installed()
{
	if (file_exists("sounds.dw") || file_exists("settings/sounds.dw")) return true;
	return sound_directory_is_valid("sounds");
	}

bool sound_directory_is_valid(const string&in root)
{
	string[] expected_dirs = {"anbients", "weapons", "players", "menu sounds", "map platforms"};
	for (uint i = 0; i < expected_dirs.length(); i++)
	{
		string path = root + "/" + expected_dirs[i];
		if (!directory_exists(path)) continue;
		string[]@ files = find_files(path + "/*");
		if (files !is null && files.length() > 0) return true;
		string[]@ subdirs = find_directories(path + "/*");
		if (subdirs !is null)
		{
			for (uint d = 0; d < subdirs.length(); d++)
			{
				string[]@ nested = find_files(subdirs[d] + "/*");
				if (nested !is null && nested.length() > 0) return true;
			}
		}
	}
	return false;
}

bool get_sound_package_metadata(string&out url, int64&out expected_size)
{
	url = "";
	expected_size = 0;
	string body = "", error_message = "";
	if (fetch_manifest(body, error_message) != 0) return false;
	var@ parsed = parse_json(body);
	if (parsed is null) return false;
	json_object@ root = parsed;
	if (root is null || !root.is_object("sounds")) return false;
	json_object@ sounds = root.get_object("sounds");
	url = sounds["url"];
	string size = sounds["size"];
	if (size != "") expected_size = int64(string_to_number(size));
	return url != "" && expected_size > 0;
}

bool install_sound_directory(const string&in source_dir)
{
	if (!sound_directory_is_valid(source_dir)) return false;
	updater_audio.stop();
	updater_audio.close();
	string stage_command = "$ErrorActionPreference='Stop'; function Copy-SoundTree([string]$from,[string]$to){[System.IO.Directory]::CreateDirectory($to)|Out-Null; foreach($entry in [System.IO.Directory]::EnumerateFileSystemEntries($from)){if([System.IO.Directory]::Exists($entry)){Copy-SoundTree $entry (Join-Path $to ([System.IO.Path]::GetFileName($entry)))}else{[System.IO.File]::Copy($entry,(Join-Path $to ([System.IO.Path]::GetFileName($entry))),$true)}}}; try { if(!(Test-Path -LiteralPath " + powershell_literal(source_dir) + " -PathType Container)){throw 'Extracted sound folder not found'}; if(Test-Path -LiteralPath 'sounds.new'){Remove-Item -LiteralPath 'sounds.new' -Recurse -Force}; Copy-SoundTree " + powershell_literal(source_dir) + " 'sounds.new'; exit 0 } catch { $_ | Out-String | Set-Content -LiteralPath 'update_temp/sounds_stage_error.txt'; exit 1 }";
	process@ stage_process = start_hidden_powershell(stage_command);
	if (!wait_for_hidden_process(stage_process, true) || !sound_directory_is_valid("sounds.new")) return false;
	file swap_script;
	if (!swap_script.open(UPDATE_TEMP_DIR + "/swap_sounds.ps1", "w")) return false;
	swap_script.write("$ErrorActionPreference='Stop'\r\n$root=(Get-Location).Path\r\n$live=Join-Path $root 'sounds'\r\n$new=Join-Path $root 'sounds.new'\r\n$backup=Join-Path $root 'sounds.old'\r\n$hadLive=Test-Path -LiteralPath $live\r\n$movedOld=$false\r\n$installedNew=$false\r\ntry { if(Test-Path -LiteralPath $backup){Remove-Item -LiteralPath $backup -Recurse -Force}; if($hadLive){Move-Item -LiteralPath $live -Destination $backup; $movedOld=$true}; Move-Item -LiteralPath $new -Destination $live; $installedNew=$true; if(!(Test-Path -LiteralPath $live)){throw 'Sound directory swap failed'}; if(Test-Path -LiteralPath $backup){Remove-Item -LiteralPath $backup -Recurse -Force}; exit 0 } catch { $_ | Out-String | Set-Content -LiteralPath 'update_temp/sounds_swap_error.txt'; if($installedNew -and (Test-Path -LiteralPath $live)){Remove-Item -LiteralPath $live -Recurse -Force}; if($movedOld -and (Test-Path -LiteralPath $backup) -and !(Test-Path -LiteralPath $live)){Move-Item -LiteralPath $backup -Destination $live}; exit 1 }\r\n");
	swap_script.close();
	if (!wait_for_hidden_process(start_hidden_powershell("", UPDATE_TEMP_DIR + "/swap_sounds.ps1"))) return false;
	return are_game_sounds_installed();
}

bool check_and_prompt_missing_sounds()
{
	if (are_game_sounds_installed()) return true;

	string prompt = tr("updater.sounds_not_found_prompt", "Os sons do jogo não foram encontrados. Deseja fazer o download dos sons do jogo? Pressione Y ou Enter para Sim, ou Escape para continuar sem sons.");
	speak(prompt);
	while (key_down(KEY_RETURN) || key_down(KEY_NUMPAD_ENTER) || kb_down("use") || kb_down("menu_activate")) wait(5);

	bool user_accepted = false;
	while (true)
	{
		wait(5);
		if (key_pressed(KEY_Y) || key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER) || key_pressed(KEY_NUMPAD_ENTER))
		{
			user_accepted = true;
			break;
		}
		if (key_pressed(KEY_ESCAPE) || key_pressed(KEY_N))
		{
			user_accepted = false;
			break;
		}
		if (key_pressed(KEY_SPACE) || key_pressed(KEY_UP) || key_pressed(KEY_DOWN) || key_pressed(KEY_LEFT) || key_pressed(KEY_RIGHT))
		{
			speak(prompt);
		}
	}

	if (!user_accepted)
	{
		bypass_missing_sounds_check = true;
		speak(tr("updater.continuing_without_sounds", "Continuando sem sons."));
		return false;
	}

	ensure_clean_update_temp();
	string sound_file = UPDATE_TEMP_DIR + "/sounds.zip";
	if (file_exists(sound_file) && file_get_size(sound_file) > 1048576 && validate_sound_archive(sound_file))
	{
		speak(tr("updater.sound_already_downloaded", "Pacote de sons já baixado. Iniciando extração."));
	}
	else
	{
		string sound_url = "";
		int64 expected_size = 0;
		if (!get_sound_package_metadata(sound_url, expected_size))
		{
			speak(tr("updater.error_dialog", {tr("updater.manifest_unavailable")}));
			cleanup_update_temp();
			bypass_missing_sounds_check = true;
			return false;
		}
		string result = dl_file(sound_url, sound_file);

		if (result != "finished" || !file_exists(sound_file) || file_get_size(sound_file) != expected_size || !validate_sound_archive(sound_file))
		{
			speak(tr("updater.download_failed", "Download falhou ou foi cancelado."));
			if (file_exists(sound_file)) file_delete(sound_file);
			cleanup_update_temp();
			bypass_missing_sounds_check = true;
			return false;
		}
		speak(tr("updater.download_complete", "Download concluído com sucesso."));
	}

	speak(tr("updater.extracting_sounds", "Extraindo o pacote de sons. Aguarde..."));
	string extract_dir = UPDATE_TEMP_DIR + "/sound_bootstrap";
	if (!extract_sound_archive(sound_file, extract_dir, true))
	{
		speak(tr("updater.sound_extract_failed", "The sound archive could not be extracted."));
		if (file_exists(sound_file)) file_delete(sound_file);
		cleanup_update_temp();
		bypass_missing_sounds_check = true;
		return false;
	}
	if (!install_sound_directory(extract_dir + "/sounds"))
	{
		speak(tr("updater.sound_install_failed", "The sound files could not be installed. Existing sounds were kept."));
		if (file_exists(sound_file)) file_delete(sound_file);
		cleanup_update_temp();
		bypass_missing_sounds_check = true;
		return false;
	}
	wait(120);
	play_update_complete_sound();

	if (are_game_sounds_installed())
	{
		speak(tr("updater.extraction_complete", "Extração concluída com sucesso. O jogo agora será reiniciado."));
		if (file_exists(sound_file)) file_delete(sound_file);
		cleanup_update_temp();
		wait_for_update_complete_sound();
		restart_game_client();
		return true;
	}

	speak(tr("updater.corrupt_sound", "Falha ao extrair o pacote de sons."));
	cleanup_update_temp();
	bypass_missing_sounds_check = true;
	return false;
}

/* Native NVGT tone generator with smooth sine waveform and gentle edge fades */
void updater_beep(int frequency, int duration)
{
	tone_synth tone;
	tone.waveform_type = 1; /* Soft sine wave */
	tone.volume = 0.20;
	tone.set_edge_fades(4, 4);
	tone.freq_ms(frequency, duration);
	tone.write_wave_sound().play_wait();
}

void ensure_clean_update_temp()
{
	cleanup_update_temp();
	if (!directory_exists(UPDATE_TEMP_DIR)) directory_create(UPDATE_TEMP_DIR);
}

/* Downloads with validation and up to three attempts. A corrupt or incomplete
   file is deleted and downloaded again before the player is told anything failed. */
bool download_update_file(const string&in url, const string&in dest, int64 expected_size, string&out error_message)
{
	error_message = "";
	if (url == "") { error_message = "The update entry has no download address."; return false; }
	if (dest == "") { error_message = "The update has no destination file."; return false; }

	for (int attempt = 1; attempt <= UPDATE_MAX_ATTEMPTS; attempt++)
	{
		if (file_exists(dest)) file_delete(dest);
		string result = dl_file(url, dest);
		if (result == "canceled")
		{
			if (file_exists(dest)) file_delete(dest);
			error_message = "Update cancelled.";
			return false;
		}

		int64 size = file_exists(dest) ? file_get_size(dest) : 0;
		if (result == "finished" && size > 0 && (expected_size <= 0 || size == expected_size))
		{
			updater_beep(1250, 90);
			return true;
		}

		if (attempt < UPDATE_MAX_ATTEMPTS)
		{
			speak("Download failed. Retrying, attempt " + (attempt + 1) + " of " + UPDATE_MAX_ATTEMPTS + ".");
			wait(500);
		}
	}
	error_message = "Download failed after multiple attempts.";
	updater_beep(220, 300);
	return false;
}

bool file_starts_with_bytes(const string&in path, const string&in expected)
{
	if (!file_exists(path) || expected == "") return false;
	file f;
	if (!f.open(path, "rb")) return false;
	string head = f.read(expected.length());
	f.close();
	return head == expected;
}

bool validate_sound_archive(const string&in path)
{
	if (!file_exists(path)) return false;
	if (file_get_size(path) < 1024) return false;
	return file_starts_with_bytes(path, "PK");
}

bool validate_game_executable(const string&in path)
{
	if (!file_exists(path)) return false;
	if (file_get_size(path) < 102400) return false;
	return file_starts_with_bytes(path, "MZ");
}

bool validate_maps_file(const string&in path)
{
	if (!file_exists(path)) return false;
	file f;
	if (!f.open(path, "rb")) return false;
	string enc = f.read();
	f.close();
	if (enc.length() == 0) return false;
	string dec = string_decrypt(enc, MAP_ENC_KEY);
	return (dec.length() > 0 && dec.find("[map:") >= 0);
}

void restart_game_client()
{
	wait(200);
	if (SCRIPT_COMPILED) run("tcf.exe", "", false, false);
	else run("nvgt", "tcf.nvgt", false, false);
	exit();
}

bool confirm_update_download(update_item@ item, const string&in message)
{
	if (item is null) return false;
	string[] title_args = {item.new_version};
	audio_form form;
	form.create_window(tr("updater.update_prompt_title", title_args), false, true, false);
	int update = form.create_button("&" + tr("updater.update_now"), true);
	int cancel = form.create_button("&" + tr("ui.cancel"), false, true);
	form.set_default_controls(update, cancel);
	form.focus(update);
	speak(message);
	while (true)
	{
		wait(5);
		update_game_world();
		form.monitor();
		if (key_pressed(KEY_ESCAPE) || form.is_pressed(cancel)) { speak(tr("updater.cancelled")); return false; }
		if (key_pressed(KEY_Y) || key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER) || key_pressed(KEY_NUMPAD_ENTER) || form.is_pressed(update)) return true;
	}
	return false;
}

void remove_legacy_content_bundles()
{
	if (file_exists("settings/items.dat")) file_delete("settings/items.dat");
	if (file_exists("settings/weapons.dat")) file_delete("settings/weapons.dat");
	if (file_exists("settings/shops.dat")) file_delete("settings/shops.dat");
	if (file_exists("settings/stores.dat")) file_delete("settings/stores.dat");
	if (file_exists("settings/packages.dat")) file_delete("settings/packages.dat");
	if (file_exists("data/items.dat")) file_delete("data/items.dat");
	if (file_exists("data/weapons.dat")) file_delete("data/weapons.dat");
	if (file_exists("data/shops.dat")) file_delete("data/shops.dat");
	if (file_exists("data/stores.dat")) file_delete("data/stores.dat");
	if (file_exists("data/packages.dat")) file_delete("data/packages.dat");
}

bool apply_game_update(update_item@ item)
{
	if (item is null) return false;
	if (item.zip_url == "" || item.zip_size <= 0)
	{
		speak(tr("updater.game_zip_missing"));
		return false;
	}
	string temp_payload = UPDATE_TEMP_DIR + "/game_update_payload.zip";
	string error_message = "";
	if (!download_update_file(item.zip_url, temp_payload, item.zip_size, error_message))
	{
		speak(error_message);
		cleanup_update_temp();
		return false;
	}

	if (!validate_sound_archive(temp_payload))
	{
		speak(tr("updater.corrupt_game_zip"));
		cleanup_update_temp();
		return false;
	}

	string staged_game = UPDATE_TEMP_DIR + "/game_staged";
	if (directory_exists(staged_game)) directory_delete(staged_game, true);
	if (!directory_create(staged_game) || !extract_update_archive(temp_payload, staged_game, true))
	{
		speak(tr("updater.game_archive_extract_failed"));
		cleanup_update_temp();
		return false;
	}
	string validation_error = "";
	if (!validate_game_executable(staged_game + "/tcf.exe")) validation_error = tr("updater.game_archive_exe_invalid");
	else if (!validate_contents_file(staged_game + "/settings/contents.dat")) validation_error = tr("updater.game_archive_contents_invalid");
	else if (!validate_maps_file(staged_game + "/settings/maps.dat")) validation_error = tr("updater.game_archive_maps_invalid");
	else if (!directory_exists(staged_game + "/lib")) validation_error = tr("updater.game_archive_library_missing");
	if (validation_error != "")
	{
		speak(tr("updater.game_install_failed") + " " + validation_error);
		cleanup_update_temp();
		return false;
	}

	file installer;
	if (!installer.open(UPDATE_TEMP_DIR + "/install_game_update.ps1", "w"))
	{
		speak(tr("updater.game_install_failed"));
		cleanup_update_temp();
		return false;
	}
	installer.write("$ErrorActionPreference='Stop'\r\n$root=(Get-Location).Path\r\n$stage=Join-Path $root 'update_temp\\game_staged'\r\n$backup=Join-Path $root 'update_temp\\game_backup'\r\nwhile(Get-Process -Name 'tcf' -ErrorAction SilentlyContinue){Start-Sleep -Milliseconds 250}\r\nNew-Item -ItemType Directory -Force -Path $backup | Out-Null\r\n$paths=@('tcf.exe','lib','settings\\contents.dat','settings\\maps.dat','settings\\versions.cfg','settings\\languages','settings\\docs')\r\n$installed=New-Object System.Collections.Generic.List[string]\r\ntry { foreach($rel in $paths) { $src=Join-Path $stage $rel; if(!(Test-Path -LiteralPath $src)) { continue }; $dst=Join-Path $root $rel; $bak=Join-Path $backup $rel; $parent=Split-Path -Parent $dst; if(!(Test-Path -LiteralPath $parent)){New-Item -ItemType Directory -Force -Path $parent | Out-Null}; if(Test-Path -LiteralPath $dst){$bp=Split-Path -Parent $bak; if(!(Test-Path -LiteralPath $bp)){New-Item -ItemType Directory -Force -Path $bp | Out-Null}; Move-Item -LiteralPath $dst -Destination $bak -Force}; $installed.Add($rel); Move-Item -LiteralPath $src -Destination $dst -Force }; if(!(Test-Path -LiteralPath (Join-Path $root 'tcf.exe'))){throw 'Missing installed executable'}; New-Item -ItemType File -Force -Path (Join-Path $root 'game_update_done.flag') | Out-Null; Start-Process -FilePath (Join-Path $root 'tcf.exe') -WorkingDirectory $root } catch { $rollback=$installed.ToArray(); [array]::Reverse($rollback); foreach($rel in $rollback) { $dst=Join-Path $root $rel; $bak=Join-Path $backup $rel; if(Test-Path -LiteralPath $dst){Remove-Item -LiteralPath $dst -Recurse -Force}; if(Test-Path -LiteralPath $bak){$parent=Split-Path -Parent $dst; if(!(Test-Path -LiteralPath $parent)){New-Item -ItemType Directory -Force -Path $parent | Out-Null}; Move-Item -LiteralPath $bak -Destination $dst -Force} }; if(Test-Path -LiteralPath (Join-Path $root 'tcf.exe')){Start-Process -FilePath (Join-Path $root 'tcf.exe') -WorkingDirectory $root}; New-Item -ItemType File -Force -Path (Join-Path $root 'game_update_failed.flag') | Out-Null; exit 1 }\r\n");
	installer.close();
	play_update_complete_sound();
	speak(tr("updater.game_restart"));
	wait_for_update_complete_sound();
	process@ installer_process = start_hidden_powershell("", UPDATE_TEMP_DIR + "/install_game_update.ps1");
	if (installer_process is null || !installer_process.valid)
	{
		speak(tr("updater.game_installer_launch_failed"));
		return false;
	}
	exit();
	return true;
}

bool apply_content_update(update_item@ item)
{
	string temp_contents = UPDATE_TEMP_DIR + "/contents_payload";
	string error_message = "";
	if (!download_update_file(item.url, temp_contents, item.size, error_message)) { speak(error_message); cleanup_update_temp(); return false; }

	string final_content_file = temp_contents;
	/* If downloaded payload is a zip archive, extract contents.dat */
	if (validate_sound_archive(temp_contents))
	{
		string extract_dir = UPDATE_TEMP_DIR + "/extracted_content";
		if (!extract_update_archive(temp_contents, extract_dir))
		{
			speak(tr("updater.corrupt_content"));
			cleanup_update_temp();
			return false;
		}
		if (file_exists(extract_dir + "/contents.dat")) final_content_file = extract_dir + "/contents.dat";
		else if (file_exists(extract_dir + "/settings/contents.dat")) final_content_file = extract_dir + "/settings/contents.dat";
	}

	if (!validate_contents_file(final_content_file))
	{
		speak(tr("updater.corrupt_content"));
		cleanup_update_temp();
		return false;
	}

	if (!directory_exists("settings")) directory_create("settings");
	string staged_contents = CONTENTS_DAT_PATH + ".new";
	string backup_contents = CONTENTS_DAT_PATH + ".bak";
	if (!file_copy(final_content_file, staged_contents, true) || !validate_contents_file(staged_contents))
	{
		speak(tr("updater.corrupt_content"));
		cleanup_update_temp();
		return false;
	}
	bool had_contents = file_exists(CONTENTS_DAT_PATH);
	if (had_contents && !file_copy(CONTENTS_DAT_PATH, backup_contents, true))
	{
		file_delete(staged_contents);
		speak(tr("updater.install_failed"));
		cleanup_update_temp();
		return false;
	}
	if (!file_copy(staged_contents, CONTENTS_DAT_PATH, true))
	{
		if (had_contents) file_copy(backup_contents, CONTENTS_DAT_PATH, true);
		file_delete(staged_contents);
		speak(tr("updater.install_failed"));
		cleanup_update_temp();
		return false;
	}
	file_delete(staged_contents);
	if (file_exists(backup_contents)) file_delete(backup_contents);
	remove_legacy_content_bundles();
	cleanup_update_temp();

	current_content_version = item.new_version;
	current_content_build = item.new_build;
	save_updater_settings();
	play_update_complete_sound();
	speak(tr("updater.content_restart"));
	wait_for_update_complete_sound();
	restart_game_client();
	return true;
}

bool apply_sounds_update(update_item@ item)
{
	string temp_zip = UPDATE_TEMP_DIR + "/sounds.zip";
	string error_message = "";
	if (!download_update_file(item.url, temp_zip, item.size, error_message)) { speak(error_message); cleanup_update_temp(); return false; }

	if (!validate_sound_archive(temp_zip))
	{
		speak(tr("updater.corrupt_sound"));
		cleanup_update_temp();
		return false;
	}

	speak(tr("updater.extracting_sounds", "Extraindo o pacote de sons. Aguarde..."));
	string extract_dir = UPDATE_TEMP_DIR + "/extracted";
	if (!extract_sound_archive(temp_zip, extract_dir, true))
	{
		speak(tr("updater.sound_extract_failed", "The sound archive could not be extracted. Existing sounds were kept."));
		cleanup_update_temp();
		return false;
	}
	wait(120);

	string source_dir = "";
	if (directory_exists(extract_dir + "/sounds")) source_dir = extract_dir + "/sounds";
	else if (directory_exists(extract_dir)) source_dir = extract_dir;

	string[]@ extracted_files = (source_dir != "") ? find_files(source_dir + "/*") : null;
	string[]@ extracted_dirs = (source_dir != "") ? find_directories(source_dir + "/*") : null;
	int extracted_count = 0;
	if (extracted_files !is null) extracted_count += extracted_files.length();
	if (extracted_dirs !is null) extracted_count += extracted_dirs.length();
	if (source_dir == "" || extracted_count == 0 || !sound_directory_is_valid(source_dir))
	{
		speak(tr("updater.sound_extract_failed", "O pacote de sons não pôde ser extraído. Os sons atuais foram mantidos."));
		cleanup_update_temp();
		return false;
	}

	if (!install_sound_directory(source_dir))
	{
		speak(tr("updater.sound_install_failed", "The new sound files could not be installed. Existing sounds were kept."));
		cleanup_update_temp();
		return false;
	}

	current_sounds_version = item.new_version;
	current_sounds_build = item.new_build;
	save_updater_settings();
	cleanup_update_temp();

	play_update_complete_sound();
	speak(tr("updater.sound_restart"));
	wait_for_update_complete_sound();
	restart_game_client();
	return true;
}

bool apply_maps_update(update_item@ item)
{
	string temp_maps = UPDATE_TEMP_DIR + "/maps_payload";
	string error_message = "";
	if (!download_update_file(item.url, temp_maps, item.size, error_message)) { speak(error_message); cleanup_update_temp(); return false; }

	string final_maps_file = temp_maps;
	/* If downloaded payload is a zip archive, extract maps.dat */
	if (validate_sound_archive(temp_maps))
	{
		string extract_dir = UPDATE_TEMP_DIR + "/extracted_maps";
		if (!extract_update_archive(temp_maps, extract_dir))
		{
			speak(tr("updater.corrupt_map"));
			cleanup_update_temp();
			return false;
		}
		if (file_exists(extract_dir + "/maps.dat")) final_maps_file = extract_dir + "/maps.dat";
		else if (file_exists(extract_dir + "/settings/maps.dat")) final_maps_file = extract_dir + "/settings/maps.dat";
	}

	if (!validate_maps_file(final_maps_file))
	{
		speak(tr("updater.corrupt_map"));
		cleanup_update_temp();
		return false;
	}

	if (!directory_exists("settings")) directory_create("settings");
	string staged_maps = MAPS_DAT_PATH + ".new";
	string backup_maps = MAPS_DAT_PATH + ".bak";
	if (!file_copy(final_maps_file, staged_maps, true) || !validate_maps_file(staged_maps))
	{
		speak(tr("updater.corrupt_map"));
		cleanup_update_temp();
		return false;
	}
	bool had_maps = file_exists(MAPS_DAT_PATH);
	if (had_maps && !file_copy(MAPS_DAT_PATH, backup_maps, true))
	{
		file_delete(staged_maps);
		speak(tr("updater.install_failed"));
		cleanup_update_temp();
		return false;
	}
	if (!file_copy(staged_maps, MAPS_DAT_PATH, true))
	{
		if (had_maps) file_copy(backup_maps, MAPS_DAT_PATH, true);
		file_delete(staged_maps);
		speak(tr("updater.install_failed"));
		cleanup_update_temp();
		return false;
	}
	file_delete(staged_maps);
	if (file_exists(backup_maps)) file_delete(backup_maps);
	if (file_exists("data/maps.dat")) file_delete("data/maps.dat");
	if (file_exists("maps.dat")) file_delete("maps.dat");
	cleanup_update_temp();

	current_maps_version = item.new_version;
	current_maps_build = item.new_build;
	save_updater_settings();
	play_update_complete_sound();
	speak(tr("updater.map_restart"));
	wait_for_update_complete_sound();
	restart_game_client();
	return true;
}

bool download_and_apply_update(update_item@ item)
{
	if (item is null || item.url == "")
	{
		speak("Error: This update has no download address.");
		return false;
	}

	ensure_clean_update_temp();
	bool applied = false;
	if (item.type == UPDATE_GAME) applied = apply_game_update(item);
	else if (item.type == UPDATE_CONTENT) applied = apply_content_update(item);
	else if (item.type == UPDATE_SOUNDS) applied = apply_sounds_update(item);
	else if (item.type == UPDATE_MAPS) applied = apply_maps_update(item);

	if (!applied) cleanup_update_temp();
	return applied;
}

/* Reads the manifest with the http class and reports real failures instead of
   pretending that no update exists. */
int fetch_manifest(string&out body, string&out error_message)
{
	body = "";
	error_message = "";

	http h;
	/* The startup check must never hold the game. A slow or unreachable server
	   is given a few seconds and then the menu opens exactly as if there were
	   no update: no retry storm, no thirty second freeze before the menu. */
	h.connect_timeout = 3000;
	h.receive_timeout = 4000;
	h.max_retries = 0;

	bool started = h.get(update_manifest_url);

	timer request_timer;
	while (!h.complete && request_timer.elapsed < 4000)
	{
		wait(10);
		if (key_pressed(KEY_ESCAPE))
		{
			h.reset();
			error_message = "Update check cancelled.";
			return -1;
		}
	}

	if (!h.complete)
	{
		h.reset();
		error_message = "The update server did not answer in time. Check your internet connection.";
		return -2;
	}

	int status = h.status_code;
	body = h.response_body;
	h.reset();

	if (!started)
	{
		error_message = "The update server could not be contacted. Check your internet connection.";
		return -2;
	}
	if (status != 200)
	{
		error_message = "The update server returned HTTP error " + status + ".";
		return -3;
	}
	if (body == "")
	{
		error_message = "The update server returned an empty manifest.";
		return -4;
	}
	return 0;
}

bool check_for_updates(bool interactive = true)
{
	load_updater_settings();

	if (interactive) speak(tr("updater.checking"));

	string manifest = "";
	string manifest_error = "";
	int fetch_result = fetch_manifest(manifest, manifest_error);
	if (fetch_result != 0)
	{
		if (interactive)
		{
			string err_msg = (manifest_error != "") ? manifest_error : "Failed to contact update server.";
			string[] args = { err_msg };
			dlg(tr("updater.error_dialog", args));
		}
		return false;
	}

	string clean_manifest = manifest.trim_whitespace();
	int brace_pos = clean_manifest.find("{");
	int bracket_pos = clean_manifest.find("[");
	int start_pos = -1;
	if (brace_pos >= 0 && bracket_pos >= 0)
		start_pos = (brace_pos < bracket_pos) ? brace_pos : bracket_pos;
	else if (brace_pos >= 0)
		start_pos = brace_pos;
	else if (bracket_pos >= 0)
		start_pos = bracket_pos;

	if (start_pos > 0)
		clean_manifest = clean_manifest.substr(start_pos);

	clean_manifest = clean_manifest.trim_whitespace();

	if (clean_manifest == "")
	{
		if (interactive) dlg(tr("updater.corrupt_manifest_dialog"));
		return false;
	}

	var@ parsed_var = parse_json(clean_manifest);
	if (parsed_var is null)
	{
		if (interactive) dlg(tr("updater.corrupt_manifest_dialog"));
		return false;
	}
	json_object@ root = parsed_var;
	if (root is null)
	{
		if (interactive) dlg(tr("updater.corrupt_manifest_dialog"));
		return false;
	}

	update_item@ available_update = null;

	if (root.is_object("game"))
	{
		json_object@ g = root.get_object("game");
		string rem_ver = g["version"];
		int rem_build = 0;
		if (g.exists("build"))
		{
			string b = g["build"];
			if (b != "") rem_build = int(string_to_number(b));
		}

		int cmp = compare_versions(current_game_version, rem_ver);
		if (cmp > 0 || (cmp == 0 && rem_build > current_game_build))
		{
			@available_update = update_item();
			available_update.type = UPDATE_GAME;
			available_update.current_version = current_game_version;
			available_update.new_version = rem_ver;
			available_update.current_build = current_game_build;
			available_update.new_build = rem_build;
			available_update.version_changed = (cmp > 0);
			available_update.url = g["url"];
			if (g.exists("zip_url")) available_update.zip_url = g["zip_url"];
			else if (available_update.url.find("tcf.exe") >= 0)
				available_update.zip_url = string_replace(available_update.url, "tcf.exe", "the_confront_v" + rem_ver + ".zip", true);
			string game_size = g["size"];
			if (game_size != "") available_update.size = int64(string_to_number(game_size));
			string game_zip_size = g["zip_size"];
			if (game_zip_size != "") available_update.zip_size = int64(string_to_number(game_zip_size));
		}
	}

	if (available_update is null && root.is_object("content"))
	{
		json_object@ c = root.get_object("content");
		string rem_ver = c["version"];
		int rem_build = 0;
		if (c.exists("build"))
		{
			string b = c["build"];
			if (b != "") rem_build = int(string_to_number(b));
		}

		int cmp = compare_versions(current_content_version, rem_ver);
		if (cmp > 0 || (cmp == 0 && rem_build > current_content_build))
		{
			@available_update = update_item();
			available_update.type = UPDATE_CONTENT;
			available_update.current_version = current_content_version;
			available_update.new_version = rem_ver;
			available_update.current_build = current_content_build;
			available_update.new_build = rem_build;
			available_update.version_changed = (cmp > 0);
			available_update.url = c["url"];
			string content_size = c["size"];
			if (content_size != "") available_update.size = int64(string_to_number(content_size));
		}
	}

	if (available_update is null && root.is_object("sounds"))
	{
		json_object@ s = root.get_object("sounds");
		string rem_ver = s["version"];
		int rem_build = 0;
		if (s.exists("build"))
		{
			string b = s["build"];
			if (b != "") rem_build = int(string_to_number(b));
		}

		int cmp = compare_versions(current_sounds_version, rem_ver);
		if (cmp > 0 || (cmp == 0 && rem_build > current_sounds_build))
		{
			@available_update = update_item();
			available_update.type = UPDATE_SOUNDS;
			available_update.current_version = current_sounds_version;
			available_update.new_version = rem_ver;
			available_update.current_build = current_sounds_build;
			available_update.new_build = rem_build;
			available_update.version_changed = (cmp > 0);
			available_update.url = s["url"];
			string sounds_size = s["size"];
			if (sounds_size != "") available_update.size = int64(string_to_number(sounds_size));
		}
	}

	if (available_update is null && root.is_object("maps"))
	{
		json_object@ m = root.get_object("maps");
		string rem_ver = m["version"];
		int rem_build = 0;
		if (m.exists("build"))
		{
			string b = m["build"];
			if (b != "") rem_build = int(string_to_number(b));
		}

		int cmp = compare_versions(current_maps_version, rem_ver);
		if (cmp > 0 || (cmp == 0 && rem_build > current_maps_build))
		{
			@available_update = update_item();
			available_update.type = UPDATE_MAPS;
			available_update.current_version = current_maps_version;
			available_update.new_version = rem_ver;
			available_update.current_build = current_maps_build;
			available_update.new_build = rem_build;
			available_update.version_changed = (cmp > 0);
			available_update.url = m["url"];
			string maps_size = m["size"];
			if (maps_size != "") available_update.size = int64(string_to_number(maps_size));
		}
	}

	if (available_update is null)
	{
		if (interactive) dlg(tr("updater.no_updates_dialog"));
		return false;
	}

	stop_main_menu_music();
	play_update_found_sound();

	string prompt_msg = "";
	if (available_update.type == UPDATE_GAME)
	{
		if (available_update.version_changed)
		{
			string[] args = { available_update.new_version };
			prompt_msg = tr("updater.game_update_available_version", args);
		}
		else
		{
			prompt_msg = tr("updater.game_update_available");
		}
	}
	else if (available_update.type == UPDATE_CONTENT)
	{
		prompt_msg = tr("updater.content_update_available");
	}
	else if (available_update.type == UPDATE_SOUNDS)
	{
		prompt_msg = tr("updater.sound_update_available");
	}
	else if (available_update.type == UPDATE_MAPS)
	{
		prompt_msg = tr("updater.map_update_available");
	}

	if (confirm_update_download(available_update, prompt_msg))
	{
		if (available_update.type == UPDATE_GAME)
		{
			if (available_update.zip_url != "")
			{
				available_update.url = available_update.zip_url;
				available_update.size = available_update.zip_size;
			}
		}
		return download_and_apply_update(available_update);
	}

	return false;
}

