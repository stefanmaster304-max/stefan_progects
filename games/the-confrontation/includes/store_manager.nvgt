
// Payment methods are a single list where the space bar checks/unchecks each
// currency accepted by the store, exactly like selecting multiple items to
// spawn on the map.
void store_populate_payment_list(audio_form@ f, int l_payments, string[]@ accepted)
{
	string[] all = store_all_payment_methods();
	for (uint i = 0; i < all.length(); i++)
	{
		bool chk = (accepted is null) ? true : store_payment_accepted(accepted, all[i]);
		f.add_list_item(l_payments, tr("currency." + all[i]), all[i], -1, chk, false);
	}
}

string[] store_read_checked_payments(audio_form@ f, int l_payments)
{
	string[] accepted;
	accepted.resize(0);
	int[]@ checked = f.get_checked_list_items(l_payments);
	if (checked !is null)
	{
		for (uint i = 0; i < checked.length(); i++)
		{
			int idx = checked[i];
			string cur = (idx >= 0) ? f.get_list_item_id(l_payments, idx) : "";
			cur = normalize_currency(cur);
			if (is_valid_store_currency(cur) && !store_payment_accepted(accepted, cur)) accepted.insert_last(cur);
		}
	}
	if (accepted.length() == 0) accepted = store_all_payment_methods();
	return accepted;
}

// Items never carry their own payment method anymore: only the price is
// editable. The currency is always the store's own, so no item is ever left
// without a payment method.
void edit_store_item(audio_form@ f, int list_items, string[]@ items, string[]@ prices, int pos)
{
	if (pos < 0 || pos >= int(items.length())) return;
	string old_item = items[pos];
	string old_price = prices[pos];

	audio_form edit;
	edit.create_window(tr("store_manager.edit_price"), false, true, false);
	int i_item = edit.create_input_box(tr("store_manager.item_id_name"), old_item, "", 0, false, true, false);
	int i_price = edit.create_input_box(tr("store_manager.item_price"), old_price);
	int btn_save = edit.create_button("&" + tr("ui.save"), true);
	int btn_cancel = edit.create_button("&" + tr("ui.cancel"), false, true);
	edit.set_default_controls(btn_save, btn_cancel);
	edit.focus(i_price);

	while(true)
	{
		wait(5);
		update_game_world();
		edit.monitor();
		if (key_pressed(KEY_ESCAPE) || edit.is_pressed(btn_cancel)) break;
		if (edit.is_pressed(btn_save))
		{
			string itm = edit.get_text(i_item);
			int price = int(stn(edit.get_text(i_price)));
			if (price < 0) price = 0;
			items[pos] = itm;
			prices[pos] = "" + price;
			f.delete_list_item(list_items, pos, true);
			f.add_list_item(list_items, itm + " - " + price, itm, pos);
			speak(tr("store_manager.price_updated", {itm, "" + price}));
			break;
		}
	}
}

void pick_store_items_dialog(string[]@ items, string[]@ prices, audio_form@ f, int list_items)
{
	load_all_items_config();
	load_all_weapons_wpm();
	load_all_packages();

	string[] all_ids;
	string[] all_labels;

	// 1. Items from settings/items/ (consumables, ammo, equipment).
	// Currency items are the payment for buying goods, so they can never be put
	// up for sale themselves.
	for (uint i = 0; i < item_registry.length(); i++)
	{
		if (item_registry[i].category == "currency") continue;
		all_ids.insert_last(item_registry[i].id);
		all_labels.insert_last("[Item - " + item_registry[i].category + "] " + item_registry[i].name + " (" + item_registry[i].id + ")");
	}

	// 2. Weapons from settings/weapons/
	for (uint w = 0; w < weapon_registry.length(); w++)
	{
		all_ids.insert_last(weapon_registry[w].id);
		all_labels.insert_last("[Weapon - " + weapon_registry[w].wclass + "] " + weapon_registry[w].name + " (" + weapon_registry[w].id + ")");
	}

	// 3. Packages from settings/packages/
	for (uint p = 0; p < package_registry.length(); p++)
	{
		all_ids.insert_last(package_registry[p].id);
		all_labels.insert_last("[Package] " + package_registry[p].name + " (" + package_registry[p].id + ")");
	}

	// 4. Explosives from settings/explosives/
	load_all_explosives_config();
	for (uint e = 0; e < explosive_registry.length(); e++)
	{
		all_ids.insert_last(explosive_registry[e].id);
		all_labels.insert_last("[Explosive - " + explosive_registry[e].etype + "] " + explosive_registry[e].name + " (" + explosive_registry[e].id + ")");
	}

	if (all_ids.length() == 0)
	{
		speak(tr("store_manager.no_items_found"));
		dlg(tr("store_manager.no_items_found"));
		return;
	}

	audio_form pf;
	pf.create_window(tr("store_manager.select_items_title"), false, true, false);
	int list = pf.create_list(tr("store_manager.select_items_hint"), 0, true, true);

	for (uint k = 0; k < all_ids.length(); k++)
	{
		bool already = (items.find(all_ids[k]) != -1);
		pf.add_list_item(list, all_labels[k], all_ids[k], -1, already, false);
	}

	int btn_save = pf.create_button("&" + tr("ui.add_selected"), true);
	int btn_cancel = pf.create_button("&" + tr("ui.cancel"), false, true);
	pf.focus(list);

	while (true)
	{
		wait(5);
		update_game_world();
		pf.monitor();

		if (key_pressed(KEY_ESCAPE) || pf.is_pressed(btn_cancel))
		{
			speak(tr("ui.cancel"));
			return;
		}

		if (pf.is_pressed(btn_save))
		{
			int[]@ checked = pf.get_checked_list_items(list);
			if (checked is null || checked.length() == 0)
			{
				speak(tr("store_manager.no_items_selected"));
				return;
			}

			int added_count = 0;
			for (uint c = 0; c < checked.length(); c++)
			{
				int idx = checked[c];
				if (idx >= 0 && idx < int(all_ids.length()))
				{
					string id = all_ids[idx];
					if (items.find(id) == -1)
					{
						int prc = 500;
						items.insert_last(id);
						prices.insert_last("" + prc);
						f.add_list_item(list_items, id + " - " + prc, id);
						added_count++;
					}
				}
			}
			speak(added_count + " " + tr("store_manager.items_added"));
			return;
		}
	}
}

void store_manager_menu()
{
	init_stores();
	while (true)
	{
		audio_form f;
		f.create_window(tr("store_manager.title"), false, true, false);
		int list = f.create_list(tr("store_manager.options"), 0, false, false);
		f.add_list_item(list, tr("store_manager.create_store"), "storefront_create");
		f.add_list_item(list, tr("store_manager.edit_store"), "storefront_edit");
		f.add_list_item(list, tr("store_manager.delete_store"), "storefront_delete");
		f.add_list_item(list, tr("store_manager.create_category"), "store_create");
		f.add_list_item(list, tr("store_manager.edit_category"), "store_edit");
		f.add_list_item(list, tr("store_manager.delete_category"), "store_delete");
		f.add_list_item(list, tr("ui.back"), "back");
		int btn_ok = f.create_button("&" + tr("ui.select"), true);
		int btn_cancel = f.create_button("&" + tr("ui.back"), false, true);
		f.set_default_controls(btn_ok, btn_cancel);
		f.focus_silently(list);

		string choice = "";
		while (true)
		{
			wait(5);
			update_game_world();
			f.monitor();
			if (key_pressed(KEY_ESCAPE) || f.is_pressed(btn_cancel)) break;
			if (f.is_pressed(btn_ok))
			{
				int pos = f.get_list_position(list);
				if (pos >= 0) choice = f.get_list_item_id(list, pos);
				break;
			}
		}
		if (choice == "") return;
		if (choice == "back") return;
		else if (choice == "storefront_create") storefront_edit_form();
		else if (choice == "storefront_edit")
		{
			storefront_select_and_edit();
			return;
		}
		else if (choice == "storefront_delete") storefront_delete_form();
		else if (choice == "store_create") store_create_form();
		else if (choice == "store_edit") store_edit_form();
		else if (choice == "store_delete") store_delete_form();
	}
}

string normalize_storefront_id(string raw)
{
	string id = string_to_lower_case(raw.trim_whitespace());
	id = string_replace(id, " ", "_", true);
	id = string_replace(id, "/", "_", true);
	id = string_replace(id, "\\", "_", true);
	id = string_replace(id, ":", "_", true);
	return id;
}

void storefront_edit_form(const string&in existing_id = "")
{
	if (is_store_encrypted()) { speak(tr("store_manager.encrypted")); return; }
	init_stores();
	init_storefronts();
	storefront_cfg@ current = (existing_id != "") ? get_storefront(existing_id) : null;
	if (existing_id != "" && current is null) { speak(tr("store_manager.not_found")); return; }
	audio_form f;
	f.create_window(existing_id == "" ? tr("store_manager.create_store") : tr("store_manager.edit_store"), false, true, false);
	int id_field = f.create_input_box(tr("store_manager.store_id"), current is null ? "" : current.name);
	int name_field = f.create_input_box(tr("store_manager.store_name"), current is null ? "" : current.display_name);
	int category_list = f.create_list(tr("store_manager.store_categories"), 0, true, true);
	for (uint i = 0; i < store_configs.length(); i++)
	{
		bool checked = (current !is null && current.categories.find(store_configs[i].name) >= 0);
		f.add_list_item(category_list, store_configs[i].display_name, store_configs[i].name, -1, checked, false);
	}
	int save = f.create_button("&" + tr("ui.save"), true);
	int cancel = f.create_button("&" + tr("ui.cancel"), false, true);
	f.set_default_controls(save, cancel);
	f.focus(id_field);
	while (true)
	{
		wait(5);
		update_game_world();
		f.monitor();
		if (key_pressed(KEY_ESCAPE) || f.is_pressed(cancel)) return;
		if (!f.is_pressed(save)) continue;
		string id = normalize_storefront_id(f.get_text(id_field));
		string display_name = f.get_text(name_field).trim_whitespace();
		if (id == "") { speak(tr("store_manager.id_empty")); f.focus(id_field); continue; }
		if (display_name == "") { speak(tr("store_manager.store_name_required")); f.focus(name_field); continue; }
		if (id != existing_id && file_exists(STOREFRONT_DIR + "/" + id + ".st"))
		{ speak(tr("store_manager.id_exists")); f.focus(id_field); continue; }
		string[] categories;
		int[]@ checked = f.get_checked_list_items(category_list);
		if (checked !is null)
			for (uint c = 0; c < checked.length(); c++)
				if (checked[c] >= 0 && checked[c] < int(store_configs.length())) categories.insert_last(store_configs[checked[c]].name);
		if (categories.length() == 0 && existing_id == "") { speak(tr("store_manager.store_category_required")); f.focus(category_list); continue; }
		storefront_cfg@ store = storefront_cfg();
		store.name = id;
		store.display_name = display_name;
		store.categories = categories;
		if (!save_storefront(store)) { speak(tr("store_manager.save_failed")); continue; }
		if (existing_id != "" && existing_id != id && file_exists(STOREFRONT_DIR + "/" + existing_id + ".st")) file_delete(STOREFRONT_DIR + "/" + existing_id + ".st");
		speak(tr("store_manager.saved_success"));
		return;
	}
}

string choose_storefront()
{
	init_stores();
	init_storefronts();
	if (storefronts.length() == 0) { speak(tr("store_manager.no_stores_found")); return ""; }
	setupmenu(false);
	for (uint i = 0; i < storefronts.length(); i++)
		m.add_item_tts(storefronts[i].display_name, storefronts[i].name);
	int selected = m.run(tr("store_manager.select_store_title"), true);
	return (selected > 0) ? m.get_item_name(selected) : "";
}

void storefront_select_and_edit()
{
	string id = choose_storefront();
	if (id != "") storefront_edit_form(id);
}

void storefront_delete_form()
{
	if (is_store_encrypted()) { speak(tr("store_manager.encrypted")); return; }
	string id = choose_storefront();
	if (id == "") return;
	if (file_exists(STOREFRONT_DIR + "/" + id + ".st")) file_delete(STOREFRONT_DIR + "/" + id + ".st");
	for (int i = int(storefronts.length()) - 1; i >= 0; i--) if (storefronts[i].name == id) storefronts.remove_at(i);
	speak(tr("store_manager.store_deleted"));
}

void store_create_form()
{
	if (is_store_encrypted())
	{
		speak(tr("store_manager.encrypted"));
		dlg(tr("store_manager.encrypted"));
		return;
	}
	audio_form f;
	f.create_window(tr("store_manager.create_title"), false, true, false);
	int i_name = f.create_input_box(tr("store_manager.category_id"), "");
	int i_display = f.create_input_box(tr("store_manager.category_name"), "");
	int l_currency = f.create_list(tr("store_manager.store_currency"), 0, false, false);
	for (uint c = 0; c < store_currencies.length(); c++)
	{
		f.add_list_item(l_currency, currency_display_name(store_currencies[c]), store_currencies[c]);
	}
	f.set_list_position(l_currency, 0, false);
	int l_payments = f.create_list(tr("store_manager.accepted_payments"), 0, true, true);
	store_populate_payment_list(f, l_payments, null);
	int list_items = f.create_list(tr("store_manager.store_items"), 0, false, false);
	int btn_add = f.create_button("&" + tr("store_manager.select_items_to_sell"), false);
	int btn_edit = f.create_button("&" + tr("store_manager.edit_price"), false);
	int btn_remove = f.create_button("&" + tr("ui.remove"), false);
	int btn_save = f.create_button("&" + tr("ui.save"), true);
	int btn_cancel = f.create_button("&" + tr("ui.cancel"), false, true);
	f.set_default_controls(btn_save, btn_cancel);
	f.focus_silently(i_name);

	string[] items;
	string[] prices;

	while(true)
	{
		wait(5);
		update_game_world();
		f.monitor();
		if (key_pressed(KEY_ESCAPE) || f.is_pressed(btn_cancel)) break;
		if (f.is_pressed(btn_save))
		{
			string name = f.get_text(i_name);
			if (name == "")
			{
				speak(tr("store_manager.id_empty"));
				continue;
			}
			if (store_category_exists(name))
			{
				speak(tr("store_manager.id_exists"));
				continue;
			}
			store_cfg@ s = @store_cfg();
			s.name = name;
			s.display_name = f.get_text(i_display);
			if (s.display_name == "") s.display_name = name;
			int cur_pos = f.get_list_position(l_currency);
			s.currency = (cur_pos >= 0 && cur_pos < int(store_currencies.length())) ? store_currencies[cur_pos] : CURRENCY_GOLD;
			s.accepted_currencies = store_read_checked_payments(f, l_payments);
			if (!store_payment_accepted(s.accepted_currencies, s.currency))
			{
				s.accepted_currencies.insert_last(s.currency);
			}
			s.item_names = items;
			s.item_prices = prices;
			save_store_config(name, s);
			if (file_exists(CONTENTS_DAT_PATH)) encrypt_all_contents_silent();
			speak(tr("store_manager.saved_success"));
			break;
		}
		if (f.is_pressed(btn_add))
		{
			pick_store_items_dialog(items, prices, f, list_items);
		}
		if (f.is_pressed(btn_edit))
		{
			int pos = f.get_list_position(list_items);
			if (pos > -1)
			{
				edit_store_item(f, list_items, items, prices, pos);
			}
		}
		if (f.is_pressed(btn_remove))
		{
			int pos = f.get_list_position(list_items);
			if (pos > -1 && pos < int(items.length()))
			{
				f.delete_list_item(list_items, pos, true);
				items.remove_at(pos);
				prices.remove_at(pos);
				speak(tr("store_manager.item_removed"));
			}
		}
	}
}

void store_edit_form()
{
	if (is_store_encrypted())
	{
		speak(tr("store_manager.encrypted"));
		dlg(tr("store_manager.encrypted"));
		return;
	}
	init_stores();
	string[] store_names;
	for (uint i = 0; i < store_configs.length(); i++)
	{
		store_names.insert_last(store_configs[i].name);
	}
	if (store_names.length() == 0)
	{
		speak(tr("store_manager.no_stores_found"));
		return;
	}

	audio_form f;
	f.create_window(tr("store_manager.select_edit_title"), false, true, false);
	int list_stores = f.create_list(tr("store_manager.title"), 0, false, false);
	for (uint i = 0; i < store_names.length(); i++)
	{
		f.add_list_item(list_stores, store_names[i], store_names[i]);
	}
	int btn_ok = f.create_button("&" + tr("ui.edit"), true);
	int btn_cancel = f.create_button("&" + tr("ui.cancel"), false, true);
	f.set_default_controls(btn_ok, btn_cancel);
	f.focus_silently(list_stores);

	string id = "";
	while(true)
	{
		wait(5);
		update_game_world();
		f.monitor();
		if (key_pressed(KEY_ESCAPE) || f.is_pressed(btn_cancel)) break;
		if (f.is_pressed(btn_ok))
		{
			int pos = f.get_list_position(list_stores);
			if (pos < 0)
			{
				speak(tr("store_manager.select_store_first"));
				continue;
			}
			id = f.get_list_item_id(list_stores, pos);
			break;
		}
	}
	if (id == "") return;
	store_cfg@ s = get_store(id);
	if (s is null)
	{
		speak(tr("store_manager.not_found"));
		return;
	}

	string[] items = s.item_names;
	string[] prices = s.item_prices;

	audio_form f2;
	f2.create_window(tr("store_manager.edit_title", {s.name}), false, true, false);
	int i_id = f2.create_input_box(tr("store_manager.category_id"), s.name);
	int i_display = f2.create_input_box(tr("store_manager.category_name"), s.display_name);
	int l_currency = f2.create_list(tr("store_manager.store_currency"), 0, false, false);
	int cur_sel = 0;
	string cur_norm = normalize_currency(s.currency);
	for (uint c = 0; c < store_currencies.length(); c++)
	{
		f2.add_list_item(l_currency, currency_display_name(store_currencies[c]), store_currencies[c]);
		if (cur_norm == store_currencies[c]) cur_sel = int(c);
	}
	f2.set_list_position(l_currency, cur_sel, false);
	int l_payments = f2.create_list(tr("store_manager.accepted_payments"), 0, true, true);
	store_populate_payment_list(f2, l_payments, s.accepted_currencies);
	int list_items = f2.create_list(tr("store_manager.store_items"), 0, false, false);
	for (uint i = 0; i < items.length(); i++)
	{
		f2.add_list_item(list_items, items[i] + " - " + prices[i], items[i]);
	}
	int btn_add = f2.create_button("&" + tr("store_manager.select_items_to_sell"), false);
	int btn_edit = f2.create_button("&" + tr("store_manager.edit_price"), false);
	int btn_remove = f2.create_button("&" + tr("ui.remove"), false);
	int btn_save = f2.create_button("&" + tr("ui.update_and_save"), true);
	int btn_cancel2 = f2.create_button("&" + tr("ui.cancel"), false, true);
	f2.set_default_controls(btn_save, btn_cancel2);

	while(true)
	{
		wait(5);
		update_game_world();
		f2.monitor();
		if (key_pressed(KEY_ESCAPE) || f2.is_pressed(btn_cancel2)) break;
		if (f2.is_pressed(btn_save))
		{
			string new_id = normalize_currency(f2.get_text(i_id));
			if (new_id == "")
			{
				speak(tr("store_manager.id_empty"));
				f2.focus(i_id);
				continue;
			}
			if (new_id != id && store_category_exists(new_id))
			{
				speak(tr("store_manager.id_exists"));
				f2.focus(i_id);
				continue;
			}
			s.display_name = f2.get_text(i_display);
			if (s.display_name == "") s.display_name = new_id;
			int cur_pos = f2.get_list_position(l_currency);
			s.currency = (cur_pos >= 0 && cur_pos < int(store_currencies.length())) ? store_currencies[cur_pos] : CURRENCY_GOLD;
			s.accepted_currencies = store_read_checked_payments(f2, l_payments);
			if (!store_payment_accepted(s.accepted_currencies, s.currency))
			{
				s.accepted_currencies.insert_last(s.currency);
			}
			s.item_names = items;
			s.item_prices = prices;

			if (new_id != id)
			{
				string old_path = get_store_path(id);
				if (file_exists(old_path)) file_delete(old_path);
				string legacy_old = STORE_DIR + "/" + id + ".txt";
				if (file_exists(legacy_old)) file_delete(legacy_old);

				s.name = new_id;
				for (uint g = 0; g < storefronts.length(); g++)
				{
					for (uint c = 0; c < storefronts[g].categories.length(); c++)
						if (storefronts[g].categories[c] == id) storefronts[g].categories[c] = new_id;
					save_storefront(storefronts[g]);
				}
				for (uint i = 0; i < store_configs.length(); i++)
				{
					if (store_configs[i].name == id)
					{
						store_configs[i].name = new_id;
						break;
					}
				}
			}
			save_store_config(s.name, s);
			if (file_exists(CONTENTS_DAT_PATH)) encrypt_all_contents_silent();
			speak(tr("store_manager.updated_success"));
			break;
		}
		if (f2.is_pressed(btn_add))
		{
			pick_store_items_dialog(items, prices, f2, list_items);
		}
		if (f2.is_pressed(btn_edit))
		{
			int pos = f2.get_list_position(list_items);
			if (pos > -1)
			{
				edit_store_item(f2, list_items, items, prices, pos);
			}
		}
		if (f2.is_pressed(btn_remove))
		{
			int pos = f2.get_list_position(list_items);
			if (pos > -1 && pos < int(items.length()))
			{
				f2.delete_list_item(list_items, pos, true);
				items.remove_at(pos);
				prices.remove_at(pos);
				speak(tr("store_manager.item_removed"));
			}
		}
	}
}

void store_delete_form()
{
	if (is_store_encrypted())
	{
		speak(tr("store_manager.encrypted"));
		dlg(tr("store_manager.encrypted"));
		return;
	}
	init_stores();
	string[] store_names;
	for (uint i = 0; i < store_configs.length(); i++)
	{
		store_names.insert_last(store_configs[i].name);
	}
	if (store_names.length() == 0)
	{
		speak(tr("store_manager.no_stores_found"));
		return;
	}

	audio_form f;
	f.create_window(tr("store_manager.delete_title"), false, true, false);
	int list_stores = f.create_list(tr("store_manager.title"), 0, false, false);
	for (uint i = 0; i < store_names.length(); i++)
	{
		f.add_list_item(list_stores, store_names[i], store_names[i]);
	}
	int btn_delete = f.create_button("&" + tr("ui.delete"), true);
	int btn_cancel = f.create_button("&" + tr("ui.cancel"), false, true);
	f.set_default_controls(btn_delete, btn_cancel);

	string id = "";
	while(true)
	{
		wait(5);
		update_game_world();
		f.monitor();
		if (key_pressed(KEY_ESCAPE) || f.is_pressed(btn_cancel)) break;
		if (f.is_pressed(btn_delete))
		{
			int pos = f.get_list_position(list_stores);
			if (pos < 0)
			{
				speak(tr("store_manager.select_store_first"));
				continue;
			}
			id = f.get_list_item_id(list_stores, pos);
			break;
		}
	}
	if (id == "") return;
	if (!store_remove_category(id))
	{
		speak(tr("store_manager.not_found"));
		return;
	}
	if (file_exists(CONTENTS_DAT_PATH)) encrypt_all_contents_silent();
	speak(tr("store_manager.deleted_success"));
}
