// explosive_manager.nvgt - Development GUI for creating, editing, viewing and deleting explosives.

void explosive_chooser()
{
	load_all_explosives_config(true);

	while (true)
	{
		audio_form form;
		form.create_window(tr("explosive_manager.title"), false, true, false);
		int list = form.create_list(tr("explosive_manager.select_action"), 0, false, true);
		form.add_list_item(list, tr("explosive_manager.create_title"), "add");
		form.add_list_item(list, tr("explosive_manager.edit_title"), "edit");
		form.add_list_item(list, tr("explosive_manager.view_title"), "view");
		form.add_list_item(list, tr("explosive_manager.remove_title"), "remove");
		int ok = form.create_button("&" + tr("ui.ok"), true);
		int cancel = form.create_button("&" + tr("ui.cancel"), false, true);
		form.set_default_controls(ok, cancel);
		form.focus(list);

		string action = "";
		while (true)
		{
			wait(5);
			update_game_world();
			form.monitor();
			if (key_pressed(KEY_ESCAPE) || form.is_pressed(cancel))
			{
				speak(tr("ui.cancel"));
				return;
			}
			if (form.is_pressed(ok))
			{
				int pos = form.get_list_position(list);
				if (pos >= 0) action = form.get_list_item_id(list, pos);
				break;
			}
		}

		if (action == "add")
		{
			if (SCRIPT_COMPILED || is_explosive_encrypted(""))
			{
				speak(tr("explosive_manager.encrypted_create"));
				continue;
			}
			explosive_data@ ex = explosive_data();
			if (explosive_edit_form(ex, true, false))
			{
				explosive_registry.insert_last(ex);
				save_explosive_config(ex);
				speak(tr("explosive_manager.saved", {ex.name}));
			}
		}
		else if (action == "edit" || action == "view" || action == "remove")
		{
			if (explosive_registry.length() == 0)
			{
				speak(tr("explosive_manager.none_found"));
				continue;
			}
			string picked_id = explosive_pick_from_registry(action);
			if (picked_id == "") continue;
			explosive_data@ ex = find_explosive_data(picked_id);
			if (ex is null) continue;

			if (action == "view")
			{
				explosive_edit_form(ex, false, true);
			}
			else if (action == "edit")
			{
				if (SCRIPT_COMPILED || is_explosive_encrypted(ex.id))
				{
					speak(tr("explosive_manager.encrypted_edit"));
					continue;
				}
				if (explosive_edit_form(ex, false, false))
				{
					save_explosive_config(ex);
					speak(tr("explosive_manager.saved", {ex.name}));
				}
			}
			else if (action == "remove")
			{
				if (SCRIPT_COMPILED || is_explosive_encrypted(ex.id))
				{
					speak(tr("explosive_manager.encrypted_remove"));
					continue;
				}
				if (explosive_confirm_delete(ex.name))
				{
					delete_explosive_config(ex.id);
					speak(tr("explosive_manager.removed", {ex.name}));
				}
			}
		}
	}
}

string explosive_pick_from_registry(const string&in mode)
{
	audio_form form;
	form.create_window(tr("explosive_manager.select_explosive"), false, true, false);
	int list = form.create_list(tr("explosive_manager.select_explosive"), 0, false, true);
	for (uint i = 0; i < explosive_registry.length(); i++)
	{
		explosive_data@ ex = explosive_registry[i];
		form.add_list_item(list, ex.name + " [" + tr("explosive_types." + ex.etype) + "] (" + ex.id + ")", ex.id);
	}
	int ok = form.create_button("&" + tr("ui.ok"), true);
	int cancel = form.create_button("&" + tr("ui.cancel"), false, true);
	form.set_default_controls(ok, cancel);
	form.focus(list);

	while (true)
	{
		wait(5);
		update_game_world();
		form.monitor();
		if (key_pressed(KEY_ESCAPE) || form.is_pressed(cancel)) return "";
		if (form.is_pressed(ok) || (form.get_current_focus() == list && (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER))))
		{
			int pos = form.get_list_position(list);
			if (pos >= 0) return form.get_list_item_id(list, pos);
			return "";
		}
	}
	return "";
}

bool explosive_confirm_delete(const string&in name)
{
	audio_form form;
	form.create_window(tr("explosive_manager.confirm_delete", {name}), false, true, false);
	int yes_btn = form.create_button("&" + tr("ui.yes"), true);
	int no_btn = form.create_button("&" + tr("ui.no"), false, true);
	form.set_default_controls(yes_btn, no_btn);
	form.focus(no_btn);
	while (true)
	{
		wait(5);
		update_game_world();
		form.monitor();
		if (key_pressed(KEY_ESCAPE) || form.is_pressed(no_btn)) return false;
		if (form.is_pressed(yes_btn)) return true;
	}
	return false;
}

string explosive_pick_sound_dialog(const string&in label, const string&in current_val)
{
	return item_pick_sound_immediate("explosive", label, current_val);
}

void explosive_update_field_visibility(audio_form@ form, const string&in etype, bool view_only,
	int in_dmg, int in_rad, int in_trig, int in_fuse, int in_throw, int in_stun, int in_active, int in_beep, int in_speed,
	int btn_plant, int btn_beep, int btn_det, int btn_travel, int btn_smoke, int btn_bounce, int btn_land, int btn_hit, int btn_exp, int btn_dist)
{
	bool is_smoke_g = (etype == "smoke_grenade");
	bool is_smoke_b = (etype == "smoke_bomb");
	bool is_smoke = (is_smoke_g || is_smoke_b);
	bool is_timed = (etype == "timed_bomb");
	bool is_frag = (etype == "frag_grenade");
	bool is_mine = (etype == "landmine");
	bool is_missile = (etype == "guided_missile");
	bool is_detonator = (etype == "remote_detonator");

	bool show_dmg = !is_detonator;
	bool show_rad = !is_detonator;
	bool show_trig = is_mine;
	bool show_fuse = (is_timed || is_frag || is_smoke_g || is_smoke_b);
	bool show_throw = (is_frag || is_smoke_g);
	bool show_stun = is_smoke_g;
	bool show_active = is_smoke_b;
	bool show_beep = (is_timed || is_mine);
	bool show_speed = is_missile;

	bool show_plant = !is_detonator;
	bool show_det = is_detonator;
	bool show_travel = is_missile;
	bool show_smoke = is_smoke;
	bool show_bounce = (is_frag || is_smoke_g);
	bool show_land = (is_frag || is_smoke_g);
	bool show_hit = !is_detonator;
	bool show_exp = !is_detonator;
	bool show_dist = !is_detonator;

	form.set_state(in_dmg, show_dmg, show_dmg);
	form.set_state(in_rad, show_rad, show_rad);
	form.set_state(in_trig, show_trig, show_trig);
	form.set_state(in_fuse, show_fuse, show_fuse);
	form.set_state(in_throw, show_throw, show_throw);
	form.set_state(in_stun, show_stun, show_stun);
	form.set_state(in_active, show_active, show_active);
	form.set_state(in_beep, show_beep, show_beep);
	form.set_state(in_speed, show_speed, show_speed);

	form.set_state(btn_plant, show_plant, show_plant && !view_only);
	form.set_state(btn_beep, show_beep, show_beep && !view_only);
	form.set_state(btn_det, show_det, show_det && !view_only);
	form.set_state(btn_travel, show_travel, show_travel && !view_only);
	form.set_state(btn_smoke, show_smoke, show_smoke && !view_only);
	form.set_state(btn_bounce, show_bounce, show_bounce && !view_only);
	form.set_state(btn_land, show_land, show_land && !view_only);
	form.set_state(btn_hit, show_hit, show_hit && !view_only);
	form.set_state(btn_exp, show_exp, show_exp && !view_only);
	form.set_state(btn_dist, show_dist, show_dist && !view_only);
}

bool explosive_edit_form(explosive_data@ ex, bool is_new, bool view_only)
{
	audio_form form;
	form.create_window(is_new ? tr("explosive_manager.create_title") : (view_only ? tr("explosive_manager.view_title") : tr("explosive_manager.edit_title")), false, true, false);

	int in_id = -1;
	if (is_new) in_id = form.create_input_box(tr("explosive_manager.internal_id"), ex.id, "", 0, false, false, view_only);
	int in_name = form.create_input_box(tr("explosive_manager.display_name"), ex.name, "", 0, false, false, view_only);
	int in_desc = form.create_input_box(tr("explosive_manager.description"), ex.description, "", 0, false, false, view_only);

	int list_type = form.create_list(tr("explosive_manager.type"), 0, false, false);
	int def_type = 0;
	for (uint i = 0; i < explosive_types.length(); i++)
	{
		if (explosive_types[i] == ex.etype) def_type = int(i);
	}
	for (uint i = 0; i < explosive_types.length(); i++)
	{
		form.add_list_item(list_type, tr("explosive_types." + explosive_types[i]), explosive_types[i], -1, false, (int(i) == def_type));
	}
	form.set_list_position(list_type, def_type, false);

	int in_dmg = form.create_input_box(tr("explosive_manager.damage"), string(ex.damage), "", 0, false, false, view_only);
	int in_rad = form.create_input_box(tr("explosive_manager.radius"), string(ex.radius), "", 0, false, false, view_only);
	int in_trig = form.create_input_box(tr("explosive_manager.trigger_radius"), string(ex.trigger_radius), "", 0, false, false, view_only);
	int in_fuse = form.create_input_box(tr("explosive_manager.fuse_ms"), string(ex.fuse_ms), "", 0, false, false, view_only);
	int in_throw = form.create_input_box(tr("explosive_manager.throw_range"), string(ex.throw_range), "", 0, false, false, view_only);
	int in_stun = form.create_input_box(tr("explosive_manager.stun_ms"), string(ex.stun_duration_ms), "", 0, false, false, view_only);
	int in_active = form.create_input_box(tr("explosive_manager.active_ms"), string(ex.active_duration_ms), "", 0, false, false, view_only);
	int in_beep = form.create_input_box(tr("explosive_manager.beep_ms"), string(ex.beep_interval_ms), "", 0, false, false, view_only);
	int in_speed = form.create_input_box(tr("explosive_manager.travel_speed_ms"), string(ex.travel_speed_ms), "", 0, false, false, view_only);
	int in_stack = form.create_input_box(tr("explosive_manager.max_stack"), string(ex.max_stack), "", 0, false, false, view_only);

	string num_only = tr("explosive_manager.numbers_only");
	form.set_disallowed_chars(in_dmg, "0123456789", true, num_only);
	form.set_disallowed_chars(in_rad, "0123456789", true, num_only);
	form.set_disallowed_chars(in_trig, "0123456789", true, num_only);
	form.set_disallowed_chars(in_fuse, "0123456789", true, num_only);
	form.set_disallowed_chars(in_throw, "0123456789", true, num_only);
	form.set_disallowed_chars(in_stun, "0123456789", true, num_only);
	form.set_disallowed_chars(in_active, "0123456789", true, num_only);
	form.set_disallowed_chars(in_beep, "0123456789", true, num_only);
	form.set_disallowed_chars(in_speed, "0123456789", true, num_only);
	form.set_disallowed_chars(in_stack, "0123456789", true, num_only);

	int btn_get = form.create_button(tr("explosive_manager.btn_pickup_sound") + get_snd_count_label(ex.sound_get));
	int btn_plant = form.create_button(tr((ex.etype == "frag_grenade" || ex.etype == "smoke_grenade") ? "explosive_manager.btn_throw_sound" : "explosive_manager.btn_plant_only_sound") + get_snd_count_label(ex.sound_plant));
	int btn_beep = form.create_button(tr("explosive_manager.btn_beep_sound") + get_snd_count_label(ex.sound_beep));
	int btn_det = form.create_button(tr("explosive_manager.btn_det_sound") + get_snd_count_label(ex.sound_detonator));
	int btn_travel = form.create_button(tr("explosive_manager.btn_travel_sound") + get_snd_count_label(ex.sound_travel));
	int btn_smoke = form.create_button(tr("explosive_manager.btn_smoke_sound") + get_snd_count_label(ex.sound_smoke));
	int btn_bounce = form.create_button(tr("explosive_manager.btn_bounce_sound") + get_snd_count_label(ex.sound_bounce));
	int btn_land = form.create_button(tr("explosive_manager.btn_land_sound") + get_snd_count_label(ex.sound_land));
	int btn_hit = form.create_button(tr("explosive_manager.btn_hit_sound") + get_snd_count_label(ex.sound_hit));
	int btn_exp = form.create_button(tr("explosive_manager.btn_explode_sound") + get_snd_count_label(ex.sound_explode));
	int btn_dist = form.create_button(tr("explosive_manager.btn_dist_sound") + get_snd_count_label(ex.sound_dist));

	int b_give = -1;
	int b_save = -1;
	if (!view_only)
	{
		b_give = form.create_button("&" + tr("ui.give_to_inventory"));
		b_save = form.create_button("&" + (is_new ? tr("ui.save") : tr("ui.update_and_save")), true);
	}
	int b_cancel = form.create_button("&" + tr("ui.close"), false, true);

	string last_type = ex.etype;
	explosive_update_field_visibility(form, last_type, view_only,
		in_dmg, in_rad, in_trig, in_fuse, in_throw, in_stun, in_active, in_beep, in_speed,
		btn_plant, btn_beep, btn_det, btn_travel, btn_smoke, btn_bounce, btn_land, btn_hit, btn_exp, btn_dist);
	form.focus(is_new ? in_id : in_name);

	while (true)
	{
		wait(5);
		update_game_world();
		form.monitor();

		int tpos_cur = form.get_list_position(list_type);
		string cur_type = (tpos_cur >= 0) ? form.get_list_item_id(list_type, tpos_cur) : last_type;
		if (cur_type != last_type)
		{
			last_type = cur_type;
			form.set_text(btn_plant, tr((cur_type == "frag_grenade" || cur_type == "smoke_grenade") ? "explosive_manager.btn_throw_sound" : "explosive_manager.btn_plant_only_sound") + get_snd_count_label(ex.sound_plant));
			explosive_update_field_visibility(form, cur_type, view_only,
				in_dmg, in_rad, in_trig, in_fuse, in_throw, in_stun, in_active, in_beep, in_speed,
				btn_plant, btn_beep, btn_det, btn_travel, btn_smoke, btn_bounce, btn_land, btn_hit, btn_exp, btn_dist);
		}

		if (key_pressed(KEY_ESCAPE) || form.is_pressed(b_cancel))
		{
			speak(tr("ui.cancel"));
			return false;
		}

		if (!view_only)
		{
			if (form.is_pressed(btn_get))
			{
				ex.sound_get = explosive_pick_sound_dialog("sound_get", ex.sound_get);
				form.set_text(btn_get, tr("explosive_manager.btn_pickup_sound") + get_snd_count_label(ex.sound_get));
			}
			if (form.is_pressed(btn_plant))
			{
				ex.sound_plant = explosive_pick_sound_dialog("sound_plant", ex.sound_plant);
				form.set_text(btn_plant, tr((cur_type == "frag_grenade" || cur_type == "smoke_grenade") ? "explosive_manager.btn_throw_sound" : "explosive_manager.btn_plant_only_sound") + get_snd_count_label(ex.sound_plant));
			}
			if (form.is_pressed(btn_beep))
			{
				ex.sound_beep = explosive_pick_sound_dialog("sound_beep", ex.sound_beep);
				form.set_text(btn_beep, tr("explosive_manager.btn_beep_sound") + get_snd_count_label(ex.sound_beep));
			}
			if (form.is_pressed(btn_det))
			{
				ex.sound_detonator = explosive_pick_sound_dialog("sound_detonator", ex.sound_detonator);
				form.set_text(btn_det, tr("explosive_manager.btn_det_sound") + get_snd_count_label(ex.sound_detonator));
			}
			if (form.is_pressed(btn_travel))
			{
				ex.sound_travel = explosive_pick_sound_dialog("sound_travel", ex.sound_travel);
				form.set_text(btn_travel, tr("explosive_manager.btn_travel_sound") + get_snd_count_label(ex.sound_travel));
			}
			if (form.is_pressed(btn_smoke))
			{
				ex.sound_smoke = explosive_pick_sound_dialog("sound_smoke", ex.sound_smoke);
				form.set_text(btn_smoke, tr("explosive_manager.btn_smoke_sound") + get_snd_count_label(ex.sound_smoke));
			}
			if (form.is_pressed(btn_bounce))
			{
				ex.sound_bounce = explosive_pick_sound_dialog("sound_bounce", ex.sound_bounce);
				form.set_text(btn_bounce, tr("explosive_manager.btn_bounce_sound") + get_snd_count_label(ex.sound_bounce));
			}
			if (form.is_pressed(btn_land))
			{
				ex.sound_land = explosive_pick_sound_dialog("sound_land", ex.sound_land);
				form.set_text(btn_land, tr("explosive_manager.btn_land_sound") + get_snd_count_label(ex.sound_land));
			}
			if (form.is_pressed(btn_hit))
			{
				ex.sound_hit = explosive_pick_sound_dialog("sound_hit", ex.sound_hit);
				form.set_text(btn_hit, tr("explosive_manager.btn_hit_sound") + get_snd_count_label(ex.sound_hit));
			}
			if (form.is_pressed(btn_exp))
			{
				ex.sound_explode = explosive_pick_sound_dialog("sound_explode", ex.sound_explode);
				form.set_text(btn_exp, tr("explosive_manager.btn_explode_sound") + get_snd_count_label(ex.sound_explode));
			}
			if (form.is_pressed(btn_dist))
			{
				ex.sound_dist = explosive_pick_sound_dialog("sound_dist", ex.sound_dist);
				form.set_text(btn_dist, tr("explosive_manager.btn_dist_sound") + get_snd_count_label(ex.sound_dist));
			}

			if (b_give != -1 && form.is_pressed(b_give))
			{
				string give_id = (is_new && in_id != -1) ? form.get_text(in_id).trim_whitespace() : ex.id;
				if (give_id != "")
				{
					give(give_id, 5);
					speak(tr("explosive_manager.given_inventory", {"5", (ex.name != "" ? ex.name : give_id)}));
				}
			}

			if (b_save != -1 && form.is_pressed(b_save))
			{
				string nid = is_new ? form.get_text(in_id).trim_whitespace() : ex.id;
				string nname = form.get_text(in_name).trim_whitespace();
				if (nid == "" || nname == "")
				{
					speak(tr("explosive_manager.id_name_required"));
					continue;
				}
				if (is_new && (find_explosive_data(nid) !is null || get_item_data(nid) !is null || find_weapon_data(nid) !is null))
				{
					speak(tr("explosive_manager.id_exists"));
					continue;
				}
				ex.id = nid;
				ex.name = nname;
				ex.description = form.get_text(in_desc).trim_whitespace();
				ex.etype = cur_type;
				ex.damage = int(string_to_number(form.get_text(in_dmg)));
				ex.radius = int(string_to_number(form.get_text(in_rad)));
				ex.trigger_radius = int(string_to_number(form.get_text(in_trig)));
				ex.fuse_ms = int(string_to_number(form.get_text(in_fuse)));
				ex.throw_range = int(string_to_number(form.get_text(in_throw)));
				ex.stun_duration_ms = int(string_to_number(form.get_text(in_stun)));
				ex.active_duration_ms = int(string_to_number(form.get_text(in_active)));
				ex.beep_interval_ms = int(string_to_number(form.get_text(in_beep)));
				ex.travel_speed_ms = int(string_to_number(form.get_text(in_speed)));
				ex.max_stack = int(string_to_number(form.get_text(in_stack)));
				if (ex.radius < 1) ex.radius = 1;
				if (ex.trigger_radius < 0) ex.trigger_radius = 0;
				if (ex.max_stack < 1) ex.max_stack = 1;
				if (ex.travel_speed_ms < 5) ex.travel_speed_ms = 5;
				return true;
			}
		}
	}
	return false;
}
