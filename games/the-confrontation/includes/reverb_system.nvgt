// reverb_system.nvgt - Native King Audio Engine Reverb Zone System.
// Uses strictly King Audio's native mixer reverb (presets and custom parameters),
// with no high-pass, low-pass, or MiniAudio fallback effects.

mixer world_reverb_mixer;
bool world_reverb_mixer_initialized = false;
int active_reverb_zone_index = -1;

const string[] KING_REVERB_PRESETS = {
	"room",
	"hall",
	"cave",
	"bathroom",
	"arena",
	"hangar",
	"forest",
	"tunnel",
	"underwater",
	"custom"
};

class map_reverb_zone
{
	int minx, maxx, miny, maxy, minz, maxz;
	string preset;
	float decay_ms;
	float wet_db;
	float dry_db;
	float diffusion;
	float density;
	float early_delay;
	float late_delay;
	float hf_reference;
	float hf_decay_ratio;
	float low_shelf_freq;
	float low_shelf_gain;
	float high_cut;
	float early_late_mix;

	bool contains(int x, int y, int z)
	{
		return (x >= minx && x <= maxx && y >= miny && y <= maxy && z >= minz && z <= maxz);
	}
}

map_reverb_zone@[] map_reverb_zones(0);

bool is_valid_king_reverb_preset(const string&in name)
{
	string p = string_to_lower_case(name.trim_whitespace());
	for (uint i = 0; i < KING_REVERB_PRESETS.length(); i++)
	{
		if (KING_REVERB_PRESETS[i] == p) return true;
	}
	return false;
}

void get_king_reverb_preset_defaults(
	const string&in preset,
	float&out decay_ms,
	float&out wet_db,
	float&out dry_db,
	float&out diffusion,
	float&out density,
	float&out early_delay,
	float&out late_delay,
	float&out hf_reference,
	float&out hf_decay_ratio,
	float&out low_shelf_freq,
	float&out low_shelf_gain,
	float&out high_cut,
	float&out early_late_mix)
{
	string p = string_to_lower_case(preset.trim_whitespace());
	wet_db = -6.0f;
	dry_db = 0.0f;
	low_shelf_freq = 250.0f;
	low_shelf_gain = 0.0f;
	early_late_mix = 60.0f;

	if (p == "room")
	{
		decay_ms = 400.0f; diffusion = 100.0f; density = 100.0f;
		early_delay = 2.0f; late_delay = 3.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 83.0f; high_cut = 6050.0f;
	}
	else if (p == "hall")
	{
		decay_ms = 1500.0f; diffusion = 100.0f; density = 100.0f;
		early_delay = 7.0f; late_delay = 11.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 59.0f; high_cut = 7800.0f;
	}
	else if (p == "cave")
	{
		decay_ms = 2900.0f; diffusion = 100.0f; density = 100.0f;
		early_delay = 15.0f; late_delay = 22.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 100.0f; high_cut = 16000.0f;
	}
	else if (p == "bathroom")
	{
		decay_ms = 1500.0f; diffusion = 100.0f; density = 60.0f;
		early_delay = 7.0f; late_delay = 11.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 54.0f; high_cut = 7600.0f;
	}
	else if (p == "arena")
	{
		decay_ms = 7200.0f; diffusion = 100.0f; density = 100.0f;
		early_delay = 20.0f; late_delay = 30.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 33.0f; high_cut = 4500.0f;
	}
	else if (p == "hangar")
	{
		decay_ms = 10000.0f; diffusion = 100.0f; density = 100.0f;
		early_delay = 20.0f; late_delay = 30.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 23.0f; high_cut = 3400.0f;
	}
	else if (p == "forest")
	{
		decay_ms = 1500.0f; diffusion = 79.0f; density = 100.0f;
		early_delay = 162.0f; late_delay = 88.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 54.0f; high_cut = 760.0f;
	}
	else if (p == "tunnel")
	{
		decay_ms = 3900.0f; diffusion = 100.0f; density = 100.0f;
		early_delay = 5.0f; late_delay = 15.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 50.0f; high_cut = 5000.0f;
	}
	else if (p == "underwater")
	{
		decay_ms = 1500.0f; diffusion = 100.0f; density = 100.0f;
		early_delay = 7.0f; late_delay = 11.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 10.0f; high_cut = 500.0f;
	}
	else
	{
		decay_ms = 1500.0f; diffusion = 80.0f; density = 60.0f;
		early_delay = 5.0f; late_delay = 10.0f; hf_reference = 5000.0f;
		hf_decay_ratio = 50.0f; high_cut = 8000.0f;
	}
}

void init_world_reverb_mixer()
{
	if (!world_reverb_mixer_initialized)
	{
		world_reverb_mixer_initialized = true;
		@p.mixer = @world_reverb_mixer;
		@sp.mixer = @world_reverb_mixer;
		@itempool.mixer = @world_reverb_mixer;
		@bulletpool.mixer = @world_reverb_mixer;
		@map_door_audio.mixer = @world_reverb_mixer;
		@elevator_audio.mixer = @world_reverb_mixer;
	}
	if (itempool.mixer !is world_reverb_mixer)
	{
		@itempool.mixer = @world_reverb_mixer;
	}
	if (npcp !is null && npcp.mixer is null)
	{
		@npcp.mixer = @world_reverb_mixer;
	}
}

void apply_king_reverb_to_mixer(
	mixer@ m,
	const string&in preset,
	float decay_ms,
	float wet_db,
	float dry_db,
	float diffusion,
	float density,
	float early_delay,
	float late_delay,
	float hf_reference,
	float hf_decay_ratio,
	float low_shelf_freq,
	float low_shelf_gain,
	float high_cut,
	float early_late_mix)
{
	if (m is null) return;
	string p_name = string_to_lower_case(preset.trim_whitespace());
	if (p_name != "" && p_name != "custom" && is_valid_king_reverb_preset(p_name))
	{
		m.set_reverb_preset(p_name, wet_db, dry_db);
	}
	else
	{
		m.set_reverb(
			decay_ms,
			wet_db,
			dry_db,
			diffusion,
			density,
			early_delay,
			late_delay,
			hf_reference,
			hf_decay_ratio,
			low_shelf_freq,
			low_shelf_gain,
			high_cut,
			early_late_mix
		);
	}
}

void clear_map_reverbs()
{
	map_reverb_zones.resize(0);
	active_reverb_zone_index = -1;
	if (world_reverb_mixer_initialized)
	{
		world_reverb_mixer.remove_reverb();
	}
}

void spawn_reverb_zone(
	int x1, int x2, int y1, int y2, int z1, int z2,
	const string&in preset,
	float decay_ms = 1500.0f,
	float wet_db = -6.0f,
	float dry_db = 0.0f,
	float diffusion = 80.0f,
	float density = 60.0f,
	float early_delay = 5.0f,
	float late_delay = 10.0f,
	float hf_reference = 5000.0f,
	float hf_decay_ratio = 50.0f,
	float low_shelf_freq = 250.0f,
	float low_shelf_gain = 0.0f,
	float high_cut = 8000.0f,
	float early_late_mix = 60.0f)
{
	string p_name = string_to_lower_case(preset.trim_whitespace());
	if (!is_valid_king_reverb_preset(p_name)) p_name = "room";

	map_reverb_zone rz;
	rz.minx = (x1 < x2) ? x1 : x2;
	rz.maxx = (x1 > x2) ? x1 : x2;
	rz.miny = (y1 < y2) ? y1 : y2;
	rz.maxy = (y1 > y2) ? y1 : y2;
	rz.minz = (z1 < z2) ? z1 : z2;
	rz.maxz = (z1 > z2) ? z1 : z2;
	rz.preset = p_name;
	rz.decay_ms = decay_ms;
	rz.wet_db = wet_db;
	rz.dry_db = dry_db;
	rz.diffusion = diffusion;
	rz.density = density;
	rz.early_delay = early_delay;
	rz.late_delay = late_delay;
	rz.hf_reference = hf_reference;
	rz.hf_decay_ratio = hf_decay_ratio;
	rz.low_shelf_freq = low_shelf_freq;
	rz.low_shelf_gain = low_shelf_gain;
	rz.high_cut = high_cut;
	rz.early_late_mix = early_late_mix;
	map_reverb_zones.insert_last(rz);
}

void update_map_reverb()
{
	init_world_reverb_mixer();
	if (!is_in_game || mapname == "" || map_reverb_zones.length() == 0)
	{
		if (active_reverb_zone_index != -1)
		{
			active_reverb_zone_index = -1;
			world_reverb_mixer.remove_reverb();
		}
		return;
	}

	int px = int(round(me.x, 0));
	int py = int(round(me.y, 0));
	int pz = int(round(me.z, 0));
	int matched_idx = -1;
	for (int i = int(map_reverb_zones.length()) - 1; i >= 0; i--)
	{
		if (map_reverb_zones[uint(i)].contains(px, py, pz))
		{
			matched_idx = i;
			break;
		}
	}

	if (matched_idx == active_reverb_zone_index) return;
	active_reverb_zone_index = matched_idx;

	if (matched_idx == -1)
	{
		world_reverb_mixer.remove_reverb();
		return;
	}

	map_reverb_zone@ rz = map_reverb_zones[uint(matched_idx)];
	apply_king_reverb_to_mixer(
		world_reverb_mixer,
		rz.preset,
		rz.decay_ms,
		rz.wet_db,
		rz.dry_db,
		rz.diffusion,
		rz.density,
		rz.early_delay,
		rz.late_delay,
		rz.hf_reference,
		rz.hf_decay_ratio,
		rz.low_shelf_freq,
		rz.low_shelf_gain,
		rz.high_cut,
		rz.early_late_mix
	);
}
