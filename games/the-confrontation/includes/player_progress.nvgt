// player_progress.nvgt - Player XP, resurrection and damage.
// Moved out of the removed NPC runtime so the player systems stay intact.

void add_player_quantum_xp(int amount)
{
	if (amount <= 0) return;
	xp += amount;
	speak("Gained " + amount + " XP!");
	normalize_player_xp(true);
	if (level >= get_resurrection_levels_required(resurrections))
	{
		resurrections += 1;
		level = 1;
		xp = 0;
		xprequired = get_xp_required(level);

		// Every resurrection raises the maximum health by a fixed 200: 1000 at the
		// start, 1200 after the first resurrection, 1400 after the second, and so on.
		maxhealth += 200;
		health = maxhealth;

		string resurrection_sound = get_player_sound("resurrection");
		if (sound_file_exists(resurrection_sound)) p.play_stationary(resurrection_sound, false);

		string maps_note = "";
		string[]@ new_maps = @get_maps_unlocked_at_resurrection(resurrections);
		if (new_maps !is null && new_maps.length() > 0)
		{
			string list = "";
			for (uint nm = 0; nm < new_maps.length(); nm++)
			{
				if (list != "") list += ", ";
				list += new_maps[nm];
			}
			maps_note = " A new map is now unlocked: " + list + ". Leave the map you are in and return to the map menu to play it.";
		}

		speak("Congratulations, dear player! You have achieved resurrection number " + resurrections + ". Your maximum health is now " + maxhealth + "." + maps_note);
	}
	save_location();
}

// Central death sequence: anti-death card first, then death sounds, then menu.
bool check_and_use_anti_death_card()
{
	if (get_item_count("anti_death_card") > 0)
	{
		give("anti_death_card", -1);
		health = maxhealth;
		is_sitting = false;
		string snd_file = "sounds/misc/deathfree.ogg";
		string s = find_sound_in_disk(snd_file);
		if (s == "") s = get_sound_path(snd_file);
		if (s != "") p.play_stationary(s, false);
		speak("Anti-death card activated. Your life has been saved and your health is fully restored.");
		save_location();
		return true;
	}
	return false;
}

// Loads and starts every sound of the player's death at once: Tristan's voice
// 17, the three numbered death effects and the platform's fall sound. Missing
// files are skipped; no generic clip is substituted for them.
sound@[] start_player_death_sounds()
{
	sound@[] started;
	string[]@ paths = get_player_death_sounds();
	for (uint i = 0; i < paths.length(); i++)
	{
		if (paths[i] == "") continue;
		sound@ s = sound();
		if (!s.load(paths[i])) continue;
		s.play();
		started.insert_last(s);
	}

	string fall_path = get_platform_sound(gmt(), "fall");
	if (fall_path == "") fall_path = get_platform_sound(gmt(), "hardland");
	if (fall_path == "") fall_path = get_player_sound("fall");
	if (fall_path != "")
	{
		sound@ fs = sound();
		if (fs.load(fall_path))
		{
			fs.play();
			started.insert_last(fs);
		}
	}
	return started;
}

void player_die(const string&in cause_message)
{
	if (check_and_use_anti_death_card())
	{
		return;
	}
	if (cause_message != "")
	{
		speak(cause_message);
	}

	if (bleading.playing) bleading.stop();
	if (heartbeat.playing) heartbeat.stop();

	// The death ensemble (voice 17 plus the three numbered effects) and the
	// platform fall sound all start together, so the fall reads as one event.
	sound@[] death_snds = start_player_death_sounds();
	timer death_wait;
	death_wait.restart();
	while (death_wait.elapsed < 30000)
	{
		bool any_playing = false;
		for (uint i = 0; i < death_snds.length(); i++)
		{
			if (death_snds[i] !is null && death_snds[i].playing)
			{
				any_playing = true;
				break;
			}
		}
		if (!any_playing) break;
		wait(5);
	}
	for (uint i = 0; i < death_snds.length(); i++)
	{
		if (death_snds[i] !is null) death_snds[i].stop();
	}
	death_snds.resize(0);

	sp.destroy_all();
	p.destroy_all();
	dp.destroy_all();

	is_sitting = false;
	reset_location_on_death();
	reset();
	mainmenu();
}

void health_damage_player(int dmg, const string&in killer_name = "", const string&in weapon_name = "")
{
	if (dmg <= 0) return;
	health -= dmg;
	if (health > 0)
	{
		if (enable_player_pain_sounds == 1)
		{
			string pain_snd = pick_player_pain_sound();
			if (pain_snd != "") p.play_stationary(pain_snd, false);
		}
	}
	else
	{
		string kn = (killer_name != "") ? killer_name : tr("game.enemy");
		string kill_msg = format_player_death_message(kn, me.x, me.y, me.z, weapon_name);
		player_die(kill_msg);
	}
}
