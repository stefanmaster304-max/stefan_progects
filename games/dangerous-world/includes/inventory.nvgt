bool is_item_equipped(const string&in item_id)
{
	if (item_id == current_weapon_id && current_weapon_id != "") return true;
	if (current_shield !is null && current_shield.id == item_id && current_shield.durability > 0) return true;
	return false;
}

// inventory.nvgt - Dedicated Fast Cyclic Player Inventory Engine

#include "package_manager.nvgt"
#include "shield_system.nvgt"

int invpos = 0;
dictionary inv;
bool takeobj;

void give(string item, int amount)
{
	int a;
	if (!inv.exists(item))
	{
		if (amount <= 0) return;
		inv.set(item, amount);
	}
	else
	{
		inv.get(item, a);
		if (a + amount <= 0)
		{
			inv.delete(item);
		}
		else
			inv.set(item, a + amount);
	}
}

int get_item_count(string item)
{
	int amount = 0;
	if (inv.exists(item))
		inv.get(item, amount);
	return amount;
}

int count_total_items()
{
	string[] keys = inv.get_keys();
	return int(keys.length());
}

string get_inventory_item_label(const string&in item_id)
{
	string name = get_item_display_name(item_id);
	int count = get_item_count(item_id);
	string status = "";
	if (is_item_equipped(item_id)) status = ", equipped";

	if (count > 0)
		return name + ", " + count + (count == 1 ? " item" : " items") + status + ".";
	else
		return name + ", 0 in backpack" + status + ".";
}

string[] get_all_inv_keys()
{
	string[] all_keys = inv.get_keys();
	string[] keys;
	for (uint i = 0; i < all_keys.length(); i++)
	{
		int qty = 0;
		inv.get(all_keys[i], qty);
		if (qty > 0 && keys.find(all_keys[i]) == -1)
		{
			keys.insert_last(all_keys[i]);
		}
	}
	if (current_weapon_id != "" && keys.find(current_weapon_id) == -1)
	{
		keys.insert_last(current_weapon_id);
	}

	keys.sort_ascending();
	return keys;
}

string serialize_inventory()
{
	string[] keys = inv.get_keys();
	string out_str = "";
	for (uint i = 0; i < keys.length(); i++)
	{
		int qty = 0;
		inv.get(keys[i], qty);
		if (qty > 0)
		{
			if (out_str != "") out_str += ";";
			out_str += keys[i] + ":" + qty;
		}
	}
	return out_str;
}

void deserialize_inventory(const string&in data)
{
	inv.delete_all();
	if (data == "") return;
	string[] pairs = string_split(data, ";", false);
	for (uint i = 0; i < pairs.length(); i++)
	{
		string[] kv = string_split(pairs[i], ":", false);
		if (kv.length() >= 2)
		{
			string item = kv[0];
			int qty = int(string_to_number(kv[1]));
			if (qty > 0) inv.set(item, qty);
		}
	}
}

string get_item_display_name(const string&in item_id)
{
	weapon_data@ w = find_weapon_data(item_id);
	if (w !is null && w.name != "") return "[Weapon] " + w.name;

	item_data@ it = get_item_data(item_id);
	if (it !is null && it.name != "") return it.name;

	package_data@ pkg = find_package_data(item_id);
	if (pkg !is null && pkg.name != "") return pkg.name;

	return string_replace(item_id, "_", " ", true);
}

string get_item_description(const string&in item_id)
{
	item_data@ it = get_item_data(item_id);
	if (it !is null)
	{
		if (it.category == "equipment") return build_equipment_description(it);
		if (it.description != "") return it.description;
	}

	package_data@ pkg = find_package_data(item_id);
	if (pkg !is null && pkg.description != "") return pkg.description;

	weapon_data@ w = find_weapon_data(item_id);
	if (w !is null)
	{
		if (w.description != "") return w.description;
		if (w.melee) return "Melee Weapon. Damage " + w.min_damage + "-" + w.max_damage + ".";
		return "Ranged Weapon. Class: " + w.wclass + ", Capacity: " + w.capacity + " " + w.ammo_display + ", Damage: " + w.min_damage + "-" + w.max_damage + ".";
	}

	return "";
}

void use(string item)
{
	if (item == "") return;
	load_all_items_config();
	load_all_weapons_wpm();
	load_all_packages();

	weapon_data@ w = find_weapon_data(item);
	if (w !is null)
	{
		equip_weapon(item);
		return;
	}

	if (is_package(item))
	{
		open_package_by_id(item);
		return;
	}

	if (is_equipment_item(item))
	{
		equip_equipment(item);
		return;
	}

	item_data@ it = get_item_data(item);
	if (it !is null)
	{
		if (it.subtype == "anti_death_card" || it.id == "anti_death_card")
		{
			speak("This anti-death card protects you automatically from your inventory upon taking fatal damage.");
			return;
		}

		if (it.category == "packages")
		{
			open_package_by_id(item);
			return;
		}
		else if (it.category == "currency")
		{
			return;
		}
		else if (it.category == "consumables")
		{
			if (health >= maxhealth)
			{
				speak("Your health is already at maximum.");
				return;
			}

			if (it.sound_use != "")
			{
				string usnd = get_sound_path(it.sound_use);
				if (usnd != "") p.play_stationary(usnd, false);
			}

			int heal_val = (it.heal_amount > 0) ? it.heal_amount : 250;
			health += heal_val;
			if (health > maxhealth) health = maxhealth;

			give(item, -1);
			return;
		}
		else
		{
			speak("Cannot use this item directly.");
			return;
		}
	}

	speak("Cannot use this item directly.");
}

void cycle_inventory(bool reverse = false)
{
	load_all_items_config();
	load_all_weapons_wpm();
	load_all_packages();

	string[] keys = get_all_inv_keys();
	if (keys.length() == 0)
	{
		focuseditem = "";
		speak("Inventory is empty.");
		return;
	}

	int idx = -1;
	if (focuseditem != "")
	{
		idx = keys.find(focuseditem);
	}

	if (idx == -1)
	{
		idx = reverse ? int(keys.length()) - 1 : 0;
	}
	else
	{
		if (reverse)
		{
			idx--;
			if (idx < 0) idx = int(keys.length()) - 1;
		}
		else
		{
			idx++;
			if (idx >= int(keys.length())) idx = 0;
		}
	}

	focuseditem = keys[idx];

	string catsnd = get_sound_path("player/invcat_change.ogg");
	if (catsnd != "") p.play_stationary(catsnd, false);

	speak(get_inventory_item_label(focuseditem));
}

bool activate_focused_item()
{
	if (focuseditem == "") return false;
	int count = get_item_count(focuseditem);
	if (count <= 0 && !is_item_equipped(focuseditem))
	{
		focuseditem = "";
		return false;
	}

	weapon_data@ w = find_weapon_data(focuseditem);
	if (w !is null)
	{
		if (current_weapon_id == focuseditem)
		{
			unequip_weapon(false);
			speak("Unequipped " + (w.name != "" ? w.name : focuseditem) + ".");
		}
		else
		{
			equip_weapon(focuseditem);
		}
		focuseditem = "";
		return true;
	}

	if (is_equipment_item(focuseditem))
	{
		equip_equipment(focuseditem);
		focuseditem = "";
		return true;
	}

	item_data@ it = get_item_data(focuseditem);
	if (it !is null && it.category == "consumables")
	{
		if (it.subtype == "anti_death_card" || it.id == "anti_death_card")
		{
			speak("This anti-death card protects you automatically from your inventory upon taking fatal damage.");
			focuseditem = "";
			return true;
		}

		if (health >= maxhealth)
		{
			speak("Your health is already at maximum.");
			return true;
		}

		if (it.sound_use != "")
		{
			string usnd = get_sound_path(it.sound_use);
			if (usnd != "") p.play_stationary(usnd, false);
		}

		int heal_val = (it.heal_amount > 0) ? it.heal_amount : 250;
		health += heal_val;
		if (health > maxhealth) health = maxhealth;

		give(focuseditem, -1);
		if (get_item_count(focuseditem) <= 0)
		{
			focuseditem = "";
		}
		return true;
	}

	if (is_package(focuseditem) || (it !is null && it.category == "packages"))
	{
		open_package_by_id(focuseditem);
		if (get_item_count(focuseditem) <= 0)
		{
			focuseditem = "";
		}
		return true;
	}

	return false;
}
