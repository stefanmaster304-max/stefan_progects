/* map_system.nvgt - Native coordinate map integration backed by map_system.dll
 * Used for instant zero-latency spatial queries in 3D maps.
 */
#pragma plugin map_system

enum map_flags {
	MAP_TILE        = 1 << 0,
	MAP_WALL        = 1 << 1,
	MAP_STAIR       = 1 << 2,
	MAP_ZONE        = 1 << 3,
	MAP_SAFEZONE    = 1 << 4,
	MAP_TRAVELPOINT = 1 << 5,
	MAP_DOOR        = 1 << 6
}

// Struct representing a fast query result
class map_query_result {
	string data1;
	string data2;
	string data3;
	int64 flags;
	map_query_result(const string&in d1 = "", const string&in d2 = "", const string&in d3 = "", int64 fl = 0) {
		data1 = d1;
		data2 = d2;
		data3 = d3;
		flags = fl;
	}
}

// The core native map class backed by map_system.dll's coordinate_map
class native_map {
	coordinate_map impl;
	int priority_counter = 0;
	string name = "";
	double minx = 0, maxx = 0;
	double miny = 0, maxy = 0;
	double minz = 0, maxz = 0;

	void reset_data() {
		impl.reset();
		priority_counter = 0;
	}

	void add_area(double x1, double x2, double y1, double y2, double z1, double z2, const string&in data1, const string&in data2 = "", const string&in data3 = "", int64 flags = 0) {
		double mn_x = (x1 < x2) ? x1 : x2;
		double mx_x = (x1 > x2) ? x1 : x2;
		double mn_y = (y1 < y2) ? y1 : y2;
		double mx_y = (y1 > y2) ? y1 : y2;
		double mn_z = (z1 < z2) ? z1 : z2;
		double mx_z = (z1 > z2) ? z1 : z2;
		impl.add_area(mn_x, mx_x, mn_y, mx_y, mn_z, mx_z, 0.0, null, data1, data2, data3, priority_counter++, flags);
	}

	void add_tile(double x1, double x2, double y1, double y2, double z1, double z2, const string&in tile_type, const string&in collectible = "") {
		add_area(x1, x2, y1, y2, z1, z2, tile_type, collectible, "", MAP_TILE);
	}

	void add_wall(double x1, double x2, double y1, double y2, double z1, double z2, const string&in wall_type) {
		add_area(x1, x2, y1, y2, z1, z2, wall_type, "", "", MAP_WALL);
	}

	void add_stair(double x1, double x2, double y1, double y2, double z1, double z2, const string&in stair_type) {
		add_area(x1, x2, y1, y2, z1, z2, stair_type, "", "", MAP_STAIR);
	}

	void add_zone(double x1, double x2, double y1, double y2, double z1, double z2, const string&in text) {
		add_area(x1, x2, y1, y2, z1, z2, text, "", "", MAP_ZONE);
	}

	void add_safezone(double x1, double x2, double y1, double y2, double z1, double z2, const string&in safetype) {
		add_area(x1, x2, y1, y2, z1, z2, safetype, "", "", MAP_SAFEZONE);
	}

	void add_travelpoint(double x1, double x2, double y1, double y2, double z1, double z2,
	                     double dx1, double dx2, double dy1, double dy2, double dz1, double dz2,
	                     const string&in target_map, int autotp = 1) {
		string dest_coords = dx1 + ":" + dx2 + ":" + dy1 + ":" + dy2 + ":" + dz1 + ":" + dz2;
		add_area(x1, x2, y1, y2, z1, z2, target_map, dest_coords, "" + autotp, MAP_TRAVELPOINT);
	}

	void add_door(double x1, double x2, double y1, double y2, double z1, double z2,
	              const string&in opensnd, const string&in closesnd, const string&in surf,
	              const string&in password = "") {
		string extra = opensnd + ":" + closesnd + ":" + surf;
		add_area(x1, x2, y1, y2, z1, z2, extra, password, "", MAP_DOOR);
	}

	string get_tile(double x, double y, double z) {
		coordinate_map_area@ a = impl.get_area(x, y, z, -1, 0.0, null, MAP_TILE);
		if (@a == null) return "";
		return a.data1;
	}

	string get_tile_collectible(double x, double y, double z) {
		coordinate_map_area@ a = impl.get_area(x, y, z, -1, 0.0, null, MAP_TILE);
		if (@a == null) return "";
		return a.data2;
	}

	string get_wall(double x, double y, double z) {
		coordinate_map_area@ a = impl.get_area(x, y, z, -1, 0.0, null, MAP_WALL);
		if (@a == null) return "";
		return a.data1;
	}

	string get_stair(double x, double y, double z) {
		coordinate_map_area@ a = impl.get_area(x, y, z, -1, 0.0, null, MAP_STAIR);
		if (@a == null) return "";
		return a.data1;
	}

	string get_zone(double x, double y, double z) {
		coordinate_map_area@ a = impl.get_area(x, y, z, -1, 0.0, null, MAP_ZONE);
		if (@a == null) return "";
		return a.data1;
	}

	string get_safezone(double x, double y, double z) {
		coordinate_map_area@ a = impl.get_area(x, y, z, -1, 0.0, null, MAP_SAFEZONE);
		if (@a == null) return "";
		return a.data1;
	}

	bool is_safezone(double x, double y, double z) {
		coordinate_map_area@ a = impl.get_area(x, y, z, -1, 0.0, null, MAP_SAFEZONE);
		return (@a != null);
	}

	bool wall_blocks(double x, double y, double z) {
		coordinate_map_area@ a = impl.get_area(x, y, z, -1, 0.0, null, MAP_WALL);
		return (@a != null);
	}
}

// Global active native map instance
native_map g_active_map;
