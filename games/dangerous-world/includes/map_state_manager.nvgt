// includes/map_state_manager.nvgt - Map state persistence across seamless transitions
// Preserves ground items and item spawners when switching maps

class map_persistent_state
{
	string map_name;
	ground_item@[] items;
	map_item_spawner@[] item_spawners;
}

dictionary g_map_states;

bool has_saved_map_state(const string&in mname)
{
	if (mname == "") return false;
	return g_map_states.exists(mname);
}

void save_current_map_state()
{
	if (mapname == "") return;
	map_persistent_state@ st = map_persistent_state();
	st.map_name = mapname;

	for (uint k = 0; k < ground_items.length(); k++)
	{
		if (ground_items[k] !is null)
		{
			ground_items[k].sound_slot = -1;
			st.items.insert_last(ground_items[k]);
		}
	}

	for (uint m = 0; m < map_item_spawners.length(); m++)
	{
		if (map_item_spawners[m] !is null)
			st.item_spawners.insert_last(map_item_spawners[m]);
	}

	g_map_states.set(mapname, @st);

	ground_items.resize(0);
	map_item_spawners.resize(0);
}

void restore_map_state(const string&in mname)
{
	if (mname != "" && g_map_states.exists(mname))
	{
		map_persistent_state@ st = null;
		g_map_states.get(mname, @st);
		if (st !is null)
		{
			ground_items = st.items;
			map_item_spawners = st.item_spawners;
			return;
		}
	}
	ground_items.resize(0);
	map_item_spawners.resize(0);
}

void clear_saved_map_state(const string&in mname)
{
	if (mname != "" && g_map_states.exists(mname))
	{
		g_map_states.delete(mname);
	}
}

void clear_all_map_states()
{
	g_map_states.delete_all();
}
