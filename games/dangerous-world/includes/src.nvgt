sound_pool sp(512); // Map ambience/source pool is bounded to prevent mixer overload
source@[] src(0);
dictionary source_playback_offsets;
dictionary source_resolved_path_cache;
dictionary source_is_music_cache;

string[] cached_source_maps;
const uint MAX_CACHED_SOURCE_MAPS = 3;
dictionary registered_source_maps;

void save_current_map_source_positions()
{
	if (mapname == "") return;
	save_map_source_positions(mapname);
}

void save_map_source_positions(const string&in mname)
{
	if (mname == "") return;
	for (uint i = 0; i < src.length(); i++)
	{
		if (src[i].map == mname && src[i].sound >= 0 && uint(src[i].sound) < sp.items.length())
		{
			double pos = 0.0;
			if (@sp.items[src[i].sound].handle != null)
				pos = sp.items[src[i].sound].handle.position;
			if (pos > 0)
			{
				string key = mname + ":" + src[i].file;
				source_playback_offsets.set(key, pos);
			}
		}
	}
}

double get_saved_source_position(const string&in mname, const string&in file)
{
	if (mname == "" || file == "") return 0.0;
	string key = mname + ":" + file;
	double pos = 0.0;
	if (source_playback_offsets.exists(key))
	{
		source_playback_offsets.get(key, pos);
	}
	return pos;
}

bool has_map_sources(const string&in mname)
{
	if (mname == "") return false;
	return registered_source_maps.exists(mname);
}

void mark_map_sources_registered(const string&in mname)
{
	if (mname != "") registered_source_maps.set(mname, true);
}

void pause_map_sources(const string&in mname)
{
	if (mname == "") return;
	for (uint i = 0; i < src.length(); i++)
	{
		if (src[i].map != mname || src[i].paused || src[i].sound < 0) continue;
		if (uint(src[i].sound) < sp.items.length() && @sp.items[src[i].sound].handle != null)
		{
			double pos = sp.items[src[i].sound].handle.position;
			if (pos > 0) source_playback_offsets.set(mname + ":" + src[i].file, pos);
		}
		sp.pause_sound(src[i].sound);
		src[i].paused = true;
	}
}

void resume_map_sources(const string&in mname)
{
	double cur_min = 0.0;
	for (uint i = 0; i < src.length(); i++)
	{
		if (src[i].map == mname && src[i].sound >= 0)
		{
			if (src[i].is_ambience)
			{
				if (src[i].is_player_inside())
				{
					if (src[i].paused)
					{
						src[i].paused = false;
						sp.resume_sound(src[i].sound);
					}
				}
				else
				{
					if (!src[i].paused)
					{
						src[i].paused = true;
						sp.pause_sound(src[i].sound);
					}
				}
			}
			else if (src[i].paused)
			{
				src[i].paused = false;
				sp.resume_sound(src[i].sound);
			}

			if (src[i].use_time_limits)
			{
				src[i].update_timed_volume(cur_min);
			}
			else
			{
				double base_vol = src[i].is_music ? map_music_volume : (ambient_volume - 100);
				float final_vol = float(base_vol + src[i].volume);
				if (final_vol > 0.0) final_vol = 0.0;
				if (final_vol < -100.0) final_vol = -100.0;
				sp.update_sound_start_values(src[i].sound, 0.0, final_vol, float(src[i].pitch));
			}
		}
	}
}

void destroy_map_sources(const string&in mname)
{
	if (mname == "") return;
	for (int i = int(src.length()) - 1; i >= 0; i--)
	{
		if (src[i].map == mname)
		{
		if (src[i].sound >= 0 && uint(src[i].sound) < sp.items.length())
			{
				double pos = 0.0;
				if (@sp.items[src[i].sound].handle != null)
					pos = sp.items[src[i].sound].handle.position;
				if (pos > 0)
				{
					string key = mname + ":" + src[i].file;
					source_playback_offsets.set(key, pos);
				}
				sp.destroy_sound(src[i].sound);
			}
			src.remove_at(uint(i));
		}
	}
	if (registered_source_maps.exists(mname))
		registered_source_maps.delete(mname);
}

void seamless_switch_map_sources(const string&in prev_map, const string&in next_map)
{
	if (prev_map != "" && prev_map != next_map)
	{
		save_map_source_positions(prev_map);
		pause_map_sources(prev_map);
	}
	if (next_map == "") return;

	int found_idx = -1;
	for (uint i = 0; i < cached_source_maps.length(); i++)
	{
		if (cached_source_maps[i] == next_map)
		{
			found_idx = int(i);
			break;
		}
	}
	if (found_idx >= 0)
	{
		cached_source_maps.remove_at(uint(found_idx));
		cached_source_maps.insert_last(next_map);
		resume_map_sources(next_map);
		return;
	}
	while (cached_source_maps.length() >= MAX_CACHED_SOURCE_MAPS)
	{
		string oldest = cached_source_maps[0];
		destroy_map_sources(oldest);
		cached_source_maps.remove_at(0);
	}
	cached_source_maps.insert_last(next_map);
}

double mult_to_db_offset(double mult)
{
	if (mult <= 0.0001) return -100.0;
	if (mult >= 0.9999) return 0.0;
	// Linear perceived amplitude conversion to decibels:
	// db = 20 * log10(mult), smoothly and audibly decreasing from 0 dB to -100 dB
	double amp = mult;
	if (amp <= 0.0001) return -100.0;
	double db = 20.0 * log10(amp);
	if (db < -100.0) db = -100.0;
	if (db > 0.0) db = 0.0;
	return db;
}

class source
{
	int x1, x2, y1, y2, z1, z2, sound;
	string file;
	string map;
	double volume;
	double pitch;
	bool use_time_limits;
	int start_hour, start_minute;
	int end_hour, end_minute;
	int fade_minutes;
	double last_multiplier;
	bool is_music;
	bool is_ambience;
	bool paused;

	bool is_player_inside()
	{
		int px = int(round(me.x, 0));
		int py = int(round(me.y, 0));
		int pz = int(round(me.z, 0));
		int min_x = (x1 < x2 ? x1 : x2);
		int max_x = (x1 < x2 ? x2 : x1);
		int min_y = (y1 < y2 ? y1 : y2);
		int max_y = (y1 < y2 ? y2 : y1);
		int min_z = (z1 < z2 ? z1 : z2);
		int max_z = (z1 < z2 ? z2 : z1);
		return (px >= min_x && px <= max_x && py >= min_y && py <= max_y && pz >= min_z && pz <= max_z);
	}

	source(int sx1, int sx2, int sy1, int sy2, int sz1, int sz2, string sf, double svol = 0, double spitch = 100, bool stime = false, int sh = 6, int sm = 0, int eh = 18, int em = 0, int sfade = 30, const string&in smap = "", bool is_amb = false)
	{
		x1 = sx1; x2 = sx2; y1 = sy1; y2 = sy2; z1 = sz1; z2 = sz2;
		file = sf;
		map = (smap != "" ? smap : mapname);
		volume = svol;
		if (spitch <= 0) spitch = 100;
		pitch = spitch;
		use_time_limits = stime;
		start_hour = sh; start_minute = sm;
		end_hour = eh; end_minute = em;
		fade_minutes = (sfade >= 0 ? sfade : 0);
		last_multiplier = 1.0;
		is_music = false;
		is_ambience = is_amb;
		paused = false;

		string sound_file = "";
		if (source_resolved_path_cache.exists(file))
		{
			source_resolved_path_cache.get(file, sound_file);
			if (source_is_music_cache.exists(file))
				source_is_music_cache.get(file, is_music);
		}
		else
		{
			sound_file = get_music_sound(file);
			if (sound_file != "")
			{
				is_music = true;
			}
			else
			{
				is_music = false;
				sound_file = get_ambience_sound(file);
				if (sound_file == "") sound_file = file;
			}
			source_resolved_path_cache.set(file, sound_file);
			source_is_music_cache.set(file, is_music);
		}

		int cx = (x1 + x2) / 2;
		int cy = (y1 + y2) / 2;
		int cz = (z1 + z2) / 2;
		int lx = cx - x1, rx = x2 - cx;
		int ly = cy - y1, ry = y2 - cy;
		int lz = cz - z1, rz = z2 - cz;

		double init_vol = volume;
		if (use_time_limits)
		{
			double cur_min = 0.0;
			double mult = calculate_time_multiplier(cur_min);
			last_multiplier = mult;
			init_vol = volume + mult_to_db_offset(mult);
			if (init_vol < -100.0) init_vol = -100.0;
		}

		double base_vol = is_music ? map_music_volume : (ambient_volume - 100);
		float final_vol = float(base_vol + init_vol);
		if (final_vol > 0.0) final_vol = 0.0;
		if (final_vol < -100.0) final_vol = -100.0;

		double start_off = get_saved_source_position(map, file);
		if (is_ambience)
		{
			// Environmental beds are non-positional 2D audio. Their map bounds
			// control only whether playback is paused; they never determine a
			// virtual emitter position or distance attenuation.
			sound = sp.play_stationary_extended(sound_file, true, start_off, 0.0, final_vol, float(pitch), true, null, null, true);
		}
		else
		{
			bool should_stream = true;
			sound = sp.play_extended_3d(sound_file, float(me.x), float(me.y), float(me.z), float(cx), float(cy), float(cz), double(facing), lx, rx, ly, ry, lz, rz, true, start_off, 0.0, final_vol, float(pitch), true, null, null, should_stream, 0);
			sp.update_sound_range_3d(sound, lx, rx, ly, ry, lz, rz);
		}

		if (is_ambience && !is_player_inside() && sound >= 0)
		{
			paused = true;
			sp.pause_sound(sound);
		}
	}

	double forward_dist(double from_t, double to_t)
	{
		double dist = to_t - from_t;
		while (dist < 0.0) dist += 1440.0;
		while (dist >= 1440.0) dist -= 1440.0;
		return dist;
	}

	double calculate_time_multiplier(double cur_min)
	{
		if (!use_time_limits) return 1.0;

		double s_min = double(start_hour * 60 + start_minute);
		double e_min = double(end_hour * 60 + end_minute);
		while (s_min < 0.0) s_min += 1440.0;
		while (s_min >= 1440.0) s_min -= 1440.0;
		while (e_min < 0.0) e_min += 1440.0;
		while (e_min >= 1440.0) e_min -= 1440.0;

		double t_min = cur_min;
		while (t_min < 0.0) t_min += 1440.0;
		while (t_min >= 1440.0) t_min -= 1440.0;

		double active_len = forward_dist(s_min, e_min);
		if (active_len == 0.0) return 1.0;

		double fade = double(fade_minutes);
		if (fade <= 0.0)
		{
			double elapsed = forward_dist(s_min, t_min);
			return (elapsed < active_len) ? 1.0 : 0.0;
		}

		if (fade > active_len) fade = active_len;
		double inactive_len = 1440.0 - active_len;
		if (fade > inactive_len) fade = inactive_len;

		// The cross-fade window precedes the transition boundary:
		// Incoming track fades in from [s_min - fade, s_min], reaching 1.0 at s_min.
		// Outgoing track fades out from [e_min - fade, e_min], reaching 0.0 at e_min.
		// At the transition boundary (e_min/s_min), the outgoing track reaches 0.0 (strictly
		// respecting the configured end time limit) while the incoming track reaches 1.0.
		double fade_in_start = s_min - fade;
		while (fade_in_start < 0.0) fade_in_start += 1440.0;
		while (fade_in_start >= 1440.0) fade_in_start -= 1440.0;
		double d_in = forward_dist(fade_in_start, t_min);

		double elapsed = forward_dist(s_min, t_min);

		if (d_in < fade)
		{
			double p = d_in / fade;
			if (p < 0.0) p = 0.0;
			if (p > 1.0) p = 1.0;
			return p;
		}
		else if (elapsed < (active_len - fade))
		{
			return 1.0;
		}
		else if (elapsed < active_len)
		{
			double p = (elapsed - (active_len - fade)) / fade;
			if (p < 0.0) p = 0.0;
			if (p > 1.0) p = 1.0;
			return 1.0 - p;
		}
		else
		{
			return 0.0;
		}
	}

	void update_timed_volume(double cur_min)
	{
		if (!use_time_limits || sound < 0) return;
		double mult = calculate_time_multiplier(cur_min);
		if (abs(mult - last_multiplier) > 0.001)
		{
			last_multiplier = mult;
			double eff_vol = volume + mult_to_db_offset(mult);
			if (eff_vol < -100.0) eff_vol = -100.0;
			double base_vol = is_music ? map_music_volume : (ambient_volume - 100);
			float final_vol = float(base_vol + eff_vol);
			if (final_vol > 0.0) final_vol = 0.0;
			if (final_vol < -100.0) final_vol = -100.0;
			sp.update_sound_start_values(sound, 0.0, final_vol, float(pitch));
		}
	}
}

void spawn_source(int sx1, int sx2, int sy1, int sy2, int sz1, int sz2, string sf, double svol = 0, double spitch = 100, bool stime = false, int sh = 6, int sm = 0, int eh = 18, int em = 0, int sfade = 30, const string&in smap = "", bool is_amb = false)
{
	source s1(sx1, sx2, sy1, sy2, sz1, sz2, sf, svol, spitch, stime, sh, sm, eh, em, sfade, smap, is_amb);
	src.insert_last(s1);
}

void update_sources()
{
	double cur_min = 0.0;
	for (uint i = 0; i < src.length(); i++)
	{
		if (src[i].map != mapname) continue;
		if (src[i].is_ambience)
		{
			bool inside = src[i].is_player_inside();
			if (inside)
			{
				if (src[i].paused)
				{
					src[i].paused = false;
					if (src[i].sound >= 0) sp.resume_sound(src[i].sound);
				}
				src[i].update_timed_volume(cur_min);
			}
			else
			{
				if (!src[i].paused)
				{
					src[i].paused = true;
					if (src[i].sound >= 0) sp.pause_sound(src[i].sound);
				}
			}
		}
		else
		{
			if (!src[i].paused)
			{
				src[i].update_timed_volume(cur_min);
			}
		}
	}
}

void apply_ambient_volume()
{
	double cur_min = 0.0;
	if (underwater_ambient_sound.active)
	{
		underwater_ambient_sound.volume = ambient_volume - 100.0;
	}
	for (uint i = 0; i < src.length(); i++)
	{
		if (src[i].map != mapname || src[i].sound < 0 || src[i].is_music || src[i].paused) continue;
		double mult = src[i].calculate_time_multiplier(cur_min);
		double eff_vol = src[i].volume + mult_to_db_offset(mult);
		if (eff_vol < -100.0) eff_vol = -100.0;
		float final_vol = float((ambient_volume - 100) + eff_vol);
		if (final_vol > 0.0) final_vol = 0.0;
		if (final_vol < -100.0) final_vol = -100.0;
		sp.update_sound_start_values(src[i].sound, 0.0, final_vol, float(src[i].pitch));
	}
}

void apply_music_volume()
{
	double cur_min = 0.0;
	for (uint i = 0; i < src.length(); i++)
	{
		if (src[i].map != mapname || src[i].sound < 0 || !src[i].is_music || src[i].paused) continue;
		double mult = src[i].calculate_time_multiplier(cur_min);
		double eff_vol = src[i].volume + mult_to_db_offset(mult);
		if (eff_vol < -100.0) eff_vol = -100.0;
		float final_vol = float(map_music_volume + eff_vol);
		if (final_vol > 0.0) final_vol = 0.0;
		if (final_vol < -100.0) final_vol = -100.0;
		sp.update_sound_start_values(src[i].sound, 0.0, final_vol, float(src[i].pitch));
	}
}

void clear_all_source_saved_positions()
{
	source_playback_offsets.delete_all();
}

void killsrcs()
{
	sp.destroy_all();
	src.resize(0);
	cached_source_maps.resize(0);
	registered_source_maps.delete_all();
	source_playback_offsets.delete_all();
}

bool play_builder_preview(const string&in path, double vol, double pitch)
{
	builder_preview_sound.close();
	if (path == "") return false;
	bool loaded = builder_preview_sound.stream(path);
	if (!loaded)
	{
		builder_preview_sound.close();
		loaded = builder_preview_sound.load(path, @no_sound_pack);
	}
	if (loaded)
	{
		builder_preview_sound.volume = vol;
		builder_preview_sound.pitch = pitch;
		builder_preview_sound.play_looped();
		return true;
	}
	return false;
}

void build_sound_source()
{
	string[] musics_list = get_map_sound_folders("builder/audio/musics/*");
	string[] sources_list = get_map_sound_folders("builder/audio/sources/*");

	string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
	string saved_x = "" + minx;
	string saved_x2 = "" + maxx;
	string saved_y = "" + miny;
	string saved_y2 = "" + maxy;
	string saved_z = "" + minz;
	string saved_z2 = "" + maxz;
	bool saved_timed = false;
	double saved_sh = 6;
	double saved_sm = 0;
	double saved_eh = 18;
	double saved_em = 0;
	double saved_fade = 30;
	int saved_cat_pos = 0;
	int saved_sub_pos = 0;
	double saved_vol = 0;
	double saved_pit = 100;
	bool do_build = true;
	int last_cat_pos = -1;
	int last_sub_pos = -1;

	audio_form f;
	int mx = -1, mx2 = -1, my = -1, my2 = -1, mnz = -1, mxz = -1;
	int cb_timed = -1, s_sh = -1, s_sm = -1, s_eh = -1, s_em = -1, s_fade = -1;
	int cat_list = -1, sub_list = -1, vol_s = -1, pit_s = -1, ok = -1, cn = -1;
	bool preview_playing = false;
	timer space_preview_timer;

	while (true)
	{
		wait(5);
		update_game_world();
		if (do_build)
		{
			do_build = false;
			if (last_cat_pos != -1)
			{
				saved_x = f.get_text(mx);
				saved_x2 = f.get_text(mx2);
				saved_y = f.get_text(my);
				saved_y2 = f.get_text(my2);
				saved_z = f.get_text(mnz);
				saved_z2 = f.get_text(mxz);
				saved_timed = f.is_checked(cb_timed);
				saved_sh = f.get_slider(s_sh);
				saved_sm = f.get_slider(s_sm);
				saved_eh = f.get_slider(s_eh);
				saved_em = f.get_slider(s_em);
				saved_fade = f.get_slider(s_fade);
				saved_vol = f.get_slider(vol_s);
				saved_pit = f.get_slider(pit_s);
			}
			f.reset();
			f.create_window("sound source", false, true, last_cat_pos != -1);
			mx = f.create_input_box("minimum x", saved_x);
			mx2 = f.create_input_box("maximum x", saved_x2);
			my = f.create_input_box("minimum y", saved_y);
			my2 = f.create_input_box("maximum y", saved_y2);
			mnz = f.create_input_box("minimum z", saved_z);
			mxz = f.create_input_box("maximum z", saved_z2);
			f.set_disallowed_chars(mx, "0123456789-", true, "Numbers only.");
			f.set_disallowed_chars(mx2, "0123456789-", true, "Numbers only.");
			f.set_disallowed_chars(my, "0123456789-", true, "Numbers only.");
			f.set_disallowed_chars(my2, "0123456789-", true, "Numbers only.");
			f.set_disallowed_chars(mnz, "0123456789-", true, "Numbers only.");
			f.set_disallowed_chars(mxz, "0123456789-", true, "Numbers only.");

			cb_timed = f.create_checkbox("Use day and night time limits", saved_timed);
			s_sh = f.create_slider("start hour", saved_sh, 0, 23, "", 1);
			s_sm = f.create_slider("start minute", saved_sm, 0, 59, "", 1);
			s_eh = f.create_slider("end hour", saved_eh, 0, 23, "", 1);
			s_em = f.create_slider("end minute", saved_em, 0, 59, "", 1);
			s_fade = f.create_slider("fade duration in minutes", saved_fade, 0, 120, "", 5);

			cat_list = f.create_list("category");
			f.add_list_item(cat_list, "musics", "musics");
			f.add_list_item(cat_list, "sources", "sources");
			f.set_list_position(cat_list, saved_cat_pos, false);

			string sub_label = (saved_cat_pos == 0) ? "music sound" : "source sound";
			sub_list = f.create_list(sub_label);
			f.add_list_item(sub_list, "none", "none");
			if (saved_cat_pos == 0)
			{
				for (uint i = 0; i < musics_list.length(); i++) f.add_list_item(sub_list, musics_list[i], musics_list[i]);
			}
			else
			{
				for (uint i = 0; i < sources_list.length(); i++) f.add_list_item(sub_list, sources_list[i], sources_list[i]);
			}
			f.set_list_position(sub_list, saved_sub_pos, false);

			vol_s = f.create_slider("volume", saved_vol, -100, 0, "", 5);
			pit_s = f.create_slider("pitch", saved_pit, 5, 500, "", 5);
			ok = f.create_button("&okay", true);
			cn = f.create_button("&cancel");
			f.set_default_controls(ok, cn);

			if (last_cat_pos == -1) f.focus_silently(mx);
			else f.focus_silently(cat_list);
			last_cat_pos = saved_cat_pos;
		}

		f.monitor();

		bool is_t = f.is_checked(cb_timed);
		f.set_state(s_sh, is_t, is_t);
		f.set_state(s_sm, is_t, is_t);
		f.set_state(s_eh, is_t, is_t);
		f.set_state(s_em, is_t, is_t);
		f.set_state(s_fade, is_t, is_t);

		int cur_cat_pos = f.get_list_position(cat_list);
		if (cur_cat_pos != -1 && cur_cat_pos != last_cat_pos)
		{
			saved_cat_pos = cur_cat_pos;
			saved_sub_pos = 0;
			builder_preview_sound.close();
			preview_playing = false;
			do_build = true;
			continue;
		}

		int cur_focus = f.get_current_focus();
		bool in_group = (cur_focus == sub_list || cur_focus == vol_s || cur_focus == pit_s);
		int cur_sub_pos = f.get_list_position(sub_list);

		if (preview_playing && cur_sub_pos != last_sub_pos)
		{
			last_sub_pos = cur_sub_pos;
			if (cur_sub_pos > 0)
			{
				string snd_name = (saved_cat_pos == 0) ? musics_list[cur_sub_pos - 1] : sources_list[cur_sub_pos - 1];
				string path = (saved_cat_pos == 0) ? get_music_sound(snd_name) : get_ambience_sound(snd_name);
				preview_playing = play_builder_preview(path, f.get_slider(vol_s), f.get_slider(pit_s));
			}
			else
			{
				builder_preview_sound.close();
				preview_playing = false;
			}
		}

		bool space_hit = key_pressed(KEY_SPACE) || (key_down(KEY_SPACE) && space_preview_timer.elapsed >= 300);
		if (space_hit && in_group)
		{
			space_preview_timer.restart();
			if (preview_playing)
			{
				builder_preview_sound.close();
				preview_playing = false;
			}
			else if (cur_sub_pos > 0)
			{
				string snd_name = (saved_cat_pos == 0) ? musics_list[cur_sub_pos - 1] : sources_list[cur_sub_pos - 1];
				string path = (saved_cat_pos == 0) ? get_music_sound(snd_name) : get_ambience_sound(snd_name);
				preview_playing = play_builder_preview(path, f.get_slider(vol_s), f.get_slider(pit_s));
			}
			last_sub_pos = cur_sub_pos;
		}

		if (builder_preview_sound.active)
		{
			builder_preview_sound.volume = f.get_slider(vol_s);
			builder_preview_sound.pitch = f.get_slider(pit_s);
		}

		if (key_pressed(KEY_ESCAPE) || f.is_pressed(cn))
		{
			builder_preview_sound.close();
			speak("canceled");
			return;
		}

		if (f.is_pressed(ok))
		{
			string tx = f.get_text(mx);
			string tx2 = f.get_text(mx2);
			string ty = f.get_text(my);
			string ty2 = f.get_text(my2);
			string tz = f.get_text(mnz);
			string tz2 = f.get_text(mxz);
			if (tx == "" || tx2 == "" || ty == "" || ty2 == "" || tz == "" || tz2 == "")
			{
				speak("Coordinates cannot be empty.");
				continue;
			}

			int p = f.get_list_position(sub_list);
			if (p <= 0)
			{
				speak("No sound selected. Please select a sound.");
				continue;
			}

			string bsub = (saved_cat_pos == 0) ? musics_list[p - 1] : sources_list[p - 1];
			if (bsub == "" || bsub == "none")
			{
				speak("No sound selected. Please select a sound.");
				continue;
			}

			int bx1 = int(string_to_number(tx));
			int bx2 = int(string_to_number(tx2));
			int by1 = int(string_to_number(ty));
			int by2 = int(string_to_number(ty2));
			int bz1 = int(string_to_number(tz));
			int bz2 = int(string_to_number(tz2));
			double bvol = f.get_slider(vol_s);
			double bpit = f.get_slider(pit_s);

			builder_preview_sound.close();
			if (f.is_checked(cb_timed))
			{
				int bsh = int(f.get_slider(s_sh));
				int bsm = int(f.get_slider(s_sm));
				int beh = int(f.get_slider(s_eh));
				int bem = int(f.get_slider(s_em));
				int bfade = int(f.get_slider(s_fade));
				save_to_map("source:" + bx1 + ":" + bx2 + ":" + by1 + ":" + by2 + ":" + bz1 + ":" + bz2 + ":" + bsub + ":" + bvol + ":" + bpit + ":1:" + bsh + ":" + bsm + ":" + beh + ":" + bem + ":" + bfade);
			}
			else
			{
				save_to_map("source:" + bx1 + ":" + bx2 + ":" + by1 + ":" + by2 + ":" + bz1 + ":" + bz2 + ":" + bsub + ":" + bvol + ":" + bpit);
			}
			return;
		}
	}
}

void build_sound_ambience()
{
	string[] musics_list = get_map_sound_folders("builder/audio/musics/*");
	string[] sources_list = get_map_sound_folders("builder/audio/sources/*");

	string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
	string saved_x = "" + minx;
	string saved_x2 = "" + maxx;
	string saved_y = "" + miny;
	string saved_y2 = "" + maxy;
	string saved_z = "" + minz;
	string saved_z2 = "" + maxz;
	bool saved_timed = false;
	double saved_sh = 6;
	double saved_sm = 0;
	double saved_eh = 18;
	double saved_em = 0;
	double saved_fade = 30;
	int saved_cat_pos = 0;
	int saved_sub_pos = 0;
	double saved_vol = 0;
	double saved_pit = 100;
	bool do_build = true;
	int last_cat_pos = -1;
	int last_sub_pos = -1;

	audio_form f;
	int mx = -1, mx2 = -1, my = -1, my2 = -1, mnz = -1, mxz = -1;
	int cb_timed = -1, s_sh = -1, s_sm = -1, s_eh = -1, s_em = -1, s_fade = -1;
	int cat_list = -1, sub_list = -1, vol_s = -1, pit_s = -1, ok = -1, cn = -1;
	bool preview_playing = false;
	timer space_preview_timer;

	while (true)
	{
		wait(5);
		update_game_world();
		if (do_build)
		{
			do_build = false;
			if (last_cat_pos != -1)
			{
				saved_x = f.get_text(mx);
				saved_x2 = f.get_text(mx2);
				saved_y = f.get_text(my);
				saved_y2 = f.get_text(my2);
				saved_z = f.get_text(mnz);
				saved_z2 = f.get_text(mxz);
				saved_timed = f.is_checked(cb_timed);
				saved_sh = f.get_slider(s_sh);
				saved_sm = f.get_slider(s_sm);
				saved_eh = f.get_slider(s_eh);
				saved_em = f.get_slider(s_em);
				saved_fade = f.get_slider(s_fade);
				saved_vol = f.get_slider(vol_s);
				saved_pit = f.get_slider(pit_s);
			}
			f.reset();
			f.create_window("sound ambience", false, true, last_cat_pos != -1);
			mx = f.create_input_box("minimum x", saved_x);
			mx2 = f.create_input_box("maximum x", saved_x2);
			my = f.create_input_box("minimum y", saved_y);
			my2 = f.create_input_box("maximum y", saved_y2);
			mnz = f.create_input_box("minimum z", saved_z);
			mxz = f.create_input_box("maximum z", saved_z2);
			f.set_disallowed_chars(mx, disallowed_nums, false, "Numbers only.");
			f.set_disallowed_chars(mx2, disallowed_nums, false, "Numbers only.");
			f.set_disallowed_chars(my, disallowed_nums, false, "Numbers only.");
			f.set_disallowed_chars(my2, disallowed_nums, false, "Numbers only.");
			f.set_disallowed_chars(mnz, disallowed_nums, false, "Numbers only.");
			f.set_disallowed_chars(mxz, disallowed_nums, false, "Numbers only.");

			cb_timed = f.create_checkbox("Use day and night time limits", saved_timed);
			s_sh = f.create_slider("start hour", saved_sh, 0, 23, "", 1);
			s_sm = f.create_slider("start minute", saved_sm, 0, 59, "", 1);
			s_eh = f.create_slider("end hour", saved_eh, 0, 23, "", 1);
			s_em = f.create_slider("end minute", saved_em, 0, 59, "", 1);
			s_fade = f.create_slider("fade duration in minutes", saved_fade, 0, 120, "", 5);

			cat_list = f.create_list("category");
			f.add_list_item(cat_list, "musics", "musics");
			f.add_list_item(cat_list, "sources", "sources");
			f.set_list_position(cat_list, saved_cat_pos, false);

			string sub_label = (saved_cat_pos == 0) ? "music sound" : "source sound";
			sub_list = f.create_list(sub_label);
			f.add_list_item(sub_list, "none", "none");
			if (saved_cat_pos == 0)
			{
				for (uint i = 0; i < musics_list.length(); i++) f.add_list_item(sub_list, musics_list[i], musics_list[i]);
			}
			else
			{
				for (uint i = 0; i < sources_list.length(); i++) f.add_list_item(sub_list, sources_list[i], sources_list[i]);
			}
			f.set_list_position(sub_list, saved_sub_pos, false);

			vol_s = f.create_slider("volume", saved_vol, -100, 0, "", 5);
			pit_s = f.create_slider("pitch", saved_pit, 5, 500, "", 5);
			ok = f.create_button("&okay", true);
			cn = f.create_button("&cancel");
			f.set_default_controls(ok, cn);

			if (last_cat_pos == -1) f.focus_silently(mx);
			else f.focus_silently(cat_list);
			last_cat_pos = saved_cat_pos;
		}

		f.monitor();

		bool is_t = f.is_checked(cb_timed);
		f.set_state(s_sh, is_t, is_t);
		f.set_state(s_sm, is_t, is_t);
		f.set_state(s_eh, is_t, is_t);
		f.set_state(s_em, is_t, is_t);
		f.set_state(s_fade, is_t, is_t);

		int cur_cat_pos = f.get_list_position(cat_list);
		if (cur_cat_pos != -1 && cur_cat_pos != last_cat_pos)
		{
			saved_cat_pos = cur_cat_pos;
			saved_sub_pos = 0;
			builder_preview_sound.close();
			preview_playing = false;
			do_build = true;
			continue;
		}

		int cur_focus = f.get_current_focus();
		bool in_group = (cur_focus == sub_list || cur_focus == vol_s || cur_focus == pit_s);
		int cur_sub_pos = f.get_list_position(sub_list);

		if (preview_playing && cur_sub_pos != last_sub_pos)
		{
			last_sub_pos = cur_sub_pos;
			if (cur_sub_pos > 0)
			{
				string snd_name = (saved_cat_pos == 0) ? musics_list[cur_sub_pos - 1] : sources_list[cur_sub_pos - 1];
				string path = (saved_cat_pos == 0) ? get_music_sound(snd_name) : get_ambience_sound(snd_name);
				preview_playing = play_builder_preview(path, f.get_slider(vol_s), f.get_slider(pit_s));
			}
			else
			{
				builder_preview_sound.close();
				preview_playing = false;
			}
		}

		bool space_hit = key_pressed(KEY_SPACE) || (key_down(KEY_SPACE) && space_preview_timer.elapsed >= 300);
		if (space_hit && in_group)
		{
			space_preview_timer.restart();
			if (preview_playing)
			{
				builder_preview_sound.close();
				preview_playing = false;
			}
			else if (cur_sub_pos > 0)
			{
				string snd_name = (saved_cat_pos == 0) ? musics_list[cur_sub_pos - 1] : sources_list[cur_sub_pos - 1];
				string path = (saved_cat_pos == 0) ? get_music_sound(snd_name) : get_ambience_sound(snd_name);
				preview_playing = play_builder_preview(path, f.get_slider(vol_s), f.get_slider(pit_s));
			}
			last_sub_pos = cur_sub_pos;
		}

		if (builder_preview_sound.active)
		{
			builder_preview_sound.volume = f.get_slider(vol_s);
			builder_preview_sound.pitch = f.get_slider(pit_s);
		}

		if (key_pressed(KEY_ESCAPE) || f.is_pressed(cn))
		{
			builder_preview_sound.close();
			speak("canceled");
			return;
		}

		if (f.is_pressed(ok))
		{
			string tx = f.get_text(mx);
			string tx2 = f.get_text(mx2);
			string ty = f.get_text(my);
			string ty2 = f.get_text(my2);
			string tz = f.get_text(mnz);
			string tz2 = f.get_text(mxz);
			if (tx == "" || tx2 == "" || ty == "" || ty2 == "" || tz == "" || tz2 == "")
			{
				speak("Coordinates cannot be empty.");
				continue;
			}

			int p = f.get_list_position(sub_list);
			if (p <= 0)
			{
				speak("No sound selected. Please select a sound.");
				continue;
			}

			string bsub = (saved_cat_pos == 0) ? musics_list[p - 1] : sources_list[p - 1];
			if (bsub == "" || bsub == "none")
			{
				speak("No sound selected. Please select a sound.");
				continue;
			}

			int bx1 = int(string_to_number(tx));
			int bx2 = int(string_to_number(tx2));
			int by1 = int(string_to_number(ty));
			int by2 = int(string_to_number(ty2));
			int bz1 = int(string_to_number(tz));
			int bz2 = int(string_to_number(tz2));
			double bvol = f.get_slider(vol_s);
			double bpit = f.get_slider(pit_s);

			builder_preview_sound.close();
			if (f.is_checked(cb_timed))
			{
				int bsh = int(f.get_slider(s_sh));
				int bsm = int(f.get_slider(s_sm));
				int beh = int(f.get_slider(s_eh));
				int bem = int(f.get_slider(s_em));
				int bfade = int(f.get_slider(s_fade));
				save_to_map("ambience:" + bx1 + ":" + bx2 + ":" + by1 + ":" + by2 + ":" + bz1 + ":" + bz2 + ":" + bsub + ":" + bvol + ":" + bpit + ":1:" + bsh + ":" + bsm + ":" + beh + ":" + bem + ":" + bfade);
			}
			else
			{
				save_to_map("ambience:" + bx1 + ":" + bx2 + ":" + by1 + ":" + by2 + ":" + bz1 + ":" + bz2 + ":" + bsub + ":" + bvol + ":" + bpit);
			}
			return;
		}
	}
}
