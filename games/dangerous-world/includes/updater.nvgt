// includes/updater.nvgt - Robust 100% functional update system for Dangerous World
// Supports Game (executable), Content (items/weapons/stores), Sounds, and Maps updates.

enum update_type
{
	UPDATE_GAME = 0,
	UPDATE_CONTENT = 1,
	UPDATE_SOUNDS = 2,
	UPDATE_MAPS = 3
}

class update_item
{
	update_type type;
	string new_version;
	string current_version;
	string url;
	string target_file;
	string target_folder;
	int new_sound_count;
	int64 size;

	update_item()
	{
		type = UPDATE_GAME;
		new_version = "";
		current_version = "";
		url = "";
		target_file = "";
		target_folder = "";
		new_sound_count = 0;
		size = 0;
	}
}

string current_game_version = "0.1.0.2";
string current_content_version = "1.0.0";
string current_sounds_version = "1.0.0";
string current_maps_version = "1.0.0";
int check_updates_on_startup = 1;
string update_manifest_url = "https://raw.githubusercontent.com/stefanmaster304-max/critical-shot-the-last-assault/main/games/dangerous-world/updates/manifest.json";

void load_updater_settings()
{
	current_game_version = ver;
	string cfg_path = "settings/versions.cfg";
	if (!file_exists(cfg_path))
	{
		save_updater_settings();
		return;
	}

	file f;
	if (f.open(cfg_path, "r"))
	{
		string data = f.read();
		f.close();

		data = string_replace(data, "\r\n", "\n", true);
		data = string_replace(data, "\r", "\n", true);
		string[]@ lines = string_split(data, "\n", true);
		if (lines !is null)
		{
			for (uint i = 0; i < lines.length(); i++)
			{
				string line = lines[i].trim_whitespace();
				if (line == "" || string_left(line, 1) == "#" || string_left(line, 1) == ";") continue;

				string[]@ parts = string_split(line, "=", true);
				if (parts !is null && parts.length() >= 2)
				{
					string k = parts[0].trim_whitespace().lower();
					string val = parts[1].trim_whitespace();

					if (k == "game_version") current_game_version = val;
					else if (k == "content_version") current_content_version = val;
					else if (k == "sounds_version") current_sounds_version = val;
					else if (k == "maps_version") current_maps_version = val;
					else if (k == "check_updates_on_startup") check_updates_on_startup = int(string_to_number(val));
					else if (k == "manifest_url") update_manifest_url = val;
				}
			}
		}
	}
	current_game_version = ver;
}

void save_updater_settings()
{
	current_game_version = ver;
	if (!directory_exists("settings")) directory_create("settings");

	file f;
	if (f.open("settings/versions.cfg", "w"))
	{
		f.write("# Dangerous World Version and Update Settings\n");
		f.write("game_version=" + current_game_version + "\n");
		f.write("content_version=" + current_content_version + "\n");
		f.write("sounds_version=" + current_sounds_version + "\n");
		f.write("maps_version=" + current_maps_version + "\n");
		f.write("check_updates_on_startup=" + check_updates_on_startup + "\n");
		f.write("manifest_url=" + update_manifest_url + "\n");
		f.close();
	}
}

int compare_versions(const string&in v1, const string&in v2)
{
	if (v1 == v2) return 0;
	if (v1 == "") return (v2 == "") ? 0 : 1;
	if (v2 == "") return -1;

	string[]@ parts1 = string_split(v1, ".", true);
	string[]@ parts2 = string_split(v2, ".", true);

	uint max_len = (parts1.length() > parts2.length()) ? parts1.length() : parts2.length();
	for (uint i = 0; i < max_len; i++)
	{
		int n1 = 0;
		int n2 = 0;
		if (i < parts1.length()) n1 = int(string_to_number(parts1[i]));
		if (i < parts2.length()) n2 = int(string_to_number(parts2[i]));

		if (n2 > n1) return 1;  // v2 is newer
		if (n2 < n1) return -1; // v2 is older
	}
	return 0;
}

string format_byte_size(int64 bytes)
{
	if (bytes <= 0) return "unknown size";
	if (bytes >= 1073741824)
	{
		double gb = double(bytes) / 1073741824.0;
		return round(gb, 2) + " gigabytes";
	}
	if (bytes >= 1048576)
	{
		double mb = double(bytes) / 1048576.0;
		return round(mb, 1) + " megabytes";
	}
	if (bytes >= 1024)
	{
		double kb = double(bytes) / 1024.0;
		return round(kb, 1) + " kilobytes";
	}
	return bytes + " bytes";
}

void play_updater_tune(const string&in name)
{
	string sound_path = "";
	if (name == "detected" || name == "updatefound" || name == "found")
	{
		if (file_exists("sounds/updater/updatefound.ogg")) sound_path = "sounds/updater/updatefound.ogg";
		else if (file_exists("sounds/updater/detected.ogg")) sound_path = "sounds/updater/detected.ogg";
	}
	else if (name == "complete" || name == "updatecomplete" || name == "completed")
	{
		if (file_exists("sounds/updater/updatecomplete.ogg")) sound_path = "sounds/updater/updatecomplete.ogg";
		else if (file_exists("sounds/updater/complete.ogg")) sound_path = "sounds/updater/complete.ogg";
	}
	else if (file_exists("sounds/updater/" + name + ".ogg"))
		sound_path = "sounds/updater/" + name + ".ogg";
	else if (file_exists("sounds/updater/" + name + ".wav"))
		sound_path = "sounds/updater/" + name + ".wav";

	if (sound_path == "" && (name == "detected" || name == "updatefound"))
	{
		sound_path = get_sound_path("menu sounds/open.ogg");
		if (sound_path == "") sound_path = get_sound_path("menu/open.ogg");
	}
	else if (sound_path == "" && (name == "complete" || name == "updatecomplete"))
	{
		sound_path = get_sound_path("menu sounds/enter.ogg");
		if (sound_path == "") sound_path = get_sound_path("menu/enter.ogg");
	}

	if (sound_path != "" && file_exists(sound_path))
	{
		sound s;
		if (s.load(sound_path))
		{
			s.play_wait();
		}
		else
		{
			p.play_stationary(sound_path, false);
		}
	}
}

string get_updater_music_path()
{
	if (file_exists("sounds/updater/updatemusic.ogg")) return "sounds/updater/updatemusic.ogg";
	if (file_exists("sounds/updater/update_loop.ogg")) return "sounds/updater/update_loop.ogg";
	if (file_exists("sounds/updater/music.ogg")) return "sounds/updater/music.ogg";
	if (file_exists("sounds/updater/loop.ogg")) return "sounds/updater/loop.ogg";
	return "";
}

void restart_game_client()
{
	wait(200);
	if (SCRIPT_COMPILED)
	{
		run("dw.exe", "", false, false);
	}
	else
	{
		run("nvgt", "dw.nvgt", false, false);
	}
	exit();
}

bool ask_update_confirmation(const string&in message)
{
	speak(message + " Press Enter to download, or Escape to cancel.");
	while (true)
	{
		wait(5);
		if (key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER) || key_pressed(KEY_Y))
		{
			return true;
		}
		if (key_pressed(KEY_ESCAPE) || key_pressed(KEY_N))
		{
			speak("Update cancelled.");
			return false;
		}
		if (key_pressed(KEY_UP) || key_pressed(KEY_DOWN) || key_pressed(KEY_LEFT) || key_pressed(KEY_RIGHT) || key_pressed(KEY_SPACE))
		{
			speak(message + " Press Enter to download, or Escape to cancel.");
		}
	}
	return false;
}

// Downloads any file via streaming directly to disk using Windows native curl.exe.
// Completely bypasses memory buffer limits, supporting massive files (> 2 GB) without RAM overhead.
bool download_file_streaming(const string&in url, const string&in temp_file, int64 expected_size, sound@ loop_snd)
{
	if (url == "" || temp_file == "") return false;

	string done_file = temp_file + ".done";
	if (file_exists(temp_file)) file_delete(temp_file);
	if (file_exists(done_file)) file_delete(done_file);

	// Windows native curl.exe with redirection support (-L) and silent mode (-s)
	string cmd = "curl.exe -L -k -s -o \"" + temp_file + "\" \"" + url + "\" && echo OK > \"" + done_file + "\" || echo ERR > \"" + done_file + "\"";
	run("cmd.exe", "/c " + cmd, false, false);

	speak("Downloading. Press Space to view download percentage, 1 for total size, 2 for downloaded so far, 3 for remaining, or Escape to cancel.");

	int64 total_bytes = expected_size;

	while (!file_exists(done_file))
	{
		wait(10);

		int64 downloaded_bytes = file_exists(temp_file) ? file_get_size(temp_file) : 0;

		double pct = 0.0;
		if (total_bytes > 0 && downloaded_bytes > 0)
		{
			pct = (double(downloaded_bytes) / double(total_bytes)) * 100.0;
			if (pct > 100.0) pct = 100.0;
		}

		int64 remaining_bytes = (total_bytes > downloaded_bytes) ? (total_bytes - downloaded_bytes) : 0;

		if (key_pressed(KEY_SPACE))
		{
			if (total_bytes > 0)
				speak(int(round(pct, 0)) + "% downloaded");
			else
				speak(format_byte_size(downloaded_bytes) + " downloaded");
		}
		else if (key_pressed(KEY_1))
		{
			speak("Total size: " + format_byte_size(total_bytes));
		}
		else if (key_pressed(KEY_2))
		{
			speak("Downloaded: " + format_byte_size(downloaded_bytes));
		}
		else if (key_pressed(KEY_3))
		{
			if (total_bytes > 0)
				speak("Remaining: " + format_byte_size(remaining_bytes));
			else
				speak("Remaining size unknown.");
		}
		else if (key_pressed(KEY_H))
		{
			speak("Press Space to view download percentage, 1 for total size, 2 for downloaded so far, 3 for remaining, or Escape to cancel.");
		}
		else if (key_pressed(KEY_ESCAPE))
		{
			// Force terminate curl.exe
			run("taskkill", "/F /IM curl.exe", true, false);
			wait(50);
			if (file_exists(temp_file)) file_delete(temp_file);
			if (file_exists(done_file)) file_delete(done_file);
			if (@loop_snd != null && loop_snd.active) loop_snd.stop();
			speak("Download cancelled.");
			return false;
		}
	}

	// Read done file result
	string result = "";
	file df;
	if (df.open(done_file, "r"))
	{
		result = df.read().trim_whitespace();
		df.close();
	}
	if (file_exists(done_file)) file_delete(done_file);

	if (result != "OK" || !file_exists(temp_file) || file_get_size(temp_file) == 0)
	{
		if (file_exists(temp_file)) file_delete(temp_file);
		if (@loop_snd != null && loop_snd.active) loop_snd.stop();
		speak("Download failed. Please check your network connection and try again.");
		return false;
	}

	return true;
}

const string UPDATE_TEMP_DIR = "update_temp";

void ensure_clean_update_temp()
{
	if (directory_exists(UPDATE_TEMP_DIR))
	{
		run("cmd.exe", "/c rd /s /q \"" + UPDATE_TEMP_DIR + "\"", true, false);
		wait(50);
	}
	if (!directory_exists(UPDATE_TEMP_DIR))
	{
		directory_create(UPDATE_TEMP_DIR);
	}
}

void cleanup_update_temp()
{
	if (directory_exists(UPDATE_TEMP_DIR))
	{
		run("cmd.exe", "/c rd /s /q \"" + UPDATE_TEMP_DIR + "\"", true, false);
	}
}

bool download_and_apply_update(update_item@ item)
{
	if (item is null || item.url == "")
	{
		speak("Error: Invalid update source URL.");
		return false;
	}

	ensure_clean_update_temp();

	sound loop_sound;
	string music_file = get_updater_music_path();
	if (music_file != "")
	{
		loop_sound.load(music_file);
		loop_sound.play_looped();
	}

	// 1. GAME UPDATE (Executable)
	if (item.type == UPDATE_GAME)
	{
		string temp_exe = UPDATE_TEMP_DIR + "/dw_update.exe";
		if (!download_file_streaming(item.url, temp_exe, item.size, loop_sound))
		{
			loop_sound.stop();
			cleanup_update_temp();
			return false;
		}
		loop_sound.stop();

		// Validate executable
		if (!file_exists(temp_exe) || file_get_size(temp_exe) < 102400)
		{
			cleanup_update_temp();
			speak("Game update download is corrupt or incomplete. Update aborted.");
			return false;
		}

		file ef;
		if (ef.open(temp_exe, "rb"))
		{
			string header = ef.read(2);
			ef.close();
			if (header != "MZ")
			{
				cleanup_update_temp();
				speak("Game update file is not a valid executable. Update aborted.");
				return false;
			}
		}

		play_updater_tune("complete");

		if (file_exists("dw_update.exe")) file_delete("dw_update.exe");
		file_copy(temp_exe, "dw_update.exe", true);
		cleanup_update_temp();

		file bat;
		if (bat.open("apply_game_update.bat", "w"))
		{
			bat.write("@echo off\r\n");
			bat.write("timeout /t 1 /nobreak > nul\r\n");
			bat.write("if exist \"dw_update.exe\" (\r\n");
			bat.write("    move /y \"dw_update.exe\" \"dw.exe\" > nul\r\n");
			bat.write(")\r\n");
			bat.write("start \"\" \"dw.exe\"\r\n");
			bat.write("del \"%~f0\"\r\n");
			bat.close();
		}

		current_game_version = item.new_version;
		save_updater_settings();

		speak("Game update is complete, the game will now restart.");
		wait(1500);
		run("cmd.exe", "/c apply_game_update.bat", false, true);
		exit();
		return true;
	}

	// 2. CONTENT UPDATE (Single contents.dat replacement containing all items, weapons, stores, packages)
	else if (item.type == UPDATE_CONTENT)
	{
		string temp_contents = UPDATE_TEMP_DIR + "/contents.dat";
		if (!download_file_streaming(item.url, temp_contents, item.size, loop_sound))
		{
			loop_sound.stop();
			cleanup_update_temp();
			return false;
		}
		loop_sound.stop();

		// Validate content file integrity
		if (!file_exists(temp_contents) || file_get_size(temp_contents) == 0)
		{
			cleanup_update_temp();
			speak("Content update download is empty or failed. Existing content preserved.");
			return false;
		}

		file cf;
		if (!cf.open(temp_contents, "rb"))
		{
			cleanup_update_temp();
			speak("Cannot open downloaded content file. Existing content preserved.");
			return false;
		}
		string enc = cf.read();
		cf.close();

		string dec = string_decrypt(enc, CONTENT_ENC_KEY);
		if (dec.length() == 0 || (string_contains(dec, "[item:", 1) == -1 && string_contains(dec, "[weapon:", 1) == -1 && string_contains(dec, "[store:", 1) == -1 && string_contains(dec, "[package:", 1) == -1))
		{
			cleanup_update_temp();
			speak("Content update file is corrupt or invalid. Existing content preserved.");
			return false;
		}

		play_updater_tune("complete");

		// Transfer validated contents.dat to proper location
		if (!directory_exists("settings")) directory_create("settings");
		if (file_exists("settings/contents.dat")) file_delete("settings/contents.dat");
		file_copy(temp_contents, "settings/contents.dat", true);

		if (directory_exists("data"))
		{
			if (file_exists("data/contents.dat")) file_delete("data/contents.dat");
			file_copy(temp_contents, "data/contents.dat", true);
		}
		if (file_exists("contents.dat"))
		{
			file_delete("contents.dat");
			file_copy(temp_contents, "contents.dat", true);
		}

		// Clean old split dat files
		if (file_exists("settings/items.dat")) file_delete("settings/items.dat");
		if (file_exists("settings/weapons.dat")) file_delete("settings/weapons.dat");
		if (file_exists("settings/shops.dat")) file_delete("settings/shops.dat");
		if (file_exists("settings/stores.dat")) file_delete("settings/stores.dat");
		if (file_exists("settings/packages.dat")) file_delete("settings/packages.dat");

		cleanup_update_temp();

		current_content_version = item.new_version;
		save_updater_settings();

		speak("Content update is complete, the game will now restart.");
		wait(1500);
		restart_game_client();
		return true;
	}

	// 3. SOUNDS UPDATE (Zipped sound package downloaded, extracted in temp, validated, then transferred to sounds folder)
	else if (item.type == UPDATE_SOUNDS)
	{
		string temp_zip = UPDATE_TEMP_DIR + "/sounds_update.zip";
		string temp_extract = UPDATE_TEMP_DIR + "/extracted_sounds";

		if (!download_file_streaming(item.url, temp_zip, item.size, loop_sound))
		{
			loop_sound.stop();
			cleanup_update_temp();
			return false;
		}
		loop_sound.stop();

		// Validate zip download
		if (!file_exists(temp_zip) || file_get_size(temp_zip) < 1000)
		{
			cleanup_update_temp();
			speak("Sound update download failed or incomplete. Existing sounds preserved.");
			return false;
		}

		speak("Extracting sound package in temporary staging. Please wait...");
		if (!directory_exists(temp_extract)) directory_create(temp_extract);

		string extract_cmd = "tar.exe -xf \"" + temp_zip + "\" -C \"" + temp_extract + "\" 2>nul || powershell -Command \"Expand-Archive -Path '" + temp_zip + "' -DestinationPath '" + temp_extract + "' -Force\"";
		run("cmd.exe", "/c " + extract_cmd, true, false);

		// Validate extraction
		string[]@ ext_dirs = find_directories(temp_extract + "/*");
		string[]@ ext_files = find_files(temp_extract + "/*");
		if ((ext_dirs is null || ext_dirs.length() == 0) && (ext_files is null || ext_files.length() == 0))
		{
			cleanup_update_temp();
			speak("Sound archive extraction failed or corrupted. Existing sounds preserved.");
			return false;
		}

		speak("Validation successful. Transferring updated sounds to game directory...");
		if (!directory_exists("sounds")) directory_create("sounds");

		// If extracted directory contains a root 'sounds' folder, copy its contents
		if (directory_exists(temp_extract + "/sounds"))
		{
			run("cmd.exe", "/c xcopy /E /Y /I \"" + temp_extract + "\\sounds\\*\" \"sounds\\\"", true, false);
		}
		else
		{
			run("cmd.exe", "/c xcopy /E /Y /I \"" + temp_extract + "\\*\" \"sounds\\\"", true, false);
		}

		cleanup_update_temp();

		current_sounds_version = item.new_version;
		save_updater_settings();

		play_updater_tune("complete");
		speak("Sound update is complete, the game will now restart.");
		wait(1500);
		restart_game_client();
		return true;
	}

	// 4. MAPS UPDATE (Single maps.dat replacement)
	else if (item.type == UPDATE_MAPS)
	{
		string temp_maps = UPDATE_TEMP_DIR + "/maps.dat";
		if (!download_file_streaming(item.url, temp_maps, item.size, loop_sound))
		{
			loop_sound.stop();
			cleanup_update_temp();
			return false;
		}
		loop_sound.stop();

		// Validate map file integrity
		if (!file_exists(temp_maps) || file_get_size(temp_maps) == 0)
		{
			cleanup_update_temp();
			speak("Map update download is empty or failed. Existing maps preserved.");
			return false;
		}

		file mf;
		if (!mf.open(temp_maps, "rb"))
		{
			cleanup_update_temp();
			speak("Cannot open downloaded maps file. Existing maps preserved.");
			return false;
		}
		string menc = mf.read();
		mf.close();

		string mdec = string_decrypt(menc, MAP_ENC_KEY);
		if (mdec.length() == 0 || (string_contains(mdec, "[map:", 1) == -1 && string_contains(mdec, "platform", 1) == -1 && string_contains(mdec, "spawnpoint", 1) == -1))
		{
			cleanup_update_temp();
			speak("Map update file is corrupt or invalid. Existing maps preserved.");
			return false;
		}

		play_updater_tune("complete");

		if (!directory_exists("settings")) directory_create("settings");
		if (file_exists("settings/maps.dat")) file_delete("settings/maps.dat");
		file_copy(temp_maps, "settings/maps.dat", true);

		if (directory_exists("data"))
		{
			if (file_exists("data/maps.dat")) file_delete("data/maps.dat");
			file_copy(temp_maps, "data/maps.dat", true);
		}
		if (file_exists("maps.dat"))
		{
			file_delete("maps.dat");
			file_copy(temp_maps, "maps.dat", true);
		}

		cleanup_update_temp();

		current_maps_version = item.new_version;
		save_updater_settings();

		speak("Map update is complete, the game will now restart.");
		wait(1500);
		restart_game_client();
		return true;
	}

	cleanup_update_temp();
	return false;
}

bool check_for_updates(bool interactive = true)
{
	load_updater_settings();

	if (interactive)
	{
		speak("Checking for updates...");
	}

	http h;
	h.connect_timeout = interactive ? 2000 : 600;
	h.receive_timeout = interactive ? 2000 : 600;
	h.max_retries = interactive ? 1 : 0;
	h.get(update_manifest_url);

	timer req_timer;
	int max_ms = interactive ? 2500 : 600;
	while (!h.complete && req_timer.elapsed < max_ms)
	{
		wait(5);
		if (interactive && key_pressed(KEY_ESCAPE))
		{
			h.reset();
			speak("Update check cancelled.");
			return false;
		}
	}

	if (!h.complete || h.status_code != 200 || h.response_body == "")
	{
		h.reset();
		if (interactive)
		{
			speak("No updates found.");
		}
		return false;
	}

	var@ parsed_var = parse_json(h.response_body);
	if (parsed_var is null)
	{
		if (interactive) speak("No updates found.");
		return false;
	}

	json_object@ root = parsed_var;
	if (root is null)
	{
		if (interactive) speak("No updates found.");
		return false;
	}

	update_item@ available_update = null;

	// 1. Check Game executable update
	if (root.is_object("game"))
	{
		json_object@ g = root.get_object("game");
		string rem_ver = g["version"];
		if (compare_versions(current_game_version, rem_ver) > 0)
		{
			@available_update = update_item();
			available_update.type = UPDATE_GAME;
			available_update.current_version = current_game_version;
			available_update.new_version = rem_ver;
			available_update.url = g["url"];
			if (g.is_object("size") || !g.is_null("size")) available_update.size = int64(g["size"]);
			if (g.is_object("target_file") || !g.is_null("target_file")) available_update.target_file = g["target_file"];
		}
	}

	// 2. Check Content update (items/weapons/stores)
	if (available_update is null && (root.is_object("content") || root.is_object("contents")))
	{
		json_object@ c = root.is_object("content") ? root.get_object("content") : root.get_object("contents");
		string rem_ver = c["version"];
		if (compare_versions(current_content_version, rem_ver) > 0)
		{
			@available_update = update_item();
			available_update.type = UPDATE_CONTENT;
			available_update.current_version = current_content_version;
			available_update.new_version = rem_ver;
			available_update.url = c["url"];
			if (c.is_object("size") || !c.is_null("size")) available_update.size = int64(c["size"]);
			if (c.is_object("target_file") || !c.is_null("target_file")) available_update.target_file = c["target_file"];
		}
	}

	// 3. Check Sound pack update
	if (available_update is null && root.is_object("sounds"))
	{
		json_object@ s = root.get_object("sounds");
		string rem_ver = s["version"];
		if (compare_versions(current_sounds_version, rem_ver) > 0)
		{
			@available_update = update_item();
			available_update.type = UPDATE_SOUNDS;
			available_update.current_version = current_sounds_version;
			available_update.new_version = rem_ver;
			available_update.url = s["url"];
			if (s.is_object("size") || !s.is_null("size")) available_update.size = int64(s["size"]);
			if (s.is_object("new_count") || !s.is_null("new_count")) available_update.new_sound_count = int(s["new_count"]);
			if (s.is_object("target_folder") || !s.is_null("target_folder")) available_update.target_folder = s["target_folder"];
		}
	}

	// 4. Check Map update
	if (available_update is null && root.is_object("maps"))
	{
		json_object@ m = root.get_object("maps");
		string rem_ver = m["version"];
		if (compare_versions(current_maps_version, rem_ver) > 0)
		{
			@available_update = update_item();
			available_update.type = UPDATE_MAPS;
			available_update.current_version = current_maps_version;
			available_update.new_version = rem_ver;
			available_update.url = m["url"];
			if (m.is_object("size") || !m.is_null("size")) available_update.size = int64(m["size"]);
			if (m.is_object("target_file") || !m.is_null("target_file")) available_update.target_file = m["target_file"];
		}
	}

	if (available_update is null)
	{
		if (interactive)
		{
			speak("No updates found.");
		}
		return false;
	}

	// Stop main menu music so detected jingle plays cleanly without overlapping
	stop_main_menu_music();

	// Play detected tune
	play_updater_tune("detected");

	// Format prompt announcement according to specification
	string prompt_msg = "";
	if (available_update.type == UPDATE_GAME)
	{
		prompt_msg = "Update available! Your version is " + available_update.current_version + " and the new version is " + available_update.new_version + ".";
	}
	else if (available_update.type == UPDATE_CONTENT)
	{
		prompt_msg = "A new content update has been found.";
	}
	else if (available_update.type == UPDATE_SOUNDS)
	{
		if (available_update.new_sound_count > 0)
		{
			prompt_msg = available_update.new_sound_count + " new sounds available for download.";
		}
		else
		{
			prompt_msg = "New sounds available for download.";
		}
	}
	else if (available_update.type == UPDATE_MAPS)
	{
		prompt_msg = "New maps are available.";
	}

	if (ask_update_confirmation(prompt_msg))
	{
		return download_and_apply_update(available_update);
	}

	return false;
}
