// projectile_system.nvgt - Dedicated 3D Projectile Physics and Ballistics System.
// Handles real physical trajectory simulation, 3D bullet pooling, obstacles/walls collision,
// area-of-effect detonation for missiles, rockets, cannonballs, grenades, drainage canisters,
// laser/energy beams, player damage with metal shield absorption, and weapon-configured sounds.
#include "rotation.nvgt"

sound_pool bulletpool;
bool bullet_pool_initialized = false;
const int MAX_ACTIVE_PROJECTILES = 500;

void ensure_bullet_pool()
{
	if (!bullet_pool_initialized)
	{
		@bulletpool.mixer = mixer();
		bulletpool.max_distance = 60.0;
		bulletpool.pan_step = 1.0;
		bulletpool.volume_step = 2.0;
		bulletpool.hrtf = true;
		bullet_pool_initialized = true;
	}
}

// Classify a weapon's ammo into a real ballistic family so the projectile
// physics actually match what the weapon is configured to fire.
string classify_projectile_type(const string&in ammo_type, const string&in wclass, const string&in wid = "")
{
	string at = string_to_lower_case(ammo_type);
	string wc = string_to_lower_case(wclass);
	string id = string_to_lower_case(wid);

	if (string_contains(at, "laser", 1) > -1 || string_contains(at, "plasma", 1) > -1 ||
		string_contains(at, "quantum", 1) > -1 || string_contains(at, "fusion", 1) > -1 ||
		string_contains(at, "energy", 1) > -1 || string_contains(at, "ion", 1) > -1 ||
		string_contains(at, "pulse", 1) > -1 || string_contains(at, "mw", 1) > -1 ||
		string_contains(at, "gw", 1) > -1 || string_contains(at, "tesla", 1) > -1 ||
		string_contains(at, "arc", 1) > -1 || string_contains(at, "emp", 1) > -1 ||
		string_contains(at, "photon", 1) > -1 || string_contains(at, "particle", 1) > -1 ||
		string_contains(at, "beam", 1) > -1 || string_contains(id, "laser", 1) > -1 ||
		wc == "energy" || wc == "energy_weapons" || wc == "laser")
		return "energy";

	if (string_contains(at, "incendiar", 1) > -1 || string_contains(at, "flame", 1) > -1 ||
		string_contains(at, "fire", 1) > -1 || string_contains(at, "dragon", 1) > -1 ||
		string_contains(at, "napalm", 1) > -1 || string_contains(at, "thermite", 1) > -1 ||
		string_contains(at, "gel", 1) > -1 || string_contains(id, "flame", 1) > -1 ||
		wc == "incendiary" || wc == "flamethrower")
		return "fire";

	if (string_contains(at, "cannon", 1) > -1 || string_contains(id, "cannon", 1) > -1 ||
		string_contains(at, "mortar", 1) > -1 || string_contains(id, "mortar", 1) > -1)
		return "cannonball";

	if (string_contains(at, "missile", 1) > -1 || string_contains(id, "missile", 1) > -1 ||
		string_contains(at, "javelin", 1) > -1 || string_contains(at, "stinger", 1) > -1 ||
		string_contains(at, "tow", 1) > -1 || string_contains(at, "sam", 1) > -1 ||
		string_contains(at, "atgm", 1) > -1)
		return "missile";

	if (string_contains(at, "rocket", 1) > -1 || string_contains(id, "rocket", 1) > -1 ||
		string_contains(at, "rpg", 1) > -1 || string_contains(at, "law", 1) > -1 ||
		string_contains(at, "gustaf", 1) > -1 || string_contains(at, "bazooka", 1) > -1 ||
		string_contains(at, "panzerfaust", 1) > -1)
		return "rocket";

	if (string_contains(at, "grenade", 1) > -1 || string_contains(id, "grenade", 1) > -1 ||
		string_contains(at, "40mm", 1) > -1 || string_contains(at, "38mm", 1) > -1 ||
		string_contains(at, "canister", 1) > -1 || string_contains(at, "bomb", 1) > -1 ||
		string_contains(at, "flare", 1) > -1 || string_contains(at, "smoke", 1) > -1)
		return "grenade";

	if (string_contains(at, "drainage", 1) > -1 || string_contains(id, "drainage", 1) > -1 ||
		string_contains(at, "drenagem", 1) > -1 || string_contains(at, "hydrological", 1) > -1 ||
		string_contains(at, "hydro", 1) > -1 || string_contains(at, "drain", 1) > -1)
		return "drainage";

	return "ballistic";
}

class active_projectile
{
	double x, y, z;
	int start_z;
	int direction;
	string weapon_id;
	string wclass;
	string ammo_type;
	string projectile_type;
	string fire_mode;
	string owner;
	timer speedtimer;
	int speedtime;
	int range;
	int distance;
	int damage;
	int spread;

	active_projectile(double px, double py, double pz, int dir, string wid, string fmode, int dmg, int spd, int rng, int sprd, string powner = "player")
	{
		x = px;
		y = py;
		z = pz;
		start_z = int(pz);
		weapon_id = wid;
		fire_mode = fmode;
		damage = dmg;
		speedtime = (spd > 0) ? spd : 5;
		range = (rng > 0) ? rng : 30;
		spread = sprd;
		distance = 0;
		owner = powner;

		weapon_data@ w = get_weapon_data(wid);
		if (w !is null)
		{
			wclass = w.wclass;
			ammo_type = w.ammo_type;
		}
		else
		{
			wclass = "bullet";
			ammo_type = "Standard";
		}

		// Real ballistic tuning per weapon family:
		// - Energy / laser: pinpoint accuracy, travels near instantly.
		// - Flamethrower / fire: conical flame cone spread, short reach.
		// - Cannon: heavy cannonball ballistic trajectory.
		// - Missile / Rocket: propelled high-speed explosive ordnance.
		// - Grenade: canister ballistic trajectory.
		// - Standard ballistic (9mm, .45 ACP, rifles, snipers): exact configured speed, range and spread.
		projectile_type = classify_projectile_type(ammo_type, wclass, wid);
		if (fire_mode != "melee")
		{
			if (projectile_type == "energy")
			{
				speedtime = 2;
				spread = 0;
			}
			else if (projectile_type == "cannonball")
			{
				speedtime = 14;
				spread = 0;
			}
			else if (projectile_type == "missile")
			{
				speedtime = 8;
				spread = 0;
			}
			else if (projectile_type == "rocket")
			{
				speedtime = 9;
				if (spread < 1) spread = 1;
			}
			else if (projectile_type == "grenade")
			{
				speedtime = 12;
				if (spread < 2) spread = 2;
			}
			else if (projectile_type == "drainage")
			{
				speedtime = 10;
				if (spread < 1) spread = 1;
			}
			else if (projectile_type == "fire")
			{
				speedtime = 8;
				spread = (spread > 0) ? (spread * 2) : 12;
			}
		}

		if (spread > 0)
			direction = int(degree_limit(double(dir) + double(random(-spread, spread)) * 0.5));
		else
			direction = dir;
	}
}

active_projectile@[] active_projectiles(0);

void spawn_projectile(double px, double py, double pz, int dir, string wid, string fmode, int dmg, int spd, int rng, int sprd, string powner = "player")
{
	ensure_bullet_pool();
	if (active_projectiles.length() >= MAX_ACTIVE_PROJECTILES)
	{
		active_projectiles.remove_at(0);
	}
	active_projectile@ proj = active_projectile(px, py, pz, dir, wid, fmode, dmg, spd, rng, sprd, powner);
	active_projectiles.insert_last(proj);
}

void destroy_all_projectiles()
{
	ensure_bullet_pool();
	active_projectiles.resize(0);
}

bool is_projectile_obstacle(int px, int py, int pz)
{
	if (px < minx or px > maxx) return true;
	if (py < miny or py > maxy) return true;
	if (pz < minz or pz > maxz) return true;
	string tile = get_tile_at(px, py, pz);
	if (string_contains(tile, "wall", 1) > -1) return true;
	return false;
}

bool has_line_of_sight(double x1, double y1, double z1, double x2, double y2, double z2)
{
	double dist = get_3d_distance(x1, y1, z1, x2, y2, z2);
	if (dist <= 1.0) return true;
	int steps = int(ceil(dist));
	double step_x = (x2 - x1) / double(steps);
	double step_y = (y2 - y1) / double(steps);
	double step_z = (z2 - z1) / double(steps);
	for (int s = 1; s < steps; s++)
	{
		int cx = int(round(x1 + step_x * double(s), 0));
		int cy = int(round(y1 + step_y * double(s), 0));
		int cz = int(round(z1 + step_z * double(s), 0));
		if (is_projectile_obstacle(cx, cy, cz)) return false;
	}
	return true;
}

double dist_point_to_line_segment_2d(double px, double py, double x1, double y1, double x2, double y2)
{
	double dx = x2 - x1;
	double dy = y2 - y1;
	if (dx == 0.0 && dy == 0.0)
	{
		return get_2d_distance(px, py, x1, y1);
	}
	double t = ((px - x1) * dx + (py - y1) * dy) / (dx * dx + dy * dy);
	if (t < 0.0) t = 0.0;
	else if (t > 1.0) t = 1.0;
	double cx = x1 + t * dx;
	double cy = y1 + t * dy;
	return get_2d_distance(px, py, cx, cy);
}

void trigger_projectile_impact(active_projectile@ pproj)
{
	if (pproj is null) return;
	weapon_data@ w = get_weapon_data(pproj.weapon_id);

	if (w !is null && w.sound_ricochet != "")
	{
		string rico_path = get_sound_path(w.sound_ricochet);
		if (rico_path != "")
		{
			bulletpool.play_extended_3d(rico_path, me.x, me.y, me.z, pproj.x, pproj.y, pproj.z, double(facing), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 100, false);
		}
	}
}

// Area-of-effect detonation for ordnance projectiles (cannonballs, missiles, rockets, grenades, drainage launchers)
void detonate_projectile_area(active_projectile@ pproj)
{
	if (pproj is null) return;
	double radius = 3.5;
	if (pproj.projectile_type == "cannonball") radius = 5.0;
	else if (pproj.projectile_type == "missile") radius = 5.0;
	else if (pproj.projectile_type == "rocket") radius = 4.5;
	else if (pproj.projectile_type == "drainage") radius = 4.0;
	else if (pproj.projectile_type == "grenade") radius = 3.5;

	weapon_data@ w = get_weapon_data(pproj.weapon_id);
	if (w !is null && w.sound_hit != "")
	{
		string hp = get_sound_path(w.sound_hit);
		if (hp != "") bulletpool.play_extended_3d(hp, me.x, me.y, me.z, pproj.x, pproj.y, pproj.z, double(facing), 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 100, false);
	}
	trigger_projectile_impact(pproj);

	// Damage player if inside explosive blast radius (self-splash)
	double p_dist = get_3d_distance(pproj.x, pproj.y, pproj.z, me.x, me.y, me.z);
	if (p_dist <= radius)
	{
		double p_falloff = 1.0 - (p_dist / (radius + 0.5));
		if (p_falloff < 0.25) p_falloff = 0.25;
		int p_splash = int(round(double(pproj.damage) * p_falloff, 0));
		int dmg_left = shield_process_damage(p_splash, "explosive");
		if (dmg_left > 0)
		{
			health_damage_player(dmg_left, "Explosion");
		}
	}
}

void projectile_loop()
{
	ensure_bullet_pool();

	for (int i = int(active_projectiles.length()) - 1; i >= 0; i--)
	{
		if (i >= int(active_projectiles.length())) break;
		active_projectile@ pproj = active_projectiles[i];

		if (pproj.speedtimer.elapsed >= pproj.speedtime)
		{
			pproj.speedtimer.restart();

			vector next_pos = move(pproj.x, pproj.y, pproj.z, pproj.direction, 0);
			pproj.x = next_pos.x;
			pproj.y = next_pos.y;
			pproj.distance++;

			bool is_area_type = (pproj.projectile_type == "cannonball" || pproj.projectile_type == "missile" ||
								 pproj.projectile_type == "rocket" || pproj.projectile_type == "grenade" ||
								 pproj.projectile_type == "drainage");

			// Check obstacles / walls / map bounds: destroyed or detonated on impact
			if (is_projectile_obstacle(int(round(pproj.x, 0)), int(round(pproj.y, 0)), int(round(pproj.z, 0))))
			{
				if (is_area_type)
				{
					detonate_projectile_area(pproj);
				}
				else
				{
					trigger_projectile_impact(pproj);
				}
				active_projectiles.remove_at(uint(i));
				continue;
			}

			// Range expiry
			if (pproj.distance >= pproj.range)
			{
				if (is_area_type)
				{
					detonate_projectile_area(pproj);
				}
				active_projectiles.remove_at(uint(i));
				continue;
			}
		}
	}
}
